l:cxt id="10"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d1d02dc9-6513-42ff-b0f9-33a78062a163"><source>iTero recommends the following best practices for use of the scanner and accessories:</source><seg-source><mrk mtype="seg" mid="6">iTero recommends the following best practices for use of the scanner and accessories:</mrk></seg-source><target><mrk mtype="seg" mid="6">O iTero recomenda as seguintes práticas, aprimoradas para o uso do scanner e dos acessórios:</mrk></target><sdl:seg-defs><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/01/2020 11:43:28</sdl:value><sdl:value key="modified_on">10/21/2020 19:34:22</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1712968416</sdl:value><sdl:value key="SegmentIdentityHash">daYnt62gnCKi5syldxd6O88g4+phLbXZgRYNClrW8yA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="12"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2b507535-8b25-4f27-9727-66485371eaf9"><source>Ensure that the sleeves remain in the labeled box or in the sleeve basket on the cart-configuration scanner, until the time of use.</source><seg-source><mrk mtype="seg" mid="7">Ensure that the sleeves remain in the labeled box or in the sleeve basket on the cart-configuration scanner, until the time of use.</mrk></seg-source><target><mrk mtype="seg" mid="7">Certifique-se de que as ponteiras permanecem na caixa etiquetada ou na cesta de ponteiras do scanner de configuração do carrinho até o momento do uso.</mrk></target><sdl:seg-defs><sdl:seg id="7" conf="ApprovedTranslation" origin="interactive" percent="97"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="97"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">D2NzSATxfOrQ8WwXMjWJHI5N2h3+CuBRfLrxsqlIZFU=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 19:03:00</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">D2NzSATxfOrQ8WwXMjWJHI5N2h3+CuBRfLrxsqlIZFU=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 17:06:01</sdl:value><sdl:value key="SDL:ProjectTranslationHash">326237908</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="12"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="73d4861e-4999-46d8-98e0-2eb1a2c4894c"><source>Inspection of the <x id="6"/> should take place before the application on the wand and after the scan.</source><seg-source><mrk mtype="seg" mid="8">Inspection of the <x id="6"/> should take place before the application on the wand and after the scan.</mrk></seg-source><target><mrk mtype="seg" mid="8"/></target><sdl:seg-defs><sdl:seg id="8" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">OxNAHemp98tjXkro3JrmP2571mUkfnAvuE4VS2QvE5A=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="14"/><sdl:cxt id="15"/><sdl:cxt id="16"/><sdl:cxt id="17"/><sdl:cxt id="12"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="263256c4-1d17-42e9-bf53-cd48651f9e32"><source><x id="10"/><x id="13"/><x id="16"/><x id="19"/></source><seg-source><mrk mtype="seg" mid="9"><x id="10"/></mrk><mrk mtype="seg" mid="10"><x id="13"/></mrk><mrk mtype="seg" mid="11"><x id="16"/></mrk><mrk mtype="seg" mid="12"><x id="19"/></mrk></seg-source><target><mrk mtype="seg" mid="9"><x id="10"/></mrk><mrk mtype="seg" mid="10"><x id="13"/></mrk><mrk mtype="seg" mid="11"><x id="16"/></mrk><mrk mtype="seg" mid="12"><x id="19"/></mrk></target><sdl:seg-defs><sdl:seg id="9" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="10" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="11" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="12" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="18"/><sdl:cxt id="19"/><sdl:cxt id="20"/><sdl:cxt id="21"/><sdl:cxt id="12"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="8d007bad-2d1d-40ae-8307-1a4c34292cf4"><source>Before applying the sleeve, inspect it for any visible discoloration, damage, or distortion that may prevent proper application.Ensure that the clear window is not scratched.After scanning, inspect the clear window to make sure it is not cracked.If damage is observed, see the <g id="31">iTero Lumina sleeves</g> section of the<x id="32"/>.</source><seg-source><mrk mtype="seg" mid="13">Before applying the sleeve, inspect it for any visible discoloration, damage, or distortion that may prevent proper application.</mrk><mrk mtype="seg" mid="14">Ensure that the clear window is not scratched.</mrk><mrk mtype="seg" mid="15">After scanning, inspect the clear window to make sure it is not cracked.</mrk><mrk mtype="seg" mid="16">If damage is observed, see the <g id="31">iTero Lumina sleeves</g> section of the<x id="32"/>.</mrk></seg-source><target><mrk mtype="seg" mid="13">Antes de colocar a ponteira<mrk mtype="x-sdl-location" mid="20ce65f7-ff5d-4a2a-b0ab-e472e1126b35"/>, verifique se há qualquer descoloração, dano ou distorção visível que possa impedir a colocação adequada.</mrk><mrk mtype="seg" mid="14">Certifique-se de que a janela transparente não tenha riscos.</mrk><mrk mtype="seg" mid="15">Após a digitalização, verifique a janela transparente para ter certeza de que não está rachada.</mrk><mrk mtype="seg" mid="16">Se for constatado algum dano, consulte a seção <g id="31">Ponteiras do iTero Lumina</g> do<x id="32"/></mrk></target><sdl:seg-defs><sdl:seg id="13" conf="ApprovedTranslation" origin="interactive" percent="96"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="96"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">k+XXPP2nHtbEMPb+fO5/aOZAsaIcYWyIYJdRXq7pUXo=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 19:03:22</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">k+XXPP2nHtbEMPb+fO5/aOZAsaIcYWyIYJdRXq7pUXo=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 17:18:38</sdl:value><sdl:value key="SDL:ProjectTranslationHash">973102758</sdl:value></sdl:seg><sdl:seg id="14" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1551367072</sdl:value><sdl:value key="SegmentIdentityHash">0lhx2fJHOqtfMhZqVrQede3hdoqewabe43ew6KoXkWE=</sdl:value></sdl:seg><sdl:seg id="15" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-330145972</sdl:value><sdl:value key="SegmentIdentityHash">0W+8mxBPoaDTCCiID3RUe8/ZchNtLpgbXO8eLvRMdcg=</sdl:value></sdl:seg><sdl:seg id="16" conf="ApprovedTranslation" origin="interactive"><sdl:prev-origin origin="source"><sdl:prev-origin origin="source"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="78"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">ubHtlPrA7TBEje6MKyTMWBE15ZJBMZ27elZXKZnoVTY=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 19:03:29</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">ubHtlPrA7TBEje6MKyTMWBE15ZJBMZ27elZXKZnoVTY=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 17:49:49</sdl:value><sdl:value key="SDL:ProjectTranslationHash">85297246</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">ubHtlPrA7TBEje6MKyTMWBE15ZJBMZ27elZXKZnoVTY=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 17:57:59</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-208304034</sdl:value><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">09/02/2024 17:49:52</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">ubHtlPrA7TBEje6MKyTMWBE15ZJBMZ27elZXKZnoVTY=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">523214830</sdl:value><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">09/02/2024 17:58:15</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="22"/><sdl:cxt id="23"/><sdl:cxt id="24"/><sdl:cxt id="25"/><sdl:cxt id="26"/><sdl:cxt id="27"/><sdl:cxt id="28"/><sdl:cxt id="29"/><sdl:cxt id="30"/><sdl:cxt id="31"/><sdl:cxt id="12"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="228a2806-e01d-4dbb-9a21-cba6557e7fa2"><source><x id="69"/> If the patient bites down on the sleeve, stop the procedure and inspect the sleeve for visible damage.<x id="70"/><x id="71"/>If damage is observed, remove the sleeve and visually inspect the optical tip of the wand.<x id="72"/><x id="73"/><x id="74"/><x id="75"/>If cracks are observed on either the optical surface or the tip of the wand, do not use the wand, contact iTero Support, and see the <g id="78">Scanner warnings</g> section of the<x id="79"/>.<x id="80"/><x id="81"/><x id="82"/><x id="83"/>If no damage to the wand is observed, replace the sleeve and continue the scan.<x id="85"/><x id="86"/></source><seg-source><mrk mtype="seg" mid="17"><x id="69"/> If the patient bites down on the sleeve, stop the procedure and inspect the sleeve for visible damage.</mrk><mrk mtype="seg" mid="18"><x id="70"/></mrk><mrk mtype="seg" mid="19"><x id="71"/>If damage is observed, remove the sleeve and visually inspect the optical tip of the wand.</mrk><mrk mtype="seg" mid="20"><x id="72"/></mrk><mrk mtype="seg" mid="21"><x id="73"/></mrk><mrk mtype="seg" mid="22"><x id="74"/></mrk><mrk mtype="seg" mid="23"><x id="75"/>If cracks are observed on either the optical surface or the tip of the wand, do not use the wand, contact iTero Support, and see the <g id="78">Scanner warnings</g> section of the<x id="79"/>.</mrk><mrk mtype="seg" mid="24"><x id="80"/><x id="81"/><x id="82"/></mrk><mrk mtype="seg" mid="25"><x id="83"/>If no damage to the wand is observed, replace the sleeve and continue the scan.</mrk><mrk mtype="seg" mid="26"><x id="85"/><x id="86"/></mrk></seg-source><target><mrk mtype="seg" mid="17"><x id="69"/> Se o paciente morder a ponteira, pare o procedimento e verifique a ponteira para verificar a ocorrência de danos visíveis.</mrk><mrk mtype="seg" mid="18"><x id="70"/></mrk><mrk mtype="seg" mid="19"><x id="71"/>Se for constatado algum dano, remova a ponteira e verifique visualmente a ponta óptica do leitor.</mrk><mrk mtype="seg" mid="20"><x id="72"/></mrk><mrk mtype="seg" mid="21"><x id="73"/></mrk><mrk mtype="seg" mid="22"><x id="74"/></mrk><mrk mtype="seg" mid="23"><x id="75"/>Se forem observadas rachaduras na superfície óptica ou na ponta do bastão, não utilize o leitor e entre em contato com o Suporte do iTero e veja a seção de <g id="78">Alertas do scanner</g> das<x id="79"/>.</mrk><mrk mtype="seg" mid="24"><x id="80"/><x id="81"/><x id="82"/></mrk><mrk mtype="seg" mid="25"><x id="83"/>Se não for observado nenhum dano ao leitor, substitua a ponteira e continue a digitalização.</mrk><mrk mtype="seg" mid="26"><x id="85"/><x id="86"/></mrk></target><sdl:seg-defs><sdl:seg id="17" conf="ApprovedTranslation" origin="interactive" percent="91"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="91"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">1UdFyNIB4tILU7lMySWFGXjwTkjoEvgQ0q3U2/2G7kg=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 19:04:31</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">1UdFyNIB4tILU7lMySWFGXjwTkjoEvgQ0q3U2/2G7kg=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 17:08:02</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1282836141</sdl:value></sdl:seg><sdl:seg id="18" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="19" conf="ApprovedTranslation" origin="interactive" percent="95"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="95"><sdl:prev
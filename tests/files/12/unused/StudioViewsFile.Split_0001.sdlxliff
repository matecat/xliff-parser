mrk mtype="seg" mid="322"/></target><sdl:seg-defs><sdl:seg id="322" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">pSYk64s5/bRffbJvmHlqalDDGftDZdGS0zKCzRlxPTo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="a424dbc1-b85e-4263-9663-259801568ff9"><source><x id="546"/></source><seg-source><mrk mtype="seg" mid="323"><x id="546"/></mrk></seg-source><target><mrk mtype="seg" mid="323"><x id="546"/></mrk></target><sdl:seg-defs><sdl:seg id="323" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="56"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="097eb01a-ea34-4fe7-93e8-6534a544d439"><source>Wireless LAN</source><seg-source><mrk mtype="seg" mid="324">Wireless LAN</mrk></seg-source><target><mrk mtype="seg" mid="324">LAN sem fio</mrk></target><sdl:seg-defs><sdl:seg id="324" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="1o0mAb7szwPl06a0u+dnIdp2p+mP9hcWzqfSBAQ9hzQ="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2019 20:43:11</sdl:value><sdl:value key="modified_on">12/22/2019 00:10:47</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">175011711</sdl:value><sdl:value key="SegmentIdentityHash">1o0mAb7szwPl06a0u+dnIdp2p+mP9hcWzqfSBAQ9hzQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="88"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="07ba168a-5665-4319-ae95-45fbeedfab58"><source>The system comes equipped with a wireless LAN unit.</source><seg-source><mrk mtype="seg" mid="325">The system comes equipped with a wireless LAN unit.</mrk></seg-source><target><mrk mtype="seg" mid="325">O sistema vem equipado com uma unidade de LAN sem fio.</mrk></target><sdl:seg-defs><sdl:seg id="325" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2019 20:43:21</sdl:value><sdl:value key="modified_on">10/22/2020 04:22:04</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">805515852</sdl:value><sdl:value key="SegmentIdentityHash">AwSCTn2SzrPPZ+Sd2qgNGYnHFT3pnRbGh2km8lZmAWI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="89"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="705969cd-5df1-482f-b0b9-31a7a5520669"><source><g id="552">Warning:</g> Never connect the LAN cable to the scanner, to avoid electrical shock.</source><seg-source><mrk mtype="seg" mid="326"><g id="552">Warning:</g> Never connect the LAN cable to the scanner, to avoid electrical shock.</mrk></seg-source><target><mrk mtype="seg" mid="326"><g id="552">Aviso:</g> para evitar choque elétrico, nunca conecte o cabo LAN ao scanner.</mrk></target><sdl:seg-defs><sdl:seg id="326" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1735543827</sdl:value><sdl:value key="SegmentIdentityHash">6dzfBRt6mJ3ezJ7Ds+mG0KpUKPnmIoVW57l1De8Wztc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="88"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e768c514-d646-4b50-8422-08a628727191"><source>When using the product, maintain a separation distance of at least 20cm between the computing unit and all persons&apos; bodies to ensure compliance with RF exposure requirements.</source><seg-source><mrk mtype="seg" mid="327">When using the product, maintain a separation distance of at least 20cm between the computing unit and all persons&apos; bodies to ensure compliance with RF exposure requirements.</mrk></seg-source><target><mrk mtype="seg" mid="327">Ao usar o produto, mantenha uma distância de separação de pelo menos 20 cm entre a unidade de computação e o corpo de todas as pessoas, para garantir a conformidade com os requisitos de exposição à RF.</mrk></target><sdl:seg-defs><sdl:seg id="327" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">01/09/2021 01:55:37</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1761440322</sdl:value><sdl:value key="SegmentIdentityHash">GW9bQZMfZjVDZ5FcUTNAGfDEh4T5FG0bbXzircpvmlM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="18f8173c-5ddb-4225-910e-45284e374994"><source>Safety classifications</source><seg-source><mrk mtype="seg" mid="328">Safety classifications</mrk></seg-source><target><mrk mtype="seg" mid="328">Classificações de segurança</mrk></target><sdl:seg-defs><sdl:seg id="328" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2019 20:43:24</sdl:value><sdl:value key="modified_on">12/21/2019 02:05:22</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1509719590</sdl:value><sdl:value key="SegmentIdentityHash">qSYxNZWNU403VbEt+hpbH1akBRcLSxaNaZqDa/NKfew=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="02f50711-c286-4e85-b79e-220805237d1c"><source>Type of protection against electrical shock: Class 1.</source><seg-source><mrk mtype="seg" mid="329">Type of protection against electrical shock: Class 1.</mrk></seg-source><target><mrk mtype="seg" mid="329">Tipo de proteção contra choque elétrico: Classe 1.</mrk></target><sdl:seg-defs><sdl:seg id="329" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/15/2020 09:38:42</sdl:value><sdl:value key="modified_on">05/15/2020 09:38:42</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1601417861</sdl:value><sdl:value key="SegmentIdentityHash">JgkhJBFGHA+dCiGTux88vxxQKU982lR/n3UQUV2ZcNE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="90"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-
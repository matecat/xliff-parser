the changes and return to the <g id="13">Settings</g> window.</mrk></seg-source><target><mrk mtype="seg" mid="14">Para definir o padrão da configuração de brilho, toque no botão <g id="9">Brilho</g>, mova o controle deslizante até o nível de brilho desejado e, depois, toque em <x id="10"/> para salvar as alterações e retornar à janela <g id="13">Configurações</g>.</mrk></target><sdl:seg-defs><sdl:seg id="14" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:19</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:19</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2100795390</sdl:value><sdl:value key="SegmentIdentityHash">qlOO1F+vvjvDtr6lS2pxte9iVR3/ootQQsx59LVKer8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="df91c9bd-69fa-4c49-8065-31ea727e1a7b"><source>Brightness settings</source><seg-source><mrk mtype="seg" mid="15">Brightness settings</mrk></seg-source><target><mrk mtype="seg" mid="15">Configurações de brilho</mrk></target><sdl:seg-defs><sdl:seg id="15" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/09/2019 09:07:10</sdl:value><sdl:value key="modified_on">12/22/2019 01:34:03</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">761246774</sdl:value><sdl:value key="SegmentIdentityHash">u1OVBYgsf1ozo1Ih/JO1LJH7YoAb90ZnC6T8fP3X5uI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/>
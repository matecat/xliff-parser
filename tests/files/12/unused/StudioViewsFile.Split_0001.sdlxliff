="100"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="11" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="11"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="fee1de28-2ae0-40f2-a342-10623eba1aba"><source>The View mode includes a <g id="21">Review tool</g> that enables you to view the NIRI and colored intraoral images captured during the scan, for every area of interest.These images are displayed in the image pane, on the right of the <g id="25">View</g> window.</source><seg-source><mrk mtype="seg" mid="12">The View mode includes a <g id="21">Review tool</g> that enables you to view the NIRI and colored intraoral images captured during the scan, for every area of interest.</mrk><mrk mtype="seg" mid="13">These images are displayed in the image pane, on the right of the <g id="25">View</g> window.</mrk></seg-source><target><mrk mtype="seg" mid="12">O modo Visualizar inclui a <g id="21">ferramenta Revisão</g> que permite visualizar as imagens NIRI e intraorais coloridas, capturadas durante a digitalização, para cada área de interesse.</mrk><mrk mtype="seg" mid="13">Essas imagens são exibidas no painel de imagens, à direita da janela <g id="25">Visualizar</g>.</mrk></target><sdl:seg-defs><sdl:seg id="12" conf="ApprovedTranslation" origin="interactive" percent="95"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="95"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">3Zd51e6ATkAgiE9eJyetl2pRm4V/4AuRdOFZHLi1U10=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/29/2024 03:26:42</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">3Zd51e6ATkAgiE9eJyetl2pRm4V/4AuRdOFZHLi1U10=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 14:13:31</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1316754166</sdl:value></sdl:seg><sdl:seg id="13" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="JlmGtWYoC0S42IQBr3ERxcJBrdLmxJxhseSoA45tkTw="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:26</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:26</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-17658010</sdl:value><sdl:value key="SegmentIdentityHash">JlmGtWYoC0S42IQBr3ERxcJBrdLmxJxhseSoA45tkTw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="bc875d63-d395-4742-91cc-8408e06c7c46"><source>In addition, you can:</source><seg-source><mrk mtype="seg" mid="14">In addition, you can:</mrk></seg-source><target><mrk mtype="seg" mid="14">Além disso, é possível:</mrk></target><sdl:seg-defs><sdl:seg id="14" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="YXf5LxSctMQ+DEYkCZA389BVbfN7Jl/os/26eqi+vVM="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/01/2020 15:57:03</sdl:value><sdl:value key="modified_on">10/21/2020 19:57:03</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-105057925</sdl:value><sdl:value key="SegmentIdentityHash">YXf5LxSctMQ+DEYkCZA389BVbfN7Jl/os/26eqi+vVM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="60b63675-e083-4923-aa37-713585ab2ce7"><source>Zoom in and out of the images in the image pane, as described in <x id="28"/></source><seg-source><mrk mtype="seg" mid="15">Zoom in and out of the images in the image pane, as described in <x id="28"/></mrk></seg-source><target><mrk mtype="seg" mid="15">Aumentar e diminuir o zoom da imagem no painel de imagens, conforme descrito em <x id="28"/></mrk></target><sdl:seg-defs><sdl:seg id="15" conf="ApprovedTranslation" origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="99"><sdl:value key="SegmentIdentityHash">dl24lA9l/x2hPqnwnaCIdThlka1oAM2Hn/A54qGMqL8=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 14:13:44</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-2080906152</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="28967980-a006-4c33-9208-8ca040fa2c97"><source>Adjust the brightness and contrast of the images in the image pane, as described in <x id="30"/></source><seg-source><mrk mtype="seg" mid="16">Adjust the brightness and contrast of the images in the image pane, as described in <x id="30"/></mrk></seg-source><target><mrk mtype="seg" mid="16">Ajustar o brilho e o contraste da imagem no painel de imagens, conforme descrito em <x id="30"/></mrk></target><sdl:seg-defs><sdl:seg id="16" conf="ApprovedTranslation" origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="99"><sdl:value key="SegmentIdentityHash">ARx+EhynGrLuJIWFxTecX4epVs1kQVKCqeptqAIcn7A=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 14:13:49</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1613492894</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="08875a28-2e67-43f2-90eb-06e20a8c8b78"><source>Capture screenshots of the images, as described in <x id="32"/></source><seg-source><mrk mtype="seg" mid="17">Capture screenshots of the images, as described in <x id="32"/></mrk></seg-source><target><mrk mtype="seg" mid="17">Fazer capturas de telas da imagem, conforme descrito em <x id="32"/></mrk></target><sdl:seg-defs><sdl:seg id="17" conf="ApprovedTranslation" origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="99"><sdl:value key="SegmentIdentityHash">+4CfGpB11Z/+9oYu/Qo6M7D1uFr6+pVUgiQQOEeJv7I=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 14:13:55</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-77019124</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="8fa8e68a-3e94-407b-a51e-df9e2a30292e"><source>When reviewing the 3D model as a NIRI image, the upper and lower jaw orientation has been set to look as if you are looking into the patient’s mouth.</source><seg-source><mrk mtype="seg" mid="18">When reviewing the 3D model as a NIRI image, the upper and lower jaw orientation has been set to look as if you are looking into the patient’s mouth.</mrk></seg-source><target><mrk mtype="seg" mid="18">Ao revisar o modelo 3D como imagem NIRI, a orientação da mandíbula e maxila é definida para parecer como se você estivesse olhando para a boca do paciente.</mrk></target><sdl:seg-defs><sdl:seg id="18" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">T/ezKemeUHJi8YPWDK/1fljtMTjbS9wXt16bAxJNSts=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1749800798</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="62a393ad-1825-40e8-8e62-73037fa7dc2c"><source><g id="38">Note:</g> If you notice an issue with a NIRI image, please contact Customer Support.</source><seg-source><mrk mtype="seg" mid="19"><g id="38">Note:</g> If you notice an issue with a NIRI image, please contact Customer Support.</mrk></seg-source><target><mrk mtype="seg" mid="19"><g id="38">Nota:</g> caso você perceba algum problema com a imagem NIRI, entre em contato com Suporte ao Cliente.</mrk></target><sdl:seg-defs><sdl:seg id="19" conf="ApprovedTranslation" origin="interactive"><sdl:prev-origin origin="source"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">/QV64BOGKuiZVAHHe3c3rnklaMOwkyhScCn6r4BDLvw=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/29/2024 03:28:31</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">/QV64BOGKuiZVAHHe3c3rnklaMOwkyhScCn6r4BDLvw=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="created_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="created_on">08/29/2024 03:28:33</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1876172668</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="5f9c72b3-2eef-4d15-80aa-2a372ea2b746"><source>To activate the Review tool:</source><seg-source><mrk mtype="seg" mid="20">To activate the Review tool:</mrk></seg-source><target><mrk mtype="seg" mid="20">Para ativar a ferramenta Revisão:</mrk></target><sdl:seg-defs><sdl:seg id="20" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="Ys8ecoIfM9lzVVwxTjD3v7UVlvyja2XRhH0qAvxHUtI="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/11/2019 15:11:29</sdl:value><sdl:value key="modified_on">12/23/2019 01:08:46</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">417464986</sdl:value><sdl:value key="SegmentIdentityHash">Ys8ecoIfM9lzVVwxTjD3v7UVlvyja2XRhH0qAvxHUtI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="f589090e-244a-4401-8d80-0bed66d63964"><source>In the <g id="45">View</g> window, tap <x id="46"/> and then drag the loupe from the right pane over an area of interest.</source><seg-source><mrk mtype="seg" mid="21">In the <g id="45">View</g> window, tap <x id="46"/> and then drag the loupe from the right pane over an area of interest.</mrk></seg-source><target><mrk mtype="seg" mid="21">Na janela <g id="45">Visualizar</g>, toque em <x id="46"/> e, em seguida, arraste a lupa do painel da direita sobre uma área de interesse.</mrk></target><sdl:seg-defs><sdl:seg id="21" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="w+oO2s/EEDFhjMnI2B1fKszPndqomEOfnmhIozPrIo0="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:26</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:26</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">989285214</sdl:value><sdl:value key="SegmentIdentityHash">w+oO2s/EEDFhjMnI2B1fKszPndqomEOfnmhIozPrIo0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="36949ebd-267c-4933-86bc-c43812359028"><source>Review tool with the <x id="50"/> loupe in the right pane</source><seg-source><mrk mtype="seg" mid="22">Review tool with the <x id="50"/> loupe in the right pane</mrk></seg-source><target><mrk mtype="seg" mid="22">Ferramenta Revisão com a <x id="50"/>lupa no painel direito</mrk></target><sdl:seg-defs><sdl:seg id="22" conf="ApprovedTranslation" origin="interactive" percent="99"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="99"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">4T0AGRyYBgkEq5N8G1P4q+2VAhlPyXkyh2E1pt872A4=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 14:16:41</sdl:value><sdl:value key="SDL:ProjectTranslationHash">409425252</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">4T0AGRyYBgkEq5N8G1P4q+2VAhlPyXkyh2E1pt872A4=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">846725068</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="13"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="3234b045-0b07-48ec-b946-7506c48e84b1"><source>The area within the loupe is displayed in the image pane on the right.The display in the image pane changes according to the position of the loupe.</source><seg-source><mrk mtype="seg" mid="23">The area within the loupe is displayed in the image pane on the right.</mrk><mrk mtype="seg" mid="24">The display in the image pane changes according to the position of the loupe.</mrk></seg-source><target><mrk mtype="seg" mid="23">A área dentro da lupa é exibida no painel de imagens à direita.</mrk><mrk mtype="seg" mid="24">A exibição no painel de imagens muda de acordo com a posição da lupa.</mrk></target><sdl:seg-defs><sdl:seg id="23" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="F2hFvyvLgrY7q9Ncy4yR+zi5uEG1leAHkYBldYtIlCM="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/13/2020 15:03:12</sdl:value><sdl:value key="modified_on">11/13/2020 15:03:12</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1895265133</sdl:value><sdl:value key="SegmentIdentityHash">F2hFvyvLgrY7q9Ncy4yR+zi5uEG1leAHkYBldYtIlCM=</sdl:value></sdl:seg><sdl:seg id="24" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="3zQgwGmU4897a83b2usB4kblmjKqSyFM3OimZD5V8OY="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/13/2020 15:03:57</sdl:value><sdl:value key="modified_on">11/15/2020 16:16:37</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2117540307</sdl:value><sdl:value key="SegmentIdentityHash">3zQgwGmU4897a83b2usB4kblmjKqSyFM3OimZD5V8OY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="13"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="172a4091-7a6d-4fc1-a37d-8d54355ce0b5"><source>A NIRI and colored intraoral image are displayed one below the other in the image pane on the right.The NIRI and colored intraoral images in the image pane match the direction of the loupe and are updated simultaneously while moving the loupe over the 3D display.</source><seg-source><mrk mtype="seg" mid="25">A NIRI and colored intraoral image are displayed one below the other in the image pane on the right.</mrk><mrk mtype="seg" mid="26">The NIRI and colored intraoral images in the image pane match the direction of the loupe and are updated simultaneously while moving the loupe over the 3D display.</mrk></seg-source><target><mrk mtype="seg" mid="25">Uma imagem intraoral colorida e uma imagem NIRI são exibidas uma embaixo da outra, no painel de imagens à direita.</mrk><mrk mtype="seg" mid="26">As imagens intraorais coloridas e NIRI no painel de imagens correspondem à direção da lupa e são atualizadas simultaneamente ao mover a lupa no visualizador 3D.</mrk></target><sdl:seg-defs><sdl:seg id="25" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">M8fxijlfwP50BaQ3qnoFAWxAn2ClfIVVZoMM7oTEOqs=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">68667843</sdl:value></sdl:seg><sdl:seg id="26" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">oSXnDOygHYduJU4nErsuRn6Ad2r1vk+zUH+6nKwdfDU=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:29:14</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1029582489</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="848d45d6-0fc7-4847-a370-1f6eff55fede"><source>Image pane on the right showing the area of interest as both NIRI and colored intraoral images</source><seg-source><mrk mtype="seg" mid="27">Image pane on the right showing the area of interest as both NIRI and colored intraoral images</mrk></seg-source><target><mrk mtype="seg" mid="27">Painel de imagens à direita, exibindo a área de interesse tanto para as imagens NIRI como para as imagens intraorais coloridas.</mrk></target><sdl:seg-defs><sdl:seg id="27" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">7Zpx+x/+aL1TKV+6OuQ24m9snV+afHXR+aj8OjPXDOY=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:29:14</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1355236959</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="14"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d2fb17d5-c220-40c9-917a-69070c201714"><source>Zooming in to and out of the images in the image pane</source><seg-source><mrk mtype="seg" mid="28">Zooming in to and out of the images in the image pane</mrk></seg-source><target><mrk mtype="seg" mid="28">Aumentar e diminuir o zoom das imagens no painel de imagens</mrk></target><sdl:seg-defs><sdl:seg id="28" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="V36fUmvpG6s/dQ9dZ8efIsoxCp0wwcXLDub3FcDHE8s="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/13/2020 15:28:35</sdl:value><sdl:value key="modified_on">11/13/2020 15:28:35</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">13786068</sdl:value><sdl:value key="SegmentIdentityHash">V36fUmvpG6s/dQ9dZ8efIsoxCp0wwcXLDub3FcDHE8s=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="6be6f9fe-3cf9-40f3-a82f-c40417c530d2"><source>In order to better evaluate the scanned images in the image pane, you can zoom in to and out of the images, as well as adjust the contrast and brightness of each image.</source><seg-source><mrk mtype="seg" mid="29">In order to better evaluate the scanned images in the image pane, you can zoom in to and out of the images, as well as adjust the contrast and brightness of each image.</mrk></seg-source><target><mrk mtype="seg" mid="29">Para avaliar melhor as imagens digitalizadas no painel de imagens, você pode aumentar e diminuir cada imagem, bem como ajustar o contraste e o brilho de cada uma delas.</mrk></target><sdl:seg-defs><sdl:seg id="29" conf="ApprovedTranslation" origin="interactive" percent="98"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="98"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">39XvDaDwzUtwZW2V66FfLQ74Oh9CP3bjdbPpyOoXx0c=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/29/2024 03:29:24</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">39XvDaDwzUtwZW2V66FfLQ74Oh9CP3bjdbPpyOoXx0c=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1898578679</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="50b94abb-ed02-4b10-b8a4-d0aad54d596f"><source>You can zoom in to or out of the selected area of the images displayed in the image pane using the following methods:</source><seg-source><mrk mtype="seg" mid="30">You can zoom in to or out of the selected area of the images displayed in the image pane using the following methods:</mrk></seg-source><target><mrk mtype="seg" mid="30">Você pode aumentar ou diminuir o zoom na área selecionada das imagens exibida no painel de imagens, usando os seguintes métodos:</mrk></target><sdl:seg-defs><sdl:seg id="30" conf="ApprovedTranslation" origin="interactive" percent="99"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="99"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">3R3JyKhfiZhSNs+gb88+pqelfhchMbK3IisZbU1KqZE=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/29/2024 03:29:25</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">3R3JyKhfiZhSNs+gb88+pqelfhchMbK3IisZbU1KqZE=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1827826989</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="acf146db-53df-4164-945d-578b7dde8e5d"><source>Using a spreading or pinching gesture on one of the images displayed in the image pane</source><seg-source><mrk mtype="seg" mid="31">Using a spreading or pinching gesture on one of the images displayed in the image pane</mrk></seg-source><target><mrk mtype="seg" mid="31">Fazendo movimento de pinça com os dedos em uma das imagens exibidas no painel de imagens</mrk></target><sdl:seg-defs><sdl:seg id="31" conf="ApprovedTranslation" origin="interactive" percent="93"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="93"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">XgPsFW/sBs6SCSfOS/EgKZdHRG/sQwnUmBleFSDTNBs=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/29/2024 03:33:54</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">XgPsFW/sBs6SCSfOS/EgKZdHRG/sQwnUmBleFSDTNBs=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 14:37:04</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-2101965324</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="fb160e61-9aec-46eb-88b9-aa4f20b88ca7"><source>Double-tapping an image in the image pane to toggle zoom in/zoom out</source><seg-source><mrk mtype="seg" mid="32">Double-tapping an image in the image pane to toggle zoom in/zoom out</mrk></seg-source><target><mrk mtype="seg" mid="32">Tocando duas vezes em uma imagem no painel de imagens para alternar entre aumentar zoom/diminuir zoom</mrk></target><sdl:seg-defs><sdl:seg id="32" conf="ApprovedTranslation" origin="interactive" percent="96"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="96"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">PmUjIGaJd6LHqSG3TnAvbBp5ZUvu7Q6L3P+qQDihRMs=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/29/2024 03:33:53</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">PmUjIGaJd6LHqSG3TnAvbBp5ZUvu7Q6L3P+qQDihRMs=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 14:37:22</sdl:value><sdl:value key="SDL:ProjectTranslationHash">516995550</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="b1955864-7409-4abb-8870-b18483fd8d01"><source>Tapping the zoom button displayed on the required image</source><seg-source><mrk mtype="seg" mid="33">Tapping the zoom button displayed on the required image</mrk></seg-source><target><mrk mtype="seg" mid="33">Tocando no botão de zoom exibido na imagem desejada</mrk></target><sdl:seg-defs><sdl:seg id="33" conf="ApprovedTranslation" origin="interactive" percent="92"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="92"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">sSVG1HzKFVl+bY/ZfFJ0/iZX3L3gphr5pUs6chmR2SI=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/29/2024 03:34:15</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">sSVG1HzKFVl+bY/ZfFJ0/iZX3L3gphr5pUs6chmR2SI=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 14:37:40</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-808395759</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d9f2b37d-ac3f-4682-b835-ed40f9e2b9f7"><source>Zooming in or out using the first two methods will enlarge or decrease the size of both image-pane images simultaneously, but keeps the image pane itself the same size.</source><seg-source><mrk mtype="seg" mid="34">Zooming in or out using the first two methods will enlarge or decrease the size of both image-pane images simultaneously, but keeps the image pane itself the same size.</mrk></seg-source><target><mrk mtype="seg" mid="34">Aumentar e diminuir o zoom, utilizando os dois primeiros métodos, irá aumentar ou diminuir o tamanho de ambas as imagens no painel de imagens de forma simultânea, mas irá manter o painel de imagens do mesmo tamanho.</mrk></target><sdl:seg-defs><sdl:seg id="34" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">aiCSAdNMhDFsb1sXFaI7Fyus2n+gpeMt+wsqjSWnUo8=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-651808286</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="87d5b330-a6c0-49dc-b0e1-63759d7984c8"><source>Zooming in using the zoom tool will enlarge the image pane and display only the relevant image.</source><seg-source><mrk mtype="seg" mid="35">Zooming in using the zoom tool will enlarge the image pane and display only the relevant image.</mrk></seg-source><target><mrk mtype="seg" mid="35">Aumentar o zoom, utilizando a ferramenta de zoom irá aumentar o painel da imagem e exibir apenas a imagem relevante.</mrk></target><sdl:seg-defs><sdl:seg id="35" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">mIp1QWC2tkqmQq8NYplXbMFXaON5MTUWEulVZ5pghw8=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1585364100</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="f70508d0-a2d2-477f-adc0-d720e5495328"><source>To zoom in or out using the zoom button:</source><seg-source><mrk mtype="seg" mid="36">To zoom in or out using the zoom button:</mrk></seg-source><target><mrk mtype="seg" mid="36">Para aumentar ou diminuir o zoom, usando o botão de zoom:</mrk></target><sdl:seg-defs><sdl:seg id="36" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="8JhsbrOVHElpJZTLmXnbMoOUqpuioHWzbbYXyFg25Bk="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/01/2020 16:00:10</sdl:value><sdl:value key="modified_on">10/21/2020 20:02:14</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">431737638</sdl:value><sdl:value key="SegmentIdentityHash">8JhsbrOVHElpJZTLmXnbMoOUqpuioHWzbbYXyFg25Bk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="3a9d57c3-e8c6-408f-a815-ba09a58abdeb"><source>Tap <x id="56"/> on either the NIRI or the colored intraoral image to zoom in to that view.</source><seg-source><mrk mtype="seg" mid="37">Tap <x id="56"/> on either the NIRI or the colored intraoral image to zoom in to that view.</mrk></seg-source><target><mrk mtype="seg" mid="37">Toque <x id="56"/>na imagem intraoral colorida ou NIRI para dar zoom na visualização.</mrk></target><sdl:seg-defs><sdl:seg id="37" conf="ApprovedTranslation" origin="interactive"><sdl:prev-origin origin="source"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">fFQHbPMA7vCM3dGMOZccbE4OkG31l97cnmLADIbjsWE=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/29/2024 03:36:24</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">fFQHbPMA7vCM3dGMOZccbE4OkG31l97cnmLADIbjsWE=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:29:14</sdl:value><sdl:value key="created_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="created_on">08/29/2024 03:36:25</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1065241848</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="130c905f-7c3f-4776-bf7d-ea4da84eb29f"><source>Zoom-in buttons on the images in the image pane</source><seg-source><mrk mtype="seg" mid="38">Zoom-in buttons on the images in the image pane</mrk></seg-source><target><mrk mtype="seg" mid="38">Botões de zoom nas imagens no painel de imagens</mrk></target><sdl:seg-defs><sdl:seg id="38" conf="ApprovedTranslation" origin="interactive" percent="96"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="96"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">g/OqtF4WbOhoMeF4YtiIxzUulBl3cP9Tn94Q1LN2cNg=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/29/2024 03:37:12</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">g/OqtF4WbOhoMeF4YtiIxzUulBl3cP9Tn94Q1LN2cNg=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1624340212</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7f4a4f1c-3ae8-4a96-8343-e40b936b5ac7"><source>The image in the image pane is enlarged and only the specific image is displayed.</source><seg-source><mrk mtype="seg" mid="39">The image in the image pane is enlarged and only the specific image is displayed.</mrk></seg-source><target><mrk mtype="seg" mid="39">A imagem no painel de imagens é aumentada e apenas a imagem em específico é exibida.</mrk></target><sdl:seg-defs><sdl:seg id="39" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">XUfAGtEfqrfII2e+2k2GaMZvO9IAzFR/vmDnOZM/JO8=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-741325313</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="49b2e32f-1c28-4f01-b291-5420feb1256f"><source>Only the zoomed-in image is displayed in the enlarged image pane</source><seg-source><mrk mtype="seg" mid="40">Only the zoomed-in image is displayed in the enlarged image pane</mrk></seg-source><target><mrk mtype="seg" mid="40">Apenas a imagem com zoom aumentado é exibida no painel de imagens ampliado</mrk></target><sdl:seg-defs><sdl:seg id="40" conf="ApprovedTranslation" origin="interactive" percent="82"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="82"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">nZSf/G3m5YSz0/lan688CjSPyNK2hsKvVaviStg3Odo=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/29/2024 03:37:44</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">nZSf/G3m5YSz0/lan688CjSPyNK2hsKvVaviStg3Odo=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 14:44:50</sdl:value><sdl:value key="SDL:ProjectTranslationHash">530467296</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d8237b7f-15e5-47c0-b200-f2d21ec77d23"><source>Tap <x id="58"/> on the enlarged 2D image to return the image to the default size.</source><seg-source><mrk mtype="seg" mid="41">Tap <x id="58"/> on the enlarged 2D image to return the image to the default size.</mrk></seg-source><target><mrk mtype="seg" mid="41">Toque <x id="58"/> na imagem 2D ampliada para fazer a imagem retornar ao tamanho padrão.</mrk></target><sdl:seg-defs><sdl:seg id="41" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="itzBho1NwGKavhWIz+bah/dteu3F0iAaXeRKYwomSeo="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:26</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:26</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-190203244</sdl:value><sdl:value key="SegmentIdentityHash">itzBho1NwGKavhWIz+bah/dteu3F0iAaXeRKYwomSeo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="14"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="38574ea7-9354-464b-8ff7-f36b001a09cf"><source>Adjusting the brightness and contrast of images in the image pane</source><seg-source><mrk mtype="seg" mid="42">Adjusting the brightness and contrast of images in the image pane</mrk></seg-source><target><mrk mtype="seg" mid="42">Ajustando o brilho e o contraste das imagens no painel de imagens</mrk></target><sdl:seg-defs><sdl:seg id="42" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="yY0/ZUGWgpl63VmBGt35rodBw4h2sQ/+W/SL/D+S9p4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/14/2020 08:06:54</sdl:value><sdl:value key="modified_on">11/15/2020 16:19:52</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1824410327</sdl:value><sdl:value key="SegmentIdentityHash">yY0/ZUGWgpl63VmBGt35rodBw4h2sQ/+W/SL/D+S9p4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2e3f8f0e-80ee-48e2-b8b4-3aa4db0a72b0"><source>You can set the brightness and contrast of each of the images displayed in the image pane by adjusting the relevant sliders in the brightness and contrast toolbar.</source><seg-source><mrk mtype="seg" mid="43">You can set the brightness and contrast of each of the images displayed in the image pane by adjusting the relevant sliders in the brightness and contrast toolbar.</mrk></seg-source><target><mrk mtype="seg" mid="43">Você pode definir o brilho e o contraste de cada uma das imagens exibidas no painel de imagens, ajustando os cursores correspondentes na barra de ferramentas de brilho e contraste.</mrk></target><sdl:seg-defs><sdl:seg id="43" conf="ApprovedTranslation" origin="interactive" percent="96"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="96"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">+b9pcIsb2j5+cVHrYVlSWLzsYYchtfB95fzKCIpSJIM=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/29/2024 03:38:41</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1802187847</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">+b9pcIsb2j5+cVHrYVlSWLzsYYchtfB95fzKCIpSJIM=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1482938796</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="13"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="a3c4c435-62a4-4d78-83fa-3168fb4d627b"><source><g id="64">Brightness </g>refers to the overall lightness or darkness of an image.Increasing the brightness makes every pixel in the image lighter, and vice versa.</source><seg-source><mrk mtype="seg" mid="44"><g id="64">Brightness </g>refers to the overall lightness or darkness of an image.</mrk><mrk mtype="seg" mid="45">Increasing the brightness makes every pixel in the image lighter, and vice versa.</mrk></seg-source><target><mrk mtype="seg" mid="44"><g id="64">Brilho </g>refere-se à claridade ou escuridão geral de uma imagem.</mrk><mrk mtype="seg" mid="45">Aumentar o brilho torna cada pixel da imagem mais claro e vice-versa.</mrk></target><sdl:seg-defs><sdl:seg id="44" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="Oq3krjA51paJX8mmeeZ9Ep0glpVkM7fA2G4mOOIoXPc="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:26</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:26</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1637956966</sdl:value><sdl:value key="SegmentIdentityHash">Oq3krjA51paJX8mmeeZ9Ep0glpVkM7fA2G4mOOIoXPc=</sdl:value></sdl:seg><sdl:seg id="45" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="Q4R2gBbPnQNqhGKpBNxsMtTZxMwUTu6ZfQ5c9OQcfq8="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/01/2020 16:06:05</sdl:value><sdl:value key="modified_on">10/21/2020 20:02:51</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">730056685</sdl:value><sdl:value key="SegmentIdentityHash">Q4R2gBbPnQNqhGKpBNxsMtTZxMwUTu6ZfQ5c9OQcfq8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="13"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="9e12dd64-7ebf-4b7f-b8d2-1d9902dcbaef"><source><g id="75">Contrast</g> is the difference in <g id="78">brightness</g> between objects in an image.Increasing the contrast makes light areas lighter and dark areas darker, and vice versa.</source><seg-source><mrk mtype="seg" mid="46"><g id="75">Contrast</g> is the difference in <g id="78">brightness</g> between objects in an image.</mrk><mrk mtype="seg" mid="47">Increasing the contrast makes light areas lighter and dark areas darker, and vice versa.</mrk></seg-source><target><mrk mtype="seg" mid="46"><g id="75">Contraste</g> é a diferença de <g id="78">brilho</g> entre os objetos de uma imagem.</mrk><mrk mtype="seg" mid="47">Aumentar o contraste torna as áreas claras mais claras e as áreas escuras mais escuras, e vice-versa.</mrk></target><sdl:seg-defs><sdl:seg id="46" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="0UW9WgQE74ITBSH+oazuiPhFwWw6lM+lo+Xai4uNqns="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:26</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:26</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1623311664</sdl:value><sdl:value key="SegmentIdentityHash">0UW9WgQE74ITBSH+oazuiPhFwWw6lM+lo+Xai4uNqns=</sdl:value></sdl:seg><sdl:seg id="47" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="yO6kytJfRSeTwJyKOUm2alpXkbB+qsmWGvPDBtAbYEk="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/11/2019 15:31:45</sdl:value><sdl:value key="modified_on">12/24/2019 03:54:15</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1804435904</sdl:value><sdl:value key="SegmentIdentityHash">yO6kytJfRSeTwJyKOUm2alpXkbB+qsmWGvPDBtAbYEk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d7c059c9-1a2f-479f-96ad-eb4202129721"><source>By default, the brightness and contrast toolbar is collapsed.</source><seg-source><mrk mtype="seg" mid="48">By default, the brightness and contrast toolbar is collapsed.</mrk></seg-source><target><mrk mtype="seg" mid="48">Por padrão, a barra de ferramentas de brilho e contraste fica recolhida.</mrk></target><sdl:seg-defs><sdl:seg id="48" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="US1uyuPGaamre31H5ZLyvLo60nHxQtinE/NMYa+1KiI="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/20/2020 00:20:35</sdl:value><sdl:value key="modified_on">11/20/2020 00:26:15</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-422184351</sdl:value><sdl:value key="SegmentIdentityHash">US1uyuPGaamre31H5ZLyvLo60nHxQtinE/NMYa+1KiI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="cd87bf5b-ca36-4288-ae49-de3a69071155"><source><g id="86">Note:</g> The color and brightness controls are displayed only when images are displayed in the image pane, and not when the loupe is in its default position in the right pane.</source><seg-source><mrk mtype="seg" mid="49"><g id="86">Note:</g> The color and brightness controls are displayed only when images are displayed in the image pane, and not when the loupe is in its default position in the right pane.</mrk></seg-source><target><mrk mtype="seg" mid="49"><g id="86">Nota:</g> os controles de cor e brilho são exibidos apenas quando as imagens são exibidas no painel de imagens, e não quando a lupa está na posição padrão no painel direito.</mrk></target><sdl:seg-defs><sdl:seg id="49" conf="ApprovedTranslation" origin="interactive" percent="97"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="97"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">cf7VxUlmzDCsJlDVMfiGHYK4QzcpQpvwDHKK9oomCgI=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/29/2024 03:38:41</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">cf7VxUlmzDCsJlDVMfiGHYK4QzcpQpvwDHKK9oomCgI=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1618609405</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="09ee2edd-441a-4015-ae28-e59a9bd877c8"><source>The contrast and brightness image controls are reset to their default values when selecting a different jaw, pushing the loupe back to its default position, or when exiting the tool.</source><seg-source><mrk mtype="seg" mid="50">The contrast and brightness image controls are reset to their default values when selecting a different jaw, pushing the loupe back to its default position, or when exiting the tool.</mrk></seg-source><target><mrk mtype="seg" mid="50">Os controles de contraste e brilho da imagem são redefinidos para seus valores padrão ao selecionar uma mandíbula diferente, empurrando a lupa de volta à sua posição padrão, ou ao sair da ferramenta.</mrk></target><sdl:seg-defs><sdl:seg id="50" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="tavEpoUkT3suBAAFitByf7IZut+cwShHgjpmXGy8Drg="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/15/2020 16:20:34</sdl:value><sdl:value key="modified_on">11/15/2020 16:20:34</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1752841994</sdl:value><sdl:value key="SegmentIdentityHash">tavEpoUkT3suBAAFitByf7IZut+cwShHgjpmXGy8Drg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e2b0331f-6ce8-4ada-81dd-2edf6d123983"><source>To adjust the brightness and contrast of the images in the image pane:</source><seg-source><mrk mtype="seg" mid="51">To adjust the brightness and contrast of the images in the image pane:</mrk></seg-source><target><mrk mtype="seg" mid="51">Para ajustar o brilho e o contraste das imagens no painel de imagens:</mrk></target><sdl:seg-defs><sdl:seg id="51" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="E3WavJ+CdYALB3BZmatBjjUD2iJ6jvaqySf704Wxflo="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/14/2020 08:31:24</sdl:value><sdl:value key="modified_on">11/15/2020 16:20:45</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1747557062</sdl:value><sdl:value key="SegmentIdentityHash">E3WavJ+CdYALB3BZmatBjjUD2iJ6jvaqySf704Wxflo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="a936cfe3-bd36-4b63-a8e7-15b7267c00eb"><source>Tap <x id="88"/> on the left edge of the image pane to display the brightness and contrast adjustment toolbar.</source><seg-source><mrk mtype="seg" mid="52">Tap <x id="88"/> on the left edge of the image pane to display the brightness and contrast adjustment toolbar.</mrk></seg-source><target><mrk mtype="seg" mid="52">Toque <x id="88"/> na borda esquerda do painel de imagens para exibir a barra de ferramentas de ajuste de brilho e contraste.</mrk></target><sdl:seg-defs><sdl:seg id="52" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="OoVisONXvUeEoM4zU5xx/oRNLX22LLJrSQH1U0dq3iI="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:26</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:26</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-741254385</sdl:value><sdl:value key="SegmentIdentityHash">OoVisONXvUeEoM4zU5xx/oRNLX22LLJrSQH1U0dq3iI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="44fbdf93-f617-4a69-95b8-0772e07a9eaa"><source>Brightness and contrast toolbar is collapsed</source><seg-source><mrk mtype="seg" mid="53">Brightness and contrast toolbar is collapsed</mrk></seg-source><target><mrk mtype="seg" mid="53">A barra de ferramentas de brilho e contraste fica recolhida</mrk></target><sdl:seg-defs><sdl:seg id="53" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="YzZsvM9z33x8LRbBn9+hLqDrr4okF2pIHf+OxYjHLeI="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/20/2020 00:13:55</sdl:value><sdl:value key="modified_on">11/20/2020 00:25:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">347546434</sdl:value><sdl:value key="SegmentIdentityHash">YzZsvM9z33x8LRbBn9+hLqDrr4okF2pIHf+OxYjHLeI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="13"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="a7988e77-bab4-4bfb-a5c6-988ba32ce78a"><source>A brightness and contrast adjustment toolbar is displayed on each of the windows in the image pane.By default, the brightness level is set to the lowest position and the contrast is set to the middle position.</source><seg-source><mrk mtype="seg" mid="54">A brightness and contrast adjustment toolbar is displayed on each of the windows in the image pane.</mrk><mrk mtype="seg" mid="55">By default, the brightness level is set to the lowest position and the contrast is set to the middle position.</mrk></seg-source><target><mrk mtype="seg" mid="54">É exibida uma barra de ferramentas de ajuste de brilho e contraste em cada uma das janelas no painel de imagens.</mrk><mrk mtype="seg" mid="55">Por padrão, o nível de brilho é fixado na posição mais baixa e o contraste é fixado na posição do meio.</mrk></target><sdl:seg-defs><sdl:seg id="54" conf="ApprovedTranslation" origin="interactive" percent="93"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="93"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">cZoWpE2UkWy5ZHPtA0NDc5hJfF1MzZmLBER3NmGMdFs=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/29/2024 03:39:08</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">cZoWpE2UkWy5ZHPtA0NDc5hJfF1MzZmLBER3NmGMdFs=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-470266301</sdl:value></sdl:seg><sdl:seg id="55" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="JxLp2/26tFsq7MtY900Ej7tQAhHXKK2bUZ2cdcnua3A="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/11/2019 15:35:22</sdl:value><sdl:value key="modified_on">12/24/2019 03:55:09</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">289934349</sdl:value><sdl:value key="SegmentIdentityHash">JxLp2/26tFsq7MtY900Ej7tQAhHXKK2bUZ2cdcnua3A=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ab457004-8f92-495b-88fb-e6dc4ab80eb9"><source>Brightness and contrast toolbars</source><seg-source><mrk mtype="seg" mid="56">Brightness and contrast toolbars</mrk></seg-source><target><mrk mtype="seg" mid="56">Barras de ferramentas de brilho e contraste</mrk></target><sdl:seg-defs><sdl:seg id="56" conf="ApprovedTranslation" origin="interactive" percent="93"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="93"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">ZQdgv2keb37olaiH9IRLmvCZ5R2DUjRanvbfODAXMRs=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/29/2024 03:39:21</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">ZQdgv2keb37olaiH9IRLmvCZ5R2DUjRanvbfODAXMRs=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 14:48:02</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1365366388</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="1fe2ee4d-16ae-46e8-86a9-3e5f17e8019d"><source>Move the slider up or down to adjust the brightness <x id="92"/>or contrast.</source><seg-source><mrk mtype="seg" mid="57">Move the slider up or down to adjust the brightness <x id="92"/>or contrast.</mrk></seg-source><target><mrk mtype="seg" mid="57">Mova o cursor deslizante para cima ou para baixo para ajustar o brilho <x id="92"/>ou o contraste.</mrk></target><sdl:seg-defs><sdl:seg id="57" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="sBURxX3VvKR3Le7VuoXETrnlTfDNk50PGa6x6vjxHZQ="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:26</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:26</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1766361159</sdl:value><sdl:value key="SegmentIdentityHash">sBURxX3VvKR3Le7VuoXETrnlTfDNk50PGa6x6vjxHZQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e6b67264-5724-4a51-998b-c2e7a73cdfae"><source><g id="98">Tip:</g> You can tap anywhere in the slider area and drag up or down to adjust the settings.</source><seg-source><mrk mtype="seg" mid="58"><g id="98">Tip:</g> You can tap anywhere in the slider area and drag up or down to adjust the settings.</mrk></seg-source><target><mrk mtype="seg" mid="58"><g id="98">Dica:</g> Para ajustar as configurações, você pode tocar em qualquer lugar da área deslizante e arrastar para cima ou para baixo.</mrk></target><sdl:seg-defs><sdl:seg id="58" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="V8Vn0HbWgwOWPZR46PEj5/SVxEdEAKFbbfVbXp1Q8j0="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:26</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:26</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1643610018</sdl:value><sdl:value key="SegmentIdentityHash">V8Vn0HbWgwOWPZR46PEj5/SVxEdEAKFbbfVbXp1Q8j0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="6eb28483-da11-447e-aaf8-92bb3df08b34"><source>Tap <x id="100"/> to collapse the toolbar.</source><seg-source><mrk mtype="seg" mid="59">Tap <x id="100"/> to collapse the toolbar.</mrk></seg-source><target><mrk mtype="seg" mid="59">Toque em <x id="100"/> para recolher a barra de ferramentas.</mrk></target><sdl:seg-defs><sdl:seg id="59" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="xxdFu0LIJ+sL/mcuI+Ig3J0GtnANA8jACs4Z9w/m1cY="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:26</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:26</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">553366716</sdl:value><sdl:value key="SegmentIdentityHash">xxdFu0LIJ+sL/mcuI+Ig3J0GtnANA8jACs4Z9w/m1cY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="14"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ca756d1c-84f6-4d8d-afde-afc0c570cd02"><source>Capturing the Review tool images</source><seg-source><mrk mtype="seg" mid="60">Capturing the Review tool images</mrk></seg-source><target><mrk mtype="seg" mid="60">Capturando imagens da ferramenta Revisão</mrk></target><sdl:seg-defs><sdl:seg id="60" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="yGigmgtCooAG3OuFXFUCNdmCcaaaZiIjKIS7hezIDS8="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/02/2020 11:32:27</sdl:value><sdl:value key="modified_on">10/21/2020 20:07:51</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-974385726</sdl:value><sdl:value key="SegmentIdentityHash">yGigmgtCooAG3OuFXFUCNdmCcaaaZiIjKIS7hezIDS8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="11"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="55d1ff72-dd55-4782-849e-1b816d8c14e5"><source>If required, you can capture the images displayed when using the Review tool.These images become part of the patient’s export package, and can later be downloaded from MyiTero.</source><seg-source><mrk mtype="seg" mid="61">If required, you can capture the images displayed when using the Review tool.</mrk><mrk mtype="seg" mid="62">These images become part of the patient’s export package, and can later be downloaded from MyiTero.</mrk></seg-source><target><mrk mtype="seg" mid="61">Se necessário, você pode capturar as imagens exibidas ao usar a ferramenta Revisão.</mrk><mrk mtype="seg" mid="62">Essas imagens se tornam parte do pacote de exportação do paciente e podem ser baixadas posteriormente do MyiTero.</mrk></target><sdl:seg-defs><sdl:seg id="61" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="heDU/eJ1iZtXE6rXP34tDD/KzwpaUnCMh+zEnFtELUY="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/11/2019 15:36:43</sdl:value><sdl:value key="modified_on">12/23/2019 01:12:42</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-190612555</sdl:value><sdl:value key="SegmentIdentityHash">heDU/eJ1iZtXE6rXP34tDD/KzwpaUnCMh+zEnFtELUY=</sdl:value></sdl:seg><sdl:seg id="62" conf="ApprovedTranslation" origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="99"><sdl:value key="SegmentIdentityHash">vUU9gVqJUzsga/HH1fC1IxOWbGcAJ4MwqD6sF3abVuU=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 14:48:48</sdl:value><sdl:value key="SDL:ProjectTranslationHash">945310863</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e180067b-957d-4fed-bf94-1ceee223a1c8"><source>For more information, see <x id="104"/>.</source><seg-source><mrk mtype="seg" mid="63">For more information, see <x id="104"/>.</mrk></seg-source><target><mrk mtype="seg" mid="63">Para mais informações, consulte <x id="104"/>.</mrk></target><sdl:seg-defs><sdl:seg id="63" conf="ApprovedTranslation" origin="auto-propagated" origin-system="Propagated from segment 2" percent="100"><sdl:rep id="7Ohy1cOz5eX+waPmq2AF23DPmdMlIbw4Gf/7YOWfIqI="/><sdl:value key="SegmentIdentityHash">7Ohy1cOz5eX+waPmq2AF23DPmdMlIbw4Gf/7YOWfIqI=</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1809051878</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1809051878</sdl:value>
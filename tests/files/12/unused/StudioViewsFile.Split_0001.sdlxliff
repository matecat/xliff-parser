d="2"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="893c4c41-e3e9-49b2-ac6e-31bc15335379"><source>Missing scan segment notifications</source><seg-source><mrk mtype="seg" mid="3">Missing scan segment notifications</mrk></seg-source><target><mrk mtype="seg" mid="3">Notificações de segmento ausente na digitalização</mrk></target><sdl:seg-defs><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="97XVZ67V1/YglhoASTb8IkWGQWiRfIBSoXZdbASMwC8="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2019 20:52:54</sdl:value><sdl:value key="modified_on">11/19/2020 22:32:53</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-105526157</sdl:value><sdl:value key="SegmentIdentityHash">97XVZ67V1/YglhoASTb8IkWGQWiRfIBSoXZdbASMwC8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="22ba693f-7b49-4d96-9be4-a14617b07f16"><source>If there are missing scan segments or bite scans when you tap the <x id="1"/> button, you will be notified at the beginning of the post-processing stage, and you will be able to go back and add the missing areas of the scan, in order to reduce manual intervention later on.</source><seg-source><mrk mtype="seg" mid="4">If there are missing scan segments or bite scans when you tap the <x id="1"/> button, you will be notified at the beginning of the post-processing stage, and you will be able to go back and add the missing areas of the scan, in order to reduce manual intervention later on.</mrk></seg-source><target><mrk mtype="seg" mid="4">Se, ao pressionar o botão, <x id="1"/> houver segmentos ausentes na digitalização ou digitalização de mordida, você será notificado no início da fase de pós-processamento e poderá voltar para adicionar as áreas da digitalização que estejam faltando e, assim, reduzir posteriormente a intervenção manual.</mrk></target><sdl:seg-defs><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:21</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2122399861</sdl:value><sdl:value key="SegmentIdentityHash">pKeDUQBHQrtxE/HUCN3IEz7lg5ZSIw/e3rhiazDPMAc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="c8bd3b62-478d-44fa-8d9f-d9ef76f6d7d3"><source>Notifications are displayed in the following cases:</source><seg-source><mrk mtype="seg" mid="5">Notifications are displayed in the following cases:</mrk></seg-source><target><mrk mtype="seg" mid="5">As notificações são exibidas nos seguintes casos:</mrk></target><sdl:seg-defs><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/02/2020 14:23:05</sdl:value><sdl:value key="modified_on">10/21/2020 20:41:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">508603102</sdl:value><sdl:value key="SegmentIdentityHash">nks3wLAH1tl+ZtWNtMF5xpdBxprOvyzfbMnt8vYvUkY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="5b25feec-5a09-4e60-a4c2-de5a7fd8d223"><source>Missing <x id="5"/>arch – segments were not scanned or not stitched together properly</source><seg-source><mrk mtype="seg" mid="6">Missing <x id="5"/>arch – segments were not scanned or not stitched together properly</mrk></seg-source><target><mrk mtype="seg" mid="6">Ausência <x id="5"/>do arco - os segmentos não foram digitalizados ou não foram unidos corretamente</mrk></target><sdl:seg-defs><sdl:seg id="6" conf="ApprovedTranslation" origin="interactive" percent="89"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="89"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">HKVI8JUWwwhn/nAAl9e8S7lnGJeprc2+8m+q3cao8So=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 18:47:13</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">HKVI8JUWwwhn/nAAl9e8S7lnGJeprc2+8m+q3cao8So=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 13:26:03</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-2006572287</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="b91820bc-2f5c-4a8c-8788-b9aa2e9f638b"><source>Bite issues</source><seg-source><mrk mtype="seg" mid="7">Bite issues</mrk></seg-source><target><mrk mtype="seg" mid="7">Problemas de mordida</mrk></target><sdl:seg-defs><sdl:seg id="7" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/13/2020 08:26:45</sdl:value><sdl:value key="modified_on">11/19/2020 00:18:19</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-204704040</sdl:value><sdl:value key="SegmentIdentityHash">YI9DuZWsro9FDoEdwdGfZReW7xcrLJpaPW8LYOrUoy8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="aea963a4-b346-4edd-9f63-f90487e97136"><source>Missing bite</source><seg-source><mrk mtype="seg" mid="8">Missing bite</mrk></seg-source><target><mrk mtype="seg" mid="8">Mordida ausente</mrk></target><sdl:seg-defs><sdl:seg id="8" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/09/2019 21:38:26</sdl:value><sdl:value key="modified_on">10/21/2020 20:42:07</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1715591176</sdl:value><sdl:value key="SegmentIdentityHash">w1lYoqMuDhE/mhCSPtqy3OrwOEZv4qgZP6kVQKvUwko=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="05e8a2ab-e01e-4c12-9e6a-2e7f06103b3d"><source>Bite scanned from one side only</source><seg-source><mrk mtype="seg" mid="9">Bite scanned from one side only</mrk></seg-source><target><mrk mtype="seg" mid="9">Mordida digitalizada apenas de um lado</mrk></target><sdl:seg-defs><sdl:seg id="9" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/09/2019 21:38:41</sdl:value><sdl:value key="modified_on">10/21/2020 20:42:10</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1045894756</sdl:value><sdl:value key="SegmentIdentityHash">htK2jgvoQtsKAM2A5XtDBEToET+QRW8A4zN6jp0MPOA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="9eaa481d-6b23-47f8-a449-e6d20a4bf1f5"><source>Discrepancy between the left and the right bite scans</source><seg-source><mrk mtype="seg" mid="10">Discrepancy between the left and the right bite scans</mrk></seg-source><target><mrk mtype="seg" mid="10">Discrepância entre as digitalizações de mordida esquerda e direita</mrk></target><sdl:seg-defs><sdl:seg id="10" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/09/2019 21:38:59</sdl:value><sdl:value key="modified_on">12/22/2019 18:30:40</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1665687627</sdl:value><sdl:value key="SegmentIdentityHash">MeB061txm0nIKKvc4HBf71I9sxd9CxGaE7Jxq7z6TGo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="de0a2bab-7413-4411-9b3b-dad78a57f4ef"><source>In addition, the bite section in the navigation controls is highlighted in red.</source><seg-source><mrk mtype="seg" mid="11">In addition, the bite section in the navigation controls is highlighted in red.</mrk></seg-source><target><mrk mtype="seg" mid="11">Além disso, a seção de mordida é destacada em vermelho nos controles de navegação.</mrk></target><sdl:seg-defs><sdl:seg id="11" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/02/2020 14:23:43</sdl:value><sdl:value key="modified_on">10/21/2020 20:42:29</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">440427529</sdl:value><sdl:value key="SegmentIdentityHash">z7CCWsCvD3lQ21IvxGIhXfB3DsGwuwkbgGJ24TSzOM8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="008a0f85-62a8-4072-ab2d-0b46ac579e54"><source>The message may be generic, or very specific to the issue including guidance on how to correct the issue.In some cases, you may be warned that the scan may be returned from the lab if you do not fix the issues.</source><seg-source><mrk mtype="seg" mid="12">The message may be generic, or very specific to the issue including guidance on how to correct the issue.</mrk><mrk mtype="seg" mid="13">In some cases, you may be warned that the scan may be returned from the lab if you do not fix the issues.</mrk></seg-source><target><mrk mtype="seg" mid="12">A mensagem pode ser genérica ou muito específica para o problema, incluindo orientações sobre como corrigi-lo.</mrk><mrk mtype="seg" mid="13">Se você não corrigir os problemas, em alguns casos, poderá ser avisado de que a digitalização poderá ser devolvida pelo laboratório.</mrk></target><sdl:seg-defs><sdl:seg id="12" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/09/2019 21:39:20</sdl:value><sdl:value key="modified_on">12/22/2019 18:30:50</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">257228694</sdl:value><sdl:value key="SegmentIdentityHash">xriZM0X1HqzZhAK/xrBx5YPkhDjgoiFPUqSjY5XSEtw=</sdl:value></sdl:seg><sdl:seg id="13" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 12:42:10</sdl:value><sdl:value key="modified_on">11/18/2022 00:33:37</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-199031060</sdl:value><sdl:value key="SegmentIdentityHash">9gqzdFfXNZsIDQl9IxN1qbjVcNJDY45sCYCvfvL+IDE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="aeeda583-6b06-4929-8656-20e4873ca59f"><source>Missing scan message and missing segments highlighted in red</source><seg-source><mrk mtype="seg" mid="14">Missing scan message and missing segments highlighted in red</mrk></seg-source><target><mrk mtype="seg" mid="14">Mensagem de digitalização ausente e segmentos ausentes destacados em vermelho</mrk></target><sdl:seg-defs><sdl:seg id="14" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/09/2019 21:40:06</sdl:value><sdl:value key="modified_on">12/22/2019 18:31:08</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">377838557</sdl:value><sdl:value key="SegmentIdentityHash">imSeZJSRayxQZvIBOvRchBaH7ESQ/DHdJUSzWNlW5Gs=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="342ff2c9-ff58-44bc-bd7d-8ddfe61631c7"><source>You can tap <g id="13">Return to Scanning</g> to go back to Scan mode and rescan the missing segments, which are highlighted in red in the navigation controls.</source><seg-source><mrk mtype="seg" mid="15">You can tap <g id="13">Return to Scanning</g> to go back to Scan mode and rescan the missing segments, which are highlighted in red in the navigation controls.</mrk></seg-source><target><mrk mtype="seg" mid="15">Você pode tocar em <g id="13">Voltar para Digitalização</g> para retornar ao modo Digitalizar e redigitalizar os segmentos ausentes, destacados em vermelho nos controles de navegação.</mrk></target><sdl:seg-defs><sdl:seg id="15" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:21</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1200299545</sdl:value><sdl:value key="SegmentIdentityHash">j5HQ6B7jV9Nu9fgV5xGQpHZ2Dd77bCo+joqQ/oRsmsQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group></body></file><file original="C:\Data\My Documents\Studio 2011\Projects\222818 Rev.3 LuminaPro-pt-BR\en-US\222818 Rev.3 LuminaPro-pt-BR_1\Content\1. Introduction\Mobile configuration_combined_Plus.htm.xlf" datatype="x-sdlfilterframework2" source-language="en-us" target-language="pt-br"><header><reference><internal-file form="base64">UEsDBBQAAAAIACQ0GVlkm8H3vwYAAAFgAAAQAAAAa2wybjNyZzMuMGYxLnhsZu1cUXPaOBB+70z/

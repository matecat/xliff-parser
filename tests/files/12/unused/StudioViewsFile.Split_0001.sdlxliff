ocked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="dFCQgXP2I/PuKrtywZk8bms+tpujr9seZj5o0JZFCNo="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/13/2020 06:13:38</sdl:value><sdl:value key="modified_on">11/18/2020 23:59:33</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1344983125</sdl:value><sdl:value key="SegmentIdentityHash">dFCQgXP2I/PuKrtywZk8bms+tpujr9seZj5o0JZFCNo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="8"/><sdl:cxt id="13"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="66464272-d1f4-42ef-b268-37cd9df76afd"><source><g id="38">Note:</g> If the recommended alternative disinfectants are not available in your region, consult your local supplier of disinfecting materials for equivalent products in your region.Equivalent products must meet local regulatory requirements, have the same active ingredients, and in addition,<x id="40"/><g id="43"> must be capable of intermediate-level disinfection, including being able to disinfect against at least Hepatitis and Tuberculosis</g>.</source><seg-source><mrk mtype="seg" mid="26"><g id="38">Note:</g> If the recommended alternative disinfectants are not available in your region, consult your local supplier of disinfecting materials for equivalent products in your region.</mrk><mrk mtype="seg" mid="27">Equivalent products must meet local regulatory requirements, have the same active ingredients, and in addition,<x id="40"/><g id="43"> must be capable of intermediate-level disinfection, including being able to disinfect against at least Hepatitis and Tuberculosis</g>.</mrk></seg-source><target><mrk mtype="seg" mid="26"><g id="38">Nota:</g> Se os desinfetantes alternativos recomendados não estiverem disponíveis em sua região, consulte seu fornecedor local de materiais desinfetantes sobre a existência de produtos equivalentes em sua região.</mrk><mrk mtype="seg" mid="27">Os produtos equivalentes devem atender às exigências regulatórias locais, conter os mesmos ingredientes ativos e ainda<x id="40"/><g id="43"> ter capacidade de desinfecção de nível intermediário, incluindo a capacidade de desinfetar, ao menos, contra os vírus da Hepatite e da Tuberculose</g>.</mrk></target><sdl:seg-defs><sdl:seg id="26" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:17</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:17</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1597608435</sdl:value><sdl:value key="SegmentIdentityHash">L+s6ZZvYR6KHEBZDNzZZuElS+fuIwEzzRFrNwMpXkPg=</sdl:value></sdl:seg><sdl:seg id="27" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:50</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:14</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1923547822</sdl:value><sdl:value key="SegmentIdentityHash">0hUNdvcWIPrY++pmo6pYTygrds1YwN3SFPFeWppZcsU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7d1b6d73-17a8-40ad-9af7-bfa262f68c50"><source>Approved cleaning and disinfection materials (Australia only)</source><seg-source><mrk mtype="seg" mid="28">Approved cleaning and disinfection materials (Australia only)</mrk></seg-source><target><mrk mtype="seg" mid="28">Materiais aprovados para limpeza e desinfecção (apenas na Austrália)</mrk></target><sdl:seg-defs><sdl:seg id="28" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 11:29:42</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:14</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1103663150</sdl:value><sdl:value key="SegmentIdentityHash">q2gJvgb+F8Ss0a3gK9O7/mn2eTANYGSzuYhN+0pTRBw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="3bf09d4c-15cb-4986-b7a3-82e16a5e52fe"><source>The following table lists the Align-recommended active ingredients and concentration levels for cleaning and disinfecting materials.</source><seg-source><mrk mtype="seg" mid="29">The following table lists the Align-recommended active ingredients and concentration levels for cleaning and disinfecting materials.</mrk></seg-source><target><mrk mtype="seg" mid="29">A tabela a seguir lista os ingredientes ativos recomendados pela Align e os níveis de concentração para a limpeza e desinfecção de materiais.</mrk></target><sdl:seg-defs><sdl:seg id="29" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 16:43:28</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:14</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">902890053</sdl:value><sdl:value key="SegmentIdentityHash">31nGAtIQ7JNWK/B+jh8h8SYGYKdS58JGu5At+YGpTNE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:
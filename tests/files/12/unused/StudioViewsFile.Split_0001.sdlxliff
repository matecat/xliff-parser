id="13"><g id="54">Pedido:</g> permite que você defina os detalhes do procedimento necessário, por exemplo, <x id="55"/>.</mrk></target><sdl:seg-defs><sdl:seg id="13" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 11:29:44</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:48</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1947936558</sdl:value><sdl:value key="SegmentIdentityHash">bmrOiFcOxUiTVCCR8zTEaXp1yTlx3ojIj87VYQVXPsw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ff9006fe-1e75-4cf8-b8b2-51a77aecb983"><source><g id="65">Scan Options:</g> Enables you to turn on toggles regarding, for example, whether <x id="66"/>the order should include a multi-bite scan.</source><seg-source><mrk mtype="seg" mid="14"><g id="65">Scan Options:</g> Enables you to turn on toggles regarding, for example, whether <x id="66"/>the order should include a multi-bite scan.</mrk></seg-source><target><mrk mtype="seg" mid="14"><g id="65">Opções de digitalização:</g> permite que você ative ou desate diferentes opções, por exemplo, se a <x id="66"/>se o pedido deve incluir uma digitalização de múltiplas mordidas.</mrk></target><sdl:seg-defs><sdl:seg id="14" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/08/2023 08:05:48</sdl:value><sdl:value key="modified_on">03/08/2023 08:05:48</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1176658088</sdl:value><sdl:value key="SegmentIdentityHash">BkhbuUeBFijzdYnbkoS/8ynwOMGxrsU8O9u6Y1JT1AA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="10"/><sdl:cxt id="11"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="b81aab7b-8dcd-48a0-87f2-f7ea6c6ff054"><source><g id="75">Notes:</g> Enables you to enter any specific notes to the lab regarding the patient’s treatment.For example, you can write special instructions for delivery or manufacturing.Tap anywhere outside the <g id="80">Notes</g> area to add the note.Each note shows the author of the note, with a timestamp, and can be edited and deleted.</source><seg-source><mrk mtype="seg" mid="15"><g id="75">Notes:</g> Enables you to enter any specific notes to the lab regarding the patient’s treatment.</mrk><mrk mtype="seg" mid="16">For example, you can write special instructions for delivery or manufacturing.</mrk><mrk mtype="seg" mid="17">Tap anywhere outside the <g id="80">Notes</g> area to add the note.</mrk><mrk mtype="seg" mid="18">Each note shows the author of the note, with a timestamp, and can be edited and deleted.</mrk></seg-source><target><mrk mtype="seg" mid="15"><g id="75">Notas:</g> Permite que você insira quaisquer anotações específicas para o laboratório sobre o tratamento do paciente.</mrk><mrk mtype="seg" mid="16">Por exemplo, você pode escrever instruções especiais sobre a entrega ou fabricação.</mrk><mrk mtype="seg" mid="17">Toque em qualquer lugar fora da área <g id="80">Notas</g> para adicionar a nota.</mrk><mrk mtype="seg" mid="18">Cada nota mostra o autor da nota com um carimbo de data e hora, e pode ser editada e excluída.</mrk></target><sdl:seg-defs><sdl:seg id="15" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/08/2023 08:05:48</sdl:value><sdl:value key="modified_on">03/08/2023 08:05:48</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1385181121</sdl:value><sdl:value key="SegmentIdentityHash">2+yZA5TfATUxAkIACF03gQpu4yvb6i8wmbkt1e9CpcQ=</sdl:value></sdl:seg><sdl:seg id="16" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/03/2022 18:03:19</sdl:value><sdl:value key="modified_on">11/18/2022 00:43:13</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1941507900</sdl:value><sdl:value key="SegmentIdentityHash">uo5DmggtBrB5schVLL4vAhzbq+vD/J7+YeDPEwnSeZE=</sdl:value></sdl:seg><sdl:seg id="17" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="KoJf2uDdfR7KT3F62fI0xbITnZ0i+4IHFbd5Ay+YyX8="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:21</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1394245707</sdl:value><sdl:value key="SegmentIdentityHash">KoJf2uDdfR7KT3F62fI0xbITnZ0i+4IHFbd5Ay+YyX8=</sdl:value></sdl:seg><sdl:seg id="18" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="3GNfRrXDNp/RV5FJ66PCV47qrj9CDhaQeqoG66Cnq2w="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/03/2022 18:03:59</sdl:value><sdl:value key="modified_on">11/18/2022 00:43:16</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">500107389</sdl:value><sdl:value key="SegmentIdentityHash">3GNfRrXDNp/RV5FJ66PCV47qrj
px;height: 31px;&quot; class=&quot;inline-in-bullet&quot; /&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:ctype">image</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag></tag-defs></header><body><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="5207e0d7-2e1c-4185-802a-5f526810b419"><source>Toggling the 3D and viewfinder display</source><seg-source><mrk mtype="seg" mid="1">Toggling the 3D and viewfinder display</mrk></seg-source><target><mrk mtype="seg" mid="1">Alternando a exibição em 3D e no visor</mrk></target><sdl:seg-defs><sdl:seg id="1" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/11/2019 15:00:40</sdl:value><sdl:value key="modified_on">12/23/2019 00:41:10</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">115586113</sdl:value><sdl:value key="SegmentIdentityHash">RdvbgCrlYZPmvvZPYecqvmE8m5x44iZLAkhQJPna300=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="eb8f302f-830e-4c00-a5b9-f1a81c1eb6fd"><source>By default, when scanning the patient’s teeth, a large 3D image of the scan is displayed in the center of the screen and the area currently being scanned is displayed in the viewfinder on the bottom left of the window.</source><seg-source><mrk mtype="seg" mid="2">By default, when scanning the patient’s teeth, a large 3D image of the scan is displayed in the center of the screen and the area currently being scanned is displayed in the viewfinder on the bottom left of the window.</mrk></seg-source><target><mrk mtype="seg" mid="2">Por padrão, ao digitalizar os dentes do paciente, é exibida uma grande imagem 3D da digitalização no centro da tela e a área que está sendo digitalizada no momento é exibida no visor, na parte inferior esquerda da janela.</mrk></target><sdl:seg-defs><sdl:seg id="2" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/22/2020 00:59:53</sdl:value><sdl:value key="modified_on">11/17/2022 00:48:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2029848636</sdl:value><sdl:value key="SegmentIdentityHash">XUEeR4ocO3WuePEOE+paUQc69NdAhVzmCo14lnU1k2A=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="9c6ee4d9-4bad-4963-82fd-4186e00ff90f"><source>In order to facilitate exploring a specific area of interest, you can switch the display to show an enlarged viewfinder in the center of the window, and a smaller 3D image displayed on the side of the window.</source><seg-source><mrk mtype="seg" mid="3">In order to facilitate exploring a specific area of interest, you can switch the display to show an enlarged viewfinder in the center of the window, and a smaller 3D image displayed on the side of the window.</mrk></seg-source><target><mrk mtype="seg" mid="3">A fim de facilitar a exploração de uma área de interesse específica, você pode alternar a exibição para mostrar um visor ampliado no centro da janela e uma imagem 3D menor exibida na lateral da janela.</mrk></target><sdl:seg-defs><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/11/2019 15:01:53</sdl:value><sdl:value key="modified_on">12/23/2019 00:41:44</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1409124122</sdl:value><sdl:value key="SegmentIdentityHash">R13wgg51DcXsSaew/ECI/lp/ry7QxKhMfjqNPFJwcu8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="5d68d7e1-f9ce-4343-810c-1d21fcd4af4d"><source>Default view – 3D scan in the center of the window and viewfinder on the left</source><seg-source><mrk mtype="seg" mid="4">Default view – 3D scan in the center of the window and viewfinder on the left</mrk></seg-source><target><mrk mtype="seg" mid="4">Visualização padrão - digitalização 3D no centro da janela e visor à esquerda</mrk></target><sdl:seg-defs><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/11/2019 15:02:14</sdl:value><sdl:value key="modified_on">12/23/2019 00:41:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">60546493</sdl:value><sdl:value key="SegmentIdentityHash">ELSa4KN4TrdNBFhQ9NXuqggbOAKlUyDDneDOb3dB1aA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="7"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="35ae1673-18c3-441e-901d-8acdc57229cd"><source>To switch to a large viewfinder in the center of the screen, tap the <x id="1"/> button.</source><seg-source><mrk mtype="seg" mid="5">To switch to a large viewfinder in the center of the screen, tap the <x id="1"/> button.</mrk></seg-source><target><mrk mtype="seg" mid="5">Para alternar para um visor grande no centro da tela, toque no botão <x id="1"/>.</mrk></target><sdl:seg-defs><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:24</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:24</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1289083954</sdl:value><sdl:value key="SegmentIdentityHash">2xSRN1D4H586Dzo1pyRwTg9WJNqQc6+NBnR4+MkVAl0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="7"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="8caaa761-808c-43fe-b1f8-b6e1f5353658"><source>Large viewfinder in the center of the screen and 3D image on the left</source><seg-source><mrk mtype="seg" mid="6">Large viewfinder in the center of the screen and 3D image on the left</mrk></seg-source><target><mrk mtype="seg" mid="6">Visor grande no centro da tela e imagem 3D à esquerda</mrk></target><sdl:seg-defs><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/11/2019 15:02:45</sdl:value><sdl:value key="modified_on">12/23/2019 00:42:03</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-442157283</sdl:value><sdl:value key="SegmentIdentityHash">KQQoFY1yRwxdNKSUk7dT2o9WI2ki/QwbcujHgrSKarU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group></body></file><file original="C:\Data\My Documents\Studio 2011\Projects\222818 Rev.3 LuminaPro-pt-BR\en-US\222818 Rev.3 LuminaPro-pt-BR_1\Content\4. Working with the scanner\Touch screen gestures.htm.xlf" datatype="x-sdlfilterframework2" source-language="en-us" target-language="pt-br"><header><reference><inter
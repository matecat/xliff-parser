uired and then tap <g id="29">Update</g>.</source><seg-source><mrk mtype="seg" mid="12">Edit the patient’s details as required and then tap <g id="29">Update</g>.</mrk></seg-source><target><mrk mtype="seg" mid="12">Edite os dados do paciente conforme necessário e toque em <g id="29">Atualizar</g>.</mrk></target><sdl:seg-defs><sdl:seg id="12" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:22</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:22</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1981853782</sdl:value><sdl:value key="SegmentIdentityHash">+Y5GxIy4kR6a1YzXWO1kf54gcz4kvY3J5L/miUeK370=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="4421a7d4-7bab-47c0-98ec-34c5d60094d4"><source>Edit Patient window and Update button</source><seg-source><mrk mtype="seg" mid="13">Edit Patient window and Update button</mrk></seg-source><target><mrk mtype="seg" mid="13">Janela Editar Paciente e botão Atualizar</mrk></target><sdl:seg-defs><sdl:seg id="13" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/30/2020 07:44:35</sdl:value><sdl:value key="modified_on">10/20/2020 19:29:37</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1856002618</sdl:value><sdl:value key="SegmentIdentityHash">zB/jP59x5Mp16l8jlURGjw+SXOx1lZMqfiUzelqthKQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e1f07216-ed42-4344-b1c4-a7855dd76830"><source>If, while editing the patient’s name, you enter the same details as an existing patient, a message is displayed notifying you of such.</source><seg-source><mrk mtype="seg" mid="14">If, while editing the patient’s name, you enter the same details as an existing patient, a message is displayed notifying you of such.</mrk></seg-source><target><mrk mtype="seg" mid="14">Se, ao editar o nome do paciente, você inserir os mesmos dados de um paciente já existente, uma mensagem será exibida, notificando-o sobre isso.</mrk></target><sdl:seg-defs><sdl:seg id="14" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/30/2020 07:45:45</sdl:value><sdl:value key="modified_on">10/20/2020 19:30:16</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1951552563</sdl:value><sdl:value key="SegmentIdentityHash">FueLVhJJNZb7YOXqmeKh6ZrvknKoR3DVthRhnJVQO7g=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e0ab8f05-7395-454e-b6c3-6fce2331c635"><source>Message that a patient with the same details already exists</source><seg-source><mrk mtype="seg" mid="15">Message that a patient with the same details already exists</mrk></seg-source><target><mrk mtype="seg" mid="15">Mensagem de que já existe um paciente com os mesmos dados</mrk></target><sdl:seg-defs><sdl:seg id="15" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/30/2020 07:45:59</sdl:value><sdl:value key="modified_on">10/20/2020 19:30:19</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">53572468</sdl:value><sdl:value key="SegmentIdentityHash">qmqOOeqv1DkQBKlLdqtvZp1mKwFTrnfIGi90dOA9dHU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="0a0b084c-4a71-4250-a889-121f5839db2f"><source>To differentiate between patients with the same details, enter a unique identifier in the <g id="35">Chart Number</g> field.</source><seg-source><mrk mtype="seg" mid="16">To differentiate between patients with the same details, enter a unique identifier in the <g id="35">Chart Number</g> field.</mrk></seg-source><target><mrk mtype="seg" mid="16">Para diferenciar entre pacientes que tenham os mesmos dados, insira um identificador exclusivo no campo <g id="35">Número do Prontuário</g>.</mrk></target><sdl:seg-defs><sdl:seg id="16" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:22</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:22</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">253790598</sdl:value><sdl:value key="SegmentIdentityHash">8jv098Vf+Lw5CfjcJatnqTsVHd8Rr+fMrY9B0AYe7vA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group></body></file><file original="C:\Data\My Documents\Studio 2011\Projects\222818 Rev.3 LuminaPro-pt-BR\en-US\222818 Rev.3 LuminaPro-pt-BR_1\Content\10. iTero scanner features and tools\Editing tools.htm.xlf" datatype="x-sdlfilterframework2" source-language="en-us" target-language="pt-br"><header><reference><internal-file form="base64">UEsDBBQAAAAIACU0GVmaql20FAYAAIY3AAAQAAAANGszMTVidm8uZmZhLnhsZu1bzW7bOBC+F+g7

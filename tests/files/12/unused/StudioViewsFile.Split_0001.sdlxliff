ed_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/13/2020 09:38:32</sdl:value><sdl:value key="modified_on">10/22/2020 03:32:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1629289750</sdl:value><sdl:value key="SegmentIdentityHash">3W6fssIPVHv+4qFtL6hNJhe63gbPqcsBwb/nj4EEZ3Q=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="10"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="a9a65df3-67bc-4549-838b-bd66d83c702e"><source>Make sure you have your MyAligntech account information ready when logging in to the iTero scanner.You need your name, account email, and password.Fill in all the necessary fields and then tap the <g id="13">Login</g> button.</source><seg-source><mrk mtype="seg" mid="6">Make sure you have your MyAligntech account information ready when logging in to the iTero scanner.</mrk><mrk mtype="seg" mid="7">You need your name, account email, and password.</mrk><mrk mtype="seg" mid="8">Fill in all the necessary fields and then tap the <g id="13">Login</g> button.</mrk></seg-source><target><mrk mtype="seg" mid="6">Certifique-se de que as informações de sua conta MyAligntech estejam prontas ao fazer login no scanner iTero.</mrk><mrk mtype="seg" mid="7">Você precisa do seu nome, e-mail da conta e senha.</mrk><mrk mtype="seg" mid="8">Preencha todos os campos necessários e toque no botão <g id="13">Login</g>.</mrk></target><sdl:seg-defs><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/28/2020 22:11:38</sdl:value><sdl:value key="modified_on">05/28/2020 22:11:38</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1
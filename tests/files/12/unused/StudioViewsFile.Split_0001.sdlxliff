/MadCap.xsd&quot;&amp;gt;&lt;/bpt&gt; or to enlarge the viewfinder&lt;ept id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/MadCap:conditionalText&amp;gt;&lt;/ept&gt;&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;&lt;bpt id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;MadCap:conditionalText MadCap:conditions=&quot;iTero.A_5D&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&amp;gt;&lt;/bpt&gt; or to enlarge the viewfinder&lt;ept id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/MadCap:conditionalText&amp;gt;&lt;/ept&gt;&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag></tag-defs></header><body><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d0fc68db-4b41-4b23-b457-c4e10e10e8f3"><source>Disabling NIRI data capture</source><seg-source><mrk mtype="seg" mid="1">Disabling NIRI data capture</mrk></seg-source><target><mrk mtype="seg" mid="1">Desativando a captura de dados NIRI</mrk></target><sdl:seg-defs><sdl:seg id="1" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">+G/4IlWniMZ03J+nh4yCaJyMRJyvVmRZgE5IebwU7fQ=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:23:48</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-386095533</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="cd8ecf33-40e3-474e-9e9f-b67cf52d0b1e"><source><g id="11"><g id="9">Note:</g> This section is not relevant for iTero Element 5D Plus Lite systems.</g></source><seg-source><mrk mtype="seg" mid="2"><g id="11"><g id="9">Note:</g> This section is not relevant for iTero Element 5D Plus Lite systems.</g></mrk></seg-source><target><mrk mtype="seg" mid="2"/></target><sdl:seg-defs><sdl:seg id="2" locked="true" conf="Draft"><sdl:rep id="eUrYMIT+hg0OrqdMegS+w1pP9p94sglMvG9Y3i8d2zc="/><sdl:value key="SegmentIdentityHash">eUrYMIT+hg0OrqdMegS+w1pP9p94sglMvG9Y3i8d2zc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="9"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="16879f78-677e-49eb-a5d9-7bea59391c25"><source>When patients are scanned, the NIRI data is captured by default.If required, you can disable capturing the NIRI data before starting a new scan.In this case, none of the NIRI features are displayed in the GUI, and NIRI data is not captured, saved, or sent.</source><seg-source><mrk mtype="seg" mid="3">When patients are scanned, the NIRI data is captured by default.</mrk><mrk mtype="seg" mid="4">If required, you can disable capturing the NIRI data before starting a new scan.</mrk><mrk mtype="seg" mid="5">In this case, none of the NIRI features are displayed in the GUI, and NIRI data is not captured, saved, or sent.</mrk></seg-source><target><mrk mtype="seg" mid="3">Quando os pacientes são digitalizados, os dados NIRI são capturados por padrão.</mrk><mrk mtype="seg" mid="4">Se necessário, você pode desativar a captura de dados NIRI antes de começar uma nova digitalização</mrk><mrk mtype="seg" mid="5">Nesse caso, nenhuma das funcionalidades NIRI serão exibidas na GUI e os dados NIRI não serão capturados, salvos ou enviados.</mrk></target><sdl:seg-defs><sdl:seg id="3" conf="ApprovedTranslation" origin="interactive"><sdl:rep id="0Epj9qM/tcosrBCfA8aVF3YbCtw0IZ17gSqMXh9ltsc="/><sdl:value key="SegmentIdentityHash">0Epj9qM/tcosrBCfA8aVF3YbCtw0IZ17gSqMXh9ltsc=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1574962805</sdl:value></sdl:seg><sdl:seg id="4" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">av1R1lulnSwdGMco/SoI4LNR+3iOIq666yjrttW4sIw=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:25:37</sdl:value><sdl:value key="SDL:ProjectTranslationHash">736908584</sdl:value></sdl:seg><sdl:seg id="5" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">x5vBxq8iB4WMzTpfCL7m+v1dIYQqf2J1nG5tdLHpuVE=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-2005533301</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="4d627a5a-b543-4623-89a7-fe3db66e35f4"><source>NIRI capture can also be disabled by default for all scans, as described in <x id="17"/>.</source><seg-source><mrk mtype="seg" mid="6">NIRI capture can also be disabled by default for all scans, as described in <x id="17"/>.</mrk></seg-source><target><mrk mtype="seg" mid="6">A captura NIRI pode ser desativada por padrão para todas as digitalizações, conforme descrito em <x id="17"/>.</mrk></target><sdl:seg-defs><sdl:seg id="6" conf="ApprovedTranslation" origin="interactive" percent="71"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="71"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">JqE85Q7FxWPC+4YpFqYe3JuhiYqp3prCEjx7ZTh5cU8=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 15:14:27</sdl:value><sdl:value key="FuzzyMatchRepair">true</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">JqE85Q7FxWPC+4YpFqYe3JuhiYqp3prCEjx7ZTh5cU8=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:26:00</sdl:value><sdl:value key="FuzzyMatchRepair">true</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1756734978</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="12262e0c-9258-43ca-9fb1-89ba9549c16b"><source>To disable NIRI data capture for a specific scan:</source><seg-source><mrk mtype="seg" mid="7">To disable NIRI data capture for a specific scan:</mrk></seg-source><target><mrk mtype="seg" mid="7">Para desativar a captura de dados NIRI para uma digitalização em específico:</mrk></target><sdl:seg-defs><sdl:seg id="7" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">oDwJ9U28K/+XCKbxP4sTey1gr99iMbUTttllYyoPFY4=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:26:05</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1296353547</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="10"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="def49ad3-b1ec-458f-b0da-a3af016ad60c"><source>Before starting a new scan, in the <g id="26">New Scan</g> window, turn off the <g id="29">NIRI Capture</g> toggle.</source><seg-source><mrk mtype="seg" mid="8">Before starting a new scan, in the <g id="26">New Scan</g> window, turn off the <g id="29">NIRI Capture</g> toggle.</mrk></seg-source><target><mrk mtype="seg" mid="8">Antes de começar uma nova digitalização, na janela <g id="26">Nova Digitalização</g>, desative o botão de alternância <g id="29">Captura NIRI</g> .</mrk></target><sdl:seg-defs><sdl:seg id="8" conf="ApprovedTranslation" origin="interactive"><sdl:prev-origin origin="source"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">cO3tne3tjZnuYKZrVUVP7YgMQe8WHW8BcCoLOTmOSO4=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/29/2024 04:03:35</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">cO3tne3tjZnuYKZrVUVP7YgMQe8WHW8BcCoLOTmOSO4=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:29:14</sdl:value><sdl:value key="created_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="created_on">08/29/2024 04:03:37</sdl:value><sdl:value key="SDL:ProjectTranslationHash">753272280</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="10"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="95419e22-dc43-4509-8570-bf222819fef6"><source>Disabling NIRI data capture for a specific scan</source><seg-source><mrk mtype="seg" mid="9">Disabling NIRI data capture for a specific scan</mrk></seg-source><target><mrk mtype="seg" mid="9">Desativando a captura de dados NIRI para uma digitalização em específico</mrk></target><sdl:seg-defs><sdl:seg id="9" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">ZNUuTDvQPyA//utp+lbwktAdvNVnDhRJaG63pTS1EJY=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:27:02</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-2113599285</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="10"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="faba15bc-538a-4daf-b24c-de40adcb2989"><source><g id="35">Note:</g> This option cannot be changed after you have started scanning.</source><seg-source><mrk mtype="seg" mid="10"><g id="35">Note:</g> This option cannot be changed after you have started scanning.</mrk></seg-source><target><mrk mtype="seg" mid="10"><g id="35">Nota:</g> esta opção não pode ser alterada após você ter começado a digitalizar.</mrk></target><sdl:seg-defs><sdl:seg id="10" conf="ApprovedTranslation" origin="interactive"><sdl:prev-origin origin="source"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">QQtlaSzaQ4Mk4f3tU8/aNSumYMaXBISjyhz7lILmkPg=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/29/2024 04:04:56</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">QQtlaSzaQ4Mk4f3tU8/aNSumYMaXBISjyhz7lILmkPg=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="created_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="created_on">08/29/2024 04:04:59</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-390770890</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="10"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="de0f5c0b-5d11-4cab-b54d-a5981f67b512"><source>Scan tool without the option to display NIRI data in the viewfinder<x id="39"/></source><seg-source><mrk mtype="seg" mid="11">Scan tool without the option to display NIRI data in the viewfinder<x id="39"/></mrk></seg-source><target><mrk mtype="seg" mid="11">A ferramenta de digitalização sem a opção para exibir os dados NIRI no visor<x id="39"/></mrk></target><sdl:seg-defs><sdl:seg id="11" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">CJsgGAZWJVz5l8AqvkC/tTEs9uInwNgg+TN06jqz5Ic=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:27:17</sdl:value><sdl:value key="SDL:ProjectTranslationHash">825214712</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ee87b3f1-ec58-4f14-ac9a-7e8bea0f5880"><source>Review tool is not displayed in View mode</source><seg-source><mrk mtype="seg" mid="12">Review tool is not displayed in View mode</mrk></seg-source><target><mrk mtype="seg" mid="12"/></target><sdl:seg-defs><sdl:seg id="12" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">PGWIWOFmCjHlnTgnFc3B9Nj1cg7tn/Cp9ll/gKxHRkY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="896f5790-b0fa-4d33-866d-4992e522831e"><source>After scanning, you can view the NIRI status of each scan in the <g id="45">Orders</g> page on the scanner and in MyiTero.</source><seg-source><mrk mtype="seg" mid="13">After scanning, you can view the NIRI status of each scan in the <g id="45">Orders</g> page on the scanner and in MyiTero.</mrk></seg-source><target><mrk mtype="seg" mid="13">Após a digitalização, você pode visualizar o status NIRI de cada digitalização na página <g id="45">Pedidos</g> no scanner e no MyiTero.</mrk></target><sdl:seg-defs><sdl:seg id="13" conf="ApprovedTranslation" origin="interactive"><sdl:prev-origin origin="source"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">vBNV11Nz8p95AGYXUI4K0RLeiT5VMAnT11poRT1oZkQ=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/29/2024 04:05:13</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">vBNV11Nz8p95AGYXUI4K0RLeiT5VMAnT11poRT1oZkQ=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified
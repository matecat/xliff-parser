tyHash">axail53FzxMtqcbbBT4n0mvkglJkaOvc1GcIHezgSKM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7dcc95ad-cd71-4bca-adea-5ed5ee27b9f1"><source>The Appliance procedure enables you to create a prescription for various dental appliances, such as night guards and sleep appliances.</source><seg-source><mrk mtype="seg" mid="4">The Appliance procedure enables you to create a prescription for various dental appliances, such as night guards and sleep appliances.</mrk></seg-source><target><mrk mtype="seg" mid="4">O procedimento Aparelho permite que você crie uma receita para vários aparelhos dentários, como guardas noturnos e aparelhos de dormir.</mrk></target><sdl:seg-defs><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/04/2022 16:55:07</sdl:value><sdl:value key="modified_on">11/18/2022 00:29:26</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1655908607</sdl:value><sdl:value key="SegmentIdentityHash">3Uba9RwsZ/R601e1kqzCqzBOnCiKonWFVz2fDcbO5TI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="617299fc-9838-42d3-ac5d-ec2f6c879a68"><source>To fill in the Rx for an Appliance procedure:</source><seg-source><mrk mtype="seg" mid="5">To fill in the Rx for an Appliance procedure:</mrk></seg-source><target><mrk mtype="seg" mid="5">Para preencher o Rx de um procedimento Aparelho:</mrk></target><sdl:seg-defs><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/04/2022 17:01:23</sdl:value><sdl:value key="modified_on">11/18/2022 00:29:29</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">713294575</sdl:value><sdl:value key="SegmentIdentityHash">z3bO+FZ0Ngwfcxv1vHpTrplQ6469Y3xcLjYxMDl2mLA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="c9d34f35-3650-4750-ad04-a112325a26eb"><source>In the <g id="11">Order</g> area, select <g id="14">Appliance</g> from the <g id="17">Procedure</g> drop-down list.</source><seg-source><mrk mtype="seg" mid="6">In the <g id="11">Order</g> area, select <g id="14">Appliance</g> from the <g id="17">Procedure</g> drop-down list.</mrk></seg-source><target><mrk mtype="seg" mid="6">Na área <g id="11">Pedido</g>, selecione <g id="14">Aparelho</g> na lista suspensa <g id="17">Procedimento</g>.</mrk></target><sdl:seg-defs><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:22</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:22</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-933997522</sdl:value><sdl:value key="SegmentIdentityHash">EoEHhA3C8A+KV3Ft9OQ/aCUjHjN70bnPUK77pY3IYwA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="abff59d1-0933-454f-aef8-40480896cc0e"><source>From the <g id="29">Type</g> drop-down list, select the type of appliance required.If the required appliance is not listed, select <g id="33">Ortho Appliance</g> and then enter your requirements in the <g id="36">Notes</g> area at the bottom of the window.</source><seg-source><mrk mtype="seg" mid="7">From the <g id="29">Type</g> drop-down list, select the type of appliance required.</mrk><mrk mtype="seg" mid="8">If the required appliance is not listed, select <g id="33">Ortho Appliance</g> and then enter your requirements in the <g id="36">Notes</g> area at the bottom of the window.</mrk></seg-source><target><mrk mtype="seg" mid="7">Na lista suspensa  <g id="29">Tipo</g>, selecione o tipo de aparelho necessário.</mrk><mrk mtype="seg" mid="8">Se o aparelho necessário não estiver listado, selecione <g id="33">Aparelho Ortodôntico</g> e insira seus requisitos na área <g id="36">Notas</g> na parte inferior da janela.</mrk></target><sdl:seg-defs><sdl:seg id="7" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:22</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:22</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">466370016</sdl:value><sdl:value key="SegmentIdentityHash">TuwuSqIaI8doZjlX8fRsvl6OAJurSFUOfugvo8rJgmc=</sdl:value></sdl:seg><sdl:seg id="8" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:22</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:22</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-992256322</sdl:value><sdl:value key="SegmentIdentityHash">3PAv4/eiZA6IPRcWxhMHhri/EoIt4DaY7DibTLlzsOc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/
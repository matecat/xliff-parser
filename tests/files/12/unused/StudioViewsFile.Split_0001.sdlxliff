vent eye damage.</mrk></seg-source><target><mrk mtype="seg" mid="364"/></target><sdl:seg-defs><sdl:seg id="364" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">yaOdjy9AZajXTw80G9KPNvSnKg/sSZA1yJ2GBSZeQEY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="90"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="5ba7ef59-7892-4497-8ac9-3060a98d59c3"><source>Avoid placing the wand in the cradle while the scanning operation is still active, in order to prevent eye damage.</source><seg-source><mrk mtype="seg" mid="365">Avoid placing the wand in the cradle while the scanning operation is still active, in order to prevent eye damage.</mrk></seg-source><target><mrk mtype="seg" mid="365"/></target><sdl:seg-defs><sdl:seg id="365" locked="true" conf="Draft"><sdl:rep id="eCBqiABsVD4kVIJpN1Qjlr8SjKFIY+dwPJkeCvglePg="/><sdl:value key="SegmentIdentityHash">eCBqiABsVD4kVIJpN1Qjlr8SjKFIY+dwPJkeCvglePg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="93"/><sdl:cxt id="94"/><sdl:cxt id="95"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="9c8bb692-159a-4d88-9899-3ec07115f3c6"><source><x id="681"/><x id="684"/><x id="687"/></source><seg-source><mrk mtype="seg" mid="366"><x id="681"/></mrk><mrk mtype="seg" mid="367"><x id="684"/></mrk><mrk mtype="seg" mid="368"><x id="687"/></mrk></seg-source><target><mrk mtype="seg" mid="366"><x id="681"/></mrk><mrk mtype="seg" mid="367"><x id="684"/></mrk><mrk mtype="seg" mid="368"><x id="687"/></mrk></target><sdl:seg-defs><sdl:seg id="366" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="367" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="368" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="723ffd0d-55af-4c4d-8553-bc144e9a0209"><source>Cleaning &amp; disinfection</source><seg-source><mrk mtype="seg" mid="369">Cleaning &amp; disinfection</mrk></seg-source><target><mrk mtype="seg" mid="369">Limpeza e desinfecção</mrk></target><sdl:seg-defs><sdl:seg id="369" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:14</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:14</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1239803549</sdl:value><sdl:value key="SegmentIdentityHash">V9gkD7MX9VOTM7/qhzUVHUtV/CeSip8rtx0KFMDCZJs=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="bae1d0a0-4fb1-492c-81e3-c52def064eb7"><source><x id="698"/> <g id="701">In order to reduce the risk of</g> cross-contamination, it is mandatory to adhere to the following:</source><seg-source><mrk mtype="seg" mid="370"><x id="698"/> <g id="701">In order to reduce the risk of</g> cross-contamination, it is mandatory to adhere to the following:</mrk></seg-source><target><mrk mtype="seg" mid="370"><x id="698"/> <g id="701">Para reduzir o risco de</g> contaminação cruzada, é obrigatório:</mrk></target><sdl:seg-defs><sdl:seg id="370" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 22:25:08</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-199365493</sdl:value><sdl:value key="SegmentIdentityHash">J7oPuj4kTv2QyjYcHAxKi6lg6R31W1W+0wqOxxXn93E=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="96"/><sdl:cxt id="59"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="9d6b366b-f0c2-4415-952f-60a44534d34c"><source>Clean and disinfect the wand, cradle, and other system components according to the instructions provided in <x id="705"/>, and replace the <x id="706"/>, as described in <x id="707"/>, before each patient session.</source><seg-source><mrk mtype="seg" mid="371">Clean and disinfect the wand, cradle, and other system components according to the instructions provided in <x id="705"/>, and replace the <x id="706"/>, as described in <x id="707"/>, before each patient session.</mrk></seg-source><target><mrk mtype="seg" mid="371"/></target><sdl:seg-defs><sdl:seg id="371" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">bYJEsSWM/F7ypsE1Cg8N49D0vqYp3AfQgxynhG7HtKg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="97"/><sdl:cxt id="98"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="27d38c9e-aba7-435c-a8e1-b834c880e85c"><source>Thoroughly clean and disinfect the wand, cradle, and other system components according to the instructions provided in <x id="711"/>, before first use and immediately after each use.Apply a new sleeve before each patient, as described in <x id="713"/>.</source><seg-source><mrk mtype="seg" mid="372">Thoroughly clean and disinfect the wand, cradle, and other system components according to the instructions provided in <x id="711"/>, before first use and immediately after each use.</mrk><mrk mtype="seg" mid="373">Apply a new sleeve before each patient, as described in <x id="713"/>.</mrk></seg-source><target><mrk mtype="seg" mid="372">Limpar e desinfetar completamente o leitor, o suporte e outros componentes do sistema, conforme descrito em <x id="711"/>, antes do primeiro uso e imediatamente após cada uso.</mrk><mrk mtype="seg" mid="373">Use uma nova ponteira antes de cada sessão com o paciente, conforme descrito em <x id="713"/>.</mrk></target><sdl:seg-defs><sdl:seg id="372" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">WZSiy14hdQghGJCl/XZrEb8K2zzyd1/ElMbAhJc7te4=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:42:45</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-606081200</sdl:value></sdl:seg><sdl:seg id="373" conf="ApprovedTranslation" origin="interactive" percent="79"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="79"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">CAPMWrlIehcZLrw5pZ9fpUKyCcxldpuC3jEovUh0zks=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 15:39:14</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">CAPMWrlIehcZLrw5pZ9fpUKyCcxldpuC3jEovUh0zks=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:43:05</sdl:value><sdl:value key="SDL:ProjectTranslationHash">2018177122</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="99"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="250ce18f-5f87-4fb0-b8c5-dea8c6e70ce6"><source>Clean and disinfect the wand, cradle, and other system components according to the instructions provided in <x id="717"/>, and replace the sleeve, as described in <x id="718"/>, before each patient session.</source><seg-source><mrk mtype="seg" mid="374">Clean and disinfect the wand, cradle, and other system components according to the instructions provided in <x id="717"/>, and replace the sleeve, as described in <x id="718"/>, before each patient session.</mrk></seg-source><target><mrk mtype="seg" mid="374"/></target><sdl:seg-defs><sdl:seg id="374" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">q+zt/T0bZVmk+AA+pLAIqAtzQPJ19hFxFf+/nbwyRMc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="79"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="f9ebaf50-2a10-4c5b-8352-cb7787788230"><source><g id="724">Warning:</g> When disinfecting the wand, cradle, and other system components, use multiple fresh wipes, as necessary, to keep the system component surfaces wet for the full contact time, as recommended by the applicable disinfection wipes manufacturer.</source><seg-source><mrk mtype="seg" mid="375"><g id="724">Warning:</g> When disinfecting the wand, cradle, and other system components, use multiple fresh wipes, as necessary, to keep the system component surfaces wet for the full contact time, as recommended by the applicable disinfection wipes manufacturer.</mrk></seg-source><target><mrk mtype="seg" mid="375"><g id="724">Aviso:</g> ao desinfetar o leitor, o suporte e outros componentes do sistema, use vários lenços novos, conforme necessário, para manter as superfícies dos componentes do sistema umedecidas durante todo o tempo de contato, conforme recomendado pelo fabricante dos lenços desinfetantes aplicáveis.</mrk></target><sdl:seg-defs><sdl:seg id="375" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="Source"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1097192004</sdl:value><sdl:value key="SegmentIdentityHash">3okSMUl4gFsSiFa4n7NYPEsIAaeUqvY6BhggUfCZIDw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="79"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="6fa7b650-3017-4fbb-93e1-d79aa605858b"><source><g id="730">Warning:</g> Avoid deviating from the recommended cleaning and disinfection process, and modifying or substituting recommended materials to reduce the risk of biological hazards.</source><seg-source><mrk mtype="seg" mid="376"><g id="730">Warning:</g> Avoid deviating from the recommended cleaning and disinfection process, and modifying or substituting recommended materials to reduce the risk of biological hazards.</mrk></seg-source><target><mrk mtype="seg" mid="376"><g id="730">Aviso:</g> evite desviar-se dos processos de limpeza e de desinfecção recomendados, bem como modificar ou substituir os materiais recomendados para reduzir a ameaça de riscos biológicos.</mrk></target><sdl:seg-defs><sdl:seg id="376" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1552794158</sdl:value><sdl:value key="SegmentIdentityHash">YgiJtdyd7Qq/fSfRfwX8Yvt2BmKwbZoN7IJW7+NPvs4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="79"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ed228176-7089-4b57-b9f2-3d6a0e540aab"><source>Disinfect the touch screen immediately after each patient.</source><seg-source><mrk mtype="seg" mid="377">Disinfect the touch screen immediately after each patient.</mrk></seg-source><target><mrk mtype="seg" mid="377">Desinfete a tela tátil imediatamente após cada paciente.</mrk></target><sdl:seg-defs><sdl:seg id="377" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">495690363</sdl:value><sdl:value key="SegmentIdentityHash">bMagR8dVe4QDVtmy+NFbhQIV9C6KUACffOmrHZ8bA8k=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="79"/><sdl:cxt id="80"/><sdl:cxt id="100"/><sdl:cxt id="101"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="3a7a71ee-91c5-494e-8e69-c7c1d8bdd251"><source><g id="739">Warning:</g> Remove and replace gloves after each patient session.Discard torn, contaminated, or removed gloves.<x id="741"/><x id="744"/><x id="747"/></source><seg-source><mrk mtype="seg" mid="378"><g id="739">Warning:</g> Remove and replace gloves after each patient session.</mrk><mrk mtype="seg" mid="379">Discard torn, contaminated, or removed gloves.<x id="741"/></mrk><mrk mtype="seg" mid="380"><x id="744"/></mrk><mrk mtype="seg" mid="381"><x id="747"/></mrk></seg-source><target><mrk mtype="seg" mid="378"><g id="739">Aviso:</g> remover e substituir as luvas após cada sessão com paciente.</mrk><mrk mtype="seg" mid="379">Descartar as luvas rasgadas, contaminadas ou removidas.<x id="741"/></mrk><mrk mtype="seg" mid="380"><x id="744"/></mrk><mrk mtype="seg" mid="381"><x id="747"/></mrk></target><sdl:seg-defs><sdl:seg id="378" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2110531939</sdl:value><sdl:value key="SegmentIdentityHash">oeHYcqiAeIBkP1FdlCxLC3IRuh2NdqPJooTm0pjqOSg=</sdl:value></sdl:seg><sdl:seg id="379" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/28/2020 10:44:28</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1268942112</sdl:value><sdl:value key="SegmentIdentityHash">f5RIlKKKPo1nErXEeohmz9TnlEDt2JT3tlIQHo1Wd0Y=</sdl:value></sdl:seg><sdl:seg id="380" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="381" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="90"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="75ae43da-626f-417c-8144-18fdb411d5a9"><source>Remove and replace gloves after each patient session.</source><seg-source><mrk mtype="seg" mid="382">Remove and replace gloves after each patient session.</mrk></seg-source><target><mrk mtype="seg" mid="382"/></target><sdl:seg-defs><sdl:seg id="382" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">7Dl6x1OYEoLLV6NYwSeOe0ie/AmG3vhFLY58L5o5nKo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="90"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="aa3f1a2b-b0f5-4bc1-8ef0-0f06d8975742"><source>Discard torn, contaminated, or removed gloves.</source><seg-source><mrk mtype="seg" mid="383">Discard torn, contaminated, or removed gloves.</mrk></seg-source><target><mrk mtype="seg" mid="383"/></target><sdl:seg-defs><sdl:seg id="383" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">3fQQCfH+7Jz/7A9fER4XpXmsW+w2OlFyKW1nkBOT9Us=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="102"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e2e3824d-789c-4399-ab27-7c45961bc1e0"><source><g id="761">Warning:</g> <g id="764"> </g>Replace the iTero Lumina sleeve between each patient.Failing to replace the sleeve between patients may cause the inadvertent transfer of microorganisms and other contaminants from one patient to another.</source><seg-source><mrk mtype="seg" mid="384"><g id="761">Warning:</g> <g id="764"> </g>Replace the iTero Lumina sleeve between each patient.</mrk><mrk mtype="seg" mid="385">Failing to replace the sleeve between patients may cause the inadvertent transfer of microorganisms and other contaminants from one patient to another.</mrk></seg-source><target><mrk mtype="seg" mid="384"><g id="761">Aviso:</g> <g id="764"> </g>substituir a ponteira do iTero Lumina entre um paciente e outro.</mrk><mrk mtype="seg" mid="385">Deixar de substituir a ponteira após cada paciente, pode causar a transferência inadvertida de microorganismos e outros contaminantes de um paciente para outro.</mrk></target><sdl:seg-defs><sdl:seg id="384" conf="ApprovedTranslation" origin="interactive" percent="72"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="72"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">+CEqe7+hfUMKxSjPVKoo7JquaC3dcYvN+SZac+tnnMc=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 15:40:02</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">+CEqe7+hfUMKxSjPVKoo7JquaC3dcYvN+SZac+tnnMc=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:43:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">141334063</sdl:value></sdl:seg><sdl:seg id="385" conf="ApprovedTranslation" origin="interactive" percent="96"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="96"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">tR4qas3WwuxalqkTTiPoTonu5biQO92Y289eKsxF364=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 15:40:40</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">tR4qas3WwuxalqkTTiPoTonu5biQO92Y289eKsxF364=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:43:30</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-651133055</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="103"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="cc256ed9-73a4-435f-a91a-b47441528495"><source>A new iTero Lumina sleeve or the protective sleeve may be applied to the wand after cleaning and disinfection have been performed.</source><seg-source><mrk mtype="seg" mid="386">A new iTero Lumina sleeve or the protective sleeve may be applied to the wand after cleaning and disinfection have been performed.</mrk></seg-source><target><mrk mtype="seg" mid="386">Depois que a limpeza e desinfecção do leitor forem realizadas, pode ser colocada uma nova ponteira <mrk mtype="x-sdl-location" mid="5a9f8b0e-7053-4c3c-b35e-d42aecf1e8e6"/>iTero Lumina ou a ponteira protetora.</mrk></target><sdl:seg-defs><sdl:seg id="386" conf="ApprovedTranslation" origin="interactive" percent="89"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="89"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">42KTCPf9XZnmoFp9+uHo2oaBT+/aL12CfLmanOOwbRA=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 15:41:01</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">42KTCPf9XZnmoFp9+uHo2oaBT+/aL12CfLmanOOwbRA=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:44:05</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1923071320</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="90"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="3805e0aa-9e59-4b0b-94af-7817f74cd648"><source><g id="774">CAUTION: </g>Dispose of <x id="775"/> according to standard operating procedures or local regulations for the disposal of contaminated medical waste.</source><seg-source><mrk mtype="seg" mid="387"><g id="774">CAUTION: </g>Dispose of <x id="775"/> according to standard operating procedures or local regulations for the disposal of contaminated medical waste.</mrk></seg-source><target><mrk mtype="seg" mid="387"/></target><sdl:seg-defs><sdl:seg id="387" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">o41Xbpv17f41S97O5MlNL4+LqRg86XWHKwwqln+y9mk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="27d0ed7b-3702-42f8-88b5-141a85184901"><source>Unpacking &amp; installing</source><seg-source><mrk mtype="seg" mid="388">Unpacking &amp; installing</mrk></seg-source><target><mrk mtype="seg" mid="388">Desembalagem e instalação</mrk></target><sdl:seg-defs><sdl:seg id="388" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:14</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:14</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1108080109</sdl:value><sdl:value key="SegmentIdentityHash">ZaV0Kl4F3GK7MGoVeoSVBz0QVsY0PbHNqpSDfM5sS2o=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="104"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="171af2f0-afe1-4335-974c-0f383f4b388c"><source>The system should be unpacked and installed following Align Technology’s instructions<g id="783">, described in </g>.</source><seg-source><mrk mtype="seg" mid="389">The system should be unpacked and installed following Align Technology’s instructions<g id="783">, described in </g>.</mrk></seg-source><target><mrk mtype="seg" mid="389">O sistema deve ser desembalado e instalado de acordo com as instruções da Align Technology<g id="783">, descritas na </g>.</mrk></target><sdl:seg-defs><sdl:seg id="389" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:14</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:14</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-787249330</sdl:value><sdl:value key="SegmentIdentityHash">eEpAEb2m+iF1EYzCmsqcUT+IdnewoiVjICvZl3xucBs=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="104"/><sdl:cxt id="105"/><sdl:cxt id="106"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7ca2e39e-1c1b-4979-9c1a-22c4369a4420"><source><x id="793"/><g id="796">CAUTION:</g> Contact Customer Support if the scanner box is damaged or if the ShockDot indicator on the box has been activated.<x id="797"/>Do not unpack the scanner.<x id="800"/></source><seg-source><mrk mtype="seg" mid="390"><x id="793"/><g id="796">CAUTION:</g> Contact Customer Support if the scanner box is damaged or if the ShockDot indicator on the box has been activated.<x id="797"/></mrk><mrk mtype="seg" mid="391">Do not unpack the scanner.</mrk><mrk mtype="seg" mid="392"><x id="800"/></mrk></seg-source><target><mrk mtype="seg" mid="390"><x id="793"/><g id="796">ATENÇÃO:</g> fale com o Suporte ao Cliente se a caixa do scanner estiver danificada ou se o indicador ShockDot na caixa tiver sido ativado.<x id="797"/></mrk><mrk mtype="seg" mid="391">Não desembale o scanner.</mrk><mrk mtype="seg" mid="392"><x id="800"/></mrk></target><sdl:seg-defs><sdl:seg id="390" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1282106548</sdl:value><sdl:value key="SegmentIdentityHash">nOjjOnKUTYihlVv1te2Uyyv7jBKTGcLQckNMpAoaQIk=</sdl:value></sdl:seg><sdl:seg id="391" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1705850717</sdl:value><sdl:value key="SegmentIdentityHash">iLGt1hQtZKdWSCPCewKWJqNFXYLiPvx1xFZUQ+UAjQk=</sdl:value></sdl:seg><sdl:seg id="392" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="cde50534-acad-43be-b155-2ff47d26ede4"><source>Work environment</source><seg-source><mrk mtype="seg" mid="393">Work environment</mrk></seg-source><target><mrk mtype="seg" mid="393">Ambiente de trabalho</mrk></target><sdl:seg-defs><sdl:seg id="393" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2019 21:22:14</sdl:value><sdl:value key="modified_on">12/22/2019 00:17:28</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1573033816</sdl:value><sdl:value key="SegmentIdentityHash">+Skj/upQQ8RWt/DJB4BgSjXjd4YX1fqw+eKVz1KwWa8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="9c6948dc-9932-4de4-b11d-5f07d177c2bd"><source><g id="813">Warning:</g> <g id="816"> </g>The system should be moved between rooms with utmost care to avoid damage.</source><seg-source><mrk mtype="seg" mid="394"><g id="813">Warning:</g> <g id="816"> </g>The system should be moved between rooms with utmost care to avoid damage.</mrk></seg-source><target><mrk mtype="seg" mid="394"><g id="813">Aviso:</g> <g id="816"> </g> para evitar danos, o sistema deve ser deslocado entre as salas com o máximo de cuidado.</mrk></target><sdl:seg-defs><sdl:seg id="394" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">189007641</sdl:value><sdl:value key="SegmentIdentityHash">BJXR4PFmY7zKEvKloHbyWFCUU3Qm7kHEIgzgfqR7JnQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="f69b4bfc-fed2-4f8a-b0d1-3bdc37d98961"><source><g id="825">CAUTION:</g> Do not <g id="828">cover/</g>block the air vents on the wand and the computing unit.</source><seg-source><mrk mtype="seg" mid="395"><g id="825">CAUTION:</g> Do not <g id="828">cover/</g>block the air vents on the wand and the computing unit.</mrk></seg-source><target><mrk mtype="seg" mid="395"><g id="825">ATENÇÃO:</g> não <g id="828">cubra/</g>bloqueie as aberturas de ventilação do leitor e da unidade de computação.</mrk></target><sdl:seg-defs><sdl:seg id="395" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 22:40:51</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">56974084</sdl:value><sdl:value key="SegmentIdentityHash">88aoS7V2t+qrxgtWWuLie946Sewuww+EB+SlpGDx5dk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="8"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7feb716c-8e00-47c2-b585-5a1e13145339"><source>The system is intended for indoor use only.It should not be exposed to direct sunlight, excessive heat, or humidity.</source><seg-source><mrk mtype="seg" mid="396">The system is intended for indoor use only.</mrk><mrk mtype="seg" mid="397">It should not be exposed to direct sunlight, excessive heat, or humidity.</mrk></seg-source><target><mrk mtype="seg" mid="396">O sistema destina-se apenas a uso em área interna.</mrk><mrk mtype="seg" mid="397">Não deve ser exposto à luz solar direta, ao calor excessivo ou à umidade.</mrk></target><sdl:seg-defs><sdl:seg id="396" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2019 21:23:42</sdl:value><sdl:value key="modified_on">10/22/2020 04:23:30</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1283956498</sdl:value><sdl:value key="SegmentIdentityHash">6vNu/pKaAwwxNUxSZNJGSPjkrLiSfU3TtUphGB541RI=</sdl:value></sdl:seg><sdl:seg id="397" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/28/2020 19:43:10</sdl:value><sdl:value key="modified_on">05/28/2020 19:43:10</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">501187934</sdl:value><sdl:value key="SegmentIdentityHash">8FBlP4dsqasDpEKiAhSYWTnj4sTqYbhTrq4LmmJJ4vY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="107"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="41893592-3b58-4c84-80ae-a9125596bb22"><source><x id="835"/>If the system has just been brought into the office from a hot, cold, or humid environment, it should be set aside until it has adjusted to room temperature, to avoid internal condensation.</source><seg-source><mrk mtype="seg" mid="398"><x id="835"/>If the system has just been brought into the office from a hot, cold, or humid environment, it should be set aside until it has adjusted to room temperature, to avoid internal condensation.</mrk></seg-source><target><mrk mtype="seg" mid="398"><x id="835"/>Se o sistema acaba de ser transportado de um ambiente quente, frio ou úmido para o consultório, seu uso deve ser suspenso até que esteja adaptado à temperatura ambiente para evitar condensação interna.</mrk></target><sdl:seg-defs><sdl:seg id="398" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:05</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-150131227</sdl:value><sdl:value key="SegmentIdentityHash">005aeJEWpYf4XFIuXQobQuPmndcJucZ2+HiY+pRcNns=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="8127cfc5-24d5-41c2-a9b7-5f0dfe3f5fbc"><source>Electromagnetic interference precaution</source><seg-source><mrk mtype="seg" mid="399">Electromagnetic interference precaution</mrk></seg-source><target><mrk mtype="seg" mid="399">Precaução com interferência eletromagnética</mrk></target><sdl:seg-defs><sdl:seg id="399" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/28/2020 16:05:13</sdl:value><sdl:value key="modified_on">10/22/2020 04:23:39</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2137940781</sdl:value><sdl:value key="SegmentIdentityHash">z7jh7nIeadBMCv8ypCspRhaHIgU5L8BTB1bnGIgSG3Y=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="13"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="c10fa96b-d724-4963-bf37-3a19835caa0b"><source>This device has been tested and found to comply with the requirements for medical devices according to standard IEC60601-1-2.This standard is designed to provide reasonable protection against harmful <x id="845"/><g id="848">electromagnetic interference and immunity in a typical clinic electromagnetic environment.</g></source><seg-source><mrk mtype="seg" mid="400">This device has been tested and found to comply with the requirements for medical devices according to standard IEC60601-1-2.</mrk><mrk mtype="seg" mid="401">This standard is designed to provide reasonable protection against harmful <x id="845"/><g id="848">electromagnetic interference and immunity in a typical clinic electromagnetic environment.</g></mrk></seg-source><target><mrk mtype="seg" mid="400">Este equipamento foi testado e está em conformidade com os requisitos para equipamentos médicos de acordo com o padrão IE60601-1-2.</mrk><mrk mtype="seg" mid="401">Este padrão foi estabelecido para fornecer uma proteção razoável contra <x id="845"/><g id="848">interferências eletromagnéticas prejudiciais e imunidade em um ambiente eletromagnético clínico típico.</g></mrk></target><sdl:seg-defs><sdl:seg id="400" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/28/2020 16:05:30</sdl:value><sdl:value key="modified_on">10/22/2020 04:23:42</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1517980748</sdl:value><sdl:value key="SegmentIdentityHash">6/zEBenHuPQcukDuCATBhqzRVE4mF58YIVmz8JEytS4=</sdl:value></sdl:seg><sdl:seg id="401" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:05</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-920187628</sdl:value><sdl:value key="SegmentIdentityHash">H1pt3LLUFmC6CCYct6hejBj/udrwx1HRpZ46tlp3SQc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="13"/><sdl:cxt id="55"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="35c3b619-23eb-4eb4-b0ea-b2b7a3dc12ad"><source>Avoid placing this device near frequency transmitting equipment or other sources of electrical and electromagnetic interference (e.g. cellular phones, mobile two-way radios, electrical appliances, RFID).High levels of such interference, due to close proximity or strength of the source, may result in disruption of performance of this device.In this case, the device can be returned to operation mode after user intervention or by auto-recovery.</source><seg-source><mrk mtype="seg" mid="402">Avoid placing this device near frequency transmitting equipment or other sources of electrical and electromagnetic interference (e.g. cellular phones, mobile two-way radios, electrical appliances, RFID).</mrk><mrk mtype="seg" mid="403">High levels of such interference, due to close proximity or strength of the source, may result in disruption of performance of this device.</mrk><mrk mtype="seg" mid="404">In this case, the device can be returned to operation mode after user intervention or by auto-recovery.</mrk></seg-source><target><mrk mtype="seg" mid="402">Evite colocar este dispositivo próximo a equipamentos de transmissão de frequência ou outras fontes de interferência elétrica e eletromagnética (por exemplo, telefones celulares, rádios intercomunicadores, equipamentos elétricos e RFID).</mrk><mrk mtype="seg" mid="403">Altos níveis de interferência, devido à proximidade ou força da fonte, podem resultar na interrupção do desempenho deste dispositivo.</mrk><mrk mtype="seg" mid="404">Nesse caso, o dispositivo pode retornar ao modo de operação após a intervenção do usuário ou por recuperação automática.</mrk></target><sdl:seg-defs><sdl:seg id="402" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/28/2020 16:07:00</sdl:value><sdl:value key="modified_on">10/22/2020 04:23:48</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1153923000</sdl:value><sdl:value key="SegmentIdentityHash">Z/0BnOVgsSUMBVLpOLX+gRVNiKtobJhFNY9ma6aSgks=</sdl:value></sdl:seg><sdl:seg id="403" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/28/2020 16:07:45</sdl:value><sdl:value key="modified_on">10/22/2020 04:23:51</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">520351609</sdl:value><sdl:value key="SegmentIdentityHash">KMekJhxclmGnnqvxJ+EB6TLoT+JpabhbvdlQUygrULM=</sdl:value></sdl:seg><sdl:seg id="404" locke
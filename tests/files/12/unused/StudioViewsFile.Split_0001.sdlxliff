colorido.</mrk><mrk mtype="seg" mid="31">Isso se aplica a todos os procedimentos de digitalização e de visualização.</mrk></target><sdl:seg-defs><sdl:seg id="30" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:23</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">809870076</sdl:value><sdl:value key="SegmentIdentityHash">HAwuXyP/JsegBt5AQj8y6qyBrRmpZvawnu+ANyEUri8=</sdl:value></sdl:seg><sdl:seg id="31" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 09:09:53</sdl:value><sdl:value key="modified_on">11/18/2022 00:32:09</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2106053996</sdl:value><sdl:value key="SegmentIdentityHash">jt+QPj6ZpxayfixvyjmKvxTygsvuZ+Iq/31vzF137bc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="09be8a68-335b-4c0b-a27b-b13ab1589815"><source>Model displayed in color and monochrome mode</source><seg-source><mrk mtype="seg" mid="32">Model displayed in color and monochrome mode</mrk></seg-source><target><mrk mtype="seg" mid="32">Modelo exibido nos modos colorido e monocromático</mrk></target><sdl:seg-defs><sdl:seg id="32" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/09/2019 20:57:57</sdl:value><sdl:value key="modified_on">12/22/2019 18:10:16</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2035630599</sdl:value><sdl:value key="SegmentIdentityHash">7dkWiLxMXeqRuV/20putTYsdPG9qCHiCPEmzU8xFh0g=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="77e86ac8-b9d0-4721-8da8-d628d7ca5191"><source>By default, models are scanned in color, but you can toggle the display per case by tapping <x id="58"/> or by default in the Scan settings, as described in <x id="59"/>.</source><seg-source><mrk mtype="seg" mid="33">By default, models are scanned in color, but you can toggle the display per case by tapping <x id="58"/> or by default in the Scan settings, as described in <x id="59"/>.</mrk></seg-source><target><mrk mtype="seg" mid="33">Por padrão, os modelos são digitalizados em cores, mas você pode alternar a exibição em cada caso tocando em <x id="58"/> ou alterar o padrão nas configurações de Digitalização conforme descrito na <x id="59"/>.</mrk></target><sdl:seg-defs><sdl:seg id="33" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:23</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1155521546</sdl:value><sdl:value key="SegmentIdentityHash">aayBaX9iL99HsJ7aCUBFRsAI0le7ub9E7/qvX/Kv9D0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="11"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="5ff67745-37b4-4720-86a4-8bb60289f2e9"><source>Switching to the next scan segment</source><seg-source><mrk mtype="seg" mid="34">Switching to the next scan segment</mrk></seg-source><target><mrk mtype="seg" mid="34">Mudando para o próximo segmento de digitalização</mrk></target><sdl:seg-defs><sdl:seg id="34" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/09/2019 20:59:07</sdl:value><sdl:value key="modified_on">12/22/2019 18:11:13</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">392659476</sdl:value><sdl:value key="SegmentIdentityHash">bkVTZ0H++eKL9MniUg8dP2orJihZueQMlTlEwVfzYW0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="fa0dae54-578c-434c-988d-3e49442bad48"><source>During scanning, the current segment is highlighted in blue in the navigation controls, and also displayed in the segment indicator box, between the arrows.</source><seg-source><mrk mtype="seg" mid="35">During scanning, the current segment is highlighted in blue in the navigation controls, and also displayed in the segment indicator box, between the arrows.</mrk></seg-source><target><mrk mtype="seg" mid="35">Durante a digitalização, o segmento atual é destacado em azul nos controles de navegação, além de ser exibido na caixa indicativa do segmento, entre as setas.</mrk></target><sdl:seg-defs><sdl:seg id="35" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/21/2020 09:32:45</sdl:value><sdl:value key="modified_on">10/22/2020 03:22:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1566461345</sdl:value><sdl:value key="SegmentIdentityHash">r97327iY3yOM98b6QEbN/mnLrSj3AKczH+BrOW0DHMs=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="13"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="b68b112b-3159-4a07-b6fd-aeae89312650"><source><g id="65">Note:</g> Before moving to the next segment, press either of the wand side buttons to stop the wand from scanning.The system emits a sound when stopping the scan and again when restarting the scan.</source><seg-source><mrk mtype="seg" mid="36"><g id="65">Note:</g> Before moving to the next segment, press either of the wand side buttons to stop the wand from scanning.</mrk><mrk mtype="seg" mid="37">The system emits a sound when stopping the scan and again when restarting the scan.</mrk></seg-source><target><mrk mtype="seg" mid="36"><g id="65">Nota:</g> Antes de passar para o próximo segmento, pressione qualquer um dos botões laterais do leitor para interromper a digitalização.</mrk><mrk mtype="seg" mid="37">O sistema emite um som ao parar a digitalização e ao reiniciar a digitalização.</mrk></target><sdl:seg-defs><sdl:seg id="36" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:23</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-238307231</sdl:value><sdl:value key="SegmentIdentityHash">5EmwpksbUvoHlFMgcsVB6UZF5OTLPLa5izQiZihqO10=</sdl:value></sdl:seg><sdl:seg id="37" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 09:12:52</sdl:value><sdl:value key="modified_on">11/18/2022 00:32:15</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1536177457</sdl:value><sdl:value key="SegmentIdentityHash">Fl8tdTDIGpMjF5rBIcPGkKzyIephhnRrUZiQR4mEKBk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="6f04c854-cbc2-47d7-93f3-8da494541804"><source>You can move to the next segment by:</source><seg-source><mrk mtype="seg" mid="38">You can move to the next segment by:</mrk></seg-source><target><mrk mtype="seg" mid="38">Você pode passar para o próximo segmento ao:</mrk></target><sdl:seg-defs><sdl:seg id="38" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/21/2020 09:32:48</sdl:value><sdl:value key="modified_on">05/31/2020 18:21:18</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-874363252</sdl:value><sdl:value key="SegmentIdentityHash">5+1vB83SKwuXLY+j5FKapnZ18kRf7fsilRMwp/1AgIo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="b4b388a0-cdc2-4b59-9384-b20357c2cbb4"><source>Tapping on the relevant arch<x id="71"/> or bite segment</source><seg-source><mrk mtype="seg" mid="39">Tapping on the relevant arch<x id="71"/> or bite segment</mrk></seg-source><target><mrk mtype="seg" mid="39">Tocar no arco<x id="71"/> ou no segmento de mordida relevantes</mrk></target><sdl:seg-defs><sdl:seg id="39" conf="ApprovedTranslation" origin="interactive" percent="81"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="81"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">WcUUVsf983qmjiA1iwqjEd09gbjKX3H60TdXkXhlv5E=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 19:00:55</sdl:value><sdl:value key="FuzzyMatchRepair">true</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">WcUUVsf983qmjiA1iwqjEd09gbjKX3H60TdXkXhlv5E=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="FuzzyMatchRepair">true</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1554917297</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="744f73af-1808-4cb1-b306-f1889601b758"><source>Tapping the arrows</source><seg-source><mrk mtype="seg" mid="40">Tapping the arrows</mrk></seg-source><target><mrk mtype="seg" mid="40">Tocar nas setas</mrk></target><sdl:seg-defs><sdl:seg id="40" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/09/2019 21:13:14</sdl:value><sdl:value key="modified_on">12/22/2019 18:12:22</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1047714492</sdl:value><sdl:value key="SegmentIdentityHash">3kxrC0UqHk2XFjISPrIbX/A2glkB0NioewhKoyo4190=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="bd927f2e-8e88-4602-a9d0-2584affaf1d3"><source>Tap the opposite arch or tap the arrows to select it</source><seg-source><mrk mtype="seg" mid="41">Tap the opposite arch or tap the arrows to select it</mrk></seg-source><target><mrk mtype="seg" mid="41">Tocar no arco oposto ou tocar nas setas para selecioná-lo</mrk></target><sdl:seg-defs><sdl:seg id="41" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/09/2019 21:03:18</sdl:value><sdl:value key="modified_on">12/22/2019 18:12:42</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1454062835</sdl:value><sdl:value key="SegmentIdentityHash">7eSDlB1LMG1efl8DpGm1Id71x6dPPL2pHIoL8GymiDg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="14"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="165e0c0e-c1ad-45ba-80c9-fb412e5db8da"><source>Swiping to the left or the right on the wand touchpad.</source><seg-source><mrk mtype="seg" mid="42">Swiping to the left or the right on the wand touchpad.</mrk></seg-source><target><mrk mtype="seg" mid="42"/></target><sdl:seg-defs><sdl:seg id="42" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">vnIPqSHFCGjeTHsuYHhPCIjsq/W4ncnFKv9bWeNTXMs=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="14"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="8a5def47-9363-48b2-8635-1aa14f458cd4"><source>To enable the wand touchpad, press and release both wand buttons simultaneously.</source><seg-source><mrk mtype="seg" mid="43">To enable the wand touchpad, press and release both wand buttons simultaneously.</mrk></seg-source><target><mrk mtype="seg" mid="43"/></target><sdl:seg-defs><sdl:seg id="43" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">lx5hEfBYdk3dPtKCJnjiQTfPh/j7Cpi9Hc0WptkSRUA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="15"/><sdl:cxt id="11"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2c939f91-9059-4d34-a87f-2612cba1826c"><source>Working with unstitched scanned segments</source><seg-source><mrk mtype="seg" mid="44">Working with unstitched scanned segments</mrk></seg-source><target><mrk mtype="seg" mid="44">Trabalhando com os segmentos digitalizados incompletos</mrk></target><sdl:seg-defs><sdl:seg id="44" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-239672931</sdl:value><sdl:value key="SegmentIdentityHash">aqgOydJ80KAugeC4FVzq47XgK8ugbljligiUXf+7U1s=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="15"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="5b691454-7338-46e1-b84f-1334a1fa1eb3"><source><x id="73"/> supports sequence-free scanning, which means that you do not have to scan your patient according to a set protocol.</source><seg-source><mrk mtype="seg" mid="45"><x id="73"/> supports sequence-free scanning, which means that you do not have to scan your patient according to a set protocol.</mrk></seg-source><target><mrk mtype="seg" mid="45"><x id="73"/> suporta a digitalização sem sequência, o que significa que você não precisa digitalizar seu paciente de acordo com um protocolo definido.</mrk></target><sdl:seg-defs><sdl:seg id="45" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 10:32:13</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-986356046</sdl:value><sdl:value key="SegmentIdentityHash">bmGarRyfkUb0T0+HwFg3H7ZFRfsd8jj7koWrlLzSlGc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="15"/><sdl:cxt id="16"/><sdl:cxt id="17"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="0c883b08-9fa1-48ba-b884-99b8ba2e074c"><source>While scanning, any unstitched segments of the 3D model are saved on the side of the <g id="79">Scan</g> window.The latest segment is displayed in full color, but the older segments appear faded.You can see up to 4 segments without pausing the scan to view any additional detected segments.</source><seg-source><mrk mtype="seg" mid="46">While scanning, any unstitched segments of the 3D model are saved on the side of the <g id="79">Scan</g> window.</mrk><mrk mtype="seg" mid="47">The latest segment is displayed in full color, but the older segments appear faded.</mrk><mrk mtype="seg" mid="48">You can see up to 4 segments without pausing the scan to view any additional detected segments.</mrk></seg-source><target><mrk mtype="seg" mid="46">Durante a digitalização, quaisquer segmentos incompletos do modelo 3D são salvos do lado da janela <g id="79">Digitalização</g>.</mrk><mrk mtype="seg" mid="47">O segmento mais recente é exibido em cores, mas os segmentos mais antigos aparecem desbotados.</mrk><mrk mtype="seg" mid="48">Você pode ver até quatro segmentos sem pausar a digitalização para visualizar quaisquer segmentos adicionais detectados.</mrk></target><sdl:seg-defs><sdl:seg id="46" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 10:33:44</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-348569526</sdl:value><sdl:value key="SegmentIdentityHash">F9NNM9r9wMV1kp6J78YVxDcKUdLqfwI47SFDqKkHiSQ=</sdl:value></sdl:seg><sdl:seg id="47" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1704303499</sdl:value><sdl:value key="SegmentIdentityHash">L3zuCb20f2SLCvE18H6PONtap/bEadnaAR84zzH9rzg=</sdl:value></sdl:seg><sdl:seg id="48" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2112428421</sdl:value><sdl:value key="SegmentIdentityHash">RE3qhmCOrrel4zd6o7jQXA4ZsY376y2TrfhqroIBs24=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="15"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="1be14a99-7641-4ef8-9754-c5db9ded95c3"><source>Unstitched scanned segments displayed on the right of the Scan window.</source><seg-source><mrk mtype="seg" mid="49">Unstitched scanned segments displayed on the right of the Scan window.</mrk></seg-source><target><mrk mtype="seg" mid="49">Os segmentos digitalizados incompletos exibidos à direita da janela Digitalização.</mrk></target><sdl:seg-defs><sdl:seg id="49" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-962075503</sdl:value><sdl:value key="SegmentIdentityHash">LYsnOInuSJe0RrKZ/Ou3ikVjS9ihgnknUDfY6kH+iKM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="15"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e10293b8-4203-4037-85ed-e5c3d36cdb68"><source>When you scan the overlapping area between the 3D model and an unstitched segment, the system stitches them together in the <g id="89">Scan</g> window and removes the segment from the side of the window.</source><seg-source><mrk mtype="seg" mid="50">When you scan the overlapping area between the 3D model and an unstitched segment, the system stitches them together in the <g id="89">Scan</g> window and removes the segment from the side of the window.</mrk></seg-source><target><mrk mtype="seg" mid="50">Ao digitalizar a área sobreposta entre o modelo 3D e um segmento incompleto, o sistema os une na janela <g id="89">Digitalização</g> e remove o segmento da lateral da janela.</mrk></target><sdl:seg-defs><sdl:seg id="50" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-468351002</sdl:value><sdl:value key="SegmentIdentityHash">QSAT64urryoyt2vODoRPeuqX0dNaXiGNBOoeji+Tg2g=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="15"/><sdl:cxt id="16"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="400b0794-7c7e-41da-a600-8b3fef642478"><source>If required, you can double-tap an unstitched segment to display it in the center of the window instead of the 3D model of the scan.You can also press the segment and then tap <g id="96">Switch to main segment</g>.</source><seg-source><mrk mtype="seg" mid="51">If required, you can double-tap an unstitched segment to display it in the center of the window instead of the 3D model of the scan.</mrk><mrk mtype="seg" mid="52">You can also press the segment and then tap <g id="96">Switch to main segment</g>.</mrk></seg-source><target><mrk mtype="seg" mid="51">Se necessário, você pode tocar duas vezes em um segmento incompleto para exibi-lo no centro da janela, em vez do modelo 3D da digitalização.</mrk><mrk mtype="seg" mid="52">Você também pode pressionar o segmento e tocar em <g id="96">Mudar para o segmento principal</g>.</mrk></target><sdl:seg-defs><sdl:seg id="51" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">705688492</sdl:value><sdl:value key="SegmentIdentityHash">+P1iQagRIvCb3KBJTU2JT1+LSOQIk4AZUCdMkzSmpb0=</sdl:value></sdl:seg><sdl:seg id="52" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 10:46:33</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1094110506</sdl:value><sdl:value key="SegmentIdentityHash">vZeHT1H/+LrnpA8c4mCFkCedKTkt4qMliv2puvs48K0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="15"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="c6294a4f-c959-4187-933a-6e56e589730d"><source>Switching to the main segment</source><seg-source><mrk mtype="seg" mid="53">Switching to the main segment</mrk></seg-source><target><mrk mtype="seg" mid="53">Mudando para o segmento principal</mrk></target><sdl:seg-defs><sdl:seg id="53" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1409893301</sdl:value><sdl:value key="SegmentIdentityHash">7qF28ITvkPzx+LUlGG3GQUuBAGItLquHh1vXTBS4oiY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="15"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="84b18185-f279-4b38-baa9-ed64d2235f17"><source>You can delete an unstitched segment by pressing it and then tapping <g id="103">Delete segment</g>.</source><seg-source><mrk mtype="seg" mid="54">You can delete an unstitched segment by pressing it and then tapping <g id="103">Delete segment</g>.</mrk></seg-source><target><mrk mtype="seg" mid="54">Você pode excluir segmento incompleto, pressionando-o e, em seguida, tocando em <g id="103">Excluir segmento </g>.</mrk></target><sdl:seg-defs><sdl:seg id="54" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 10:48:53</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2047095530</sdl:value><sdl:value key="SegmentIdentityHash">xpkvjN/Z9WawbAhNHfua+UZ3r370XOnc1W4GDA4XNGc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="15"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="1eaf8e9b-03a3-4f47-8cce-30901f6a430c"><source>Deleting an unstitched segment</source><seg-source><mrk mtype="seg" mid="55">Deleting an unstitched segment</mrk></seg-source><target><mrk mtype="seg" mid="55">Excluindo um segmento incompleto</mrk></target><sdl:seg-defs><sdl:seg id="55" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-380165375</sdl:value><sdl:value key="SegmentIdentityHash">LQDEQbYPVfrOmKy7Kowgr9WyYwtGLm9JL7Z9aDJcCQw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="15"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="3ca6db8b-6110-4728-9655-ac2ef80a15db"><source>By default, sequence-free scanning is enabled, but you can disable it from the <g id="110">Scan</g> settings, as described in <x id="111"/>.</source><seg-source><mrk mtype="seg" mid="56">By default, sequence-free scanning is enabled, but you can disable it from the <g id="110">Scan</g> settings, as described in <x id="111"/>.</mrk></seg-source><target><mrk mtype="seg" mid="56">Por padrão, a digitalização sem sequência está ativada, mas você pode desativá-la nas configurações de <g id="110">Digitalização</g>, conforme descrito em <x id="111"/>.</mrk></target><sdl:seg-defs><sdl:seg id="56" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 10:51:54</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1191570346</sdl:value><sdl:value key="SegmentIdentityHash">sWUYM/WQvLT8sXkNdzTz600pcTFUpF1eMUZ5BJQaTEA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group></body></file><file original="C:\Data\My Documents\Studio 2011\Projects\222818 Rev.3 LuminaPro-pt-BR\en-US\222818 Rev.3 LuminaPro-pt-BR_1\Content\4. Working with the scanner\Scanner toolbar.htm.xlf" datatype="x-sdlfilterframework2" source-language="en-us" target-language="pt-br"><header><reference><internal-file form="base64">UEsDBBQAAAAIACQ0GVmnHoBWNgoAAANpAAAQAAAAY2F2bmxxNXcueW1pLnhsZu1dXY7bOBJ+H2Du

refix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:variable name=&quot;iTero.aNGie&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot; /&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">3</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag></tag-defs></header><body><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="0b760203-bb18-43f6-819c-d1f21e9e657f"><source>Recommended Separation Distances Between Portable and Mobile RF Communications Equipment and the iTero <g id="11">Lumina Pro dental imaging system</g><x id="12"/><x id="13"/> that is not Life-Supporting</source><seg-source><mrk mtype="seg" mid="1">Recommended Separation Distances Between Portable and Mobile RF Communications Equipment and the iTero <g id="11">Lumina Pro dental imaging system</g><x id="12"/><x id="13"/> that is not Life-Supporting</mrk></seg-source><target><mrk mtype="seg" mid="1">Distâncias de Separação Recomendadas entre Equipamentos de Comunicação de RF portáteis e sistema de imagiologia dentária iTero <g id="11">Lumina Pro</g><x id="12"/><x id="13"/> que não se destinam a Suporte de Vida </mrk></target><sdl:seg-defs><sdl:seg id="1" conf="ApprovedTranslation" origin="interactive" percent="87"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="87"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">5b1IHslqBJkHgfaJ8KxrNLC20W74okBYx58NPJcUUME=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 19:09:09</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">5b1IHslqBJkHgfaJ8KxrNLC20W74okBYx58NPJcUUME=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1565299949</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ddc89b42-0a85-446e-82b8-ef746d5fe253"><source><x id="17"/> is intended for use in the electromagnetic environment in which radiated RF disturbances are controlled.The customer or the user of the <x id="19"/> can help prevent electromagnetic interference by maintaining a minimum distance between portable and mobile RF communications equipment (transmitters) and the <x id="20"/> system as recommended below, according to the maximum output power of the communications equipment.</source><seg-source><mrk mtype="seg" mid="2"><x id="17"/> is intended for use in the electromagnetic environment in which radiated RF disturbances are controlled.</mrk><mrk mtype="seg" mid="3">The customer or the user of the <x id="19"/> can help prevent electromagnetic interference by maintaining a minimum distance between portable and mobile RF communications equipment (transmitters) and the <x id="20"/> system as recommended below, according to the maximum output power of the communications equipment.</mrk></seg-source><target><mrk mtype="seg" mid="2">O <x id="17"/> destina-se ao uso em ambiente eletromagnético no qual perturbações de RF irradiados são controlados.</mrk><mrk mtype="seg" mid="3">O cliente ou usuário do <x id="19"/> pode ajudar a prevenir a ocorrência de interferência eletromagnética, mantendo uma distância mínima entre os equipamentos de comunicação de RF portáteis e móveis (transmissores) e o sistema <x id="20"/> conforme recomendado abaixo, de acordo com a potência máxima de saída do equipamento de comunicação.</mrk></target><sdl:seg-defs><sdl:seg id="2" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 22:31:18</sdl:value><sdl:value key="modified_on">06/12/2024 17:59:12</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">606376892</sdl:value><sdl:value key="SegmentIdentityHash">0TY4fBCuumrg7j/sfIEVejHoDvsG1g3AQ4ai2TbjGpI=</sdl:value></sdl:seg><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 22:31:18</sdl:value><sdl:value key="modified_on">06/12/2024 17:59:12</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1679111037</sdl:value><sdl:value key="SegmentIdentityHash">5aD2GCia1lVFJs/RjokkiniSP3zN6n6zR5zhRg1i/zA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="fcc44f2d-bb3d-4865-a742-40be2430ca12"><source>For transmitters rated at a maximum output power not listed above, the recommended separation distance d in meters (m) can be estimated using the equation applicable to the frequency of the transmitter, where P is the maximum output power rating of the transmitter in watts (W) according to the transmitter manufacturer.</source><seg-source><mrk mtype="seg" mid="4">For transmitters rated at a maximum output power not listed above, the recommended separation distance d in meters (m) can be estimated using the equation applicable to the frequency of the transmitter, where P is the maximum output power rating of the transmitter in watts (W) according to the transmitter manufacturer.</mrk></seg-source><target><mrk mtype="seg" mid="4">Para transmissores com uma potência máxima de saída não listada acima, a distância d de separação recomendada em metros (m) pode ser estimada usando a equação aplicável à frequência do transmissor, onde P é a potência de saída máxima do transmissor em watts ( W) de acordo com o fabricante do transmissor.</mrk></target><sdl:seg-defs><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 22:31:18</sdl:value><sdl:value key="modified_on">06/12/2024 17:59:12</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1255692476</sdl:value><sdl:value key="SegmentIdentityHash">km2sUR5z4+n0NlEdKZ0b090fmShCcminD7z3mFki0Oc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="cddde29b-9f8c-45ad-becc-f6316b37f6ed"><source><g id="27">Note 1:</g> At 80 MHz and 800 MHz, the separation distance for the higher frequency range applies.</source><seg-source><mrk mtype="seg" mid="5"><g id="27">Note 1:</g> At 80 MHz and 800 MHz, the separation distance for the higher frequency range applies.</mrk></seg-source><target><mrk mtype="seg" mid="5"><g id="27">Nota 1:</g> em 80 MHz e 800 MHz, aplica-se a distância de separação para a faixa de frequência mais alta.</mrk></target><sdl:seg-defs><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/06/2024 15:50:37</sdl:value><sdl:value key="modified_on">06/12/2024 17:59:12</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">365761410</sdl:value><sdl:value key="SegmentIdentityHash">iglR2lGJ8QJJBbOq+uNbu38f3ZGqCZ+UIN38AHon0TI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="81581b2f-e3bc-4df7-8690-f6821593374b"><source><g id="33">Note 2:</g> These guidelines may not apply in all situations.Electromagnetic propagation is affected by absorption and reflection from structures, objects and people.</source><seg-source><mrk mtype="seg" mid="6"><g id="33">Note 2:</g> These guidelines may not apply in all situations.</mrk><mrk mtype="seg" mid="7">Electromagnetic propagation is affected by absorption and reflection from structures, objects and people.</mrk></seg-source><target><mrk mtype="seg" mid="6"><g id="33">Nota 2:</g> essas diretrizes podem não ser aplicáveis a todas as situações.</mrk><mrk mtype="seg" mid="7">A propagação eletromagnética é afetada pela absorção e pela reflexão de estruturas, objetos e pessoas.</mrk></target><sdl:seg-defs><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/06/2024 15:53:18</sdl:value><sdl:value key="modified_on">06/12/2024 17:59:12</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2007053968</sdl:value><sdl:value key="SegmentIdentityHash">6SK4WLHaRTOX93yRWUoukZav/p3JPbYBalYzl5wBFUY=</sdl:value></sdl:seg><sdl:seg id="7" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="wyP3QR3KCQbqp5mOKc5pS3euZ4gpNUjxWYyYw4XrX08="/><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 22:31:18</sdl:value><sdl:value key="modified_on">06/12/2024 17:59:11</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1581615104</sdl:value><sdl:value key="SegmentIdentityHash">wyP3QR3KCQbqp5mOKc5pS3euZ4gpNUjxWYyYw4XrX08=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group></body></file><file original="C:\Data\My Documents\Studio 2011\Projects\222818 Rev.3 LuminaPro-pt-BR\en-US\222818 Rev.3 LuminaPro-pt-BR_1\Content\4. Working with the scanner\Shutting down the scanner_combined.htm.xlf" datatype="x-sdlfilterframework2" source-language="en-us" target-language="pt-br"><header><reference><internal-file form="base64">UEsDBBQAAAAIACQ0GVlH6wqQ3AcAAAJFAAAQAAAAZ2F3emlnM3kueHU0LnhsZu1c4W4iORL+v9K+

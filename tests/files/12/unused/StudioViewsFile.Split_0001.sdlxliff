"><source>The scanner is capable of connecting to the wireless LAN in order to support the file transfer to and from the iTero cloud.Connection to other wireless devices is not supported.</source><seg-source><mrk mtype="seg" mid="7">The scanner is capable of connecting to the wireless LAN in order to support the file transfer to and from the iTero cloud.</mrk><mrk mtype="seg" mid="8">Connection to other wireless devices is not supported.</mrk></seg-source><target><mrk mtype="seg" mid="7">O scanner é capaz de se conectar à LAN sem fio para suportar a transferência de arquivos de e para a nuvem iTero.</mrk><mrk mtype="seg" mid="8">Não é não compatível a conexão com outros dispositivos sem fio.</mrk></target><sdl:seg-defs><sdl:seg id="7" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2022 11:09:15</sdl:value><sdl:value key="modified_on">12/06/2022 11:09:15</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">869192511</sdl:value><sdl:value key="SegmentIdentityHash">12N7LJnhDpqpp/SLljKf/0fEh8SXMaEH+9exLhwcSyY=</sdl:value></sdl:seg><sdl:seg id="8" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2022 11:09:15</sdl:value><sdl:value key="modified_on">12/06/2022 11:09:15</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">247013524</sdl:value><sdl:value key="SegmentIdentityHash">gvPeeJT1zL5cBl3aLWCGe4AqPNR8D23PWrESl03kvZM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="11"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="02782bf0-5b3f-4460-a624-7d9a3507de3b">
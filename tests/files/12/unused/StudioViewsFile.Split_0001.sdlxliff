/ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;&lt;ept id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/MadCap:conditionalText&amp;gt;&lt;/ept&gt;&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="103"><ph name="&lt;MadCap:xref href=&quot;../3. Getting Started/Align Oral Health Suite.htm&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;section 1.0.1, page 1&lt;/MadCap:xref&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:xref href=&quot;../3. Getting Started/Align Oral Health Suite.htm&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;section 1.0.1, page 1&lt;/MadCap:xref&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag></tag-defs></header><body><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ea14acdc-dd17-41ce-97af-855227e177f1"><source>Scan:Sending</source><seg-source><mrk mtype="seg" mid="1">Scan:Sending</mrk></seg-source><target><mrk mtype="seg" mid="1"/></target><sdl:seg-defs><sdl:seg id="1" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">ve0cNNSf0nYWYb0Op8Ha1lq9KcRaTNLiJZYWj1GD818=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2283f982-0f02-43f3-b73b-15a78506e903"><source>Sending the scan</source><seg-source><mrk mtype="seg" mid="2">Sending the scan</mrk></seg-source><target><mrk mtype="seg" mid="2"/></target><sdl:seg-defs><sdl:seg id="2" locked="true" conf="Draft"><sdl:rep id="G+rQpkL4WAUebQFnutvzhw9gj+3xh5ES0pjPquSnRXg="/><sdl:value key="SegmentIdentityHash">G+rQpkL4WAUebQFnutvzhw9gj+3xh5ES0pjPquSnRXg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="cd20a351-e75b-47a2-9152-762facb9f24b"><source>Sending the scan</source><seg-source><mrk mtype="seg" mid="3">Sending the scan</mrk></seg-source><target><mrk mtype="seg" mid="3">Enviando a digitalização</mrk></target><sdl:seg-defs><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="G+rQpkL4WAUebQFnutvzhw9gj+3xh5ES0pjPquSnRXg="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2019 18:58:18</sdl:value><sdl:value key="modified_on">05/31/2020 06:46:36</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2009708023</sdl:value><sdl:value key="SegmentIdentityHash">G+rQpkL4WAUebQFnutvzhw9gj+3xh5ES0pjPquSnRXg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="b59d5342-9a69-4344-bdda-17ee86c0c0a5"><source>After you have scanned the patient and reviewed the Rx to ensure that no data is missing, you can send the scan to the lab<x id="3"/> or to storage, depending on the procedure.</source><seg-source><mrk mtype="seg" mid="4">After you have scanned the patient and reviewed the Rx to ensure that no data is missing, you can send the scan to the lab<x id="3"/> or to storage, depending on the procedure.</mrk></seg-source><target><mrk mtype="seg" mid="4">Após digitalizar o paciente e revisar o Rx para garantir que não faltem dados, dependendo do procedimento, você pode enviar a digitalização para o laboratório<x id="3"/> ou para armazenamento.</mrk></target><sdl:seg-defs><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">100398543</sdl:value><sdl:value key="SegmentIdentityHash">Xi6HQl1eh4/gyB5vVAwwQZLK2dw5ilhaQT36U2WB6Uw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="8"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="5a8cb984-a097-4ebf-bfc1-78e1dcfc244d"><source><g id="9">Note:</g> Before you can send the scan, you have to confirm that you have received the patient&apos;s consent to have their health data collected and processed by Align.</source><seg-source><mrk mtype="seg" mid="5"><g id="9">Note:</g> Before you can send the scan, you have to confirm that you have received the patient&apos;s consent to have their health data collected and processed by Align.</mrk></seg-source><target><mrk mtype="seg" mid="5"/></target><sdl:seg-defs><sdl:seg id="5" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">y8TjBtzXKEL/K2oNJ614uZauBFA2niE07fSzaIhg/C4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="136869ca-4234-40b9-8dd1-c3c5dec2cdbf"><source>Notes:</source><seg-source><mrk mtype="seg" mid="6">Notes:</mrk></seg-source><target><mrk mtype="seg" mid="6">Notas:</mrk></target><sdl:seg-defs><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="MV5Vg0NrwdcmWKQ9naRB8KXHXb6LE+trTaKS4OubnEc="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/07/2019 00:22:06</sdl:value><sdl:value key="modified_on">11/19/2020 22:28:16</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-381729265</sdl:value><sdl:value key="SegmentIdentityHash">MV5Vg0NrwdcmWKQ9naRB8KXHXb6LE+trTaKS4OubnEc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="10"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ac83caba-1440-4e31-9709-e48bf6c28795"><source>Ensure that the wand is placed back in the cradle, with the optical window facing the cradle, before sending the scan.</source><seg-source><mrk mtype="seg" mid="7">Ensure that the wand is placed back in the cradle, with the optical window facing the cradle, before sending the scan.</mrk></seg-source><target><mrk mtype="seg" mid="7">Antes de enviar a digitalização, certifique-se de que o leitor esteja colocado novamente no suporte, com a janela óptica voltada para o suporte.</mrk></target><sdl:seg-defs><sdl:seg id="7" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">394148034</sdl:value><sdl:value key="SegmentIdentityHash">U0RlcHaUY89e5AkvTLnbi17+a3WcJp0jmoG4n61z1dc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="10"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d09f92f9-731b-431a-837c-3b4dc8fb14b6"><source>Before you can send the scan, you have to confirm that you have received the patient&apos;s consent to have their health data collected and processed by Align for the purposes of dental care and for further processing in accordance with your End User License Agreement.</source><seg-source><mrk mtype="seg" mid="8">Before you can send the scan, you have to confirm that you have received the patient&apos;s consent to have their health data collected and processed by Align for the purposes of dental care and for further processing in accordance with your End User License Agreement.</mrk></seg-source><target><mrk mtype="seg" mid="8">Antes de enviar a digitalização, você deve confirmar que recebeu o consentimento do paciente para que seus dados de saúde sejam coletados e processados pela Align para fins de atendimento odontológico e para processamento posterior de acordo com seu Acordo de Licença de Usuário Final.</mrk></target><sdl:seg-defs><sdl:seg id="8" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2110356413</sdl:value><sdl:value key="SegmentIdentityHash">2TlX3pwSuuId2/iWYCNqLEra1NXTrZySZNLabdxu8P4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="10"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="92eccc36-5cf6-42b1-8fa3-8a025a996a24"><source>The wand lights may flicker during the sending process.</source><seg-source><mrk mtype="seg" mid="9">The wand lights may flicker during the sending process.</mrk></seg-source><target><mrk mtype="seg" mid="9">As luzes do leitor podem piscar durante o processo de envio.</mrk></target><sdl:seg-defs><sdl:seg id="9" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1305773927</sdl:value><sdl:value key="SegmentIdentityHash">bsuwO3df7nVJbfoBu3YXpbGheFO7G3PqkKkdNSbX31c=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="16ad99ee-fad1-46c7-bc19-684dd4059c74"><source>Evaluate the fitting of the dental devices manufactured using the data generated from the scanner according to the standard of care procedure.</source><seg-source><mrk mtype="seg" mid="10">Evaluate the fitting of the dental devices manufactured using the data generated from the scanner according to the standard of care procedure.</mrk></seg-source><target><mrk mtype="seg" mid="10">Avalie a adaptação dos dispositivos odontológicos fabricados, utilizando os dados gerados pelo scanner de acordo com o procedimento padrão de tratamento.</mrk></target><sdl:seg-defs><sdl:seg id="10" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">629017208</sdl:value><sdl:value key="SegmentIdentityHash">UNUx8B2HKjut2OHSvUvvclnRdQUe1TmAVnpLZriryeU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="4a34a5f7-6de6-41f2-bea4-76802ad10dcc"><source>To send the scan:</source><seg-source><mrk mtype="seg" mid="11">To send the scan:</mrk></seg-source><target><mrk mtype="seg" mid="11">Para enviar a digitalização:</mrk></target><sdl:seg-defs><sdl:seg id="11" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/09/2019 13:23:02</sdl:value><sdl:value key="modified_on">12/23/2019 01:19:35</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">523739509</sdl:value><sdl:value key="SegmentIdentityHash">lAGHL4gTB0zrDz/Axcu4/tAIjsG44Dg/lsds6G1yiZ0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="9bab5c37-5e76-4870-86ea-6ebfa631946c"><source>Tap <x id="11"/> on the toolbar to send the scan, including screenshots of the scanned model, if relevant.</source><seg-source><mrk mtype="seg" mid="12">Tap <x id="11"/> on the toolbar to send the scan, including screenshots of the scanned model, if relevant.</mrk></seg-source><target><mrk mtype="seg" mid="12">Toque em <x id="11"/> na barra de ferramentas para enviar a digitalização, incluindo as capturas de tela do modelo digitalizado, caso seja relevante.</mrk></target><sdl:seg-defs><sdl:seg id="12" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:24</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:24</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">352844569</sdl:value><sdl:value key="SegmentIdentityHash">3Wxsau4xn8u0UuVXhg4uXgpVTRs/cXcJ0pSXwPBJdXc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="13"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="a193f037-f346-4a7f-ab9f-f32c3e2804eb"><source><x id="15"/><x id="18"/></source><seg-source><mrk mtype="seg" mid="13"><x id="15"/></mrk><mrk mtype="seg" mid="14"><x id="18"/></mrk></seg-source><target><mrk mtype="seg" mid="13"><x id="15"/></mrk><mrk mtype="seg" mid="14"><x id="18"/></mrk></target><sdl:seg-defs><sdl:seg id="13" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="14" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="14"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="1e146c07-8860-4591-944d-74514f9482d2"><source>Notification about missing treatment information</source><seg-source><mrk mtype="seg" mid="15">Notification about missing treatment information</mrk></seg-source><target><mrk mtype="seg" mid="15"/></target><sdl:seg-defs><sdl:seg id="15" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">gtB1qnNzLYVnVA8W4RrvX+wQgIv/wvMXxtoC4w73IdM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="15"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="813e86bb-db12-4065-af70-ca3a3fb65719"><source>Tap <g id="31">OK</g> to display the <g id="34">Rx Details</g> page, showing a notification in the <g id="37">Treatment Information</g> area for each treatment missing required fields.</source><seg-source><mrk mtype="seg" mid="16">Tap <g id="31">OK</g> to display the <g id="34">Rx Details</g> page, showing a notification in the <g id="37">Treatment Information</g> area for each treatment missing required fields.</mrk></seg-source><target><mrk mtype="seg" mid="16"/></target><sdl:seg-defs><sdl:seg id="16" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">quAmS/H8ayleGEANLCNvOjDe0LvwdpbtWU88SkVcC5Q=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="15"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="a625a6ca-a972-44e9-83cd-f1ebfb91b84d"><source>Missing fields highlighted in red in the Treatment Information area</source><seg-source><mrk mtype="seg" mid="17">Missing fields highlighted in red in the Treatment Information area</mrk></seg-source><target><mrk mtype="seg" mid="17"/></target><sdl:seg-defs><sdl:seg id="17" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">wU3v+hw+7Vp3OfDM+bKwQPVVTJrqBaiCfDcNJbl22M8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="16"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7cf2abd9-8dc8-4f80-b616-e7497053336b"><source>Tap <g id="43">Show Details</g> to open the treatment options and fill in the missing details.</source><seg-source><mrk mtype="seg" mid="18">Tap <g id="43">Show Details</g> to open the treatment options and fill in the missing details.</mrk></seg-source><target><mrk mtype="seg" mid="18"/></target><sdl:seg-defs><sdl:seg id="18" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">ccQUPxHzJ9x6lAss22gVXodmXo9xgLsJgMbd3goL2aY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="16"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="c7a8e2ac-ed8b-488f-b6bc-0faae9f14616"><source>Tap <x id="45"/> to send the scan.</source><seg-source><mrk mtype="seg" mid="19">Tap <x id="45"/> to send the scan.</mrk></seg-source><target><mrk mtype="seg" mid="19"/></target><sdl:seg-defs><sdl:seg id="19" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">fhpCri/TVP5JQ+xduW+UAlTpziq/XrizZfthEBgTf9M=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="70d840a1-d1dd-4ce1-9213-932099ad1100"><source>The <g id="51">Complete Scan</g> window is displayed.</source><seg-source><mrk mtype="seg" mid="20">The <g id="51">Complete Scan</g> window is displayed.</mrk></seg-source><target><mrk mtype="seg" mid="20">A janela <g id="51">Concluir Digitalização</g> é exibida.</mrk></target><sdl:seg-defs><sdl:seg id="20" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="Source"><sdl:value key="created_by">NEARUA
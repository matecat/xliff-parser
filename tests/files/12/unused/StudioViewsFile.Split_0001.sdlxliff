4=</sdl:value></sdl:seg><sdl:seg id="283" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="284" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="65"/><sdl:cxt id="66"/><sdl:cxt id="67"/><sdl:cxt id="68"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="6f0fbff0-7a06-40cb-9c98-f501e97bc6f4"><source><x id="419"/>Cart-configuration scanners are provided with two Li-ion rechargeable battery packs.<x id="421"/>Mobile-configuration scanners are provided with one battery pack.<x id="423"/>The battery packs are placed in the back bottom half of the computing unit.</source><seg-source><mrk mtype="seg" mid="285"><x id="419"/>Cart-configuration scanners are provided with two Li-ion rechargeable battery packs.</mrk><mrk mtype="seg" mid="286"><x id="421"/></mrk><mrk mtype="seg" mid="287">Mobile-configuration scanners are provided with one battery pack.</mrk><mrk mtype="seg" mid="288"><x id="423"/>The battery packs are placed in the back bottom half of the computing unit.</mrk></seg-source><target><mrk mtype="seg" mid="285"><x id="419"/>Os scanners com configuração do carrinho são fornecidos com duas baterias recarregáveis de íons de lítio.</mrk><mrk mtype="seg" mid="286"><x id="421"/></mrk><mrk mtype="seg" mid="287">Os scanners com configuração móvel são fornecidos com uma bateria.</mrk><mrk mtype="seg" mid="288"><x id="423"/>As duas baterias são colocadas na metade inferior traseira da unidade de computação.</mrk></target><sdl:seg-defs><sdl:seg id="285" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">11/20/2023 10:37:45</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-31640619</sdl:value><sdl:value key="SegmentIdentityHash">gwP2FVrrByRCYuBI7b4oXxCYnPR6+1kV7Xnta0MIU18=</sdl:value></sdl:seg><sdl:seg id="286" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="287" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">11/20/2023 10:39:41</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">162911155</sdl:value><sdl:value key="SegmentIdentityHash">A8y72hvFDrSfLOVRiXdV0gekkjM+jC03y92woM2qtw8=</sdl:value></sdl:seg><sdl:seg id="288" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 21:52:03</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1414250252</sdl:value><sdl:value key="SegmentIdentityHash">+FyBXpH2FBZ/BgiUyvmk+J9jdGmnF66PGG9Pvdxr+MI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="65"/><sdl:cxt id="66"/><sdl:cxt id="69"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="4b02c6ff-f6b5-4f5a-9112-ff27f321f528"><source><g id="431">CAUTION:</g> There is a danger of battery burning and/or explosion if the screen is damaged and/or the battery is not replaced according to Align&apos;s instructions.Do not use the scanner if dropped or any damage is noticed.Contact Customer Support.</source><seg-source><mrk mtype="seg" mid="289"><g id="431">CAUTION:</g> There is a danger of battery burning and/or explosion if the screen is damaged and/or the battery is not replaced according to Align&apos;s instructions.</mrk><mrk mtype="seg" mid="290">Do not use the scanner if dropped or any damage is noticed.</mrk><mrk mtype="seg" mid="291">Contact Customer Support.</mrk></seg-source><target><mrk mtype="seg" mid="289"><g id="431">ATENÇÃO:</g> há risco de queima e/ou explosão da bateria caso a tela esteja danificada e/ou a bateria não seja substituída de acordo com as instruções da Align.</mrk><mrk mtype="seg" mid="290">Não use o scanner se ele cair ou se notar algum dano.</mrk><mrk mtype="seg" mid="291">Fale com o Suporte ao Cliente.</mrk></target><sdl:seg-defs><sdl:seg id="289" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 21:53:43</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1068294053</sdl:value><sdl:value key="SegmentIdentityHash">K8AL5H91O6zVF9kzy9eEl1OvlNOIX42uCGpquSBgwy8=</sdl:value></sdl:seg><sdl:seg id="290" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/28/2020 14:53:55</sdl:value><sdl:value key="modified_on">10/22/2020 04:20:44</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-482849530</sdl:value><sdl:value key="SegmentIdentityHash">zjpgOrN+zAyq1aNk8lisp9KGRgNkmVmpGuNRpsenNdI=</sdl:value></sdl:seg><sdl:seg id="291" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/28/2020 14:54:03</sdl:value><sdl:value key="modified_on">10/22/2020 04:20:46</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1185395096</sdl:value><sdl:value key="SegmentIdentityHash">o/mw//mqxYVC6/P7B36ZPpbRcmC5wMTxBz8gA0PIr6Y=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="57"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="87c698ab-8f88-43cc-a70f-eb61973baade"><source>Use only the original AC/DC adaptor connected to the system to charge the batteries.</source><seg-source><mrk mtype="seg" mid="292">Use only the original AC/DC adaptor connected to the system to charge the batteries.</mrk></seg-source><target><mrk mtype="seg" mid="292">Use apenas o adaptador AC/DC original conectado ao sistema para carregar as baterias.</mrk></target><sdl:seg-defs><sdl:seg id="292" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2022 11:00:36</sdl:value><sdl:value key="modified_on">12/06/2022 11:00:36</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-859598481</sdl:value><sdl:value key="SegmentIdentityHash">4VvwwQHjgviKHd3bAvQGC6Ut1Cv1NyEF/DjeZNdTgQM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="57"/><sdl:cxt id="70"/><sdl:cxt id="71"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="b7ea060b-e88c-4845-8753-72d9013526bb"><source><x id="442"/><g id="445">CAUTION:</g> A failing Li-ion battery begins to hiss, bulge, and leak electrolytes.The electrolytes consist of lithium salt in an organic solvent (lithium hexafluorophosphate), which is highly flammable.Burning electrolytes can ignite combustible materials in close proximity.</source><seg-source><mrk mtype="seg" mid="293"><x id="442"/><g id="445">CAUTION:</g> A failing Li-ion battery begins to hiss, bulge, and leak electrolytes.</mrk><mrk mtype="seg" mid="294">The electrolytes consist of lithium salt in an organic solvent (lithium hexafluorophosphate), which is highly flammable.</mrk><mrk mtype="seg" mid="295">Burning electrolytes can ignite combustible materials in close proximity.</mrk></seg-source><target><mrk mtype="seg" mid="293"><x id="442"/><g id="445">ATENÇÃO:</g> uma bateria de íons de lítio com defeito começa a sibilar, inchar e a vazar eletrólitos.</mrk><mrk mtype="seg" mid="294">Os eletrólitos consistem em sal de lítio em um solvente orgânico (hexafluorofosfato de lítio), que é altamente inflamável.</mrk><mrk mtype="seg" mid="295">A queima de eletrólitos pode inflamar materiais combustíveis que estiverem nas proximidades.</mrk></target><sdl:seg-defs><sdl:seg id="293" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">663157464</sdl:value><sdl:value key="SegmentIdentityHash">t7BaXySKOYYgGs5s3v4eEiABRJqvesyOkwN7uzeqbB8=</sdl:value></sdl:seg><sdl:seg id="294" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/01/2022 13:02:01</sdl:value><sdl:value key="modified_on">11/01/2022 13:02:01</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-807755807</sdl:value><sdl:value key="SegmentIdentityHash">nuNiSwpqhDrSCkRqOgB3rX8P2WjFFTLMFgSp+c6WEbk=</sdl:value></sdl:seg><sdl:seg id="295" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/10/2022 08:41:38</sdl:value><sdl:value key="modified_on">11/18/2022 00:24:13</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1655275856</sdl:value><sdl:value key="SegmentIdentityHash">VJH48lGv2MH2dJ6umtI8GEf0j0WRfchATzOyeP3q8lY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="57"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="0b54daec-fb3f-492b-acb3-23db626b1fcc"><source>Please note, there is a risk of burns associated with this situation.</source><seg-source><mrk mtype="seg" mid="296">Please note, there is a risk of burns associated with this situation.</mrk></seg-source><target><mrk mtype="seg" mid="296">Observe que existe risco de queimaduras associado a esta situação.</mrk></target><sdl:seg-defs><sdl:seg id="296" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 15:29:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1216850021</sdl:value><sdl:value key="SegmentIdentityHash">jSp0pczNJ5OGVfIUFpAqaebFInyckkEUx2NTflXV3w8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="72"/><sdl:cxt id="73"/><sdl:cxt id="59"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7e9a42ef-b8b3-4fa9-8d0e-79a472382134"><source>The screen should be stored and operated following the environmental conditions that appear in this manual.Do not expose the scanner to extreme heat sources, such as radiators and fireplaces.</source><seg-source><mrk mtype="seg" mid="297">The screen should be stored and operated following the environmental conditions that appear in this manual.</mrk><mrk mtype="seg" mid="298">Do not expose the scanner to extreme heat sources, such as radiators and fireplaces.</mrk></seg-source><target><mrk mtype="seg" mid="297">A tela deve ser guardada e operada de acordo com as condições ambientais que aparecem neste manual.</mrk><mrk mtype="seg" mid="298">Não exponha o scanner à fontes extremas de calor, como radiadores e lareiras.</mrk></target><sdl:seg-defs><sdl:seg id="297" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/28/2020 14:54:56</sdl:value><sdl:value key="modified_on">10/22/2020 04:20:53</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">730983724</sdl:value><sdl:value key="SegmentIdentityHash">nLg5BzcUJs1Jqm+JwInSpurl/NLv7DHzZH/bnL9+aOs=</sdl:value></sdl:seg><sdl:seg id="298" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/28/2020 14:55:39</sdl:value><sdl:value key="modified_on">10/22/2020 04:20:56</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1948424227</sdl:value><sdl:value key="SegmentIdentityHash">sdzKEyFkKIbZgX3QaXLXU4HBBF9C0HudSCtHzSICNuA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="72"/><sdl:cxt id="73"/><sdl:cxt id="74"/><sdl:cxt id="59"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ef542a56-287b-4b15-96f1-24d46326a50e"><source>Never operate the device without batteries!Do not use the batteries for any purpose other than the intended use of the product.Discard used batteries according to the manufacturer&apos;s instructions and local requirements.</source><seg-source><mrk mtype="seg" mid="299">Never operate the device without batteries!</mrk><mrk mtype="seg" mid="300">Do not use the batteries for any purpose other than the intended use of the product.</mrk><mrk mtype="seg" mid="301">Discard used batteries according to the manufacturer&apos;s instructions and local requirements.</mrk></seg-source><target><mrk mtype="seg" mid="299">Nunca opere o dispositivo sem baterias!</mrk><mrk mtype="seg" mid="300">Não use as baterias para nenhuma outra finalidade diferente do uso previsto para o produto.</mrk><mrk mtype="seg" mid="301">Descarte as baterias usadas de acordo com as instruções do fabricante e das exigências locais.</mrk></target><sdl:seg-defs><sdl:seg id="299" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/28/2020 14:55:49</sdl:value><sdl:value key="modified_on">10/22/2020 04:20:59</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">366233239</sdl:value><sdl:value key="SegmentIdentityHash">l5+dbvuweETgv/u27CJHh+LDMnw3Ht2hjw1jh4/o/go=</sdl:value></sdl:seg><sdl:seg id="300" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/28/2020 14:58:18</sdl:value><sdl:value key="modified_on">10/22/2020 04:21:02</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">934394177</sdl:value><sdl:value key="SegmentIdentityHash">m2P38CtP8v01XQWRX70Rl4qLqe6CQ9By83nb5LEqzGY=</sdl:value></sdl:seg><sdl:seg id="301" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/28/2020 14:58:54</sdl:value><sdl:value key="modified_on">10/22/2020 04:21:04</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-461255708</sdl:value><sdl:value key="SegmentIdentityHash">nmDLCAZ4cX0swczwU10Zt3FlWwRzmf1G1hlKqEoI2t0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="75"/><sdl:cxt id="59"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="df0fc808-97a2-4e3c-a1ff-dce957143eca"><source>Replace the batteries only with the same battery type supplied by Align.</source><seg-source><mrk mtype="seg" mid="302">Replace the batteries only with the same battery type supplied by Align.</mrk></seg-source><target><mrk mtype="seg" mid="302"/></target><sdl:seg-defs><sdl:seg id="302" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">jU1OMTeQ/XrrDhltyL9M1h5SWx86bNv1Li9ZD8OzhAs=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="76"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="5a4d49d9-c62a-41bb-ab0e-c422ae6676b5"><source>Replace the batteries only with batteries supplied by Align for your specific device configuration.</source><seg-source><mrk mtype="seg" mid="303">Replace the batteries only with batteries supplied by Align for your specific device configuration.</mrk></seg-source><target><mrk mtype="seg" mid="303">Substitua as baterias apenas por baterias fornecidas pela Align para a configuração específica do seu equipamento.</mrk></target><sdl:seg-defs><sdl:seg id="303" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1485715547</sdl:value><sdl:value key="SegmentIdentityHash">XN41TVBOiEVvGUuQReCbnLaqw3lv3KE9Tw7eEdfX0TY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="3b47ad72-a262-48f4-948d-1117e70a05bf"><source>Electric warnings</source><seg-source><mrk mtype="seg" mid="304">Electric warnings</mrk></seg-source><target><mrk mtype="seg" mid="304">Alertas de eletricidade</mrk></target><sdl:seg-defs><sdl:seg id="304" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/28/2020 19:02:51</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-571365353</sdl:value><sdl:value key="SegmentIdentityHash">ZOaIKZ5p1c6OXgBbUEy3uz1O/+rk8apRfYc6og1Qrw0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="8"/><sdl:cxt id="77"/><sdl:cxt id="78"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="f046417d-6032-4803-aee1-11543d4d959c"><source><g id="479">Warning:</g> <g id="482"> </g> <x id="483"/><g id="487">Do not remove external panels and covers in order to avoid electrical shock.</g>There are no user-serviceable parts inside.In <x id="490"/> scanners, you <x id="491"/><g id="494">may</g> open the cover of the diagnostics panel in case of system failure, only when required by Customer Support.</source><seg-source><mrk mtype="seg" mid="305"><g id="479">Warning:</g> <g id="482"> </g> <x id="483"/></mrk><mrk mtype="seg" mid="306"><g id="487">Do not remove external panels and covers in order to avoid electrical shock.</g></mrk><mrk mtype="seg" mid="307">There are no user-serviceable parts inside.</mrk><mrk mtype="seg" mid="308">In <x id="490"/> scanners, you <x id="491"/><g id="494">may</g> open the cover of the diagnostics panel in case of system failure, only when required by Customer Support.</mrk></seg-source><target><mrk mtype="seg" mid="305"><g id="479">Aviso:</g> <g id="482"> </g> <x id="483"/></mrk><mrk mtype="seg" mid="306"><g id="487">Para evitar choque elétrico, não remova os painéis externos e as tampas.</g></mrk><mrk mtype="seg" mid="307">Não há qualquer elemento interno que possa ser manuseado pelo usuário.</mrk><mrk mtype="seg" mid="308">Nos scanners <x id="490"/>, só <x id="491"/><g id="494">pode</g> abrir a tampa do painel de diagnóstico em caso de falha do sistema, caso seja solicitado pelo Suporte ao Cliente.</mrk></target><sdl:seg-defs><sdl:seg id="305" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 21:59:50</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1377023776</sdl:value><sdl:value key="SegmentIdentityHash">0Lnc0MwPsC+NVO2d70f89LiWH7yJmd0CiY7Fv9ozIRg=</sdl:value></sdl:seg><sdl:seg id="306" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/19/2024 21:38:34</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1002044398</sdl:value><sdl:value key="SegmentIdentityHash">0YXoA3bse0wwRL8yzxQ642ZNQMbc5/eJUSzGqoH1u2o=</sdl:value></sdl:seg><sdl:seg id="307" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2019 20:25:26</sdl:value><sdl:value key="modified_on">11/18/2020 18:44:45</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1538635732</sdl:value><sdl:value key="SegmentIdentityHash">aoBCxFLGxl38J8z/Vi35v5HauRWtzqP03vytesudti4=</sdl:value></sdl:seg><sdl:seg id="308" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1066775080</sdl:value><sdl:value key="SegmentIdentityHash">xDUBfw/hjpqtMm5NSe+GpxJ2g/7AUNxdxY4kMU4rr4Y=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2f4b4bed-9385-4869-91f0-4804763bd2b9"><source><g id="503">Warning:</g> Do not connect any non-Align-approved external devices such as webcams, USB devices, LAN, or other mains-operated equipment, in order to avoid electrical shock.</source><seg-source><mrk mtype="seg" mid="309"><g id="503">Warning:</g> Do not connect any non-Align-approved external devices such as webcams, USB devices, LAN, or other mains-operated equipment, in order to avoid electrical shock.</mrk></seg-source><target><mrk mtype="seg" mid="309"><g id="503">Aviso:</g> para evitar choque elétrico, não conecte nenhum dispositivo externo não aprovado pela Align, como webcams, dispositivos USB, LAN ou outros equipamentos operados por energia elétrica.</mrk></target><sdl:seg-defs><sdl:seg id="309" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 22:02:02</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">444148858</sdl:value><sdl:value key="SegmentIdentityHash">TRiuaVwXJ3zuQpNU00FwgXGOj3QbWfi1MBg1w5VuBRQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="83f906a1-a84a-49e8-a112-e86895cf60da"><source><g id="509">Warning:</g> Do not remove and replace batteries without first disconnecting the power cable from the mains, and disconnecting the screen power cable.</source><seg-source><mrk mtype="seg" mid="310"><g id="509">Warning:</g> Do not remove and replace batteries without first disconnecting the power cable from the mains, and disconnecting the screen power cable.</mrk></seg-source><target><mrk mtype="seg" mid="310"><g id="509">Aviso:</g> não remova nem substitua as baterias sem, primeiro, desconectar o cabo de alimentação da rede elétrica e desconectar o cabo de alimentação da tela.</mrk></target><sdl:seg-defs><sdl:seg id="310" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 22:05:15</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">412706299</sdl:value><sdl:value key="SegmentIdentityHash">kF7lkslB0g+uugO6hgChyNXexQ8JJGzq9zgDpUZ3+Ws=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ce2d0aef-7e23-4340-8f1f-6906853e96fb"><source><g id="515">Warning:</g> Do not connect the scanner to a mains supply without protective grounding, in order to avoid the risk of electrical shock.</source><seg-source><mrk mtype="seg" mid="311"><g id="515">Warning:</g> Do not connect the scanner to a mains supply without protective grounding, in order to avoid the risk of electrical shock.</mrk></seg-source><target><mrk mtype="seg" mid="311"><g id="515">Aviso:</g> para evitar o risco de choque elétrico, não conecte o scanner a uma fonte de alimentação sem aterramento de proteção.</mrk></target><sdl:seg-defs><sdl:seg id="311" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 22:11:45</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2013288395</sdl:value><sdl:value key="SegmentIdentityHash">i8Fiwp/q8mrYzly2/ymmMiH8ucSlkFps8guGbbggcrE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="79"/><sdl:cxt id="80"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d766e55d-bba0-45b4-8b38-cb62613cddb2"><source><g id="521">Warning:</g> Use only the supplied power cable, which has a protective earth lead.Do not connect a power cable that is not supplied by Align Technology and/or do not use a power strip or extension cord to connect to the system in order to avoid electrical shock.</source><seg-source><mrk mtype="seg" mid="312"><g id="521">Warning:</g> Use only the supplied power cable, which has a protective earth lead.</mrk><mrk mtype="seg" mid="313">Do not connect a power cable that is not supplied by Align Technology and/or do not use a power strip or extension cord to connect to the system in order to avoid electrical shock.</mrk></seg-source><target><mrk mtype="seg" mid="312"><g id="521">Aviso:</g> use apenas o cabo de alimentação fornecido, que tem um cabo de aterramento de proteção.</mrk><mrk mtype="seg" mid="313">Para evitar choque elétrico não conecte ao sistema um cabo de energia que não tenha sido fornecido pela Align Technology e/ou não utilize filtro de linha ou cabo de extensão.</mrk></target><sdl:seg-defs><sdl:seg id="312" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:18</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:18</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-983213976</sdl:value><sdl:value key="SegmentIdentityHash">rGSyAJGCsPURPFuakIjIsy7iVE4atVec5/ueX6zZzOY=</sdl:value></sdl:seg><sdl:seg id="313" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">522521220</sdl:value><sdl:value key="SegmentIdentityHash">wprca7VKVlqBXSBEMKPZqI9QR7XjXLXdczsr9NWLjw8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="81"/><sdl:cxt id="82"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="a5f454a3-576d-44fc-9460-7b7e03bb1373"><source><x id="525"/><x id="528"/></source><seg-source><mrk mtype="seg" mid="314"><x id="525"/></mrk><mrk mtype="seg" mid="315"><x id="528"/></mrk></seg-source><target><mrk mtype="seg" mid="314"><x id="525"/></mrk><mrk mtype="seg" mid="315"><x id="528"/></mrk></target><sdl:seg-defs><sdl:seg id="314" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3
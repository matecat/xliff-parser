rw14YWavekjLVjQ/u2XbiMlrbhU2Ehd2s=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="10"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="68a1c083-ee23-439b-a1ca-880d16746fea"><source>Attach the blue protective sleeve onto the wand.</source><seg-source><mrk mtype="seg" mid="15">Attach the blue protective sleeve onto the wand.</mrk></seg-source><target><mrk mtype="seg" mid="15"/></target><sdl:seg-defs><sdl:seg id="15" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">/NZndjxvn3YRMHSPurCp1wHyG8n2BCsbCSP20LiOTpc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="10"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d8da15bd-40e3-45ff-8873-d40ed270e431"><source>Place all items in the supplied carrying case to move the system between offices.</source><seg-source><mrk mtype="seg" mid="16">Place all items in the supplied carrying case to move the system between offices.</mrk></seg-source><target><mrk mtype="seg" mid="16"/></target><sdl:seg-defs><sdl:seg id="16" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">VZUikAGMmNMsNwdTQYwXZCrHs7tessqbPg80z/3F6/w=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="10"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="84ddb97b-db14-4773-b3ce-d632b112cd11"><source><x id="29"/> <g id="32"> intraoral scanner</g> <g id="35"> imaging system</g> in the supplied carrying case</source><seg-source><mrk mtype="seg" mid="17"><x id="29"/> <g id="32"> intraoral scanner</g> <g id="35"> imaging system</g> in the supplied carrying case</mrk></seg-source><target><mrk mtype="seg" mid="17"/></target><sdl:seg-defs><sdl:seg id="17" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">dq8bzs556vzOu1GRXTVOS+hxo4MzZ0+6pbofssv1VRU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="10"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="6a55cf6c-ed66-4e45-ac01-8e1a2bb20c2d"><source>Make sure the case is kept dry to protect the system components from humidity.</source><seg-source><mrk mtype="seg" mid="18">Make sure the case is kept dry to protect the system components from humidity.</mrk></seg-source><target><mrk mtype="seg" mid="18"/></target><sdl:seg-defs><sdl:seg id="18" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">MdtR/FwJD+rS/p8uLGObI/kr4u7mM6qdxmrkjOwuobw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="48339ca6-c164-479c-a624-897d48f996df"><source>Moving the <x id="37"/> cart-configuration scanner</source><seg-source><mrk mtype="seg" mid="19">Moving the <x id="37"/> cart-configuration scanner</mrk></seg-source><target><mrk mtype="seg" mid="19">Transportando o <x id="37"/> scanner na configuração do carrinho</mrk></target><sdl:seg-defs><sdl:seg id="19" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:20</sdl:value><sdl:value key="modified_on">06/12/2024 16:29:53</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-932507855</sdl:value><sdl:value key="SegmentIdentityHash">NFWF4sK2E94MbzqcJ9OO8wMx6RLIgwE3foDkJB1x0Og=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2c193728-cfed-425b-8c40-d3963b448325"><source>The scanner can be moved between rooms within the office and while you are seated, with a patient.</source><seg-source><mrk mtype="seg" mid="20">The scanner can be moved between rooms within the office and while you are seated, with a patient.</mrk></seg-source><target><mrk mtype="seg" mid="20">O scanner pode ser deslocado entre salas dentro do consultório e enquanto você está sentado, com um paciente.</mrk></target><sdl:seg-defs><sdl:seg id="20" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/13/2020 06:43:28</sdl:value><sdl:value key="modified_on">10/22/2020 01:27:13</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-546528504</sdl:value><sdl:value key="SegmentIdentityHash">UlHyWiRTINLNWuJZgcCJUT+Km0j3gbgzHe+DlHOtEY8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7fd33ac9-c199-4783-a8bd-4b0a39b92241"><source>To move the scanner between rooms:</source><seg-source><mrk mtype="seg" mid="21">To move the scanner between rooms:</mrk></seg-source><target><mrk mtype="seg" mid="21">Para deslocar o scanner entre salas:</mrk></target><sdl:seg-defs><sdl:seg id="21" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="YrtsEgP/MotauDI/QwdnKxzoiJukfZyCYHfQkoMicx4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/09/2020 15:59:05</sdl:value><sdl:value key="modified_on">10/22/2020 01:27:19</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2057001337</sdl:value><sdl:value key="SegmentIdentityHash">YrtsEgP/MotauDI/QwdnKxzoiJukfZyCYHfQkoMicx4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="72d249b6-1c02-4917-8a64-d69ce93b84f1"><source>Ensure that the wand is firmly positioned in the cradle, with the optical window facing the cradle.</source><seg-source><mrk mtype="seg" mid="22">Ensure that the wand is firmly positioned in the cradle, with the optical window facing the cradle.</mrk></seg-source><target><mrk mtype="seg" mid="22">Certifique-se de que o leitor esteja posicionado firmemente no suporte, com a janela óptica voltada para o suporte.</mrk></target><sdl:seg-defs><sdl:seg id="22" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="L/y3Fp6yP1ZmcLasiSZc2FKwLvkguUfiA/iJbk8bgGY="/><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/19/2024 19:45:48</sdl:value><sdl:value key="modified_on">06/12/2024 16:29:53</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1407827251</sdl:value><sdl:value key="SegmentIdentityHash">L/y3Fp6yP1ZmcLasiSZc2FKwLvkguUfiA/iJbk8bgGY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="4edc125b-0e8b-4f77-9c3f-0c30689ce8a6"><source>Unplug the system from the wall outlet and carefully wrap the power cable around the upper handle, to prevent the cable from being caught between the wheels.</source><seg-source><mrk mtype="seg" mid="23">Unplug the system from the wall outlet and carefully wrap the power cable around the upper handle, to prevent the cable from being caught between the wheels.</mrk></seg-source><target><mrk mtype="seg" mid="23">Desconecte o sistema da tomada e enrole cuidadosamente o cabo de energia ao redor da alça superior, para evitar que o cabo fique preso entre as rodas.</mrk></target><sdl:seg-defs><sdl:seg id="23" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/17/2022 00:07:08</sdl:value><sdl:value key="modified_on">11/17/2022 00:07:08</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1608976577</sdl:value><sdl:value key="SegmentIdentityHash">Xtoe7u+Snx+NLeDOVlfqxvjWzZtQcl+ywi6UtJ9IijQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="15326e49-d179-4622-bebd-8b3481aa3019"><source>Using the upper handle, move the system to its new location and plug it into a wall outlet.</source><seg-source><mrk mtype="seg" mid="24">Using the upper handle, move the system to its new location and plug it into a wall outlet.</mrk></seg-source><target><mrk mtype="seg" mid="24">Usando a alça superior, mova o sistema para seu novo local e conecte-o a uma tomada de parede.</mrk></target><sdl:seg-defs><sdl:seg id="24" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/17/2022 00:07:10</sdl:value><sdl:value key="modified_on">11/17/2022 00:07:10</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1862122646</sdl:value><sdl:value key="SegmentIdentityHash">Ocr71HbJGEaqdSQ6K70RLZfuzp4+vaEhioqKLxvlgY8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="82036fd3-71ae-4e84-b712-852a445e395b"><source><g id="43">Note:</g> If the scanner needs to be lifted, lift it using the upper handle and the post.</source><seg-source><mrk mtype="seg" mid="25"><g id="43">Note:</g> If the scanner needs to be lifted, lift it using the upper handle and the post.</mrk></seg-source><target><mrk mtype="seg" mid="25"><g id="43">Nota:</g> se o scanner precisar ser levantado, levante-o usando a alça superior e o extensor.</mrk></target><sdl:seg-defs><sdl:seg id="25" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:20</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:20</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2138532949</sdl:value><sdl:value key="SegmentIdentityHash">VZjM5Dy5lto9DDIZAxMrC65is74cleJkmFurRAi6ZfY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="a4f82c69-56bc-4523-aa32-1b44166c0db7"><source>Moving the scanner</source><seg-source><mrk mtype="seg" mid="26">Moving the scanner</mrk></seg-source><target><mrk mtype="seg" mid="26">Transportando o scanner</mrk></target><sdl:seg-defs><sdl:seg id="26" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="02eTOxoVWAOZQHn65FkmcoEURMeTQEo+xB78FSpBzSA="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2019 18:45:54</sdl:value><sdl:value key="modified_on">11/19/2020 22:33:17</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">218638774</sdl:value><sdl:value key="SegmentIdentityHash">02eTOxoVWAOZQHn65FkmcoEURMeTQEo+xB78FSpBzSA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="8feb6580-f470-4870-aebe-77ef0bf8e057"><source>To move the cart-configuration scanner while in a seated position:</source><seg-source><mrk mtype="seg" mid="27">To move the cart-configuration scanner while in a seated position:</mrk></seg-source><target><mrk mtype="seg" mid="27">Para deslocar o scanner de configuração do carrinho enquanto está em uma posição sentada:</mrk></target><sdl:seg-defs><sdl:seg id="27" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/17/2022 00:07:20</sdl:value><sdl:value key="modified_on">11/17/2022 00:07:20</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-388095841</sdl:value><sdl:value key="SegmentIdentityHash">C+96Y8KG9ozSXy+V3Jz0JYxqEcKR4lWN9+AX17DcwYA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="12"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="41314e8e-f7bb-4e1a-9831-4dbcbc3bd90a"><source>Use the main handle to move the scanner.</source><seg-source><mrk mtype="seg" mid="28">Use the main handle to move the scanner.</mrk></seg-source><target><mrk mtype="seg" mid="28">Use a alça central para deslocar o scanner.</mrk></target><sdl:seg-defs><sdl:seg id="28" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/09/2020 16:03:40</sdl:value><sdl:value key="modified_on">10/22/2020 01:28:35</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1054774374</sdl:value><sdl:value key="SegmentIdentityHash">cFgad/HdHRpQ03UQfcvf/aEU0F1GPiARGvS3l4CjCvk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="13"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="8d657c89-844f-492f-942e-65c70270744a"><source>The screen height is optimized for a more ergonomic experience while seated.If required, you can adjust the tilt of the screen.</source><seg-source><mrk mtype="seg" mid="29">The screen height is optimized for a more ergonomic experience while seated.</mrk><mrk mtype="seg" mid="30">If required, you can adjust the tilt of the screen.</mrk></seg-source><target><mrk mtype="seg" mid="29">A altura da tela é otimizada para fornecer uma experiência mais ergonômica na posição sentada.</mrk><mrk mtype="seg" mid="30">Se necessário, você pode ajustar a inclinação da tela.</mrk></target><sdl:seg-defs><sdl:seg id="29" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/13/2020 06:59:04</sdl:value><sdl:value key="modified_on">11/17/2022 00:07:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1024904054</sdl:value><sdl:value key="SegmentIdentityHash">jEIhpg5oXVuHAxDXFAJ9SwSwgPbPshppKoLyzTj0Hr0=</sdl:value></sdl:seg><sdl:seg id="30" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/09/2020 16:04:00</sdl:value><sdl:value key="modified_on">11/17/2022 00:07:25</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">432402541</sdl:value><sdl:value key="SegmentIdentityHash">hy33BXj0Ik94Agsvlvs7Ppe4A0iNWnfrPGuyyNGq3ps=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="45ec5756-909d-4c7c-9413-f66847ed342e"><source><g id="57">Note:</g> Do not use the wand or the wand cable to move the scanner, in order to <x id="58"/><g id="61">reduce the risk of the scanner toppling over or damage to the cable.</g></source><seg-source><mrk mtype="seg" mid="31"><g id="57">Note:</g> Do not use the wand or the wand cable to move the scanner, in order to <x id="58"/><g id="61">reduce the risk of the scanner toppling over or damage to the cable.</g></mrk></seg-source><target><mrk mtype="seg" mid="31"><g id="57">Nota:</g> não use o leitor ou o cabo do leitor para deslocar o scanner, para <x id="58"/><g id="61">reduzir o risco do scanner cair ou do cabo se danificar.</g></mrk></target><sdl:seg-defs><sdl:seg id="31" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:51</sdl:value><sdl:value key="modified_on">06/12/2024 16:29:53</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">578769326</sdl:value><sdl:value key="SegmentIdentityHash">CcJjflZr1lRVDCekDaOSy9E/Ped0JBG707HswCgA1Us=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="b3bd5a12-673a-46eb-ac2e-446ccfd5a622"><source>Carrying the <x id="63"/> mobile-configuration scanner within the clinic</source><seg-source><mrk mtype="seg" mid="32">Carrying the <x id="63"/> mobile-configuration scanner within the clinic</mrk></seg-source><target><mrk mtype="seg" mid="32">Transportando o <x id="63"/> scanner de configuração móvel dentro da clínica</mrk></target><sdl:seg-defs><sdl:seg id="32" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:20</sdl:value><sdl:value key="modified_on">06/12/2024 16:29:53</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1066193809</sdl:value><sdl:value key="SegmentIdentityHash">HmUxZRCbD3McmxL676EkHdMTwhnt7wiwIpeIfP96zFc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="be8ff96e-0ad0-4532-85f5-5a841576a544"><source>The mobile-configuration scanner can be carried between rooms within the clinic as well as transported between clinics.</source><seg-source><mrk mtype="seg" mid="33">The mobile-configuration scanner can be carried between rooms within the clinic as well as transported between clinics.</mrk></seg-source><target><mrk mtype="seg" mid="33">O scanner de configuração móvel pode ser transportado entre as salas dentro da clínica ou também entre clínicas.</mrk></target><sdl:seg-defs><sdl:seg id="33" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/17/2022 00:07:32</sdl:value><sdl:value key="modified_on">11/17/2022 00:07:32</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">154617232</sdl:value><sdl:value key="SegmentIdentityHash">2J8yR1pIsFI8DLuHgxjGtJzXhuJRVPH5OjrInqWwS5o=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="5ba99e51-f9aa-45b8-bb4d-db0fae9f5652"><source>When carrying the scanner, you should always move the handle to the carrying position and wind the wand cable around the cradle.</source><seg-source><mrk mtype="seg" mid="34">When carrying the scanner, you should always move the handle to the carrying position and wind the wand cable around the cradle.</mrk></seg-source><target><mrk mtype="seg" mid="34">Ao carregar o scanner, você deve sempre mover a alça para a posição de transporte e enrolar o cabo do leitor ao redor do suporte.</mrk></target><sdl:seg-defs><sdl:seg id="34" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/04/2022 17:55:39</sdl:value><sdl:value key="modified_on">11/17/2022 00:07:34</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">318715519</sdl:value><sdl:value key="SegmentIdentityHash">qSat8diHqUUFkdTE+Je8g8Dc4+ziwFER8WI4QBOFw3Q=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="fb206a96-0c70-46f7-95eb-707334c12b8d"><source>To carry the mobile-configuration scanner within the clinic:</source><seg-source><mrk mtype="seg" mid="35">To carry the mobile-configuration scanner within the clinic:</mrk></seg-source><target><mrk mtype="seg" mid="35">Para transportar o  scanner de configuração móvel dentro da clínica:</mrk></target><sdl:seg-defs><sdl:seg id="35" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/17/2022 00:07:36</sdl:value><sdl:value key="modified_on">11/17/2022 00:07:36</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2113291890</sdl:value><sdl:value key="SegmentIdentityHash">rE/G8Kq+N61IGDD+WKJWtSWZDFajO3s72GwKtkrbLlk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2da7f4a9-d373-4fde-9ce0-15547b2d2782"><source>Ensure that the wand is firmly positioned in the cradle, with the optical window facing the cradle.</source><seg-source><mrk mtype="seg" mid="36">Ensure that the wand is firmly positioned in the cradle, with the optical window facing the cradle.</mrk></seg-source><target><mrk mtype="seg" mid="36">Certifique-se de que o leitor esteja posicionado firmemente no suporte, com a janela óptica voltada para o suporte.</mrk></target><sdl:seg-defs><sdl:seg id="36" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="L/y3Fp6yP1ZmcLasiSZc2FKwLvkguUfiA/iJbk8bgGY="/><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/19/2024 19:45:48</sdl:value><sdl:value key="modified_on">06/12/2024 16:29:53</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1407827251</sdl:value><sdl:value key="SegmentIdentityHash">L/y3Fp6yP1ZmcLasiSZc2FKwLvkguUfiA/iJbk8bgGY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="c906a316-b49e-4f2a-9f3d-2f685958c156"><source>Disconnect the power cable from the mains and then from the back of the computing unit.</source><seg-source><mrk mtype="seg" mid="37">Disconnect the power cable from the mains and then from the back of the computing unit.</mrk></seg-source><target><mrk mtype="seg" mid="37">Desconecte o cabo de alimentação da rede elétrica e, em seguida, da parte traseira da unidade de computação.</mrk></target><sdl:seg-defs><sdl:seg id="37" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="HsQLSiuii+iqQ5YYz60XZj+sDonC3OR7DpuwslHvYiQ="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/04/2022 17:56:47</sdl:value><sdl:value key="modified_on">11/17/2022 00:07:41</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">748488697</sdl:value><sdl:value key="SegmentIdentityHash">HsQLSiuii+iqQ5YYz60XZj+sDonC3OR7DpuwslHvYiQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="13"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="9bb8c440-198f-4e27-a004-72281723641a"><source>While holding the computing unit with one hand, slide the locking latch to unlock the handle and then move the handle to the carrying position.For more information, see <x id="66"/>.</source><seg-source><mrk mtype="seg" mid="38">While holding the computing unit with one hand, slide the locking latch to unlock the handle and then move the handle to the carrying position.</mrk><mrk mtype="seg" mid="39">For more information, see <x id="66"/>.</mrk></seg-source><target><mrk mtype="seg" mid="38">Segurando a unidade de computação com uma mão, deslize a trava de bloqueio para destravar a alça. Depois, mova a alça para a posição de transporte.</mrk><mrk mtype="seg" mid="39">Para mais informações, consulte <x id="66"/>.</mrk></target><sdl:seg-defs><sdl:seg id="38" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/04/2022 17:57:30</sdl:value><sdl:value key="modified_on">11/17/2022 00:07:46</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1395120922</sdl:value><sdl:value key="SegmentIdentityHash">T6f9fF/MIlm0WIK8p7m9n4a7QG0cqUSDBJFoqpW9zrQ=</sdl:value></sdl:seg><sdl:seg id="39" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="7Ohy1cOz5eX+waPmq2AF23DPmdMlIbw4Gf/7YOWfIqI="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:19</sdl:value><sdl:value key="modified_on">06/12/2024 15:49:36</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1809051878</sdl:value><sdl:value key="SegmentIdentityHash">7Ohy1cOz5eX+waPmq2AF23DPmdMlIbw4Gf/7YOWfIqI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7334b44c-9e29-458a-b94b-319c8071d178"><source>Loosely wrap the cable around the cradle for easy and safe portability.</source><seg-source><mrk mtype="seg" mid="40">Loosely wrap the cable around the cradle for easy and safe portability.</mrk></seg-source><target><mrk mtype="seg" mid="40">Enrole levemente o cabo em torno do suporte para que seja fácil e seguro de transportar.</mrk></target><sdl:seg-defs><sdl:seg id="40" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">01/05/2021 14:52:28</sdl:value><sdl:value key="modified_on">01/05/2021 14:52:28</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">621838931</sdl:value><sdl:value key="SegmentIdentityHash">a3g1n7vtxKeARHBVUULNIP9fUWHZB/02Urytlmva1jU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="568ebd52-297d-4685-868e-7c3d610eebd4"><source>Carrying the scanner between rooms within the clinic</source><seg-source><mrk mtype="seg" mid="41">Carrying the scanner between rooms within the clinic</mrk></seg-source><target><mrk mtype="seg" mid="41">Transportando o scanner entre salas dentro da clínica</mrk></target><sdl:seg-defs><sdl:seg id="41" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">01/04/2021 19:05:19</sdl:value><sdl:value key="modified_on">01/04/2021 19:05:19</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-905847380</sdl:value><sdl:value key="SegmentIdentityHash">PQpiW40jnRl1LTrgyvWQGPQvdmz6MZX5vW2t5V3sAlI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="95293dc4-7d92-4140-b19b-a64479ccfff8"><source>Transporting the <x id="69"/> mobile-configuration scanner between clinics</source><seg-source><mrk mtype="seg" mid="42">Transporting the <x id="69"/> mobile-configuration scanner between clinics</mrk></seg-source><target><mrk mtype="seg" mid="42">Transportando o <x id="69"/> scanner de configuração móvel entre clínicas</mrk></target><sdl:seg-defs><sdl:seg id="42" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:20</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:20</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1461136999</sdl:value><sdl:value key="SegmentIdentityHash">Crox1WqBodl2NxEFii1E2exAVAnw3ZfubxTdkZhSOdI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="13"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="c1ef32e8-60d6-495d-a11b-3a8c6a6af737"><source>When transporting the mobile-configuration scanner between clinics, always pack the scanner in its supplied trolley.For more <x id="78"/><g id="81">information</g>, see <x id="82"/>.</source><seg-source><mrk mtype="seg" mid="43">When transporting the mobile-configuration scanner between clinics, always pack the scanner in its supplied trolley.</mrk><mrk mtype="seg" mid="44">For more <x id="78"/><g id="81">information</g>, see <x id="82"/>.</mrk></seg-source><target><mrk mtype="seg" mid="43">Ao transportar o scanner de configuração móvel entre clínicas, sempre embale o scanner no carrinho fornecido.</mrk><mrk mtype="seg" mid="44">Para mais <x id="78"/><g id="81">informações</g>, consulte <x id="82"/>.</mrk></target><sdl:seg-defs><sdl:seg id="43" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/17/2022 00:08:14</sdl:value><sdl:value key="modified_on">11/17/2022 00:08:14</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">833819760</sdl:value><sdl:value key="SegmentIdentityHash">pVlQ2ZPVmwKRy8abP+whg6qYyJfO87Ye6++cm7jJa6I=</sdl:value></sdl:seg><sdl:seg id="44" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:19</sdl:value><sdl:value key="modified_on">06/12/2024 16:29:53</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1044441906</sdl:value><sdl:value key="SegmentIdentityHash">VMlfoQdpGhXhKHTDY4Juv
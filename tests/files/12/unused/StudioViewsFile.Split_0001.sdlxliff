are and maintenance</mrk></seg-source><target><mrk mtype="seg" mid="3">Cuidados e manutenção</mrk></target><sdl:seg-defs><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="JHNPPGgYPKvDl5GT3tF6vfr7VD15SwLkWv52dNIK8qI="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2019 18:10:17</sdl:value><sdl:value key="modified_on">05/31/2020 06:43:14</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1008236899</sdl:value><sdl:value key="SegmentIdentityHash">JHNPPGgYPKvDl5GT3tF6vfr7VD15SwLkWv52dNIK8qI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="8"/><sdl:cxt id="9"/><sdl:cxt id="10"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="8ce1db0f-d250-491b-9d35-124b4796ffe5"><source><x id="0"/><x id="3"/></source><seg-source><mrk mtype="seg" mid="4"><x id="0"/></mrk><mrk mtype="seg" mid="5"><x id="3"/></mrk></seg-source><target><mrk mtype="seg" mid="4"><x id="0"/></mrk><mrk mtype="seg" mid="5"><x id="3"/></mrk></target><sdl:seg-defs><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="11"/><sdl:cxt id="10"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="c9426d83-8648-4add-999c-a00bba91cdc9"><source>Align scanners do not require specific maintenance.During the service lifetime, support including replacement of malfunctioning main system components, or software maintenance including software upgrade<x id="12"/> to improve <x id="13"/>user’s experience might be performed, in accordance with the service contract.</source><seg-source><mrk mtype="seg" mid="6">Align scanners do not require specific maintenance.</mrk><mrk mtype="seg" mid="7">During the service lifetime, support including replacement of malfunctioning main system components, or software maintenance including software upgrade<x id="12"/> to improve <x id="13"/>user’s experience might be performed, in accordance with the service contract.</mrk></seg-source><target><mrk mtype="seg" mid="6">Os scanners da Align não requerem manutenção específica.</mrk><mrk mtype="seg" mid="7">Durante a vida útil do serviço, poderá ser realizado o suporte, incluindo a substituição de componentes principais do sistema com defeito, ou a manutenção de software, incluindo atualização de software<x id="12"/> para melhorar <x id="13"/>a experiência do usuário, de acordo com o contrato de serviço.</mrk></target><sdl:seg-defs><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 18:49:08</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-907657951</sdl:value><sdl:value key="SegmentIdentityHash">Qh0N8Z99eDiKMYHU59VM7vFXGgQNRoMicLl4lXxPYyw=</sdl:value></sdl:seg><sdl:seg id="7" conf="ApprovedTranslation" origin="interactive"><sdl:prev-origin origin="source"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="96"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">hCTzP6BmV4vh3uY3brQBOtarnac3Xe8MyCPbti9LrJQ=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 15:46:18</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">hCTzP6BmV4vh3uY3brQBOtarnac3Xe8MyCPbti9LrJQ=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/29/2024 04:02:23</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">hCTzP6BmV4vh3uY3brQBOtarnac3Xe8MyCPbti9LrJQ=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:22:57</sdl:value><sdl:value key="created_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="created_on">08/29/2024 04:02:26</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1159664454</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="13"/><sdl:cxt id="10"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="eee99d2d-2b9e-431d-80cb-3544f622a9ef"><source><x id="16"/><x id="19"/></source><seg-source><mrk mtype="seg" mid="8"><x id="16"/></mrk><mrk mtype="seg" mid="9"><x id="19"/></mrk></seg-source><target><mrk mtype="seg" mid="8"><x id="16"/></mrk><mrk mtype="seg" mid="9"><x id="19"/></mrk></target><sdl:seg-defs><sdl:seg id="8" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="9" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="14"/><sdl:cxt id="10"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="98f0ece8-04b4-4068-b9ce-03479932c1e8"><source>Before cleaning and disinfecting the scanner, read and understand the <g id="27">Cleaning and Disinfection</g> section in the<x id="28"/>.</source><seg-source><mrk mtype="seg" mid="10">Before cleaning and disinfecting the scanner, read and understand the <g id="27">Cleaning and Disinfection</g> section in the<x id="28"/>.</mrk></seg-source><target><mrk mtype="seg" mid="10">Antes da limpeza e desinfecção do scanner, leia e compreenda a seção <g id="27">Limpeza e Desinfecção</g> nas<x id="28"/>.</mrk></target><sdl:seg-defs><sdl:seg id="10" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 10:38:06</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">340980870</sdl:value><sdl:value key="SegmentIdentityHash">3MWcgxffbZ656rV0mwY7JMVYnZHApL3X8hX/My8uAPs=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="15"/><sdl:cxt id="16"/><sdl:cxt id="17"/><sdl:cxt id="10"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="d0e70ca2-db2b-4524-9dd7-77c9e76a59f2"><source><g id="35">Note for users in Australia:</g> This document refers to Caviwipes1 and their designated contact time of one (1) minute as the default instruction for the cleaning and disinfection procedure.For a list of alternative active ingredients approved in Australia, see <x id="37"/>.When following the cleaning and disinfection procedure detailed in this manual, please refer to the manufacturers&apos; instructions and specified contact time for the selected disinfecting wipes.</source><seg-source><mrk mtype="seg" mid="11"><g id="35">Note for users in Australia:</g> This document refers to Caviwipes1 and their designated contact time of one (1) minute as the default instruction for the cleaning and disinfection procedure.</mrk><mrk mtype="seg" mid="12">For a list of alternative active ingredients approved in Australia, see <x id="37"/>.</mrk><mrk mtype="seg" mid="13">When following the cleaning and disinfection procedure detailed in this manual, please refer to the manufacturers&apos; instructions and specified contact time for the selected disinfecting wipes.</mrk></seg-source><target><mrk mtype="seg" mid="11"><g id="35">Nota para usuários na Austrália:</g> este documento se refere ao Caviwipes1 e ao seu tempo de contato designado de um (1) minuto como instrução padrão para o procedimento de limpeza e desinfecção.</mrk><mrk mtype="seg" mid="12">Para obter uma lista de ingredientes ativos alternativos aprovados na Austrália, consulte <x id="37"/>.</mrk><mrk mtype="seg" mid="13">Ao seguir o procedimento de limpeza e desinfecção detalhado neste manual, consulte as instruções do fabricante e o tempo de contato especificado para os lenços desinfetantes selecionados.</mrk></target><sdl:seg-defs><sdl:seg id="11" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 18:55:06</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2026470531</sdl:value><sdl:value key="SegmentIdentityHash">4U+ch44NHLvYLOdD2zZzHj4EQ1QCkb/rjPEzfhrFkus=</sdl:value></sdl:seg><sdl:seg id="12" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 18:57:36</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">633628130</sdl:value><sdl:value key="SegmentIdentityHash">+zlS1gmmjxzqAZFaNbNceXe6qNra7yrnVZqOiPHOliw=</sdl:value></sdl:seg><sdl:seg id="13" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 18:58:34</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1007442066</sdl:value><sdl:value key="SegmentIdentityHash">pAmpDwpudDOdkGEMPNVvUbXfyzq7d4y3lglmnXlqNtI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="10"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="b7659341-da7a-47c4-b68a-231810546d13"><source>If you are performing any sanitation procedures in the office that involve fogging or spraying, make sure that the iTero scanner is not in the room.</source><seg-source><mrk mtype="seg" mid="14">If you are performing any sanitation procedures in the office that involve fogging or spraying, make sure that the iTero scanner is not in the room.</mrk></seg-source><target><mrk mtype="seg" mid="14">Se estiver realizando quaisquer procedimentos de limpeza que envolvam vaporização ou pulverização no consultório, certifique-se de que o scanner iTero não esteja no ambiente.</mrk></target><sdl:seg-defs><sdl:seg id="14" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/13/2020 07:49:43</sdl:value><sdl:value key="modified_on">10/22/2020 02:44:57</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-560700376</sdl:value><sdl:value key="SegmentIdentityHash">4M3fj4zpaSXEsLkp+8LCPy9iRANheiYhgMqCqeZ4Lk8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="14"/><sdl:cxt id="10"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="3445d332-2769-4889-920f-8030320c9685"><source><g id="46">Note:</g> Refer to the disinfecting agent manufacturer&apos;s user manuals and data sheets for additional information and instructions for use.</source><seg-source><mrk mtype="seg" mid="15"><g id="46">Note:</g> Refer to the disinfecting agent manufacturer&apos;s user manuals and data sheets for additional information and instructions for use.</mrk></seg-source><target><mrk mtype="seg" mid="15"><g id="46">Note:</g> consulte os manuais do usuário e as folhas de dados do fabricante do agente desinfetante para obter informações adicionais e instruções de uso.</mrk></target><sdl:seg-defs><sdl:seg id="15" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:50</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-82258053</sdl:value><sdl:value key="SegmentIdentityHash">JDi93KAywUbn+nuKvmqMER9Ej/1474a1HNXZwB3paAY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="10"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="aa3a11bc-2670-4ee8-ae5a-1459cc56824c"><source>To <x id="53"/><g id="56">reduce the risk of</g> cross-contamination, it is mandatory to:</source><seg-source><mrk mtype="seg" mid="16">To <x id="53"/><g id="56">reduce the risk of</g> cross-contamination, it is mandatory to:</mrk></seg-source><target><mrk mtype="seg" mid="16">Para <x id="53"/><g id="56">reduzir o risco de</g> contaminação cruzada, é obrigatório:</mrk></target><sdl:seg-defs><sdl:seg id="16" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 10:41:40</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1898055051</sdl:value><sdl:value key="SegmentIdentityHash">7LZRHCSb79yOOPGN5gKckzyMSSyKsLH0p+YFx4sSiek=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="18"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="ddad49aa-40b3-4cec-9984-4a8244908b23"><source><x id="63"/> <g id="66">Thoroughly clean and disinfect the wand, cradle, and other system components</g>, as described in the following sections.</source><seg-source><mrk mtype="seg" mid="17"><x id="63"/> <g id="66">Thoroughly clean and disinfect the wand, cradle, and other system components</g>, as described in the following sections.</mrk></seg-source><target><mrk mtype="seg" mid="17"><x id="63"/> <g id="66">Limpar e desinfetar completamente o leitor, o suporte e outros componentes do sistema</g>, conforme descrito nas seções a seguir.</mrk></target><sdl:seg-defs><sdl:seg id="17" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 10:43:18</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1643249721</sdl:value><sdl:value key="SegmentIdentityHash">nwoFxmy/TrBh/DlQRRk8ioVOMRlCBfJxWpovU1l9CUg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="19"/><sdl:cxt id="10"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="ebb992b5-9d6f-4a88-90c6-8563de36aa7b"><source>Replace the <x id="69"/> before each patient session, as described in <x id="70"/>.</source><seg-source><mrk mtype="seg" mid="18">Replace the <x id="69"/> before each patient session, as described in <x id="70"/>.</mrk></seg-source><target><mrk mtype="seg" mid="18"/></target><sdl:seg-defs><sdl:seg id="18" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">m/B5FETBiOfNvTq5yo7BKhjK58wnGbvw5Xxz2p20Jrc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="20"/><sdl:cxt id="10"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="1fa50cc8-3852-4703-99e2-2d797adccccc"><source>Attach a new sleeve before each patient session, as described in <x id="73"/>.</source><seg-source><mrk mtype="seg" mid="19">Attach a new sleeve before each patient session, as described in <x id="73"/>.</mrk></seg-source><target><mrk mtype="seg" mid="19">Colocar uma nova ponteira antes de cada sessão com o paciente, conforme descrito em <x id="73"/>.</mrk></target><sdl:seg-defs><sdl:seg id="19" conf="ApprovedTranslation" origin="interactive" percent="93"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="93"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">Dk7jHfsXg2z6lzNxSXypzxtMQMPs+2Kq2V5Uq5F0wFA=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 15:46:49</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">Dk7jHfsXg2z6lzNxSXypzxtMQMPs+2Kq2V5Uq5F0wFA=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:23:26</sdl:value><sdl:value key="SDL:ProjectTranslationHash">748816478</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="21"/><sdl:cxt id="18"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="6054c2ff-7ef7-4a81-bbd7-d353025320f0"><source>Dispose of <x id="75"/> according to standard operating procedures or local regulations for the disposal of contaminated medical waste.</source><seg-source><mrk mtype="seg" mid="20">Dispose of <x id="75"/> according to standard operating procedures or local regulations for the disposal of contaminated medical waste.</mrk></seg-source><target><mrk mtype="seg" mid="20"/></target><sdl:seg-defs><sdl:seg id="20" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">QWrtiyMWBHFdcgUsqzxAKYssZQmka8BKzdSKR345uEo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="22"/><sdl:cxt id="18"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="85e91ace-32c6-4993-9e4e-564cef13a1a9"><source>Dispose of the sleeve after each patient and in accordance with standard operating procedures or local regulations for the disposal of contaminated medical waste.</source><seg-source><mrk mtype="seg" mid="21">Dispose of the sleeve after each patient and in accordance with standard operating procedures or local regulations for the disposal of contaminated medical waste.</mrk></seg-source><target><mrk mtype="seg" mid="21">Descartar a ponteira após cada paciente e de acordo com os procedimentos operacionais padrão ou com as regulamentações locais para remoção de lixo hospitalar contaminado.</mrk></target><sdl:seg-defs><sdl:seg id="21" conf="ApprovedTranslation" origin="interactive" percent="97"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="97"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">yWUWxgh+4IJySp9uCqs3TlFp3eo62Q0IUmg1rZE9HKI=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 15:47:05</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">yWUWxgh+4IJySp9uCqs3TlFp3eo62Q0IUmg1rZE9HKI=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:23:36</sdl:value><sdl:value key="SDL:ProjectTranslationHash">2025695656</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="14"/><sdl:cxt id="18"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="e458b155-aa93-495a-b84e-1a7d9adbae0e"><source>Wear gloves when using the touch-screen.</source><seg-source><mrk mtype="seg" mid="22">Wear gloves when using the touch-screen.</mrk></seg-source><target><mrk mtype="seg" mid="22">Usar luvas ao manusear a tela tátil.</mrk></target><sdl:seg-defs><sdl:seg id="22" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:50</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1394171015</sdl:value><sdl:value key="SegmentIdentityHash">tl8OcuWj5a7QOzyiLiGpGcwKGz3Yg3M3Jy5UXJ3J07M=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="18"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="6f4383c3-8b30-478a-b0b6-cdd33ff83729"><source>Remove and replace gloves after each patient procedure.</source><seg-source><mrk mtype="seg" mid="23">Remove and replace gloves after each patient procedure.</mrk></seg-source><target><mrk mtype="seg" mid="23">Remover e substituir as luvas após cada procedimento no paciente.</mrk></target><sdl:seg-defs><sdl:seg id="23" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/28/2020 10:44:21</sdl:value><sdl:value key="modified_on">10/22/2020 02:46:44</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1564607251</sdl:value><sdl:value key="SegmentIdentityHash">YRTdI/E3zLD2b3gn7OnFKfjOKOM97jPU6OVc4EVlJAg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="18"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="2d115f09-f703-4205-9c25-00a6b94224ef"><source>Discard torn, contaminated, or used gloves.</source><seg-source><mrk mtype="seg" mid="24">Discard torn, contaminated, or used gloves.</mrk></seg-source><target><mrk mtype="seg" mid="24">Descartar as luvas rasgadas, contaminadas ou usadas.</mrk></target><sdl:seg-defs><sdl:seg id="24" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/07/2022 14:31:43</sdl:value><sdl:value key="modified_on">11/17/2022 01:25:42</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1736132675</sdl:value><sdl:value key="SegmentIdentityHash">ANP2Du6EZyHBlvpY0dCPYeMYZz2d1WEWcA9zeZ2UWWE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group></body></file><file original="C:\Data\My Documents\Studio 2011\Projects\222818 Rev.3 LuminaPro-pt-BR\en-US\222818 Rev.3 LuminaPro-pt-BR_1\Content\11. Care and maintenance\A1_Handling the wand and cable_combined.htm.xlf" datatype="x-sdlfilterframework2" source-language="en-us" target-language="pt-br"><header><reference><internal-file form="base64">UEsDBBQAAAAIACU0GVkevB25/gUAAIEwAAAQAAAAdTNwbno0Zmguc29xLnhsZu1b3W7bNhS+L9B3

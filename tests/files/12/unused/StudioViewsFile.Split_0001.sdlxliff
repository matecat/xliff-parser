ey="SegmentIdentityHash">YrtsEgP/MotauDI/QwdnKxzoiJukfZyCYHfQkoMicx4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="10"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="bef2cf3e-cbcb-452a-818d-3d6799294a45"><source>Ensure that the wand is firmly positioned in the cradle, with the optical window facing the cradle.</source><seg-source><mrk mtype="seg" mid="9">Ensure that the wand is firmly positioned in the cradle, with the optical window facing the cradle.</mrk></seg-source><target><mrk mtype="seg" mid="9"/></target><sdl:seg-defs><sdl:seg id="9" locked="true" conf="Draft"><sdl:rep id="L/y3Fp6yP1ZmcLasiSZc2FKwLvkguUfiA/iJbk8bgGY="/><sdl:value key="SegmentIdentityHash">L/y3Fp6yP1ZmcLasiSZc2FKwLvkguUfiA/iJbk8bgGY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2dd51489-7d59-4cd8-9f56-b975a901a370"><source>Press and release the power button at the bottom of the touch screen to shut down the system.</source><seg-source><mrk mtype="seg" mid="10">Press and release the power button at the bottom of the touch screen to shut down the system.</mrk></seg-source><target><mrk mtype="seg" mid="10"/></target><sdl:seg-defs><sdl:seg id="10" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">mMzeAi5D7L9pwE2+PnAWoe9ZzuuRBTlUx19RgA7w0t8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="10"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="6831fd4a-8731-493d-a71a-c4aa2402ca6e"><source>Unplug the system from the wall outlet.</source><seg-source><mrk mtype="seg" mid="11">Unplug the system from the wall outlet.</mrk></seg-source><target><mrk mtype="seg" mid="11"/></target><sdl:seg-defs><sdl:seg id="11" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">u4RGE3q
ate in which the user and patient are established.</mrk></seg-source><target><mrk mtype="seg" mid="413">Quaisquer incidentes graves relacionados com o dispositivo iTero devem ser relatados à Align Technology Ltd. e à autoridade competente do país onde o usuário e o paciente estão estabelecidos.</mrk></target><sdl:seg-defs><sdl:seg id="413" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2022 11:07:58</sdl:value><sdl:value key="modified_on">12/06/2022 11:07:58</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1429283167</sdl:value><sdl:value key="SegmentIdentityHash">go9Zo56wuDotDpQgjwwwLhC2fN2L+zXAIqsOkSF+QC8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="108"/><sdl:cxt id="49"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="8fcc4bcf-d48a-4eee-bca0-14ee373c0e21"><source><g id="878">Warning:</g> The iTero Lumina sleeves are intended for single use only.Do not reuse.</source><seg-source><mrk mtype="seg" mid="414"><g id="878">Warning:</g> The iTero Lumina sleeves are intended for single use only.</mrk><mrk mtype="seg" mid="415">Do not reuse.</mrk></seg-source><target><mrk mtype="seg" mid="414"><g id="878">Aviso:</g> as ponteiras do Tero Lumina destinam-se ao uso único.</mrk><mrk mtype="seg" mid="415">Não as reutilize.</mrk></target><sdl:seg-defs><sdl:seg id="414" conf="ApprovedTranslation" origin="interactive" percent="77"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="77"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">cwESu7WxjBmZ567JTsQ+93ZjUtjtkU80811Wpj+aBBw=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 15:41:53</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">cwESu7WxjBmZ567JTsQ+93ZjUtjtkU80811Wpj+aBBw=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:45:44</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1097482129</sdl:value></sdl:seg><sdl:seg id="415" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="mnGMnYGMoXjFv9nrjXgdPCdMun8Fx17AEm6FmXE2yqE="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:05</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-657901251</sdl:value><sdl:value key="SegmentIdentityHash">mnGMnYGMoXjFv9nrjXgdPCdMun8Fx17AEm6FmXE2yqE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="108"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e9ed413b-45a5-413c-9301-43c11c7cb622"><source><g id="887">Warning:</g> The iTero Lumina sleeves are intended for single use and must be disposed of and replaced after each patient in order to reduce the risk of cross-contamination.</source><seg-source><mrk mtype="seg" mid="416"><g id="887">Warning:</g> The iTero Lumina sleeves are intended for single use and must be disposed of and replaced after each patient in order to reduce the risk of cross-contamination.</mrk></seg-source><target><mrk mtype="seg" mid="416"><g id="887">Aviso:</g> as ponteiras do Tero Lumina destinam-se ao uso único e devem ser descartadas e substituídas depois do uso em cada paciente para reduzir o risco de contaminação cruzada.</mrk></target><sdl:seg-defs><sdl:seg id="416" conf="ApprovedTranslation" origin="interactive" percent="92"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="92"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">5HWUv5tLyqFVlXsDOScLvwGld1wr5MNFOywbPxLz7f0=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 15:42:14</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">5HWUv5tLyqFVlXsDOScLvwGld1wr5MNFOywbPxLz7f0=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:45:58</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-197935811</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="108"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="65c47a51-5f06-4736-b0ff-ff4dcb38ef12"><source><g id="896">Warning:</g> To reduce the risk of cross-contamination, it is essential that the <x id="897"/> scanner is fully cleaned and disinfected immediately after each patient, and that the iTero Lumina sleeve is replaced between patients, as described in <x id="898"/>.</source><seg-source><mrk mtype="seg" mid="417"><g id="896">Warning:</g> To reduce the risk of cross-contamination, it is essential that the <x id="897"/> scanner is fully cleaned and disinfected immediately after each patient, and that the iTero Lumina sleeve is replaced between patients, as described in <x id="898"/>.</mrk></seg-source><target><mrk mtype="seg" mid="417"><g id="896">Aviso:</g> para reduzir o risco de contaminação cruzada, é essencial que o scanner<x id="897"/> seja totalmente limpo e desinfetado imediatamente após cada paciente e que a ponteira do iTero Lumina seja substituída entre um paciente e outro, conforme descrito em <x id="898"/>.</mrk></target><sdl:seg-defs><sdl:seg id="417" conf="ApprovedTranslation" origin="interactive" percent="93"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="93"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">nhn5CEUOAIWSXd62lCNtFRsyLEAHZVDITnUC8rwQI8o=</sdl:va
rk</value><value key="hasDisplayText">False</value><value key="attribute:mtype">seg</value><value key="attribute:mid">1</value></props></cxt-def><cxt-def id="3" type="x-xhtml-madcap:keyword-term" code="RT" name="x-xhtml-madcap:keyword-term" descr="Custom Resource type"/><cxt-def id="4" type="Translation unit" code="TU" name="Translation unit" descr="Transunit element"/><cxt-def id="5" type="Wi Fi tips.htm" code="FL" name="Wi Fi tips.htm" descr="File element in the XLIFF Document"/><cxt-def id="6" type="x-xml-h2" code="RT" name="x-xml-h2" descr="Custom Resource type"/><cxt-def id="7" type="segment" purpose="Location"><props><value key="segmentIdentifier">3</value><value key="prefix"></value><value key="localName">mrk</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">mrk</value><value key="hasDisplayText">False</value><value key="attribute:mtype">seg</value><value key="attribute:mid">3</value></props></cxt-def><cxt-def id="8" type="segment" purpose="Location"><props><value key="segmentIdentifier">5</value><value key="prefix"></value><value key="localName">mrk</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">mrk</value><value key="hasDisplayText">False</value><value key="attribute:mtype">seg</value><value key="attribute:mid">5</value></props></cxt-def><cxt-def id="9" type="x-xml-p" code="RT" name="x-xml-p" descr="Custom Resource type"/><cxt-def id="10" type="segment" purpose="Location"><props><value key="segmentIdentifier">7</value><value key="prefix"></value><value key="localName">mrk</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">mrk</value><value key="hasDisplayText">False</value><value key="attribute:mtype">seg</value><value key="attribute:mid">7</value></props></cxt-def></cxt-defs></header><body><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="3866ebb7-562e-4ec1-9769-429126b51d24"><source>LAN network guidelines:Wi-Fi tips</source><seg-source><mrk mtype="seg" mid="1">LAN network guidelines:Wi-Fi tips</mrk></seg-source><target><mrk mtype="seg" mid="1"/></target><sdl:seg-defs><sdl:seg id="1" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">EMaWbgUwWvwmcCxQTnnfnGglGHVxoG1gxlb7CVlQOS8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="5418dd73-ea30-4941-bff8-c29f9dfa96d8"><source>Wi-Fi tips</source><seg-source><mrk mtype="seg" mid="2">Wi-Fi tips</mrk></seg-source><target><mrk mtype="seg" mid="2"/></target><sdl:seg-defs><sdl:seg id="2" locked="true" conf="Draft"><sdl:rep id="sZTfr8Qmen6Uu9caQv5qwZhyLB83p8BMIpgeZMofhYQ="/><sdl:value key="SegmentIdentityHash">sZTfr8Qmen6Uu9caQv5qwZhyLB83p8BMIpgeZMofhYQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="b35c3ada-61de-4705-8168-853bfed02cdb"><source>Wi-Fi tips</source><seg-source><mrk mtype="seg" mid="3">Wi-Fi tips</mrk></seg-source><target><mrk mtype="seg" mid="3">Dicas de Wi-Fi</mrk></target><sdl:seg-defs><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="sZTfr8Qmen6Uu9caQv5qwZhyLB83p8BMIpgeZMofhYQ="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/21/2019 01:24:32</sdl:value><sdl:value key="modified_on">06/12/2024 13:58:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1732705579</sdl:value><sdl:value key="SegmentIdentityHash">sZTfr8Qmen6Uu9caQv5qwZhyLB83p8BMIpgeZMofhYQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="8"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="b3c5cffd-ffde-4c08-b2cc-1c6a2f3784bf"><source>Wi-Fi routers allow you to access the internet system using a Wi-Fi connection from essentially any place within the functional range of the wireless network.Nevertheless, the number, depth, and position of walls, ceilings, or additional partitions that the wireless signals must travel through may limit the range and strength of the signal.Normal signals vary, depending on the material types and background RF (radio frequency) noise in your home or business.</source><seg-source><mrk mtype="seg" mid="4">Wi-Fi routers allow you to access the internet system using a Wi-Fi connection from essentially any place within the functional range of the wireless network.</mrk><mrk mtype="seg" mid="5">Nevertheless, the number, depth, and position of walls, ceilings, or additional partitions that the wireless signals must travel through may limit the range and strength of the signal.</mrk><mrk mtype="seg" mid="6">Normal signals vary, depending on the material types and background RF (radio frequency) noise in your home or business.</mrk></seg-source><target><mrk mtype="seg" mid="4">Os roteadores Wi-Fi permitem que você acesse o sistema de internet, usando uma conexão Wi-Fi de praticamente qualquer lugar dentro da faixa funcional da rede sem fio.</mrk><mrk mtype="seg" mid="5">No entanto, o alcance e a intensidade do sinal podem ser limitados pelo número, a profundidade e a posição das paredes, tetos ou de partições adicionais pelos quais os sinais sem fio devem passar.</mrk><mrk mtype="seg" mid="6">Os sinais normais variam dependendo dos tipos de material e do ruído de fundo RF (radiofrequência) no local de atendimento ou em seu consultório.</mrk></target><sdl:seg-defs><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/02/2020 11:33:21</sdl:value><sdl:value key="modified_on">10/21/2020 20:08:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">25265262</sdl:value><sdl:value key="SegmentIdentityHash">cn4PL2kiMnT1RsUPGQq82FeR5tmAeh+YtP9HD2MPnPY=</sdl:value></sdl:seg><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/30/2020 22:08:13</sdl:value><sdl:value key="modified_on">05/30/2020 22:08:13</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2034694198</sdl:value><sdl:value key="SegmentIdentityHash">o8e/boSatoGL8xZdP8W+T2kTYhqSYKQunL3Q6O1x5hU=</sdl:value></sdl:seg><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/11/2019 09:34:17</sdl:value><sdl:value key="modified_on">10/22/2020 04:39:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1788579226</sdl:value><sdl:value key="SegmentIdentityHash">T73/rfxATq9xxje6/R31UrXkpppCgKnzwOOFFUYhzWg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="9290634b-2998-4c1c-b8f4-dff8cddf9639"><source>Be sure to have a minimal number of walls and ceilings between the router and other network devices.Each barrier can reduce the adapter’s range by 1-3 meters (3-9 feet).</source><seg-source><mrk mtype="seg" mid="7">Be sure to have a minimal number of walls and ceilings between the router and other network devices.</mrk><mrk mtype="seg" mid="8">Each barrier can reduce the adapter’s range by 1-3 meters (3-9 feet).</mrk></seg-source><target><mrk mtype="seg" mid="7">Certifique-se de ter o mínimo número de paredes e tetos entre o roteador e outros dispositivos de rede.</mrk><mrk mtype="seg" mid="8">Cada barreira pode reduzir o alcance do adaptador em 1-3 metros (3-9 pés).</mrk></target><sdl:seg-defs><sdl:seg id="7" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/11/2019 09:34:18</sdl:value><sdl:value key="modified_on">12/23/2019 02:53:41</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1149341190</sdl:value><sdl:value key="SegmentIdentityHash">qLQPs2xjQ1zOvSwQbppOlmk1gsz5NFwNKx87z3aDcKI=</sdl:value></sdl:seg><sdl:seg id="8" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/02/2020 11:33:51</sdl:value><sdl:value key="modified_on">10/21/2020 20:10:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1934023624</sdl:value><sdl:value key="SegmentIdentityHash">n7aVIcIaxyf+lS1vuHvV4oIr5eb/raNQm643dbBJJv4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="8"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="377fb056-e932-4dd3-823f-b694bed1e0a6"><source>Be sure to have a straight line, free of any partition, between network devices.Even a wall that seems rather thin can block a signal of 1 meter (3 feet) if the wall angle is shifted by only 2 degrees.To achieve the best reception, place all the devices so that the Wi-Fi signal travels straight through a wall or partition (instead of at an angle).</source><seg-source><mrk mtype="seg" mid="9">Be sure to have a straight line, free of any partition, between network devices.</mrk><mrk mtype="seg" mid="10">Even a wall that seems rather thin can block a signal of 1 meter (3 feet) if the wall angle is shifted by only 2 degrees.</mrk><mrk mtype="seg" mid="11">To achieve the best reception, place all the devices so that the Wi-Fi signal travels straight through a wall or partition (instead of at an angle).</mrk></seg-source><target><mrk mtype="seg" mid="9">Certifique-se de que há uma linha reta, livre de qualquer divisão, entre os dispositivos de rede.</mrk><mrk mtype="seg" mid="10">Até mesmo uma parede que parece ser bem fina pode bloquear um sinal de 1 metro (3 pés), se o ângulo da mesma estiver deslocado em apenas 2 graus.</mrk><mrk mtype="seg" mid="11">Para obter a melhor recepção, posicione todos os equipamentos de modo que o sinal Wi-Fi passe diretamente por uma parede ou divisória (em vez de estar em ângulo).</mrk></target><sdl:seg-defs><sdl:seg id="9" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/02/2020 11:33:57</sdl:value><sdl:value key="modified_on">10/21/2020 20:10:45</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-441956620</sdl:value><sdl:value key="SegmentIdentityHash">DVsr6/hqrL03cDn+CN53ngZAPvqoYEjzc6Z9sjBlcdg=</sdl:value></sdl:seg><sdl:seg id="10" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/30/2020 22:09:30</sdl:value><sdl:value key="modified_on">05/30/2020 22:09:30</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1595897590</sdl:value><sdl:value key="SegmentIdentityHash">ggfxYFbrfvrwdHMrCvqX93X/mKZxbhmneiJVLkxgRew=</sdl:value></sdl:seg><sdl:seg id="11" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/26/2020 08:23:39</sdl:value><sdl:value key="modified_on">05/31/2020 18:39:38</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">14120504</sdl:value><sdl:value key="SegmentIdentityHash">59VTGjIc8End2dGSz3iruIw4O0Ui4lAIl1Ha5MS1e1s=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="8"/><sdl:cxt id="10"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="64a084b0-27d5-4006-b1bd-0eb177f14b5f"><source>Construction materials make a difference.A solid metal door, or aluminum nails, can be very dense and may have an adverse effect on a Wi-Fi signal.Try to position access points, wireless routers, and computers so that the signal travels through drywalls or open doorways.Materials and objects such as glass, steel, metal, walls with insulation, water tanks (aquariums), mirrors, file cabinets, brick, and concrete may reduce the wireless signal.</source><seg-source><mrk mtype="seg" mid="12">Construction materials make a difference.</mrk><mrk mtype="seg" mid="13">A solid metal door, or aluminum nails, can be very dense and may have an adverse effect on a Wi-Fi signal.</mrk><mrk mtype="seg" mid="14">Try to position access points, wireless routers, and computers so that the signal travels through drywalls or open doorways.</mrk><mrk mtype="seg" mid="15">Materials and objects such as glass, steel, metal, walls with insulation, water tanks (aquariums), mirrors, file cabinets, brick, and concrete may reduce the wireless signal.</mrk></seg-source><target><mrk mtype="seg" mid="12">Os materiais de construção fazem a diferença.</mrk><mrk mtype="seg" mid="13">As portas de metal sólido ou os pregos de alumínio podem ser muito densos e podem ter um efeito adverso no sinal Wi-Fi.</mrk><mrk mtype="seg" mid="14">Tente posicionar os pontos de acesso, roteadores sem fio e computadores para que o sinal passe através de paredes de gesso ou de portas abertas.</mrk><mrk mtype="seg" mid="15">Materiais e objetos, tais como vidro, aço, metal, paredes com isolamento, tanques de água (aquários), espelhos, fichários, tijolos e concreto, podem reduzir o sinal sem fio.</mrk></target><sdl:seg-defs><sdl:seg id="12" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/11/2019 09:34:54</sdl:value><sdl:value key="modified_on">12/23/2019 02:54:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2110045048</sdl:value><sdl:value key="SegmentIdentityHash">D0uX2dQYNrqtVLc3JP0WmKbJQ1huN6XzI7CLArQhb1Y=</sdl:value></sdl:seg><sdl:seg id="13" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/30/2020 22:10:21</sdl:value><sdl:value key="modified_on">05/30/2020 22:10:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-526571038</sdl:value><sdl:value key="SegmentIdentityHash">uoO9+Fy6sQKuwC8agXzB00zANFfnIqUrMXnR0ATrDfo=</sdl:value></sdl:seg><sdl:seg id="14" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/02/2020 11:34:24</sdl:value><sdl:value key="modified_on">10/21/2020 20:11:34</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1756089798</sdl:value><sdl:value key="SegmentIdentityHash">pajNFMtx/1NeWyKQvvt3RTOfwqvxHlDOjzNao4N6kUE=</sdl:value></sdl:seg><sdl:seg id="15" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/02/2020 11:34:34</sdl:value><sdl:value key="modified_on">10/21/2020 20:11:43</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">919680934</sdl:value><sdl:value key="SegmentIdentityHash">7d4PBx9OmS3x4NNcDZJKNQGUqfMGpT5I1wNyK3Gcs58=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d35f836e-6876-4c6f-8268-5e973e222389"><source>Keep the scanner away (at least 3-6 feet or 1-2 meters) from electrical devices or appliances that generate RF noise.</source><seg-source><mrk mtype="seg" mid="16">Keep the scanner away (at least 3-6 feet or 1-2 meters) from electrical devices or appliances that generate RF noise.</mrk></seg-source><target><mrk mtype="seg" mid="16">Mantenha o scanner afastado (a pelo menos 3-6 pés ou 1-2 metros) de equipamentos elétricos ou de aparelhos que geram ruído de RF.</mrk></target><sdl:seg-defs><sdl:seg id="16" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/02/2020 11:35:09</sdl:value><sdl:value key="modified_on">10/21/2020 20:11:49</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-741714266</sdl:value><sdl:value key="SegmentIdentityHash">EXC147R+cWVSrVg2B9qvUaiPE869CzqqN6wHO56EdiY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="8"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="52ece942-57ee-4c38-a5d2-e65d21662627"><source>If you are using 2.4GHz cordless phones or X-10 (wireless products such as ceiling fans, remote lights, and home security systems), the wireless connection may be severely degraded or entirely drop.The base of many wireless devices transmits an RF signal, even if the device is not in use.Position any other wireless devices as far as possible from the scanner and router.</source><seg-source><mrk mtype="seg" mid="17">If you are using 2.4GHz cordless phones or X-10 (wireless products such as ceiling fans, remote lights, and home security systems), the wireless connection may be severely degraded or entirely drop.</mrk><mrk mtype="seg" mid="18">The base of many wireless devices transmits an RF signal, even if the device is not in use.</mrk><mrk mtype="seg" mid="19">Position any other wireless devices as far as possible from the scanner and router.</mrk></seg-source><target><mrk mtype="seg" mid="17">Se você estiver usando telefones sem fio de 2,4 GHz ou produtos X-10 sem fio (tais como ventiladores de teto, acionamento remoto de luzes e sistemas de segurança doméstica), a conexão sem fio poderá baixar muito ou cair totalmente.</mrk><mrk mtype="seg" mid="18">A base de muitos dispositivos sem fio transmite um sinal de RF, mesmo se o dispositivo não estiver em uso.</mrk><mrk mtype="seg" mid="19">Posicione outros dispositivos sem fio o mais longe possível do scanner e do roteador.</mrk></target><sdl:seg-defs><sdl:seg id="17" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/02/2020 11:36:01</sdl:value><sdl:value key="modified_on">10/21/2020 20:11:56</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1021870039</sdl:value><sdl:value key="SegmentIdentityHash">wQRvopAzJj8MlpPKC0ryp53XfnTNxU70TWEgwSSI9Is=</sdl:value></sdl:seg><sdl:seg id="18" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/30/2020 22:15:41</sdl:value><sdl:value key="modified_on">05/30/2020 22:15:41</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-307494433</sdl:value><sdl:value key="SegmentIdentityHash">IY+k5wGtXin/hH9Yp3dX3N5yUETSdcOPVTYqYhSY1mc=</sdl:value></sdl:seg><sdl:seg id="19" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/02/2020 11:36:34</sdl:value><sdl:value key="modified_on">10/21/2020 20:13:20</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">74356447</sdl:value><sdl:value key="SegmentIdentityHash">L++jhXNS2S9qX1nbwfzrEDVkp0tFrKcN+Yo0ZbR7/T0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="8"/><sdl:cxt id="10"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="05da1b5c-cd21-4c55-a407-6886165bde8f"><source>In your area, there may be more than one active wireless network.Each network uses one or more channels.If the channel is near your system channels, the communication may gradually decline.Ask your IT department to check this, and if required, change the channel numbers used by your network.</source><seg-source><mrk mtype="seg" mid="20">In your area, there may be more than one active wireless network.</mrk><mrk mtype="seg" mid="21">Each network uses one or more channels.</mrk><mrk mtype="seg" mid="22">If the channel is near your system channels, the communication may gradually decline.</mrk><mrk mtype="seg" mid="23">Ask your IT department to check this, and if required, change the channel numbers used by your network.</mrk></seg-source><target><mrk mtype="seg" mid="20">Em sua área, pode haver mais de uma rede sem fio ativa.</mrk><mrk mtype="seg" mid="21">Cada rede usa um ou mais canais.</mrk><mrk mtype="seg" mid="22">Se o canal estiver perto dos canais de seu sistema, a comunicação pode diminuir gradualmente.</mrk><mrk mtype="seg" mid="23">Peça ao seu departamento de TI para verificar isso e, se necessário, altere o número de canais usados pela sua rede.</mrk></target><sdl:seg-defs><sdl:seg id="20" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/26/2020 08:24:59</sdl:value><sdl:value key="modified_on">05/26/2020 08:24:59</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">43999783</sdl:value><sdl:value key="SegmentIdentityHash">0RE0XnddFkOX7ywYOwUpecrti/oDvPBkTZTmI565YfE=</sdl:value></sdl:seg><sdl:seg id="21" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/26/2020 08:25:04</sdl:value><sdl:value key="modified_on">05/26/2020 08:25:04</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><
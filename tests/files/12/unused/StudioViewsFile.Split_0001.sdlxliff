y the <g id="11">Patients</g> page.</mrk></seg-source><target><mrk mtype="seg" mid="3">Na tela inicial, toque no botão <g id="8">Pacientes </g>para exibir a página <g id="11">Pacientes</g>.</mrk></target><sdl:seg-defs><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:24</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:24</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1031349266</sdl:value><sdl:value key="SegmentIdentityHash">oExDUXk+v1Jd/q/ErZ11pfiGsGz0TAJPWcmPhH6VMYo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="102258b7-b79e-4c60-9882-145b15407c0a"><source>The <g id="17">Patients</g> page displays a list of all patients registered in your iTero system, and if relevant, their chart number, date of birth, and the date of their last scan.</source><seg-source><mrk mtype="seg" mid="4">The <g id="17">Patients</g> page displays a list of all patients registered in your iTero system, and if relevant, their chart number, date of birth, and the date of their last scan.</mrk></seg-source><target><mrk mtype="seg" mid="4">A página dos <g id="17">Pacientes</g> exibe uma lista de todos os pacientes registrados em seu sistema iTero e, se relevante, os números dos prontuários, as datas de nascimentos e as datas das últimas digitalizações.</mrk></target><sdl:seg-defs><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:24</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:24</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-415750015</sdl:value><sdl:value key="SegmentIdentityHash">fHvj7kQgYgADGW+HPqEZOzzu0Vv+iOgMsP8RxP6gEsU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="bcfe17d5-e2a4-4fbf-a503-6441c0e8cc66"><source>Patients page</source><seg-source><mrk mtype="seg" mid="5">Patients page</mrk></seg-source><target><mrk mtype="seg" mid="5">Página Pacientes</mrk></target><sdl:seg-defs><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/02/2020 14:29:07</sdl:value><sdl:value key="modified_on">10/21/2020 20:43:03</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-483488720</sdl:value><sdl:value key="SegmentIdentityHash">2+Cp7xLjcuypv++jVxnIcQiMl4BygFQk0Nd9VKVUJ8A=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="a6dd2be5-4329-44e0-be6a-de0f51b37164"><source>Once you have selected a patient, you can view the patient’s profile page with the patient’s details.</source><seg-source><mrk mtype="seg" mid="6">Once you have selected a patient, you can view the patient’s profile page with the patient’s details.</mrk></seg-source><target><mrk mtype="seg" mid="6">Depois de selecionar um paciente, você pode visualizar a página de perfil do paciente com os dados do paciente.</mrk></target><sdl:seg-defs><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sd
slated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="106" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="27"/><sdl:cxt id="30"/><sdl:cxt id="31"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="131a63cb-ab20-40d3-8480-d221062a4c7c"><source>When patients are scanned, the NIRI data is captured by default.However, you can disable capturing the NIRI data.In this case, none of the NIRI features will be displayed in the GUI, and NIRI data will not be captured, saved, or sent.</source><seg-source><mrk mtype="seg" mid="107">When patients are scanned, the NIRI data is captured by default.</mrk><mrk mtype="seg" mid="108">However, you can disable capturing the NIRI data.</mrk><mrk mtype="seg" mid="109">In this case, none of the NIRI features will be displayed in the GUI, and NIRI data will not be captured, saved, or sent.</mrk></seg-source><target><mrk mtype="seg" mid="107">Quando seus pacientes são digitalizados, os dados NIRI são capturados por padrão</mrk><mrk mtype="seg" mid="108">Contudo, você pode desativar a captura de dados NIRI.</mrk><mrk mtype="seg" mid="109">Nesse caso, nenhuma das funcionalidades NIRI serão exibidas na GUI e os dados NIRI não serão capturados, salvos ou enviados.</mrk></target><sdl:seg-defs><sdl:seg id="107" conf="ApprovedTranslation" origin="interactive"><sdl:rep id="0Epj9qM/tcosrBCfA8aVF3YbCtw0IZ17gSqMXh9ltsc="/><sdl:value key="SegmentIdentityHash">0Epj9qM/tcosrBCfA8aVF3YbCtw0IZ17gSqMXh9ltsc=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:48:41</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1574962805</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1777805895</sdl:value></sdl:seg><sdl:seg id="108" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">RFiLxD5UibHLADuZ6ueEC7c/rk/SYe/WxNAwjsEIvYw=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:48:45</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-594580385</sdl:value></sdl:seg><sdl:seg id="109" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">XvvJSEjVwlMWhirLFgKhN7hSlfoWWEdOhqrxJJBGr88=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-2005533301</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="27"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="59686f6c-957a-4f3e-854c-7bacd3180c94"><source>If required, NIRI capture can also be disabled for a specific scan, as described in <x id="161"/>.</source><seg-source><mrk mtype="seg" mid="110">If required, NIRI capture can also be disabled for a specific scan, as described in <x id="161"/>.</mrk></seg-source><target><mrk mtype="seg" mid="110">Se necessário, a captura NIRI também pode ser desativada para uma digitalização em específico, conforme descrito em <x id="161"/></mrk></target><sdl:seg-defs><sdl:seg id="110" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">M532hygFbC6UO2+0hrMIpjKCixRRhOuwSu0fQuQNvOw=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1256408202</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="27"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e842aa3c-5c32-40ca-b136-34e0690bac02"><source>To disable NIRI data capture, by default:</source><seg-source><mrk mtype="seg" mid="111">To disable NIRI data capture, by default:</mrk></seg-source><target><mrk mtype="seg" mid="111">Para desativar a captura de dados NIRI por padrão:</mrk></target><sdl:seg-defs><sdl:seg id="111" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">8syVy1Tz2KAF+8nIkvkMypYQa5DoyXb0PwpTdyqJ6oc=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:50:09</sdl:value><sdl:value key="SDL:ProjectTranslationHash">743067883</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="27"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="1c338008-8208-470b-a218-10aaf183022f"><source>In the <g id="170">Settings</g> window, tap <g id="173">Rx Settings</g>.</source><seg-source><mrk mtype="seg" mid="112">In the <g id="170">Settings</g> window, tap <g id="173">Rx Settings</g>.</mrk></seg-source><target><mrk mtype="seg" mid="112">Na janela <g id="170">Configurações</g>, toque em <g id="173">Configurações do RX</g>.</mrk></target><s
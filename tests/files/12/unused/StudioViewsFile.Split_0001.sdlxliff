isplayText">False</value><value key="attribute:mtype">seg</value><value key="attribute:mid">1</value></props></cxt-def><cxt-def id="3" type="segment" purpose="Location"><props><value key="segmentIdentifier">3</value><value key="prefix"></value><value key="localName">mrk</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">mrk</value><value key="hasDisplayText">False</value><value key="attribute:mtype">seg</value><value key="attribute:mid">3</value></props></cxt-def><cxt-def id="4" type="x-xml-p" code="RT" name="x-xml-p" descr="Custom Resource type"/><cxt-def id="5" type="Translation unit" code="TU" name="Translation unit" descr="Transunit element"/><cxt-def id="6" type="MultiBite.flsnp" code="FL" name="MultiBite.flsnp" descr="File element in the XLIFF Document"/></cxt-defs><tag-defs xmlns="http://sdl.com/FileTypes/SdlXliff/1.0"><tag id="8"><bpt name="&lt;span class=&quot;strong&quot;&gt;" word-end="false">&lt;bpt id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</bpt><bpt-props><value key="prefix"></value><value key="localName">bpt</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;span class=&quot;strong&quot;&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></bpt-props><ept name="&lt;/span&gt;" word-end="false">&lt;ept id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ept><ept-props><value key="prefix"></value><value key="localName">ept</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;/span&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></ept-props></tag><tag id="11"><bpt name="&lt;span class=&quot;strong&quot;&gt;" word-end="false">&lt;bpt id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</bpt><bpt-props><value key="prefix"></value><value key="localName">bpt</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;span class=&quot;strong&quot;&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">2</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></bpt-props><ept name="&lt;/span&gt;" word-end="false">&lt;ept id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ept><ept-props><value key="prefix"></value><value key="localName">ept</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;/span&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">2</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></ept-props></tag></tag-defs></header><body><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="31b18a07-3f51-4dcb-9f92-3c358ed9748c"><source><g id="8">Multi-Bite:</g> Turn on the <g id="11">Multi-Bite</g> toggle if a multi-bite scan is required.This enables you to preserve the 2-bite relation based on your needs, and delivers comprehensive bite information to the lab for appliance fabrication.</source><seg-source><mrk mtype="seg" mid="1"><g id="8">Multi-Bite:</g> Turn on the <g id="11">Multi-Bite</g> toggle if a multi-bite scan is required.</mrk><mrk mtype="seg" mid="2">This enables you to preserve the 2-bite relation based on your needs, and delivers comprehensive bite information to the lab for appliance fabrication.</mrk></seg-source><target><mrk mtype="seg" mid="1"><g id="8">Mordida Múltipla:</g> ative a opção <g id="11">Mordida-Múltipla</g> caso seja necessário realizar uma digitalização de mordida múltipla.</mrk><mrk mtype="seg" mid="2">Isso lhe permite preservar a relação de 2 mordidas com base em suas necessidades, e fornece informações abrangentes sobre a mordida ao laboratório para a fabricação do aparelho.</mrk></target><sdl:seg-defs><sdl:seg id="1" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:29</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:29</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1810846168</sdl:value><sdl:value key="SegmentIdentityHash">g4ENgROwwO+Aar5qjlL9g9lSEJDmA0Q3gxVh0ctCcAE=</sdl:value></sdl:seg><sdl:seg id="2" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/23/2022 18:52:25</sdl:value><sdl:value key="modified_on">11/23/2022 18:52:25</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">713056424</sdl:value><sdl:value key="SegmentIdentityHash">8yu7VRXNtUPLAQS64TsZjyIrkXWjgQd7zWch6mlT308=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group></body></file><file original="C:\Data\My Documents\Studio 2011\Projects\222818 Rev.3 LuminaPro-pt-BR\en-US\222818 Rev.3 LuminaPro-pt-BR_1\Content\Resources\Snippets\NewSleeve.flsnp.xlf" datatype="x-sdlfilterframework2" source-language="en-us" target-language="pt-br"><header><reference><internal-file form="base64">UEsDBBQAAAAIACQ0GVk+6Y4xUwQAADYTAAAQAAAAbmVlbjV0MWsucnlyLnhsZu1YzXLbNhC+Zybv

:1.2</value></props></tag><tag id="52"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;&lt;bpt id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;span class=&quot;strong&quot;&amp;gt;&lt;/bpt&gt;Note for &lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;MadCap:variable name=&quot;iTero.LaptopConfiguration&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot; /&amp;gt;&lt;/ph&gt; users:&lt;ept id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/span&amp;gt;&lt;/ept&gt; This manual describes the scanner operation using a touch screen.&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;&lt;bpt id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;span class=&quot;strong&quot;&amp;gt;&lt;/bpt&gt;Note for &lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;MadCap:variable name=&quot;iTero.LaptopConfiguration&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot; /&amp;gt;&lt;/ph&gt; users:&lt;ept id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/span&amp;gt;&lt;/ept&gt; This manual describes the scanner operation using a touch screen.&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="55"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;If your laptop does not support a touch-screen display, you can use standard Windows mouse controls to operate the scanner.&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;If your laptop does not support a touch-screen display, you can use standard Windows mouse controls to operate the scanner.&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="58"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;For more information on using mouse controls to operate the scanner, see &lt;ph id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;MadCap:xref href=&quot;../4. Working with the scanner/Touch screen gestures.htm#Mouse&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&amp;gt;1.0.2&amp;lt;/MadCap:xref&amp;gt;&lt;/ph&gt;.&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;For more information on using mouse controls to operate the scanner, see &lt;ph id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;MadCap:xref href=&quot;../4. Working with the scanner/Touch screen gestures.htm#Mouse&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&amp;gt;1.0.2&amp;lt;/MadCap:xref&amp;gt;&lt;/ph&gt;.&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="71"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;&lt;bpt id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;MadCap:conditionalText MadCap:conditions=&quot;iTero.Z_Backlog&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&amp;gt;&lt;/bpt&gt;xxx for Element xxx&lt;ept id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/MadCap:conditionalText&amp;gt;&lt;/ept&gt;&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;&lt;bpt id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;MadCap:conditionalText MadCap:conditions=&quot;iTero.Z_Backlog&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&amp;gt;&lt;/bpt&gt;xxx for Element xxx&lt;ept id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/MadCap:conditionalText&amp;gt;&lt;/ept&gt;&lt;/MadCap
Hash">-178615824</sdl:value><sdl:value key="SegmentIdentityHash">5MPrTdhUNOwXNQJ3bXBDc3vrJxArDO+EgvXZbG4DlJo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="84c2d8af-af14-4579-a7f3-0b49b4e90605"><source><x id="54"/> <x id="55"/></source><seg-source><mrk mtype="seg" mid="29"><x id="54"/> <x id="55"/></mrk></seg-source><target><mrk mtype="seg" mid="29"><x id="54"/> <x id="55"/></mrk></target><sdl:seg-defs><sdl:seg id="29" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="5MPrTdhUNOwXNQJ3bXBDc3vrJxArDO+EgvXZbG4DlJo="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:15</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:15</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-178615824</sdl:value><sdl:value key="SegmentIdentityHash">5MPrTdhUNOwXNQJ3bXBDc3vrJxArDO+EgvXZbG4DlJo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="a66e5b0f-71c7-4c66-87c4-8b2bc94cfcca"><source>Initial assembly</source><seg-source><mrk mtype="seg" mid="30">Initial assembly</mrk></seg-source><target><mrk mtype="seg" mid="30">Montagem inicial</mrk></target><sdl:seg-defs><sdl:seg id="30" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">01/04/2021 11:24:39</sdl:value><sdl:value key="modified_on">01/04/2021 11:24:39</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1973553862</sdl:value><sdl:value key="SegmentIdentityHash">ASjx54weYH7q8AkXs8v6HKrs1i9LI3zWiSNQ1Yn7Kjc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="6e9ce219-cd17-48ae-b179-2daa720b9040"><source>Undo the strap holding the computing unit (A), and then remove it using the handle (B).</source><seg-source><mrk mtype="seg" mid="31">Undo the strap holding the computing unit (A), and then remove it using the handle (B).</mrk></seg-source><target><mrk mtype="seg" mid="31">Abra o zíper que segura a unidade de computação (A) e, em seguida, remova-a usando a alça (B).</mrk></target><sdl:seg-defs><sdl:seg id="31" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 16:05:38</sdl:value><sdl:value key="modified_on">11/18/2022 00:26:06</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1703234913</sdl:value><sdl:value key="SegmentIdentityHash">mIGOmBTIIqy31cIhzYUowTp5Hszt2QCrDQyL4vS0zZM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="27aa513b-ea84-4f43-9b3a-ccd700d6afc8"><source>Rest the computing unit (A) on a smooth, flat surface and hold it with one hand.</source><seg-source><mrk mtype="seg" mid="32">Rest the computing unit (A) on a smooth, flat surface and hold it with one hand.</mrk></seg-source><target><mrk mtype="seg" mid="32">Coloque a unidade de computação (A) em uma superfície lisa e plana, segurando-a com uma mão.</mrk></target><sdl:seg-defs><sdl:seg id="32" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 16:06:13</sdl:value><sdl:value key="modified_on">11/18/2022 00:26:11</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">15299216</sdl:value><sdl:value key="SegmentIdentityHash">3xhSL4W9dc+l+fUM98g+EAe6/CStbR6ZI0Su5rwXXUM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="1cfe2330-a3f3-403f-93f4-346c361e7b3f"><source>While holding the computing unit, slide the locking latch to the right until you feel a click, to unlock the handle (B).</source><seg-source><mrk mtype="seg" mid="33">While holding the computing unit, slide the locking latch to the right until you feel a click, to unlock the handle (B).</mrk></seg-source><target><mrk mtype="seg" mid="33">Enquanto segura a unidade de computação, deslize a trava de bloqueio para a direita até ouvir um clique para destravar a alça.</mrk></target><sdl:seg-defs><sdl:seg id="33" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 16:07:30</sdl:value><sdl:value key="modified_on">11/18/2022 00:26:13</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1142506545</sdl:value><sdl:value key="SegmentIdentityHash">J+PbGYvDt6bwaxCoHuwoSoAq4Sm3Ly7iifMF717a58I=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="11"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d99e524f-5738-4b6e-99df-a6367a17e10b"><source>Move the handle (B) down to the standing position.Ensure that the handle is securely locked in place by trying to pull it back up.</source><seg-source><mrk mtype="seg" mid="34">Move the handle (B) down to the standing position.</mrk><mrk mtype="seg" mid="35">Ensure that the handle is securely locked in place by trying to pull it back up.</mrk></seg-source><target><mrk mtype="seg" mid="34">Mova a alça (B) para baixo até a posição ereta.</mrk><mrk mtype="seg" mid="35">Certifique-se de que a alça esteja seguramente travada no lugar, tentando puxá-la de volta.</mrk></target><sdl:seg-defs><sdl:seg id="34" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 16:07:58</sdl:value><sdl:value key="modified_on">11/18/2022 00:26:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1303138420</sdl:value><sdl:value key="SegmentIdentityHash">C/Gww6/RS1RKSS+1sd17RPqdrYmMZF3CViPqhRo69MQ=</sdl:value></sdl:seg><sdl:seg id="35" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">01/08/2021 02:10:54</sdl:value><sdl:value key="modified_on">01/08/2021 02:10:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1626831088</sdl:value><sdl:value key="SegmentIdentityHash">w6XL8LQG3KBUV/StYY/MxrjiqPYNa1BrMo0fjtCZAts=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="9b6d83d6-9b95-44a3-93bb-6a147471691f"><source>Undo the snaps and open the flap to remove the rest of the scanner components.</source><seg-source><mrk mtype="seg" mid="36">Undo the snaps and open the flap to remove the rest of the scanner components.</mrk></seg-source><target><mrk mtype="seg" mid="36">Desfaça os encaixes e abra a aba para remover os demais componentes do scanner.</mrk></target><sdl:seg-defs><sdl:seg id="36" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 16:10:31</sdl:value><sdl:value key="modified_on">11/18/2022 00:26:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1586571043</sdl:value><sdl:value key="SegmentIdentityHash">rLhQUijftOyyO7dUvXxzlXecxxbcS6+qozjBX/EORJw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="11"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="4fcf58d2-0c9e-418b-8910-f63cb8208be8"><source>Slide down the cradle (C) on the slider on the side of the computing unit (A) until it clicks into place.Make sure the cradle is secure and cannot be removed.</source><seg-source><mrk mtype="seg" mid="37">Slide down the cradle (C) on the slider on the side of the computing unit (A) until it clicks into place.</mrk><mrk mtype="seg" mid="38">Make sure the cradle is secure and cannot be removed.</mrk></seg-source><target><mrk mtype="seg" mid="37">Deslize para baixo o suporte (C) pelo encaixe lateral da unidade de computação (A) até ouvir um clique.</mrk><mrk mtype="seg" mid="38">Certifique-se de que o suporte esteja seguro e de que não possa ser removido.</mrk></target><sdl:seg-defs><sdl:seg id="37" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 16:13:19</sdl:value><sdl:value key="modified_on">11/18/2022 00:26:26</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">671432803</sdl:value><sdl:value key="SegmentIdentityHash">zHPNTCt0AkxwzagsA8rkBIAdYxXO3LL6FUl7HkfbTTk=</sdl:value></sdl:seg><sdl:seg id="38" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 16:13:45</sdl:value><sdl:value key="modified_on">11/18/2022 00:26:29</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1684282058</sdl:value><sdl:value key="SegmentIdentityHash">7PdxTNWpfFnNIlQc+Ea/O69QC0jN62fXEmAAoetke2c=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="8fe4124e-f4d7-47d0-9066-fa53824be818"><source>Place the wand (D) in the cradle (C) and connect the wand cable to the port marked <x id="61"/> at the back of the computing unit (A).</source><seg-source><mrk mtype="seg" mid="39">Place the wand (D) in the cradle (C) and connect the wand cable to the port marked <x id="61"/> at the back of the computing unit (A).</mrk></seg-source><target><mrk mtype="seg" mid="39">Coloque o leitor (D) no suporte (C) e conecte o cabo do leitor à porta marcada <x id="61"/> na parte de trás da unidade de computação (A).</mrk></target><sdl:seg-defs><sdl:seg id="39" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="V7rlg9fJtva6pOGbG6U8rE17p9GNHiCOVkG96MmD0dg="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:18</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:18</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1283349033</sdl:value><sdl:value key="SegmentIdentityHash">V7rlg9fJtva6pOGbG6U8rE17p9GNHiCOVkG96MmD0dg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="11"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="f60ef46d-3d3f-43d1-aec7-1b7f89846625"><source>Connect the power cable to the power supply (E).Afterwards, connect one side of the cable to the back of the computing unit (A) and the other side to a power outlet.</source><seg-source><mrk mtype="seg" mid="40">Connect the power cable to the power supply (E).</mrk><mrk mtype="seg" mid="41">Afterwards, connect one side of the cable to the back of the computing unit (A) and the other side to a power outlet.</mrk></seg-source><target><mrk mtype="seg" mid="40">Conecte o cabo de alimentação à fonte de alimentação (E).</mrk><mrk mtype="seg" mid="41">Em seguida, conecte um lado do cabo à parte traseira da unidade de computação (A) e o outro lado a uma tomada elétrica.</mrk></target><sdl:seg-defs><sdl:seg id="40" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 16:14:32</sdl:value><sdl:value key="modified_on">11/18/2022 00:26:31</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1534805379</sdl:value><sdl:value key="SegmentIdentityHash">jsBZ/vVvHUNJhfLXrWPz+IxwQdJnYvW+LTEqvQjQbUs=</sdl:value></sdl:seg><sdl:seg id="41" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 16:16:35</sdl:value><sdl:value key="modified_on">11/18/2022 00:26:34</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-500220347</sdl:value><sdl:value key="SegmentIdentityHash">d65ZRF8zHiwBvonfDR1wHyoWJIibO0P8tv0e3635bBc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="da6cabeb-db87-4bf7-903b-47a8800510e4"><source><g id="70">Warning:</g> <x id="71"/> Use only the supplied power cable, which has a protective earth lead.</source><seg-source><mrk mtype="seg" mid="42"><g id="70">Warning:</g> <x id="71"/> Use only the supplied power cable, which has a protective earth lead.</mrk></seg-source><target><mrk mtype="seg" mid="42"/></target><sdl:seg-defs><sdl:seg id="42" locked="true" conf="Draft"><sdl:rep id="1JTrh0HIBwg5sGAAVn4Ch1WQAfiBhpxfXQvcnRhfiKA="/><sdl:value key="SegmentIdentityHash">1JTrh0HIBwg5sGAAVn4Ch1WQAfiBhpxfXQvcnRhfiKA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="69fb922e-cf39-424e-bf07-90010fb381d1"><source><x id="74"/></source><seg-source><mrk mtype="seg" mid="43"><x id="74"/></mrk></seg-source><target><mrk mtype="seg" mid="43"><x id="74"/></mrk></target><sdl:seg-defs><sdl:seg id="43" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="bf28a344-6fe6-45f2-9a68-087bc9b1a89d"><source><g id="81">Note:</g> Place the cable in a safe manner so that no one is likely to accidentally trip over it.</source><seg-source><mrk mtype="seg" mid="44"><g id="81">Note:</g> Place the cable in a safe manner so that no one is likely to accidentally trip over it.</mrk></seg-source><target><mrk mtype="seg" mid="44"><g id="81">Nota:</g> coloque o cabo de maneira segura para que ninguém tropece nele acidentalmente.</mrk></target><sdl:seg-defs><sdl:seg id="44" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:18</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:18</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1372629048</sdl:value><sdl:value key="SegmentIdentityHash">k57iim7CJ5UiIks32HriTvedbruFAtABqGSwXZMec2Y=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="11"/><sdl:cxt id="14"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="197194dd-1ff4-4b88-8107-7be8d43adf7c"><source>For remote training or support sessions, position the webcam (F) on the computing unit (A) and then connect it to the USB port at the back of the computing unit.<x id="91"/><g id="94">Note:</g> The webcam is packed in the scanner box.</source><seg-source><mrk mtype="seg" mid="45">For remote training or support sessions, position the webcam (F) on the computing unit (A) and then connect it to the USB port at the back of the computing unit.</mrk><mrk mtype="seg" mid="46"><x id="91"/></mrk><mrk mtype="seg" mid="47"><g id="94">Note:</g> The webcam is packed in the scanner box.</mrk></seg-source><target><mrk mtype="seg" mid="45">Para o treinamento remoto ou sessões de suporte, posicione a webcam (F) na unidade de computação (A) e, depois, conecte-a à porta USB na parte de trás da unidade de computação.</mrk><mrk mtype="seg" mid="46"><x id="91"/></mrk><mrk mtype="seg" mid="47"><g id="94">Nota:</g> a webcam vem embalada na caixa do scanner.</mrk></target><sdl:seg-defs><sdl:seg id="45" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 16:17:05</sdl:value><sdl:value key="modified_on">11/18/2022 00:26:49</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2066403846</sdl:value><sdl:value key="SegmentIdentityHash">JGR+pZhAMuCi9MnND/yO8MNcmkLGQMeBRdfg8uHppZE=</sdl:value></sdl:seg><sdl:seg id="46" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="47" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 11:29:40</sdl:value><sdl:value key="modified_on">06/12/2024 16:12:26</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1780356257</sdl:value><sdl:value key="SegmentIdentityHash">GpkUelkGYUAMW27ghTRnAH7Wr2MdahsM/Qbz3bymzgU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="fbf22d2b-b92e-49c9-8e36-28f2f332a825"><source>Press the power button (G) to turn on the scanner.</source><seg-source><mrk mtype="seg" mid="48">Press the power button (G) to turn on the scanner.</mrk></seg-source><target><mrk mtype="seg" mid="48">Pressione o botão ligar/desligar (G) para ligar o scanner.</mrk></target><sdl:seg-defs><sdl:seg id="48" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/10/2022 09:05:05</sdl:value><sdl:value key="modified_on">11/18/2022 00:26:50</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1889224117</sdl:value><sdl:value key="SegmentIdentityHash">IsO7oYKzerZlIU7ACyHNKuaritWog1+VSju46Y8HTQY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="1c17c5c0-4edc-487a-9a73-0d0b23548010"><source>Notes:</source><seg-source><mrk mtype="seg" mid="49">Notes:</mrk></seg-source><target><mrk mtype="seg" mid="49">Notas:</mrk></target><sdl:seg-defs><sdl:seg id="49" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="MV5Vg0NrwdcmWKQ9naRB8KXHXb6LE+trTaKS4OubnEc="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/07/2019 00:22:06</sdl:value><sdl:value key="modified_on">11/19/2020 22:28:16</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-381729265</sdl:value><sdl:value key="SegmentIdentityHash">MV5Vg0NrwdcmWKQ9naRB8KXHXb6LE+trTaKS4OubnEc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="8aac56b7-09e6-4b33-96e8-65b74ffc3b6f"><source>The webcam must be disconnected after each training or support session.</source><seg-source><mrk mtype="seg" mid="50">The webcam must be disconnected after each training or support session.</mrk></seg-source><target><mrk mtype="seg" mid="50">A webcam deve ser desconectada após cada sessão de suporte ou treinamento.</mrk></target><sdl:seg-defs><sdl:seg id="50" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/29/2020 11:09:07</sdl:value><sdl:value key="modified_on">10/20/2020 18:31:35</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2093538714</sdl:value><sdl:value key="SegmentIdentityHash">6n9N3twcuC6hJbI8IuhgI9BirpyRyJ1Tob9IXAIMY8M=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="4f454c44-6482-4763-badc-ce943f220218"><source>Always return the wand to the cradle after each use.</source><seg-source><mrk mtype="seg" mid="51">Always return the wand to the cradle after each use.</mrk></seg-source><target><mrk mtype="seg" mid="51">Sempre retorne o leitor para o suporte após cada uso.</mrk></target><sdl:seg-defs><sdl:seg id="51" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="HIMdwnCf3MResmn/8QjmorM9ZZFmdWtpJmmyZKCpfW4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">01/04/2021 18:00:56</sdl:value><sdl:value key="modified_on">01/04/2021 18:00:56</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1748484030</sdl:value><sdl:value key="SegmentIdentityHash">HIMdwnCf3MResmn/8QjmorM9ZZFmdWtpJmmyZKCpfW4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="15"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d7feeede-7789-4abe-b71a-02d743e30c61"><source>When the system is not in use, the wand should be placed in the cradle with the optical window facing the cradle.</source><seg-source><mrk mtype="seg" mid="52">When the system is not in use, the wand should be placed in the cradle with the optical window facing the cradle.</mrk></seg-source><target><mrk mtype="seg" mid="52">Quando o sistema não estiver em uso, o leitor deverá ser colocado no suporte com a janela óptica voltada para o suporte.</mrk></target><sdl:seg-defs><sdl:seg id="52" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="jD/4uBeQxi37ewdSg8APdi5E0EfYYeeO3OckhN8AnRo="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:51</sdl:value><sdl:value key="modified_on">06/12/2024 16:12:26</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2040307606</sdl:value><sdl:value key="SegmentIdentityHash">jD/4uBeQxi37ewdSg8APdi5E0EfYYeeO3OckhN8AnRo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="eb051b09-d62c-4fcf-a1ff-bba2f0548766"><source>The wand, cradle, and other system components should be cleaned and disinfected <x id="103"/><g id="106">immediately after each patient</g>, as described in <x id="107"/>.</source><seg-source><mrk mtype="seg" mid="53">The wand, cradle, and other system components should be cleaned and disinfected <x id="103"/><g id="106">immediately after each patient</g>, as described in <x id="107"/>.</mrk></seg-source><target><mrk mtype="seg" mid="53">O leitor, o suporte e outros componentes do sistema devem ser limpos e desinfetados <x id="103"/><g id="106">imediatamente após cada paciente</g>, conforme descrito em <x id="107"/>.</mrk></target><sdl:seg-defs><sdl:seg id="53" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="CeCWebQ3rrXV3TW8Qcc8QfJffveMj3DiTKTKQMLjFAM="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:51</sdl:value><sdl:value key="modified_on">06/12/2024 16:12:26</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1281125494</sdl:value><sdl:value key="SegmentIdentityHash">CeCWebQ3rrXV3TW8Qcc8QfJffveMj3DiTKTKQMLjFAM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7cd325d6-edda-4f8d-85d6-b03f62f6f1a4"><source>Ensure that the scanner is positioned in a location where it can easily be disconnected from the power outlet.</source><seg-source><mrk mtype="seg" mid="54">Ensure that the scanner is positioned in a location where it can easily be disconnected from the power outlet.</mrk></seg-source><target><mrk mtype="seg" mid="54">Certifique-se de que o scanner esteja posicionado em um local onde possa ser facilmente desconectado da tomada elétrica.</mrk></target><sdl:seg-defs><sdl:seg id="54" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="JnhfsGCp5cXb+vH2IE3gbzBUlsKkY04vIvz6K7FJCDA="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 12:30:50</sdl:value><sdl:value key="modified_on">11/11/2022 20:15:48</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1147912737</sdl:value><sdl:value key="SegmentIdentityHash">JnhfsGCp5cXb+vH2IE3gbzBUlsKkY04vIvz6K7FJCDA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="aecae525-7a55-494f-9c96-8be65dad4928"><source>Moving the scanner within the clinic</source><seg-source><mrk mtype="seg" mid="55">Moving the scanner within the clinic</mrk></seg-source><target><mrk mtype="seg" mid="55">Transportando o scanner dentro da clínica</mrk></target><sdl:seg-defs><sdl:seg id="55" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">01/04/2021 18:02:28</sdl:value><sdl:value key="modified_on">01/04/2021 18:02:28</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-758832741</sdl:value><sdl:value key="SegmentIdentityHash">kBC2Fv3dzaW0T1RlzPbzvTZ7OKIWuLOpA/BibehPzyw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="c8b08776-e1ae-4325-8679-416bcf37c93f"><source>Ensure that the wand (D) is firmly positioned in the cradle (C).</source><seg-source><mrk mtype="seg" mid="56">Ensure that the wand (D) is firmly positioned in the cradle (C).</mrk></seg-source><target><mrk mtype="seg" mid="56">Verifique se o leitor (D) está posicionado firmemente no suporte (C).</mrk></target><sdl:seg-defs><sdl:seg id="56" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/10/2022 09:05:28</sdl:value><sdl:value key="modified_on">11/18/2022 00:26:59</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1830206916</sdl:value><sdl:value key="SegmentIdentityHash">bWC372buMDeWdBByRl1eIRfmSZ5vYtAMN6imkcGOKEI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="3c15c71e-8a79-4112-ac71-7f4359f1c7fd"><source>Disconnect the power cable (E) from the mains and then from the back of the computing unit (A).</source><seg-source><mrk mtype="seg" mid="57">Disconnect the power cable (E) from the mains and then from the back of the computing unit (A).</mrk></seg-source><target><mrk mtype="seg" mid="57">Desconecte o cabo de alimentação (E) da rede elétrica e, em seguida, da parte traseira da unidade de computação (A).</mrk></target><sdl:seg-defs><sdl:seg id="57" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/10/2022 09:05:46</sdl:value><sdl:value key="modified_on">11/18/2022 00:27:03</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1169403312</sdl:value><sdl:value key="SegmentIdentityHash">3OJnnM/UU7+soBeJ4huqiaQmqiP1UIzaKZyKR4PhGtA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="32ace2b8-f5f4-4d74-9862-1ec55aa75021"><source>While holding the computing unit (A) with one hand, slide the locking latch to the right to unlock the handle (B) and then move the handle to the carrying position.</source><seg-source><mrk mtype="seg" mid="58">While holding the computing unit (A) with one hand, slide the locking latch to the right to unlock the handle (B) and then move the handle to the carrying position.</mrk></seg-source><target><mrk mtype="seg" mid="58">Segurando a unidade de computação (A) com uma mão, deslize a trava de bloqueio para a direita para destravar a alça (B). Depois, mova a alça para a posição de transporte.</mrk></target><sdl:seg-defs><sdl:seg id="58" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/10/2022 09:06:04</sdl:value><sdl:value key="modified_on">11/18/2022 00:27:05</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2066645287</sdl:value><sdl:value key="SegmentIdentityHash">P0JlytOa5KaWTDG9gd3x6c0Rl4rShmuICAkavwrBjR0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="0948c21a-2ef9-47ca-aee8-ce2696ddc8b6"><source>Loosely wrap the wand cable around the cradle (C) for easy and safe portability.</source><seg-source><mrk mtype="seg" mid="59">Loosely wrap the wand cable around the cradle (C) for easy and safe portability.</mrk></seg-source><target><mrk mtype="seg" mid="59">Enrole levemente o cabo do leitor em torno do suporte (C) para que seja fácil e seguro de transportar.</mrk></target><sdl:seg-defs><sdl:seg id="59" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/10/2022 09:06:13</sdl:value><sdl:value key="modified_on">11/18/2022 00:27:06</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1667069950</sdl:value><sdl:value key="SegmentIdentityHash">gCLBeVIShXBgkRhdJAtT0r7K15LJfe8jThABo5s39M0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="038ab31f-78cc-4670-8c7e-420bdc986383"><source>Using the trolley for transportation</source><seg-source><mrk mtype="seg" mid="60">Using the trolley for transportation</mrk></seg-source><target><mrk mtype="seg" mid="60">Usando o carrinho para o transporte</mrk></target><sdl:seg-defs><sdl:seg id="60" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">01/04/2021 18:09:53</sdl:value><sdl:value key="modified_on">01/04/2021 18:09:53</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">490512041</sdl:value><sdl:value key="SegmentIdentityHash">Ljhpca6gJogusJoSC7nhyvzj5nNdRngkr/VdpaF/eCw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="1f14d0f9-6925-4282-a77c-9770b1c5ed95"><source>Before transporting the scanner, it must be packed into the supplied trolley.</source><seg-source><mrk mtype="seg" mid="61">Before transporting the scanner, it must be packed into the supplied trolley.</mrk></seg-source><target><mrk mtype="seg" mid="61">Antes de transportar o scanner, ele deve ser embalado no carrinho fornecido.</mrk></target><sdl:seg-defs><sdl:seg id="61" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">01/04/2021 18:10:04</sdl:value><sdl:value key="modified_on">01/04/2021 18:10:04</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">565997921</sdl:value><sdl:value key="SegmentIdentityHash">HzPWZVx0rL1mTdt7qzIqNyHVfbdv+nllw+Q1zAw7he8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="012b4a0a-2604-4841-8b06-3019d9cc1858"><source>Turn off the scanner and disconnect the power cable (E) from the mains and then from the back of the computing unit (A).</source><seg-source><mrk mtype="seg" mid="62">Turn off the scanner and disconnect the power cable (E) from the mains and then from the back of the computing unit (A).</mrk></seg-source><target><mrk mtype="seg" mid="62">Desligue o scanner e desconecte o cabo de alimentação (E) da rede elétrica e, em seguida, da parte traseira da unidade de computação (A).</mrk></target><sdl:seg-defs><sdl:seg id="62" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/10/2022 09:07:13</sdl:value><sdl:value key="modified_on">11/18/2022 00:27:09</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-688159097</sdl:value><sdl:value key="SegmentIdentityHash">6Dn7W86+z8q2bHT7MUbrCIWpXsnCyI6azziD+P5zXV0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="11"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="005d3475-d4ac-4086-a913-5761711de300"><source>For easier packing, start by placing the power pack (E) in its designated compartment in the trolley.Wrap the thinner part of the cable and place it on top of the power supply, and then wrap the thicker part of the cable and place it in its compartment in the trolley.</source><seg-source><mrk mtype="seg" mid="63">For easier packing, start by placing the power pack (E) in its designated compartment in the trolley.</mrk><mrk mtype="seg" mid="64">Wrap the thinner part of the cable and place it on top of the power supply, and then wrap the thicker part of the cable and place it in its compartment in the trolley.</mrk></seg-source><target><mrk mtype="seg" mid="63">Para facilitar a embalagem, comece colocando o pacote de alimentação (E) no devido compartimento no carrinho.</mrk><mrk mtype="seg" mid="64">Enrole a parte mais fina do cabo e coloque-o em cima da fonte de alimentação e, em seguida, enrole a parte mais grossa do cabo e coloque-o em seu compartimento no carrinho.</mrk></target><sdl:seg-defs><sdl:seg id="63" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/10/2022 09:08:28</sdl:value><sdl:value key="modified_on">11/18/2022 00:27:11</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1274005393</sdl:value><sdl:value key="SegmentIdentityHash">1gr5jY/XXkdgJDvazrhl+mHfO1l9kHaiDFxN33uTg44=</sdl:value></sdl:seg><sdl:seg id="64" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2022 11:08:37</sdl:value><sdl:value key="modified_on">12/06/2022 11:08:37</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-435380240</sdl:value><sdl:value key="SegmentIdentityHash">ilOef8z7H0kAx1PJki//T0QkGzOgXvorcT8sy2Shx8k=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="df2ed6ba-8e8a-444b-b989-2b0c56fb0ce5"><source>Disconnect the wand (D) and place it in its compartment in the trolley.</source><seg-source><mrk mtype="seg" mid="65">Disconnect the wand (D) and place it in its compartment in the trolley.</mrk></seg-source><target><mrk mtype="seg" mid="65">Desconecte o leitor (D) e coloque-o em seu respectivo compartimento no carrinho.</mrk></target><sdl:seg-defs><sdl:seg id="65" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/10/2022 09:08:41</sdl:value><sdl:value key="modified_on">11/18/2022 00:27:13</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">705433590</sdl:value><sdl:value key="SegmentIdentityHash">dyfcyXkT3T6wwOJr+mjZE9mc2DiLG3meVb2BXVflC6s=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="bdc58838-7313-4b38-bc06-77650ee2841a"><source>While holding the computing unit (A) with one hand, remove the cradle (C) by pressing the release button and pulling up the cradle.</source><seg-source><mrk mtype="seg" mid="66">While holding the computing unit (A) with one hand, remove the cradle (C) by pressing the release button and pulling up the cradle.</mrk></seg-source><target><mrk mtype="seg" mid="66">Enquanto segura a unidade de computação (A) com uma mão, remova o suporte (C), pressionando o botão de destravamento e puxando o suporte para cima.</mrk></target><sdl:seg-defs><sdl:seg id="66" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 16:02:45</sdl:value><sdl:value key="modified_on">11/18/2022 00:27:14</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-930012725</sdl:value><sdl:value key="SegmentIdentityHash">pkXsgY2H/E1+Ne+Or/5rQnlhQq0yeEelW/v6uk37eiY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="913fd69e-9460-4bdc-a1d8-5674f76f1a09"><source>Place the cradle (C) in the trolley.</source><seg-source><mrk mtype="seg" mid="67">Place the cradle (C) in the trolley.</mrk></seg-source><target><mrk mtype="seg" mid="67">Coloque o suporte (D) no carrinho.</mrk></target><sdl:seg-defs><sdl:seg id="67" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/10/2022 09:08:49</sdl:value><sdl:value key="modified_on">11/18/2022 00:27:16</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2082629389</sdl:value><sdl:value key="SegmentIdentityHash">DtzMBxBBZ3cU5QIv7VNtF0STRBKpCYq+dAJaD0kWoYc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="0639b25d-198c-49de-80fd-a16d80348aaf"><source>Optional: Place new sleeves in the compartment next to the cradle (C), instead of the protective trolley cover (H).</source><seg-source><mrk mtype="seg" mid="68">Optional: Place new sleeves in the compartment next to the cradle (C), instead of the protective trolley cover (H).</mrk></seg-source><target><mrk mtype="seg" mid="68">Opcional: coloque novas ponteiras no compartimento ao lado do suporte (C), em vez da capa protetora do carrinho (H).</mrk></target><sdl:seg-defs><sdl:seg id="68" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/10/2022 09:09:55</sdl:value><sdl:value key="modified_on">11/18/2022 00:27:18</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-121764662</sdl:value><sdl:value key="SegmentIdentityHash">Yr1ZXEtGcHrexZKQyHNbzOr/U88GwAX1Zo+fQ77zUtU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="797187c2-8fde-4894-95b4-6638c86e96fb"><source>Move the flap to cover the scanner components and then secure the flap with the snaps.</source><seg-source><mrk mtype="seg" mid="69">Move the flap to cover the scanner components and then secure the flap with the snaps.</mrk></seg-source><target><mrk mtype="seg" mid="69">Mova a aba para cobrir os componentes do scanner e prenda a aba com os fechos.</mrk></target><sdl:seg-defs><sdl:seg id="69" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">01/04/2021 18:36:57</sdl:value><sdl:value key="modified_on">01/04/2021 18:36:57</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-863862506</sdl:value><sdl:value key="SegmentIdentityHash">IAa+RNK3LuCGyr6Rj0Pkx24vasCz8V5zkAQHAEL6eGU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d6b99680-48d7-49e2-baad-d73bd7441966"><source>Slide the locking latch to the right to unlock the stand (B) and then move it to the carrying position.</source><seg-source><mrk mtype="seg" mid="70">Slide the locking latch to the right to unlock the stand (B) and then move it to the carrying position.</mrk></seg-source><target><mrk mtype="seg" mid="70">Deslize a trava de bloqueio para a direita, para destravar o suporte (B). Depois, mova-o para a posição de transporte.</mrk></target><sdl:seg-defs><sdl:seg id="70" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/10/2022 09:10:09</sdl:value><sdl:value key="modified_on">11/18/2022 00:27:19</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1561127359</sdl:value><sdl:value key="SegmentIdentityHash">81GvwjyODJVGwRzHJoZ9qamHSB9fcu+vY5XVCeQGhFM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="11"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="c17dba08-7a2c-4530-85f8-1fc00c37a4c2"><source>Place the computing unit (A) in its compartment in the trolley.Thread the outer strap through the handle (B) and close the straps to ensure that it is held securely in place.</source><seg-source><mrk mtype="seg" mid="71">Place the computing unit (A) in its compartment in the trolley.</mrk><mrk mtype="seg" mid="72">Thread the outer strap through the handle (B) and close the straps to ensure that it is held securely in place.</mrk></seg-source><target><mrk mtype="seg" mid="71">Coloque a unidade de computação (A) em seu respectivo compartimento no carrinho.</mrk><mrk mtype="seg" mid="72">Passe a cinta externa pela alça (B) e feche a cinta para garantir que seja mantida com segurança no lugar.</mrk></target><sdl:seg-defs><sdl:seg id="71" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/10/2022 09:10:19</sdl:value><sdl:value key="modified_on">11/18/2022 00:27:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1056932094</sdl:value><sdl:value key="SegmentIdentityHash">Lre2wl5XAiNAnpNTXqBo072lKF/TZOprGGeRYEEbQe4=</sdl:value></sdl:seg><sdl:seg id="72" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/10/2022 09:10:28</sdl:value><sdl:value key="modified_on">11/18/2022 00:27:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-239586135</sdl:value><sdl:value key="SegmentIdentityHash">W/TROVYY+YbAP9Zu2l3N022GBoyUR5A1Acv0popADXA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="caffc6e6-0764-4cb1-9884-6bc473ad8e3a"><source>Close the trolley by lifting the side with the fastened flap and then zipping it closed.</source><seg-source><mrk mtype="seg" mid="73">Close the trolley by lifting the side with the fastened flap and then zipping it closed.</mrk></seg-source><target><mrk mtype="seg" mid="73">Feche o carrinho, levantando a lateral com a aba presa e, depois, fechando o zíper.</mrk></target><sdl:seg-defs><sdl:seg id="73" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 16:17:52</sdl:value><sdl:value key="modified_on">11/09/2022 16:17:52</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-992781297</sdl:value><sdl:value key="SegmentIdentityHash">+khk9fuikugqFqt1yXPv4QPtPd/1lzJf57D71su/k3s=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="11"/><sdl:cxt id="14"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="1fdb00db-b58d-4145-bd1e-fff4e561b6c3"><source>You are now ready to travel with your scanner.<x id="115"/>If required, you can use the optional protective trolley cover (H), described in <x id="116"/>.</source><seg-source><mrk mtype="seg" mid="74">You are now ready to travel with your scanner.</mrk><mrk mtype="seg" mid="75"><x id="115"/></mrk><mrk mtype="seg" mid="76">If required, you can use the optional protective trolley cover (H), described in <x id="116"/>.</mrk></seg-source><target><mrk mtype="seg" mid="74">Agora você está pronto para transportar o seu scanner.</mrk><mrk mtype="seg" mid="75"><x id="115"/></mrk><mrk mtype="seg" mid="76">Se necessário, você pode usar a capa protetora opcional do carrinho, descrita em <x id="116"/>.</mrk></target><sdl:seg-defs><sdl:seg id="74" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">01/04/2021 18:43:13</sdl:value><sdl:value key="modified_on">01/04/2021 18:43:13</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1045697559</sdl:value><sdl:value key="SegmentIdentityHash">UAdU09eTMKr+jn+n2PFYaOE5FGJ0IJMNE5J48il6D/g=</sdl:value></sdl:seg><sdl:seg id="75" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="76" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:18</sdl:value><sdl:value key="modified_on">11/12/2022 06:02:36</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">524532710</sdl:value><sdl:value key="SegmentIdentityHash">sjtQpyxJBNzo5hcM3H/CgvcfSzgRn/p7DZJ7tL1KIJg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="3f7c25a3-e14c-4dd6-9773-ffd10c7eb07d"><source>Notes:</source><seg-source><mrk mtype="seg" mid="77">Notes:</mrk></seg-source><target><mrk mtype="seg" mid="77">Notas:</mrk></target><sdl:seg-defs><sdl:seg id="77" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="MV5Vg0NrwdcmWKQ9naRB8KXHXb6LE+trTaKS4OubnEc="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/07/2019 00:22:06</sdl:value><sdl:value key="modified_on">11/19/2020 22:28:16</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-381729265</sdl:value><sdl:value key="SegmentIdentityHash">MV5Vg0NrwdcmWKQ9naRB8KXHXb6LE+trTaKS4OubnEc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="1ec18ed7-0447-4dae-a315-b239ef5e41d6"><source>The trolley must be handled with care.</source><seg-source><mrk mtype="seg" mid="78">The trolley must be handled with care.</mrk></seg-source><target><mrk mtype="seg" mid="78">O carrinho deve ser manuseado com cuidado.</mrk></target><sdl:seg-defs><sdl:seg id="78" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">01/04/2021 18:43:18</sdl:value><sdl:value key="modified_on">01/04/2021 18:43:18</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-967736759</sdl:value><sdl:value key="SegmentIdentityHash">JftlNjDru0W6nX1VM+yDs3YO0GERM9436qkMDAuvQ1c=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7f8a1654-4564-46b6-a185-53ede42bf4a9"><source>Avoid leaving the trolley in the sun in order to prevent the scanner from reaching extreme temperatures.</source><seg-source><mrk mtype="seg" mid="79">Avoid leaving the trolley in the sun in order to prevent the scanner from reaching extreme temperatures.</mrk></seg-source><target><mrk mtype="seg" mid="79">Evite deixar o carrinho ao sol para evitar que o scanner alcance temperaturas extremas.</mrk></target><sdl:seg-defs><sdl:seg id="79" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">01/04/2021 18:45:15</sdl:value><sdl:value key="modified_on">01/04/2021 18:45:15</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1827800253</sdl:value><sdl:value key="SegmentIdentityHash">6zKQU2LT8sLT8iloIrSXILoTLcQSiwqSlBV0WnFiJD0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="c377e665-477f-40b1-bc83-dcb0afbeb9ef"><source>Make sure the trolley is kept dry to protect the system components from humidity.</source><seg-source><mrk mtype="seg" mid="80">Make sure the trolley is kept dry to protect the system components from humidity.</mrk></seg-source><target><mrk mtype="seg" mid="80">Certifique-se de manter o carrinho seco para proteger os componentes do sistema contra a umidade.</mrk></target><sdl:seg-defs><sdl:seg id="80" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">01/04/2021 18:45:35</sdl:value><sdl:value key="modified_on">01/04/2021 18:45:35</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1156557496</sdl:value><sdl:value key="SegmentIdentityHash">8Ow22UQT3lEshG8ppF+eu4ZAW0KfMlaP1/lkmapIX50=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="49f8da0c-2970-45ea-b26f-1496d4b30919"><source>If the scanner has just been brought into the office from a hot, cold, or humid environment, it should be set aside until it has adjusted to room temperature, to avoid internal condensation.</source><seg-source><mrk mtype="seg" mid="81">If the scanner has just been brought into the office from a hot, cold, or humid environment, it should be set aside until it has adjusted to room temperature, to avoid internal condensation.</mrk></seg-source><target><mrk mtype="seg" mid="81">Se o scanner acaba de ser transportado de um ambiente quente, frio ou úmido para o consultório, seu uso deve ser suspenso até que esteja adaptado à temperatura ambiente para evitar condensação interna.</mrk></target><sdl:seg-defs><sdl:seg id="81" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/10/2022 09:14:14</sdl:value><sdl:value key="modified_on">11/18/2022 00:27:34</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1322774075</sdl:value><sdl:value key="SegmentIdentityHash">uPUaED2o+Q+VHUlxKeZfp7L3GQBl2l7V2aCZzlzwBxY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="814ef829-5cc8-4ea7-9ac1-c2d800112043"><source>Do not check the trolley as baggage when traveling by air, to <x id="124"/><g id="127">reduce the risk of</g> damage to the scanner that may be caused by uncontrolled transportation conditions.</source><seg-source><mrk mtype="seg" mid="82">Do not check the trolley as baggage when traveling by air, to <x id="124"/><g id="127">reduce the risk of</g> damage to the scanner that may be caused by uncontrolled transportation conditions.</mrk></seg-source><target><mrk mtype="seg" mid="82">Ao viajar de avião, não despache o carrinho como bagagem para <x id="124"/><g id="127">reduzir o risco de</g> danos ao scanner que podem ser causados por condições não controladas de transporte.</mrk></target><sdl:seg-defs><sdl:seg id="82" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:51</sdl:value><sdl:value key="modified_on">06/12/2024 16:12:26</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-323168859</sdl:value><sdl:value key="SegmentIdentityHash">YFFDnoEl0zaP1/IodvmgaxKSxLKNqz824p4aF18eYqQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="70966060-3182-48fe-bbe1-c2906b498579"><source>Optional protective trolley cover</source><seg-source><mrk mtype="seg" mid="83">Optional protective trolley cover</mrk></seg-source><target><mrk mtype="seg" mid="83">Capa protetora do carrinho opcional</mrk></target><sdl:seg-defs><sdl:seg id="83" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/10/2022 09:16:48</sdl:value><sdl:value key="modified_on">11/18/2022 00:27:35</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-571391115</sdl:value><sdl:value key="SegmentIdentityHash">GzMhiw6kSycqnm5l9QJUnqmaa4Q605Sxer0HPfWSWmc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="20dd4607-9f7f-46a6-8ff2-dd634c00a653"><source>The trolley is supplied with an optional protective cover that helps protect it against wear and tear and adverse weather conditions.</source><seg-source><mrk mtype="seg" mid="84">The trolley is supplied with an optional protective cover that helps protect it against wear and tear and adverse weather conditions.</mrk></seg-source><target><mrk mtype="seg" mid="84">O carrinho é fornecido com uma capa protetora opcional que ajuda a protegê-lo contra o desgaste e as condições climáticas adversas.</mrk></target><sdl:seg-defs><sdl:seg id="84" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/22/2021 16:23:55</sdl:value><sdl:value key="modified_on">03/22/2021 16:23:55</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1486631921</sdl:value><sdl:value key="SegmentIdentityHash">e2Yr4jxSy20wgX8lzxVsF3KeNID4EIbHpuMT4srVjHY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2c20565e-6aab-462b-b999-963a42dd1bfc"><source><g id="133">Note:</g> The protective cover provides a certain level of protection against rain, but is not waterproof.</source><seg-source><mrk mtype="seg" mid="85"><g id="133">Note:</g> The protective cover provides a certain level of protection against rain, but is not waterproof.</mrk></seg-source><target><mrk mtype="seg" mid="85"><g id="133">Nota:</g> a capa protetora fornece um certo nível de proteção contra a chuva, mas não é à prova d&apos;água.</mrk></target><sdl:seg-defs><sdl:seg id="85" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:18</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:18</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">989971771</sdl:value><sdl:value key="SegmentIdentityHash">vQekklX1O2w6A8PzJSzHcRbqAyA7GbGviLgdOCBAIe8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="bc3afd9d-585d-4247-a46f-922f832219c2"><source>Open the VELCRO<g id="139">®</g> flap and slip the protective cover (H) over the trolley handle.</source><seg-source><mrk mtype="seg" mid="86">Open the VELCRO<g id="139">®</g> flap and slip the protective cover (H) over the trolley handle.</mrk></seg-source><target><mrk mtype="seg" mid="86">Abra a aba do VELCRO<g id="139">®</g> e deslize a capa protetora (H) sobre a alça do carrinho.</mrk></target><sdl:seg-defs><sdl:seg id="86" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:18</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:18</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2022007597</sdl:value><sdl:value key="SegmentIdentityHash">1BR4LodYZIb9v5CJJWWdKwfe9zMnN5LnXzjAbcyZtH8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="a3225499-c743-42de-8621-2dae2be13d99"><source>Pull down to cover the trolley and then close the VELCRO<g id="145">®</g> flap.</source><seg-source><mrk mtype="seg" mid="87">Pull down to cover the trolley and then close the VELCRO<g id="145">®</g> flap.</mrk></seg-source><target><mrk mtype="seg" mid="87">Puxe para baixo para cobrir o carrinho e, em seguida, feche a aba do VELCRO<g id="145">®</g>.</mrk></target><sdl:seg-defs><sdl:seg id="87" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:18</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:18</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">346807274</sdl:value><sdl:value key="SegmentIdentityHash">3SlPCRbFwNtOol72FO5qJNwh/6hvJ+ZbJ9VWPAh1P3U=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ad17a764-6a7c-4f79-bb4b-f4b22eb9e446"><source>VESA mounting</source><seg-source><mrk mtype="seg" mid="88">VESA mounting</mrk></seg-source><target><mrk mtype="seg" mid="88">Montagem VESA</mrk></target><sdl:seg-defs><sdl:seg id="88" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="tNc2ECYaLKABzlEOfVKuYEO6/Kju013N6k9yMfICGoM="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">01/04/2021 18:46:23</sdl:value><sdl:value key="modified_on">01/04/2021 18:46:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1404709244</sdl:value><sdl:value key="SegmentIdentityHash">tNc2ECYaLKABzlEOfVKuYEO6/Kju013N6k9yMfICGoM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="dd77ea8e-9af2-4062-8277-518edc88647e"><source>The scanner provides a standard 100mm VESA mounting interface that can be used for mounting it using 3rd party VESA-based mounting solutions.</source><seg-source><mrk mtype="seg" mid="89">The scanner provides a standard 100mm VESA mounting interface that can be used for mounting it using 3rd party VESA-based mounting solutions.</mrk></seg-source><target><mrk mtype="seg" mid="89">O scanner fornece uma interface de montagem VESA padrão de 100 mm que pode ser usada para montá-lo usando soluções de montagem VESA de terceiros.</mrk></target><sdl:seg-defs><sdl:seg id="89" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">01/08/2021 02:28:52</sdl:value><sdl:value key="modified_on">01/08/2021 02:28:52</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-812176934</sdl:value><sdl:value key="SegmentIdentityHash">tHOrOLvgEyiyxT8HX+GJaDp2NWQ9X8WFC4B6kVl1HGc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="65001d04-2a0c-4802-8b84-3836f9591f1d"><source>Notes:</source><seg-source><mrk mtype="seg" mid="90">Notes:</mrk></seg-source><target><mrk mtype="seg" mid="90">Notas:</mrk></target><sdl:seg-defs><sdl:seg id="90" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="MV5Vg0NrwdcmWKQ9naRB8KXHXb6LE+trTaKS4OubnEc="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/07/2019 00:22:06</sdl:value><sdl:value key="modified_on">11/19/2020 22:28:16</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-381729265</sdl:value><sdl:value key="SegmentIdentityHash">MV5Vg0NrwdcmWKQ9naRB8KXHXb6LE+trTaKS4OubnEc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="f5ac2018-9394-4756-89f0-d84f873bb8c7"><source>Ensure that the selected VESA mounting solution supports the following scanner specifications:</source><seg-source><mrk mtype="seg" mid="91">Ensure that the selected VESA mounting solution supports the following scanner specifications:</mrk></seg-source><target><mrk mtype="seg" mid="91">Certifique-se de que a solução de montagem VESA selecionada suporta as seguintes especificações do scanner:</mrk></target><sdl:seg-defs><sdl:seg id="91" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">01/04/2021 18:48:25</sdl:value><sdl:value key="modified_on">01/04/2021 18:48:25</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-96397891</sdl:value><sdl:value key="SegmentIdentityHash">iH0EODQa5hydEZ8A8AazKPnd/Cv4oIFG/DXmPYjX2i8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="1a795476-08a8-4d90-b972-8cc96a0172f9"><source>VESA 100mm</source><seg-source><mrk mtype="seg" mid="92">VESA 100mm</mrk></seg-source><target><mrk mtype="seg" mid="92">VESA 100mm</mrk></target><sdl:seg-defs><sdl:seg id="92" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">01/04/2021 18:48:28</sdl:value><sdl:value key="modified_on">01/04/2021 18:48:28</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1076607170</sdl:value><sdl:value key="SegmentIdentityHash">XL2BeF82FgVAxL8Iw80qJXhwWQyYlyKSrQbtZ0ophbA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="11"/><sdl:cxt id="14"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="adc3805f-9893-4588-b461-2844bfc06fb4"><source>Minimum weight: 6kg (including the computing unit, wand, and cradle).<x id="148"/>Recommended weight: 9kg.</source><seg-source><mrk mtype="seg" mid="93">Minimum weight: 6kg (including the computing unit, wand, and cradle).</mrk><mrk mtype="seg" mid="94"><x id="148"/></mrk><mrk mtype="seg" mid="95">Recommended weight: 9kg.</mrk></seg-source><target><mrk mtype="seg" mid="93">Peso mínimo: 6 kg (incluindo a unidade de computação, o leitor e o suporte).</mrk><mrk mtype="seg" mid="94"><x id="148"/></mrk><mrk mtype="seg" mid="95">Peso recomendado: 9kg.</mrk></target><sdl:seg-defs><sdl:seg id="93" locked="true" conf="Translated" origin="tm" origin-sy
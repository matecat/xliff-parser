d="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2cd3a214-3279-40fe-9426-ed49cca36d2d"><source><g id="25">/</g></source><seg-source><mrk mtype="seg" mid="9"><g id="25">/</g></mrk></seg-source><target><mrk mtype="seg" mid="9"><g id="25">/</g></mrk></target><sdl:seg-defs><sdl:seg id="9" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:21</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-178616110</sdl:value><sdl:value key="SegmentIdentityHash">a0LFERgSgfJVMYPamY5oWd0zfaNwJROLPpt5VpRb/wA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="11a720eb-3743-4eb8-8737-9fcdcf364ba8"><source>Displays the status of the <x id="32"/>battery:</source><seg-source><mrk mtype="seg" mid="10">Displays the status of the <x id="32"/>battery:</mrk></seg-source><target><mrk mtype="seg" mid="10">Exibe o estado da bateria<x id="32"/>:</mrk></target><sdl:seg-defs><sdl:seg id="10" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="0V5k1DHA4aVgmCvqW9n0lwzk8Q1Dc6yWLej1qgcNV64="/><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 21:39:24</sdl:value><sdl:value key="modified_on">06/12/2024 16:29:53</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">889055702</sdl:value><sdl:value key="SegmentIdentityHash">0V5k1DHA4aVgmCvqW9n0lwzk8Q1Dc6yWLej1qgcNV64=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="79281381-1041-435c-8623-b77052b211be"><source>A lightning bolt indicates that the scanner is connected to the power, and the battery is charging.</source><seg-source><mrk mtype="seg" mid="11">A lightning bolt indicates that the scanner is connected to the power, and the battery is charging.</mrk></seg-source><target><mrk mtype="seg" mid="11">O ícone de raio indica que o scanner está conectado ao cabo de energia e que a bateria está carregando.</mrk></target><sdl:seg-defs><sdl:seg id="11" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="MtUhsQFxh+Y3FGLItKJ24FaSJ9S+jy6qE53YyeZB+5w="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/18/2022 00:51:54</sdl:value><sdl:value key="modified_on">11/18/2022 00:51:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-691871444</sdl:value><sdl:value key="SegmentIdentityHash">MtUhsQFxh+Y3FGLItKJ24FaSJ9S+jy6qE53YyeZB+5w=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="13"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="439d0d77-6a9f-4c95-85d2-443d539809e9"><source>When using battery power, the remaining charge level is displayed on the battery icon.When the remaining charge level falls below 25%, the battery icon is displayed in red <x id="35"/>.</source><seg-source><mrk mtype="seg" mid="12">When using battery power, the remaining charge level is displayed on the battery icon.</mrk><mrk mtype="seg" mid="13">When the remaining charge level falls below 25%, the battery icon is displayed in red <x id="35"/>.</mrk></seg-source><target><mrk mtype="seg" mid="12">Ao usar a energia da bateria, o nível de carga restante é exibido no ícone da bateria.</mrk><mrk mtype="seg" mid="13">Quando o nível de carga restante estiver abaixo de 25%, o ícone da bateria será exibido em vermelho <x id="35"/>.</mrk></target><sdl:seg-defs><sdl:seg id="12" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="O4mkF0lwu+PLHJXONOKwtQSNgGclug/U93DBGZcXo9s="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/13/2020 07:39:34</sdl:value><sdl:value key="modified_on">10/22/2020 02:41:03</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">211063797</sdl:value><sdl:value key="SegmentIdentityHash">O4mkF0lwu+PLHJXONOKwtQSNgGclug/U93DBGZcXo9s=</sdl:value></sdl:seg><sdl:seg id="13" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="JQepmVDjYK9P8zWn1yh+No4rVL1ryahBKASC4s74VVg="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:21</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1829129478</sdl:value><sdl:value key="SegmentIdentityHash">JQepmVDjYK9P8zWn1yh+No4rVL1ryahBKASC4s74VVg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="14"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="6db62ab9-b5a2-4767-80aa-3c34d8de5299"><source>Tap the battery icon to view the percentage of remaining charge:</source><seg-source><mrk mtype="seg" mid="14">Tap the battery icon to view the percentage of remaining charge:</mrk></seg-source><target><mrk mtype="seg" mid="14">Toque no ícone da bateria para visualizar a porcentagem da carga restante:</mrk></target><sdl:seg-defs><sdl:seg id="14" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/03/2022 17:50:49</sdl:value><sdl:value key="modified_on">11/18/2022 00:52:02</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1181946806</sdl:value><sdl:value key="SegmentIdentityHash">prjaFZp28FKqEMDIUHPNnyoM/Zg+dompf9sCoUKjeak=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="14"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="f843a1b5-6ce2-49aa-bf19-a7d6b6357256"><source><g id="42">Percentage of remaining battery charge</g></source><seg-source><mrk mtype="seg" mid="15"><g id="42">Percentage of remaining battery charge</g></mrk></seg-source><target><mrk mtype="seg" mid="15"><g id="42">Porcentagem de carga restante da bateria</g></mrk></target><sdl:seg-defs><sdl:seg id="15" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:21</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2005593018</sdl:value><sdl:value key="SegmentIdentityHash">7NEF4GiBpJnrlg1v3d/MoWeTdf9oZ2aqcJ6x9bqd96M=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ebe27b3d-ee77-4f41-9adf-fcd07ed507bd"><source><g id="48">Learning Center:</g> Tap to access training materials and educational videos for the iTero scanner.</source><seg-source><mrk mtype="seg" mid="16"><g id="48">Learning Center:</g> Tap to access training materials and educational videos for the iTero scanner.</mrk></seg-source><target><mrk mtype="seg" mid="16"><g id="48">Centro de Aprendizagem:</g> toque para acessar materiais de treinamento e vídeos educativos para o scanner iTero.</mrk></target><sdl:seg-defs><sdl:seg id="16" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:21</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2109044804</sdl:value><sdl:value key="SegmentIdentityHash">YAUV5P3sFnz8UB885pYs+Cn7t0wOgK8UKEY1rcCYo6k=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="a6933465-1c9a-4320-bb0a-d22f48346016"><source><g id="55">Lock:</g> Tap to log out of your account whenever the scanner is not in use, as described in <x id="56"/>.This helps ensure that the dental practice is HIPAA compliant, and that all medical information is secure.</source><seg-source><mrk mtype="seg" mid="17"><g id="55">Lock:</g> Tap to log out of your account whenever the scanner is not in use, as described in <x id="56"/>.</mrk><mrk mtype="seg" mid="18">This helps ensure that the dental practice is HIPAA compliant, and that all medical information is secure.</mrk></seg-source><target><mrk mtype="seg" mid="17"><g id="55">Bloquear:</g> Toque para efetuar logout de sua conta sempre que o scanner não estiver em uso, conforme descrito na <x id="56"/></mrk><mrk mtype="seg" mid="18">Isso ajuda a garantir que a prática odontológica seja compatível com a HIPAA e que todas as informações médicas estejam seguras.</mrk></target><sdl:seg-defs><sdl:seg id="17" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:21</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-960329980</sdl:value><sdl:value key="SegmentIdentityHash">/ONBZ930zFNjbMR+pmhg4vMbw1EcaaTCCfXLaDwRMks=</sdl:value></sdl:seg><sdl:seg id="18" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/18/2022 00:52:12</sdl:value><sdl:value key="modified_on">11/18/2022 00:52:12</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1880603147</sdl:value><sdl:value key="SegmentIdentityHash">8JPaTNCh9I4NZxFpSJAOTIMYS5m9N0owTap/qk2PoeI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="cfe7446c-70ae-4089-90a5-33680fd8c1ee"><source><g id="64">Tip:</g> You should lock the system while cleaning it, in order to avoid unintended entries.</source><seg-source><mrk mtype="seg" mid="19"><g id="64">Tip:</g> You should lock the system while cleaning it, in order to avoid unintended entries.</mrk></seg-source><target><mrk mtype="seg" mid="19"><g id="64">Dica:</g> Você deve bloquear o sistema enquanto efetua a limpeza, para evitar entradas não intencionais.</mrk></target><sdl:seg-defs><sdl:seg id="19" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:21</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:21</sdl:value><sdl:value key="last_modified_
\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-381729265</sdl:value><sdl:value key="SegmentIdentityHash">MV5Vg0NrwdcmWKQ9naRB8KXHXb6LE+trTaKS4OubnEc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="12"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2eb0d90a-47a0-456d-b469-8d41ce2d8a35"><source><x id="20"/><x id="23"/></source><seg-source><mrk mtype="seg" mid="10"><x id="20"/></mrk><mrk mtype="seg" mid="11"><x id="23"/></mrk></seg-source><target><mrk mtype="seg" mid="10"><x id="20"/></mrk><mrk mtype="seg" mid="11"><x id="23"/></mrk></target><sdl:seg-defs><sdl:seg id="10" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="11" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="14"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="9edf42ac-f5c4-4ede-a1ff-fc81121efb60"><source>In order to ensure that you are using the latest version of the iTero software and that all Windows security patches are up to date, a notification is displayed as soon as the software updates are available for installation.For more information on scheduling the installation of these software updates, see <x id="27"/>.</source><seg-source><mrk mtype="seg" mid="12">In order to ensure that you are using the latest version of the iTero software and that all Windows security patches are up to date, a notification is displayed as soon as the software updates are available for installation.</mrk><mrk mtype="seg" mid="13">For more information on scheduling the installation of these software updates, see <x id="27"/>.</mrk></seg-source><target><mrk mtype="seg" mid="12">Para garantir que você esteja usando a última versão do software iTero e que todos os patches de segurança do Windows estejam atualizados, uma notificação será exibida assim que as atualizações de software estiverem disponíveis para instalação.</mrk><mrk mtype="seg" mid="13">Para obter mais informações sobre como agendar a instalação dessas atualizações de software, consulte <x id="27"/>.</mrk></target><sdl:seg-defs><sdl:seg id="12" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/16/2024 12:39:46</sdl:value><sdl:value key="modified_on">06/12/2024 16:29:53</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1906024831</sdl:value><sdl:value key="SegmentIdentityHash">+K6UoZJqPn/WL3zp52+dNUoUjoc/SXu9J3SK+z95nWw=</sdl:value></sdl:seg><sdl:seg id="13" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/16/2024 13:09:05</sdl:value><sdl:value key="modified_on">06/12/2024 16:29:53</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2067779798</sdl:value><sdl:value key="SegmentIdentityHash">3WLvGVV3GHXSfxiXK/2hjfAj7v/5PPhHUxKfR7YzSfI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e2b1fa5d-53f4-4655-9f57-9033dd205833"><source>If you did not shut down the scanner correctly previously, a message will be displayed notifying you of this and will remain until you acknowledge the message by tapping <g id="35">I UNDERSTAND</g>.For more information on shutting down the scanner, see <x id="37"/>.</source><seg-source><mrk mtype="seg" mid="14">If you did not shut down the scanner correctly previously, a message will be displayed notifying you of this and will remain until you acknowledge the message by tapping <g id="35">I UNDERSTAND</g>.</mrk><mrk mtype="seg" mid="15">For more information on shutting down the scanner, see <x id="37"/>.</mrk></seg-source><target><mrk mtype="seg" mid="14">Se você não desligar o scanner corretamente, na próxima vez que fizer login, será exibida uma mensagem notificando-o sobre isso e a mesma permanecerá até que você confirme a mensagem tocando em <g id="35">ENTENDI</g>.</mrk><mrk mtype="seg" mid="15">Para obter mais informações sobre como desligar o scanner, consulte a <x id="37"/>.</mrk></target><sdl:seg-defs><sdl:seg id="14" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:21</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">773569546</sdl:value><sdl:value key="SegmentIdentityHash">27E5K00Y1nTim/TTG2GSqKEGEBoqdrnXR4D8prBWEc4=</sdl:value></sdl:seg><sdl:seg id="15" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:21</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">931621174</sdl:value><sdl:value key="SegmentIdentityHash">/Vis5xVuPdG3bvZTSDTHZabw2i2bUTEsCdeztii4fV4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e8e68218-fd45-4ec3-bbd0-b8705e599b83"><source>Unexpected shutdown notification</source><seg-source><mrk mtype="seg" mid="16">Unexpected shutdown notification</mrk></seg-source><target><mrk mtype="seg" mid="16">Notificação de desligamento inesperado</mrk></target><sdl:seg-defs><sdl:seg id="16" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/13/2020 09:42:27</sdl:value><sdl:value key="modified_on">10/22/2020 03:33:14</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">650279808</sdl:value><sdl:value key="SegmentIdentityHash">fl9KQcvlDCMVZIDPfAE+dL4DAAk+5yZpowzRUvsB8ds=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="3274e7bc-2020-4f9a-9825-77650ee2eb58"><source>To log in to the scanner:</source><seg-source><mrk mtype="seg" mid="17">To log in to the scanner:</mrk></seg-source><target><mrk mtype="seg" mid="17">Para efetuar login no scanner:</mrk></target><sdl:seg-defs><sdl:seg id="17" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/07/2019 01:11:50</sdl:value><sdl:value key="modified_on">12/22/2019 01:05:37</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1640427164</sdl:value><sdl:value key="SegmentIdentityHash">Z3wzbi/uM7NUZTn6LdyJOMI5/XNR2lOv7BKIiBfnsyg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="956f14da-0f55-4d12-8fed-0e0062472abb"><source>Select your username from the <g id="44">Doctor Name</g> drop-down list.</source><seg-source><mrk mtype="seg" mid="18">Select your username from the <g id="44">Doctor Name</g> drop-down list.</mrk></seg-source><target><mrk mtype="seg" mid="18">Selecione seu nome de usuário na lista suspensa <g id="44">Nome do Médico</g>.</mrk></target><sdl:seg-defs><sdl:seg id="18" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:21</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">56363802</sdl:value><sdl:value key="SegmentIdentityHash">gGfKt+z51ZI230Gu6oqbIgwGWxcmTxsUe8hf5Wfpm+o=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="f697ef5e-4fcb-4389-bc04-240af6413a0e"><source>Enter the email address you used when registering with myaligntech.com.Your email address is displayed automatically if you selected the <g id="51">Remember Me</g> check box in a previous login session.</source><seg-source><mrk mtype="seg" mid="19">Enter the email address you used when registering with myaligntech.com.</mrk><mrk mtype="seg" mid="20">Your email address is displayed automatically if you selected the <g id="51">Remember Me</g> check box in a previous login session.</mrk></seg-source><target><mrk mtype="seg" mid="19">Digite o endereço de e-mail usado ao se registrar no myaligntech.com.</mrk><mrk mtype="seg" mid="20">Seu endereço de e-mail é exibido automaticamente se você tiver selecionado a caixa de opção <g id="51">Lembrar-me</g> em uma sessão de login anterior.</mrk></target><sdl:seg-defs><sdl:seg id="19" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/07/2019 01:12:22</sdl:value><sdl:value key="modified_on">12/22/2019 01:05:59</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1277183973</sdl:value><sdl:value key="SegmentIdentityHash">KmSK19CCMDuroA/ADM3HXSk3m33KeIEXazrHtAFY0w0=</sdl:value></sdl:seg><sdl:seg id="20" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:21</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1741133480</sdl:value><sdl:value key="SegmentIdentityHash">EjrzZhP+oFHq+mpS4ooua6pydJvy3Oqjs7wj65sd9ug=</sdl:value></sdl:seg></sdl:seg-def
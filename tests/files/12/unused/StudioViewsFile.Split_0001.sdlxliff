urce>The <x id="26"/> imaging system essential performances are:</source><seg-source><mrk mtype="seg" mid="21">The <x id="26"/> imaging system essential performances are:</mrk></seg-source><target><mrk mtype="seg" mid="21"/></target><sdl:seg-defs><sdl:seg id="21" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">f2iguNtCyFbqCJzW8Uykc4sH9/jUdFCksEem6nHiulo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="24"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7f855937-e335-4bca-b6dc-338ee5aa5a06"><source>Display near‑infrared imaging without interference on the iTero Element 5D Plus touch screen as part of the caries-detection solution.</source><seg-source><mrk mtype="seg" mid="22">Display near‑infrared imaging without interference on the iTero Element 5D Plus touch screen as part of the caries-detection solution.</mrk></seg-source><target><mrk mtype="seg" mid="22"/></target><sdl:seg-defs><sdl:seg id="22" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">ACMPUJ6dxJTiYD1Mw246gFeKt9rre6rdjgkTAGu/bQI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="24"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="9cdb2738-6df8-40e5-bea4-bb2defe0edf7"><source>Stored scan data is accessible and can be displayed.</source><seg-source><mrk mtype="seg" mid="23">Stored scan data is accessible and can be displayed.</mrk></seg-source><target><mrk mtype="seg" mid="23"/></target><sdl:seg-defs><sdl:seg id="23" locked="true" conf="Draft"><sdl:rep id="dqWB+jiMbN3zoYORsseOMqeWjfO0FRAdfTmUZqvS+aA="/><sdl:value key="SegmentIdentityHash">dqWB+jiMbN3zoYORsseOMqeWjfO0FRAdfTmUZqvS+aA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="25"/><sdl:cxt id="26"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="974a7f66-a50c-45a8-915f-
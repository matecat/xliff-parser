</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></ept-props></tag><tag id="141"><bpt name="&lt;MadCap:conditionalText MadCap:conditions=&quot;iTero.Lumina Pro RoW&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;" word-end="false">&lt;bpt id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</bpt><bpt-props><value key="prefix"></value><value key="localName">bpt</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:conditionalText MadCap:conditions=&quot;iTero.Lumina Pro RoW&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">2</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></bpt-props><ept name="&lt;/MadCap:conditionalText&gt;" word-end="false">&lt;ept id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ept><ept-props><value key="prefix"></value><value key="localName">ept</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;/MadCap:conditionalText&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">2</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></ept-props></tag><tag id="0"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;iTero Element 5D and iTero Element 5D Plus Imaging Systems are intraoral scanners intended to provide optical impression (CAD/CAM) features and 3D digital impressions of teeth, oral soft tissue, structure and bite relationship.&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;iTero Element 5D and iTero Element 5D Plus Imaging Systems are intraoral scanners intended to provide optical impression (CAD/CAM) features and 3D digital impressions of teeth, oral soft tissue, structure and bite relationship.&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="3"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;In addition, the iTero Element 5D and iTero Element 5D Plus imaging systems include a NIRI functionality that is used as a diagnostic aid for the detection of interproximal carious lesions above the gingiva and for monitoring the progress of such lesions.&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;In addition, the iTero Element 5D and iTero Element 5D Plus imaging systems include a NIRI functionality that is used as a diagnostic aid for the detection of interproximal carious lesions above the gingiva and for monitoring the progress of such lesions.&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="6"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;Data generated from iTero may be used in conjunction with the CAD/CAM fabrication of dental restorations, orthodontic devices, abutments, and accessories.&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;Data generated from iTero may be used in conjunction with the CAD/CAM fabrication of dental restorations, orthodontic devices, abutments, and accessories.&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="12"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;&lt;bpt id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;span class=&quot;strong&quot;&amp;gt;&lt;/bpt&gt;Note:&lt;ept id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/span&amp;gt;&lt;/ept&gt; iTero NIRI technology is not supported by iTero Element 5D Plus Lite systems (i.e.&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;&lt;bpt id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;span class=&quot;strong&quot;&amp;gt;&lt;/bpt&gt;Note:&lt;ept id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/span&amp;gt;&lt;/ept&gt; iTero NIRI technology is not supported by iTero Element 5D Plus Lite systems (i.e.&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="15"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;iTero Element 5D Plus cart with a Lite SW configuration and iTero Element 5D Plus mobile with a Lite SW configuration).&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;iTero Element 5D Plus cart with a Lite SW configuration and iTero Element 5D Plus mobile with a Lite SW configuration).&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="19"><ph name="&lt;MadCap:variable name=&quot;iTero.ProductNameElement&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot; /&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value
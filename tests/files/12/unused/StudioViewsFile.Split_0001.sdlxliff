" conf="ApprovedTranslation" origin="interactive"><sdl:prev-origin origin="source"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">uowkYyzFlq+dd/1WptOGbsKz+PNkAMGwierglcinoOs=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 18:18:30</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">uowkYyzFlq+dd/1WptOGbsKz+PNkAMGwierglcinoOs=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 17:29:18</sdl:value><sdl:value key="created_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="created_on">08/28/2024 18:18:41</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-778760206</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="19"/><sdl:cxt id="20"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="113dae12-2198-4dc7-ab26-390c289c54b9"><source>iTero Lumina sleeves are suitable for the <x id="71"/> family of products.They are a single-use disposable component intended for use as a cover to the <x id="73"/> scanner wand to reduce the risk of cross-contamination during the scanning procedure and to protect the optical window of the wand.</source><seg-source><mrk mtype="seg" mid="31">iTero Lumina sleeves are suitable for the <x id="71"/> family of products.</mrk><mrk mtype="seg" mid="32">They are a single-use disposable component intended for use as a cover to the <x id="73"/> scanner wand to reduce the risk of cross-contamination during the scanning procedure and to protect the optical window of the wand.</mrk></seg-source><target><mrk mtype="seg" mid="31">As ponteiras do Tero Lumina são adequadas para a família de produtos <x id="71"/>.</mrk><mrk mtype="seg" mid="32">São componentes descartáveis de uso único, utilizado como uma cobertura do leitor do scanner <x id="73"/> para reduzir o risco de contaminação cruzada durante o procedimento de digitalização e para proteger a janela óptica do leitor.</mrk></target><sdl:seg-defs><sdl:seg id="31" conf="ApprovedTranslation" origin="interactive" percent="75"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="75"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">D/+WXXQcdgn15TW1EU1mcp2GrZMDOwY3DRMd2SAtCFc=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 18:19:16</sdl:value><sdl:value key="FuzzyMatchRepair">true</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">D/+WXXQcdgn15TW1EU1mcp2GrZMDOwY3DRMd2SAtCFc=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="FuzzyMatchRepair">true</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1925990382</sdl:value></sdl:seg><sdl:seg id="32" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 15:48:12</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1048211809</sdl:value><sdl:value key="SegmentIdentityHash">CiyijHedmFtqLlcW3n6LTiAIdf9o/H71Eu2rX/cVhbg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="21"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="1122be77-bb6d-4333-9eab-8c38e2bfb769"><source>There are two types of wand sleeves:</source><seg-source><mrk mtype="seg" mid="33">There are two types of wand sleeves:</mrk></seg-source><target><mrk mtype="seg" mid="33">Existem dois tipos de ponteiras do leitor:</mrk></target><sdl:seg-defs><sdl:seg id="33" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/13/2020 14:28:23</sdl:value><sdl:value key="modified_on">11/19/2020 20:49:50</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">656784652</sdl:value><sdl:value key="SegmentIdentityHash">uHbBnHCfD9kuFTo9nGzONWxtCkqTP+hVsO07kpVKgEs=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="22"/><sdl:cxt id="23"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="48899280-13ef-4aea-aa2a-5d012df32908"><source><g id="90">Protective sleeve (<x id="85"/><g id="88">dark</g>):</g> Used when the scanner is not in use, to protect the optical surface of the wand.</source><seg-source><mrk mtype="seg" mid="34"><g id="90">Protective sleeve (<x id="85"/><g id="88">dark</g>):</g> Used when the scanner is not in use, to protect the optical surface of the wand.</mrk></seg-source><target><mrk mtype="seg" mid="34"><g id="90">Ponteira protetora (<x id="85"/><g id="88">escura</g>):</g> utilizada quando o scanner não estiver em uso para proteger a superfície óptica do leitor.</mrk></target><sdl:seg-defs><sdl:seg id="34" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 15:48:12</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1608376756</sdl:value><sdl:value key="SegmentIdentityHash">scqvcovjRrQIxrmcGRh5ZDvLn0x3Ow8nKlwFx6LHZrA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="24"/><sdl:cxt id="25"/><sdl:cxt id="26"/><sdl:cxt id="27"/><sdl:cxt id="28"/><sdl:cxt id="23"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="4476721f-ac49-41cf-bf50-8ca7559696c6"><source><g id="118">Disposable sleeve:</g> Used while scanning.Before scanning the patient, attach a new disposable sleeve, as described in <x id="120"/>.<x id="122"/><g id="131"><g id="126"> </g><g id="129"> </g></g><x id="132"/><x id="133"/>Protective sleeve<x id="134"/><x id="135"/>Disposable sleeve<x id="136"/><x id="137"/><x id="138"/></source><seg-source><mrk mtype="seg" mid="35"><g id="118">Disposable sleeve:</g> Used while scanning.</mrk><mrk mtype="seg" mid="36">Before scanning the patient, attach a new disposable sleeve, as described in <x id="120"/>.</mrk><mrk mtype="seg" mid="37"><x id="122"/><g id="131"><g id="126"> </g><g id="129"> </g></g><x id="132"/><x id="133"/></mrk><mrk mtype="seg" mid="38">Protective sleeve<x id="134"/><x id="135"/></mrk><mrk mtype="seg" mid="39">Disposable sleeve<x id="136"/><x id="137"/><x id="138"/></mrk></seg-source><target><mrk mtype="seg" mid="35"><g id="118">Ponteira descartável:</g> utilizada durante a digitalização.</mrk><mrk mtype="seg" mid="36">Antes de digitalizar o paciente, coloque uma nova ponteira descartável, conforme descrito na <x id="120"/>.</mrk><mrk mtype="seg" mid="37"><x id="122"/><g id="131"><g id="126"> </g><g id="129"> </g></g><x id="132"/><x id="133"/></mrk><mrk mtype="seg" mid="38">Ponteira protetora<x id="134"/><x id="135"/></mrk><mrk mtype="seg" mid="39">Ponteira descartável<x id="136"/><x id="137"/><x id="138"/></mrk></target><sdl:seg-defs><sdl:seg id="35" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">08/08/2024 10:23:16</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-478575814</sdl:value><sdl:value key="SegmentIdentityHash">KotQvmgkSkjDNP5pToBRR5oU
ue><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="70"><ph name="&lt;MadCap:xref href=&quot;../4. Working with the scanner/Defining the User settings.htm#_Ref15816976&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;section 1.0.1.1, page 1&lt;/MadCap:xref&gt;" word-end="false">&lt;ph id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:xref href=&quot;../4. Working with the scanner/Defining the User settings.htm#_Ref15816976&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;section 1.0.1.1, page 1&lt;/MadCap:xref&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">2</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="82"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;If required, you can enable saliva detection for the current scan by pressing on the screen and then tapping &lt;bpt id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;span class=&quot;strong&quot;&amp;gt;&lt;/bpt&gt;Enable Saliva Detection&lt;ept id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/span&amp;gt;&lt;/ept&gt;, as described in &lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;MadCap:xref href=&quot;../10. iTero scanner features and tools/Enabling saliva detection.htm&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&amp;gt;section 1.0.1, page 1&amp;lt;/MadCap:xref&amp;gt;&lt;/ph&gt;.&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;If required, you can enable saliva detection for the current scan by pressing on the screen and then tapping &lt;bpt id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;span class=&quot;strong&quot;&amp;gt;&lt;/bpt&gt;Enable Saliva Detection&lt;ept id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/span&amp;gt;&lt;/ept&gt;, as described in &lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;MadCap:xref href=&quot;../10. iTero scanner features and tools/Enabling saliva detection.htm&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&amp;gt;section 1.0.1, page 1&amp;lt;/MadCap:xref&amp;gt;&lt;/ph&gt;.&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="85"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;You can also enable saliva detection, by default, for all scans, as described in &lt;ph id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;MadCap:xref href=&quot;../4. Working with the scanner/Defining the User settings.htm#_Ref15816976&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&amp;gt;section 1.0.1.1, page 1&amp;lt;/MadCap:xref&amp;gt;&lt;/ph&gt;.&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;You can also enable saliva detection, by default, for all scans, as described in &lt;ph id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;MadCap:xref href=&quot;../4. Working with the scanner/Defining the User settings.htm#_Ref15816976&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&amp;gt;section 1.0.1.1, page 1&amp;lt;/MadCap:xref&amp;gt;&lt;/ph&gt;.&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="88"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;xxx check x-refs xxx&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;xxx check x-refs xxx&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag></tag-defs></header><body><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="cf5f68ee-faf0-4f4d-847e-78ce287ded35"><source>Guidance</source><seg-source><mrk mtype="seg" mid="1">Guidance</mrk></seg-source><target><mrk mtype="seg" mid="1"/></target><sdl:seg-defs><sdl:seg id="1" locked="true" conf="Draft"><sdl:rep id="81Ft66Iy27wnXINeMHPknLkHALOvRLmxz5OvBssUCeI="/><sdl:value key="SegmentIdentityHash">81Ft66Iy27wnXINeMHPknLkHALOvRLmxz5OvBssUCeI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="6adfff38-2799-4041-b7e8-a99d05e8aea7"><source>Scanning guidance</source><seg-source><mrk mtype="seg" mid="2">Scanning guidance</mrk></seg-source><target><mrk mtype="seg" mid="2"/></target><sdl:seg-defs><sdl:seg id="2" locked="true" conf="Draft"><sdl:rep id="5ql52fgVu83HbNOvsdxQ6OcZiIcbhiND8TKMDmQa2uc="/><sdl:value key="SegmentIdentityHash">5ql52fgVu83HbNOvsdxQ6OcZiIcbhiND8TKMDmQa2uc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="b395ee24-162d-4542-9bc0-653802bfa66c"><source>Scanning guidance</source><seg-source><mrk mtype="seg" mid="3">Scanning guidance</mrk></seg-source><target><mrk mtype="seg" mid="3">Orientações para a digitalização</mrk></target><sdl:seg-defs><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="5ql52fgVu83HbNOvsdxQ6OcZiIcbhiND8TKMDmQa2uc="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2019 18:58:04</sdl:value><sdl:value key="modified_on">11/19/2020 20:13:32</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-745821535</sdl:value><sdl:value key="SegmentIdentityHash">5ql52fgVu83HbNOvsdxQ6OcZiIcbhiND8TKMDmQa2uc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="66aa05ec-7d12-48bd-8720-e291254530f5"><source>As soon as you move to Scan mode, the recommended scanning sequence for the selected scan segment is displayed, by default, in the center of the scanner window.It will automatically disappear after a short while, or you can tap anywhere on the screen to hide it.</source><seg-source><mrk mtype="seg" mid="4">As soon as you move to Scan mode, the recommended scanning sequence for the selected scan segment is displayed, by default, in the center of the scanner window.</mrk><mrk mtype="seg" mid="5">It will automatically disappear after a short while, or you can tap anywhere on the screen to hide it.</mrk></seg-source><target><mrk mtype="seg" mid="4">Assim que você passa para o modo Digitalizar, é exibida a sequência de digitalização recomendada para o segmento selecionado, por padrão, no centro da janela do scanner.</mrk><mrk mtype="seg" mid="5">Ela desaparecerá automaticamente após alguns instantes ou você pode tocar em qualquer lugar da tela para ocultá-la.</mrk></target><sdl:seg-defs><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/19/2024 19:30:06</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-984542504</sdl:value><sdl:value key="SegmentIdentityHash">asMiywXfAgc+c4vNnLkFLhcC3trGYeK9G4KhkZUKXZI=</sdl:value></sdl:seg><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/24/2020 15:33:05</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1640602947</sdl:value><sdl:value key="SegmentIdentityHash">VujlxwKqWGxkUX0FLEddIE3ANeDzlvBfhv7sw9/rN6I=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="0fe0020f-cf92-4071-b347-5487a5ee634f"><source>If required, you can disable the scanning guidance for all scans, as described in <x id="3"/>.</source><seg-source><mrk mtype="seg" mid="6">If required, you can disable the scanning guidance for all scans, as described in <x id="3"/>.</mrk></seg-source><target><mrk mtype="seg" mid="6">Se necessário, você pode desativar a orientação para a digitalização para todas as digitalização, conforme descrito em<x id="3"/>.</mrk></target><sdl:seg-defs><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/19/2024 19:30:43</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1024288614</sdl:value><sdl:value key="SegmentIdentityHash">XMh94D01jNnyrPPsJSK7WaW1tOGCL0f1WCmX8adJebw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="10"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="91b99958-3929-4177-a0a5-fe7990e6149e"><source><x id="6"/> supports sequence-free scanning, which means that you do not have to scan according to a set protocol.For more information on working with unstitched scanned segments, see <x id="8"/>.</source><seg-source><mrk mtype="seg" mid="7"><x id="6"/> supports sequence-free scanning, which means that you do not have to scan according to a set protocol.</mrk><mrk mtype="seg" mid="8">For more information on working with unstitched scanned segments, see <x id="8"/>.</mrk></seg-source><target><mrk mtype="seg" mid="7"><x id="6"/> suporta a digitalização sem sequência, o que significa que você não precisa digitalizar de acordo com um protocolo definido.</mrk><mrk mtype="seg" mid="8">Para mais informações sobre como trabalhar com segmentos digitalizados incompletos, consulte <x id="8"/>.</mrk></target><sdl:seg-defs><sdl:seg id="7" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">6464052</sdl:value><sdl:value key="SegmentIdentityHash">B1pxzlk0IHiAO3N6tXSin/fQ6Sq7P6N8pVoRPAiAyq4=</sdl:value></sdl:seg><sdl:seg id="8" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2139881098</sdl:value><sdl:value key="SegmentIdentityHash">gTdKMD35JGwOq+UrrhB65bEwQ4ImZ+YKD3SpJHi9JDo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="70bb1b04-3c9f-4e34-98f2-d0229a25c172"><source>iTero recommends you follow the <x id="13"/>scanning sequence for best results.</source><seg-source><mrk mtype="seg" mid="9">iTero recommends you follow the <x id="13"/>scanning sequence for best results.</mrk></seg-source><target><mrk mtype="seg" mid="9">O iTero recomenda que você siga a <x id="13"/>sequência de digitalização para obter os melhores resultados.</mrk></target><sdl:seg-defs><sdl:seg id="9" conf="ApprovedTranslation" origin="interactive" percent="92"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="92"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">xC7hLyDbGdVai2yDXdq0BdPLxnxmCDrH6d7gmcylPEA=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 19:08:40</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">xC7hLyDbGdVai2yDXdq0BdPLxnxmCDrH6d7gmcylPEA=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:17:12</sdl:value><sdl:value key="SDL:ProjectTranslationHash">2034958812</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2ff08688-faeb-42d7-aab3-82dfa70091a7"><source>Recommended scanning sequence – lower jaw</source><seg-source><mrk mtype="seg" mid="10">Recommended scanning sequence – lower jaw</mrk></seg-source><target><mrk mtype="seg" mid="10">Sequência de digitalização recomendada - mandíbula inferior</mrk></target><sdl:seg-defs><sdl:seg id="10" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/24/2020 15:33:55</sdl:value><sdl:value key="modified_on">10/20/2020 01:34:57</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">49690293</sdl:value><sdl:value key="SegmentIdentityHash">8wlhIG8z0pF8wC90+Gg74nhedQm/V6sRcw7FlgiQujM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="10"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="4c187d62-f2e2-4d8e-988e-ccd913fa3298"><source><g id="26">Note:</g> If you select the <g id="29">Do not show again</g> check box, this guidance will not be displayed in future scans.You can return the guidance by enabling it in the <g id="33">Scan</g> settings, as described in <x id="34"/>.</source><seg-source><mrk mtype="seg" mid="11"><g id="26">Note:</g> If you select the <g id="29">Do not show again</g> check box, this guidance will not be displayed in future scans.</mrk><mrk mtype="seg" mid="12">You can return the guidance by enabling it in the <g id="33">Scan</g> settings, as described in <x id="34"/>.</mrk></seg-source><target><mrk mtype="seg" mid="11"><g id="26">Nota:</g> se você marcar a caixa de seleção <g id="29">Não exibir novamente</g>, esta orientação não será exibida em digitalizações futuras.</mrk><mrk mtype="seg" mid="12">Você pode retornar às orientações ativando-a nas configurações de <g id="33">Digitalização</g> conforme descrito na <x id="34"/>.</mrk></target><sdl:seg-defs><sdl:seg id="11" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1701166965</sdl:value><sdl:value key="SegmentIdentityHash">bD7A5rT+zNVgKYHUZT6Tx8y4ualnmfQ7o4tLlcLTCdo=</sdl:value></sdl:seg><sdl:seg id="12" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:23</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1412094254</sdl:value><sdl:value key="SegmentIdentityHash">1o+q6vlA5JtEyhP7Piv5JaY2tkU25s+KxSR3T48OPyk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e894ff18-853d-4767-a909-6ac6927af8af"><source>In addition, if you press both wand buttons simultaneously, the following guidance is displayed:</source><seg-source><mrk mtype="seg" mid="13">In addition, if you press both wand buttons simultaneously, the following guidance is displayed:</mrk></seg-source><target><mrk mtype="seg" mid="13"/></target><sdl:seg-defs><sdl:seg id="13" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">x38B2lGfUv500NnhfZ5TAgKJgzHiG6lxot5l1SZueL4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ac089cd1-318c-4747-8dee-78194f18abe7"><source>Wand guidance</source><seg-source><mrk mtype="seg" mid="14">Wand guidance</mrk></seg-source><target><mrk mtype="seg" mid="14"/></target><sdl:seg-defs><sdl:seg id="14" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">Y6NHDR2l5Fbpx8p5wcRyCfopJEmAIy5ponQ9J1TNQHw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="1f2e1235-ad7b-410d-8b94-c3698efb5bf0"><source><x id="45"/> <g id="48">Firmly press</g> either of the wand buttons to begin scanning.<g id="52">The wand emits a sound, indicating that scanning has started.</g></source><seg-source><mrk mtype="seg" mid="15"><x id="45"/> <g id="48">Firmly press</g> either of the wand buttons to begin scanning.</mrk><mrk mtype="seg" mid="16"><g id="52">The wand emits a sound, indicating that scanning has started.</g></mrk></seg-source><target><mrk mtype="seg" mid="15"><x id="45"/> <g id="48">Pressione firmemente</g>qualquer um dos botões do leitor para começar a digitalizar.</mrk><mrk mtype="seg" mid="16"><g id="52">O leitor emite um som, indicando que a digitalização foi iniciada.</g></mrk></target><sdl:seg-defs><sdl:seg id="15" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-539606144</sdl:value><sdl:value key="SegmentIdentityHash">+U6A+GjXgxdg0lj8Vd8dRSvlUDmsvMCwlUbMHNsCCn0=</sdl:value></sdl:seg><sdl:seg id="16" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 11:39:09</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1816310204</sdl:value><sdl:value key="SegmentIdentityHash">pv0jpfW/eydW9Ku56cQhqGFY9IvvIHF+0dYv3Lnrcgk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e367b6ba-88fc-4f3c-a142-0ec92b99d570"><source>To allow optimal capturing of the NIR images, the wand should be held 0-3mm above the patient’s teeth.</source><seg-source><mrk mtype="seg" mid="17">To allow optimal capturing of the NIR images, the wand should be held 0-3mm above the patient’s teeth.</mrk></seg-source><target><mrk mtype="seg" mid="17"/></target><sdl:seg-defs><sdl:seg id="17" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">MviMGMWjexMj8sUISvgAFE1GTVkJFNXKKD0pUXDEpoQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="5a6b5aa1-9c7a-4afd-8804-9c4d681c8adb"><source>To allow optimal capturing of 3D images, the wand should be held 4mm above the patient&apos;s teeth.</source><seg-source><mrk mtype="seg" mid="18">To allow optimal capturing of 3D images, the wand should be held 4mm above the patient&apos;s teeth.</mrk></seg-source><target><mrk mtype="seg" mid="18">Para permitir uma captura ideal das imagens 3D, o leitor deve ser mantido entre 4 mm acima dos dentes do paciente.</mrk></target><sdl:seg-defs><sdl:seg id="18" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-871619040</sdl:value><sdl:value key="SegmentIdentityHash">KBSHe3UT0Lx0d7B35oCYTKdB568tWmxVAzFyxyMX2Bs=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="13"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="aabb7107-7677-4c54-8da2-50c7173725e1"><source>Saliva detection</source><seg-source><mrk mtype="seg" mid="19">Saliva detection</mrk></seg-source><target><mrk mtype="seg" mid="19">Detecção de saliva</mrk></target><sdl:seg-defs><sdl:seg id="19" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="r6367YqiFrC/dh5oW6wVeZ/lI1Mec97B4pmmKVHqcDM="/><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/19/2024 21:34:59</sdl:value><sdl:value key="modified_on">06/12/2024 13:58:48</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">221288670</sdl:value><sdl:value key="SegmentIdentityHash">r6367YqiFrC/dh5oW6wVeZ/lI1Mec97B4pmmKVHqcDM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="14"/><sdl:cxt id="15"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="f2a1f429-3f89-4022-8451-3293b406f36f"><source><x id="54"/><x id="57"/></source><seg-source><mrk mtype="seg" mid="20"><x id="54"/></mrk><mrk mtype="seg" mid="21"><x id="57"/></mrk></seg-source><target><mrk mtype="seg" mid="20"><x id="54"/></mrk><mrk mtype="seg" mid="21"><x id="57"/></mrk></target><sdl:seg-defs><sdl:seg id="20" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="21" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="10"/><sdl:cxt id="16"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="5e2f9f73-b6d4-4239-9137-11bbee05bcca"><source>By default, saliva detection during scanning is disabled.If required, you can enable saliva detection for the current scan by pressing on the screen and then tapping <g id="67">Enable Saliva Detection</g>, as described in <x id="68"/>.You can also enable saliva detection, by default, for all scans, as described in <x id="70"/>.</source><seg-source><mrk mtype="seg" mid="22">By default, saliva detection during scanning is disabled.</mrk><mrk mtype="seg" mid="23">If required, you can enable saliva detection for the current scan by pressing on the screen and then tapping <g id="67">Enable Saliva Detection</g>, as described in <x id="68"/>.</mrk><mrk mtype="seg" mid="24">You can also enable saliva detection, by default, for all scans, as described in <x id="70"/>.</mrk></seg-source><target><mrk mtype="seg" mid="22">Por padrão, durante a digitalização, a detecção de saliva fica desativada.</mrk><mrk mtype="seg" mid="23">Se necessário, você pode ativar a detecção de saliva para a digitalização atual, pressionando a tela e, em seguida, tocando em <g id="67">Ativar Detecção de Saliva</g>, conforme descrito em <x id="68"/>.</mrk><mrk mtype="seg" mid="24">Você também pode ativar a detecção de saliva por padrão para todas as digitalizações, conforme descrito em <x id="70"/>.</mrk></target><sdl:seg-defs><sdl:seg id="22" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2113348737</sdl:value><sdl:value key="SegmentIdentityHash">2FyjcBHxAedEjMairgyxxWI5CKvQrE2cB/G1opaE96k=</sdl:value></sdl:seg><sdl:seg id="23" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 11:42:44</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1737444202</sdl:value><sdl:value key="SegmentIdentityHash">TXloD8bzYsLPFE2EMkn7jI0LHrhtubNOQUl9Hm+f3Q0=</sdl:value></sdl:seg><sdl:seg id="24" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1513309066</sdl:value><sdl:value key="SegmentIdentityHash">lwjrHGvblmgUtkWK4mUl90CfA1BnOJa+/58f9EctG7E=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="10"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="b1a95a46-05fc-4a43-ad59-daace0c6d85c"><source>If saliva detection is enabled, when saliva bubbles are detected by the system during the scan, a saliva drop icon appears at the bottom of the screen indicating saliva detection.The area on the 3D model where the saliva was detected is removed, such that a hole is formed on the model&apos;s surface.</source><seg-source><mrk mtype="seg" mid="25">If saliva detection is enabled, when saliva bubbles are detected by the system during the scan, a saliva drop icon appears at the bottom of the screen indicating saliva detection.</mrk><mrk mtype="seg" mid="26">The area on the 3D model where the saliva was detected is removed, such that a hole is formed on the model&apos;s surface.</mrk></seg-source><target><mrk mtype="seg" mid="25">Se a detecção de saliva estiver ativada, quando bolhas de saliva forem detectadas pelo sistema durante a digitalização, um ícone de gota de saliva aparecerá na parte inferior da tela, indicando a detecção de saliva.</mrk><mrk mtype="seg" mid="26">A área do modelo 3D onde a saliva foi detectada é removida, formando um buraco na superfície do modelo.</mrk></target><sdl:seg-defs><sdl:seg id="25" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1239559368</sdl:value><sdl:value key="SegmentIdentityHash">mqOL6qMHS+3711qOd6Y6ROJZ3c1ksSG4t4884OHNNUw=</sdl:value></sdl:seg><sdl:seg id="26" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1755828768</sdl:value><sdl:value key="SegmentIdentityHash">rFQHU7QOEMlnxcGaiQ37ywI8c5Zvf7861zPknG7IyKU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="4434ec6b-6eb1-487e-9e50-abeb1e285db8"><source>Saliva detection – area with saliva bubbles is shown as a hole and a drop icon is displayed</source><seg-source><mrk mtype="seg" mid="27">Saliva detection – area with saliva bubbles is shown as a hole and a drop icon is displayed</mrk></seg-source><target><mrk mtype="seg" mid="27">Detecção de saliva – a área com bolhas de saliva é mostrada como um buraco e um ícone de gota é exibido</mrk></target><sdl:seg-defs><sdl:seg id="27" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">219272402</sdl:value><sdl:value key="SegmentIdentityHash">Iys9cwzD97Eyli1NgpuwHWNRb9EYwIyERt3Tspedd+U=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="10"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="68ce227e-a914-4583-b905-a31bb9a09a9d"><source>All areas with saliva bubbles need to be dried and rescanned before sending the scan.The drop icon reappears when hovering over the area, if the saliva still exists.</source><seg-source><mrk mtype="seg" mid="28">All areas with saliva bubbles need to be dried and rescanned before sending the scan.</mrk><mrk mtype="seg" mid="29">The drop icon reappears when hovering over the area, if the saliva still exists.</mrk></seg-source><target><mrk mtype="seg" mid="28">Todas as áreas com bolhas de saliva precisam ser secas e digitalizadas novamente antes de enviar a digitalização.</mrk><mrk mtype="seg" mid="29">Se ainda houver saliva, ao passar o mouse sobre a área, o ícone de gota reaparecerá.</mrk></target><sdl:seg-defs><sdl:seg id="28" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1081797318</sdl:value><sdl:value key="SegmentIdentityHash">9APzvXndGRZCfXkejA5wElIQ7gGdglLIkuWhzx+EKYM=</sdl:value></sdl:seg><sdl:seg id="29" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-563941027</sdl:value><sdl:value key="SegmentIdentityHash">IM31WVpmvlWl/71UnFuxOkZWyuj/tuQ9Dcat7sDZ9jg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="02f04556-eb54-4dc1-8a5e-bd939f42bfba"><source>When pausing the scan, the area with saliva bubbles is displayed in light blue.</source><seg-source><mrk mtype="seg" mid="30">When pausing the scan, the area with saliva bubbles is displayed in light blue.</mrk></seg-source><target><mrk mtype="seg" mid="30">Ao pausar a digitalização, a área com bolhas de saliva é exibida em azul claro.</mrk></target><sdl:seg-defs><sdl:seg id="30" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1642196128</sdl:value><sdl:value key="SegmentIdentityHash">ABEIWfoFAdAM7nNar/q4+JUpuN82Chj13+6oH8JTVDo=</sdl:value></s
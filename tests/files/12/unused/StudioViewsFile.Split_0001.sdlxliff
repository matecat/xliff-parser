>2</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="79"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;&lt;bpt id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;span class=&quot;strong&quot;&amp;gt;&lt;/bpt&gt;Note for Fixed Restorative and Denture/Removable procedures:&lt;ept id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/span&amp;gt;&lt;/ept&gt; After viewing the scan, return to the &lt;bpt id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;span class=&quot;emphasis&quot;&amp;gt;&lt;/bpt&gt;New Scan&lt;ept id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/span&amp;gt;&lt;/ept&gt; window to fill in any mandatory fields that were not filled in. These fields were not mandatory when scanning the patient but must be filled in before sending the scan.&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;&lt;bpt id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;span class=&quot;strong&quot;&amp;gt;&lt;/bpt&gt;Note for Fixed Restorative and Denture/Removable procedures:&lt;ept id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/span&amp;gt;&lt;/ept&gt; After viewing the scan, return to the &lt;bpt id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;span class=&quot;emphasis&quot;&amp;gt;&lt;/bpt&gt;New Scan&lt;ept id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/span&amp;gt;&lt;/ept&gt; window to fill in any mandatory fields that were not filled in. These fields were not mandatory when scanning the patient but must be filled in before sending the scan.&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="82"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;If there are missing fields when sending the scan, a message is displayed, prompting you to fill in all mandatory fields highlighted in red in the &lt;bpt id=&quot;3&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;span class=&quot;strong&quot;&amp;gt;&lt;/bpt&gt;Treatment Information&lt;ept id=&quot;3&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/span&amp;gt;&lt;/ept&gt; area.&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;If there are missing fields when sending the scan, a message is displayed, prompting you to fill in all mandatory fields highlighted in red in the &lt;bpt id=&quot;3&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;span class=&quot;strong&quot;&amp;gt;&lt;/bpt&gt;Treatment Information&lt;ept id=&quot;3&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/span&amp;gt;&lt;/ept&gt; area.&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag></tag-defs></header><body><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="a42a780b-b4bb-4013-9926-1ae0aaaf177c"><source>Viewing the scan</source><seg-source><mrk mtype="seg" mid="1">Viewing the scan</mrk></seg-source><target><mrk mtype="seg" mid="1"/></target><sdl:seg-defs><sdl:seg id="1" locked="true" conf="Draft"><sdl:rep id="2juI6X+1QNOcgew1X3OmSrwnLpATuujI/6ENcKNXihM="/><sdl:value key="SegmentIdentityHash">2juI6X+1QNOcgew1X3OmSrwnLpATuujI/6ENcKNXihM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="74ec7ddc-3c3f-4f2f-b413-2ac165bea9e1"><source>Scan:Viewing</source><seg-source><mrk mtype="seg" mid="2">Scan:Viewing</mrk></seg-source><target><mrk mtype="seg" mid="2"/></target><sdl:seg-defs><sdl:seg id="2" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">/spnf+3XK02J9/W06WaHwOTzFK6FIhqqvJwvaVWdc9g=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e1a75173-2ae6-40f2-8d60-ae322412edff"><source>Viewing the scan</source><seg-source><mrk mtype="seg" mid="3">Viewing the scan</mrk></seg-source><target><mrk mtype="seg" mid="3">Visualizando a digitalização</mrk></target><sdl:seg-defs><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="2juI6X+1QNOcgew1X3OmSrwnLpATuujI/6ENcKNXihM="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2019 19:02:32</sdl:value><sdl:value key="modified_on">05/31/2020 23:02:18</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1666772975</sdl:value><sdl:value key="SegmentIdentityHash">2juI6X+1QNOcgew1X3OmSrwnLpATuujI/6ENcKNXihM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d1af9a5e-d487-463b-add1-97fe69f69a14"><source>After scanning the patient, tap <x id="1"/> to move to View mode.After the post-processing stage is complete, you can inspect the model in high resolution to ensure that sufficient anatomy has been captured, and that the model is accurate and complete.</source><seg-source><mrk mtype="seg" mid="4">After scanning the patient, tap <x id="1"/> to move to View mode.</mrk><mrk mtype="seg" mid="5">After the post-processing stage is complete, you can inspect the model in high resolution to ensure that sufficient anatomy has been captured, and that the model is accurate and complete.</mrk></seg-source><target><mrk mtype="seg" mid="4">Depois de digitalizar o paciente, toque em <x id="1"/> para passar para o modo Visualizar.</mrk><mrk mtype="seg" mid="5">Após a conclusão da etapa de pós-processamento, você pode inspecionar o modelo em alta resolução para garantir que tenha capturado suficiente anatomia e que o modelo esteja preciso e completo.</mrk></target><sdl:seg-defs><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:24</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:24</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">918171230</sdl:value><sdl:value key="SegmentIdentityHash">TFRO2YKZUl1eibmmermUekT73v4pBD6G+qJXoyDOW6A=</sdl:value></sdl:seg><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/07/2022 13:26:08</sdl:value><sdl:value key="modified_on">11/17/2022 01:24:02</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-982864715</sdl:value><sdl:value key="SegmentIdentityHash">4b1VHFZJavqYvA6zluPKEdUZNxuCTqW0FOJyK5YOpyw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d6d7e1c4-4ea1-487a-aa3d-9feffa293318"><source>If there are missing scan segments or missing bites, a message will be displayed at the beginning of the post‑processing stage notifying you of this and enabling you to go back and add the missing areas of the scan.For more information, see <x id="6"/>.</source><seg-source><mrk mtype="seg" mid="6">If there are missing scan segments or missing bites, a message will be displayed at the beginning of the post‑processing stage notifying you of this and enabling you to go back and add the missing areas of the scan.</mrk><mrk mtype="seg" mid="7">For more information, see <x id="6"/>.</mrk></seg-source><target><mrk mtype="seg" mid="6">Na ocorrência de segmentos de digitalização ausentes ou mordidas ausentes, será exibida uma notificação no início do estágio de pós-processamento, permitindo que você volte e adicione as áreas da digitalização que estejam faltando.</mrk><mrk mtype="seg" mid="7">Para mais informações, consulte <x id="6"/>.</mrk></target><sdl:seg-defs><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/07/2022 13:27:44</sdl:value><sdl:value key="modified_on">11/17/2022 01:24:03</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-910769080</sdl:value><sdl:value key="SegmentIdentityHash">HKJ54+Se6kAorg2fVQF8Tv+7aAjjAVJDavcu7n04Tu0=</sdl:value></sdl:seg><sdl:seg id="7" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="7Ohy1cOz5eX+waPmq2AF23DPmdMlIbw4Gf/7YOWfIqI="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:19</sdl:value><sdl:value key="modified_on">06/12/2024 15:49:36</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1809051878</sdl:value><sdl:value key="SegmentIdentityHash">7Ohy1cOz5eX+waPmq2AF23DPmdMlIbw4Gf/7YOWfIqI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e3ca84b4-98e0-4bb2-972b-c5d2eeca5d50"><source>While viewing the scan, you can:</source><seg-source><mrk mtype="seg" mid="8">While viewing the scan, you can:</mrk></seg-source><target><mrk mtype="seg" mid="8">Ao visualizar a digitalização, você pode:</mrk></target><sdl:seg-defs><sdl:seg id="8" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/09/2019 21:28:45</sdl:value><sdl:value key="modified_on">12/22/2019 18:22:08</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1309237776</sdl:value><sdl:value key="SegmentIdentityHash">QnKOvTTmWpHj5V+z7Ng/Eue0XwxAa0QZT537PowlELE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="500bff07-f64c-4eb9-bdf1-efc56c860ca8"><source>Delete selected areas of a scan, as described in <x id="9"/>.</source><seg-source><mrk mtype="seg" mid="9">Delete selected areas of a scan, as described in <x id="9"/>.</mrk></seg-source><target><mrk mtype="seg" mid="9"/></target><sdl:seg-defs><sdl:seg id="9" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">BJg3oNk6CMzY5CBM6FbDvHGX+1iWj22JC9lzZrq0qW0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="10"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="4ce42b8d-eb66-4f12-92dc-667405641cef"><source>Trim excess tissue from the scan, as described in <x id="11"/>.</source><seg-source><mrk mtype="seg" mid="10">Trim excess tissue from the scan, as described in <x id="11"/>.</mrk></seg-source><target><mrk mtype="seg" mid="10">Cortar o excesso de tecido da digitalização, conforme descrito em <x id="11"/>.</mrk></target><sdl:seg-defs><sdl:seg id="10" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:53</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1256840098</sdl:value><sdl:value key="SegmentIdentityHash">mKv3LvR4F9hU/kT/L3zU+vh+ZSI/h8/bNUFcJ67hDzo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="3abfb7b1-908f-472b-bf88-6ee10c3da445"><source>Manually create the die separation if the green hint point was not on the center of the prepped tooth during scanning, as described in <x id="13"/>.</source><seg-source><mrk mtype="seg" mid="11">Manually create the die separation if the green hint point was not on the center of the prepped tooth during scanning, as described in <x id="13"/>.</mrk></seg-source><target><mrk mtype="seg" mid="11"/></target><sdl:seg-defs><sdl:seg id="11" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">DrP7DHvZNNGAEAcdmA++oIPzUsjURjbYCtcmcC5sfsA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2c85d581-2cd6-40ec-93cf-5d086b7a6712"><source>Define the margin line, as described in <x id="15"/>.</source><seg-source><mrk mtype="seg" mid="12">Define the margin line, as described in <x id="15"/>.</mrk></seg-source><target><mrk mtype="seg" mid="12"/></target><sdl:seg-defs><sdl:seg id="12" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">ombE4JtfNP6ZtvpAcKlKTgNVoYR/qriz/FsuAZsgULI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="38c033ee-a4f7-4d4e-b752-dbad84aab691"><source><g id="42">View an area of interest using the Review tool, as described in </g> <g id="45">.</g><x id="47"/> <x id="48"/> <x id="49"/> <x id="50"/></source><seg-source><mrk mtype="seg" mid="13"><g id="42">View an area of interest using the Review tool, as described in </g> <g id="45">.</g></mrk><mrk mtype="seg" mid="14"><x id="47"/> <x id="48"/> <x id="49"/> <x id="50"/></mrk></seg-source><target><mrk mtype="seg" mid="13"><g id="42">Visualizar uma área de interesse, usando a ferramenta Revisão, conforme descrito em </g> <g id="45">.</g></mrk><mrk mtype="seg" mid="14"><x id="47"/> <x id="48"/> <x id="49"/> <x id="50"/></mrk></target><sdl:seg-defs><sdl:seg id="13" conf="ApprovedTranslation" origin="interactive"><sdl:prev-origin origin="source"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="96"><sdl:prev-origin/><sdl:value key="SegmentIdentity
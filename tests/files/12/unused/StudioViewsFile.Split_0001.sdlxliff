n">10/13/2020 10:44:25</sdl:value><sdl:value key="modified_on">10/22/2020 04:00:02</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1564805998</sdl:value><sdl:value key="SegmentIdentityHash">XW21O1tkuR+F5+2/dIhaY/scD7YetAg5B+Dzyb8ljEY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e3981476-0312-4037-b8d8-489fc28c6145"><source><g id="44">Note:</g> Replace cleaning and disinfection materials (brushes/wipes) if visibly damaged or soiled.</source><seg-source><mrk mtype="seg" mid="13"><g id="44">Note:</g> Replace cleaning and disinfection materials (brushes/wipes) if visibly damaged or soiled.</mrk></seg-source><target><mrk mtype="seg" mid="13"><g id="44">Nota:</g> substitua os materiais de limpeza e desinfecção (escovas/lenços) se estiverem visivelmente danificados ou sujos.</mrk></target><sdl:seg-defs><sdl:seg id="13" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="glAETUxYAUIkjNvAmI3EkRn9APxuqLdF1wlv7y3cGcY="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:16</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:16</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-946997791</sdl:value><sdl:value key="SegmentIdentityHash">glAETUxYAUIkjNvAmI3EkRn9APxuqLdF1wlv7y3cGcY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="83f91848-787d-44b3-9b66-c528a20c7f61"><source>Before starting the cleaning and disinfection procedure, put on your PPE.</source><seg-source><mrk mtype="seg" mid="14">Before starting the cleaning and disinfection procedure, put on your PPE.</mrk></seg-source><target><mrk mtype="seg" mid="14">Antes de iniciar o procedimento de limpeza e desinfecção, coloque seu EPI.</mrk></target><sdl:seg-defs><sdl:seg id="14" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="vIVT1q/qhOUF0hOjovlrY3XcytK55TwuFBVJ5JvSIcw="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/29/2020 10:11:09</sdl:value><sdl:value key="modified_on">06/04/2020 16:17:17</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">223780906</sdl:value><sdl:value key="SegmentIdentityHash">vIVT1q/qhOUF0hOjovlrY3XcytK55TwuFBVJ5JvSIcw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group></body></file><file original="C:\Data\My Documents\Studio 2011\Projects\222818 Rev.3 LuminaPro-pt-BR\en-US\222818 Rev.3 LuminaPro-pt-BR_1\Content\11. Care and maintenance\A3.2_Cradle cleaning and disinfection.htm.xlf" datatype="x-sdlfilterframework2" source-language="en-us" target-language="pt-br"><header><reference><internal-file form="base64">UEsDBBQAAAAIACU0GVlpda81CAoAAI+UAAAQAAAAZnFheTIycXIueGczLnhsZu1d647buBX+v8C+

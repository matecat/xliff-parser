e><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;If the vent cover is damaged or you are unable to secure it in place, replace it with one of the spare vent covers that were shipped with the system.&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="33"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;For more information on replacing the vent cover, see &lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;MadCap:xref href=&quot;#Removing&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&amp;gt;section 1.0.1.1, page 1&amp;lt;/MadCap:xref&amp;gt;&lt;/ph&gt; below.&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;For more information on replacing the vent cover, see &lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;MadCap:xref href=&quot;#Removing&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&amp;gt;section 1.0.1.1, page 1&amp;lt;/MadCap:xref&amp;gt;&lt;/ph&gt; below.&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="48"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;&lt;bpt id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;MadCap:conditionalText MadCap:conditions=&quot;iTero.Not Lumina&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&amp;gt;&lt;/bpt&gt;blue&lt;ept id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/MadCap:conditionalText&amp;gt;&lt;/ept&gt;&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;&lt;bpt id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;MadCap:conditionalText MadCap:conditions=&quot;iTero.Not Lumina&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&amp;gt;&lt;/bpt&gt;blue&lt;ept id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/MadCap:conditionalText&amp;gt;&lt;/ept&gt;&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="53"><ph name="&lt;MadCap:xref href=&quot;A3.0_Cradle_Cleaning and disinfecting_2.htm#_Ref24291822&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;section 1.1, page 1&lt;/MadCap:xref&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:xref href=&quot;A3.0_Cradle_Cleaning and disinfecting_2.htm#_Ref24291822&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;section 1.1, page 1&lt;/MadCap:xref&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag></tag-defs></header><body><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="6b4bd9de-3e8e-4a90-8d7a-3ce9773973ff"><source>Storage and maintenance</source><seg-source><mrk mtype="seg" mid="1">Storage and maintenance</mrk></seg-source><target><mrk mtype="seg" mid="1">Armazenamento e manutenção</mrk></target><sdl:seg-defs><sdl:seg id="1" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="IWLFturoBaKVitt0FlN7+t5zlc4ccrZoGYfx1+FA0NY="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/28/2020 08:53:18</sdl:value><sdl:value key="modified_on">10/22/2020 03:29:28</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1598238510</sdl:value><sdl:value key="SegmentIdentityHash">IWLFturoBaKVitt0FlN7+t5zlc4ccrZoGYfx1+FA0NY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="77e4e0f5-fd80-42dd-a52d-3be130f31967"><source>Visually inspect the wand for any noticeable damage, for example, deterioration such as corrosion, discoloration, pitting, or cracks.Pay special attention to the optical surface, making sure it remains clean.</source><seg-source><mrk mtype="seg" mid="2">Visually inspect the wand for any noticeable damage, for example, deterioration such as corrosion, discoloration, pitting, or cracks.</mrk><mrk mtype="seg" mid="3">Pay special attention to the optical surface, making sure it remains clean.</mrk></seg-source><target><mrk mtype="seg" mid="2">Inspecione visualmente o leitor para checar se há danos perceptíveis como, por exemplo, deterioração, corrosão, descoloração, furos ou rachaduras.</mrk><mrk mtype="seg" mid="3">Preste atenção especialmente à superfície óptica, certificando-se de que a mesma permanece limpa.</mrk></target><sdl:seg-defs><sdl:seg id="2" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="2mZDveHoJ1hKAZoBRtwLC4cM4QrnT3cxN5zsNqycDEw="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/09/2020 09:56:44</sdl:value><sdl:value key="modified_on">11/19/2020 19:42:02</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1843770648</sdl:value><sdl:value key="SegmentIdentityHash">2mZDveHoJ1hKAZoBRtwLC4cM4QrnT3cxN5zsNqycDEw=</sdl:value></sdl:seg><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/22/2020 03:30:00</sdl:value><sdl:value key="modified_on">11/19/2020 23:10:51</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1306511967</sdl:value><sdl:value key="SegmentIdentityHash">3UlH9uc/gfTZOXIdko2P1yZ111cptrHJKFbzfJ9pDEk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="8"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d911d6cb-4e92-4797-a8b3-8bc8d9151b94"><source>If damage is found, see the <g id="8">Scanner warnings<
match the search criteria.</mrk></seg-source><target><mrk mtype="seg" mid="4">Quando procura um paciente existente, é preciso inserir pelo menos 3 caracteres do nome do paciente no campo de pesquisa para ver uma lista de pacientes que correspondem com os critérios de pesquisa.</mrk></target><sdl:seg-defs><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2022 11:20:36</sdl:value><sdl:value key="modified_on">12/06/2022 11:20:36</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">149109445</sdl:value><sdl:value key="SegmentIdentityHash">H42kC/f/yZCCRtlz7S5QZd7FNTsB4PKajKUgogVh03Q=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d1456629-0b85-485b-a125-a87e75f309ac"><source>In addition, you can search for a patient from the <g id="6">Patients</g> page, described in <x id="7"/>.</source><seg-source><mrk mtype="seg" mid="5">In addition, you can search for a patient from the <g id="6">Patients</g> page, described in <x id="7"/>.</mrk></seg-source><target><mrk mtype="seg" mid="5">Além disso, você pode pesquisar pacientes na página <g id="6">Pacientes</g>, conforme descrito na <x id="7"/>.</mrk></target><sdl:seg-defs><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:22</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:22</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">75887506</sdl:value><sdl:value key="SegmentIdentityHash">2VVV062
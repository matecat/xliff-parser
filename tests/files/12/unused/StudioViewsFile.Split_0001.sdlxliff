d="8"/>.</mrk></target><sdl:seg-defs><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/08/2022 16:48:04</sdl:value><sdl:value key="modified_on">11/18/2022 00:31:40</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">335041530</sdl:value><sdl:value key="SegmentIdentityHash">tpPEsJ3zH5Rsg2pRTetfbPapHkIVSqmAeo5VkZoOnrM=</sdl:value></sdl:seg><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:22</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:22</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">394424950</sdl:value><sdl:value key="SegmentIdentityHash">TIvWQV/pRaWWEXQCJgl9oWY/9wquPEygF2KirFBB65E=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="cf7e2503-0545-4eed-a093-d377ac2a5355"><source>In addition, you can add new patients using MyiTero or your Dental Program Management Services (DPMS) software.</source><seg-source><mrk mtype="seg" mid="7">In addition, you can add new patients using MyiTero or your Dental Program Management Services (DPMS) software.</mrk></seg-source><target><mrk mtype="seg" mid="7">Além disso, você pode adicionar novos pacientes, usando o MyiTero ou o seu software de Serviços de Gerenciamento de Programas Odontológicos (DPMS).</mrk></target><sdl:seg-defs><sdl:seg id="7" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/08/2022 17:09:16</sdl:value><sdl:value key="modified_on">06/12/2024 17:53:39</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1979839216</sdl:value><sdl:value key="SegmentIdentityHash">eXbfJOHFEUZilsBm9yzctfQkkLvLZV80HvLRBW9KQU8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="b2df4414-8b6f-4b5f-8c24-4e7566fe2fbc"><source>To add a new patient:</source><seg-source><mrk mtype="seg" mid="8">To add a new patient:</mrk></seg-source><target><mrk mtype="seg" mid="8">Adicionar um novo paciente:</mrk></target><sdl:seg-defs><sdl:seg id="8" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/01/2020 14:28:27</sdl:value><sdl:value key="modified_on">10/21/2020 19:43:52</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1213724957</sdl:value><sdl:value key="SegmentIdentityHash">k9hcU+A+VqlTv0Lfc0Wt3J4g2hLUsYhHbinf2CTegQg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="463e3e05-c866-4096-88d0-b34adb131571"><source>In the <g id="18">New Scan</g> window, in the <g id="21">Patient</g> area, enter the patient&apos;s first name and last name.</source><seg-source><mrk mtype="seg" mid="9">In the <g id="18">New Scan</g> window, in the <g id="21">Patient</g> area, enter the patient&apos;s first name and last name.</mrk></seg-source><target><mrk mtype="seg" mid="9">Na área <g id="21">Paciente</g> da janela <g id="18">Nova Digitalização</g>, insira o primeiro nome e o sobrenome do paciente.</mrk></target><sdl:seg-defs><sdl:seg id="9" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:22</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:22</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2088045778</sdl:value><sdl:value key="SegmentIdentityHash">1UJEQTe4zjYoi3JuD0kdY3DR5zoOVteGD5xcO6mJ8EM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="651849ec-3a76-4c0e-b927-ac871b8c220d"><source>If required, enter the patient&apos;s date of birth, select the patient&apos;s gender, and enter a unique identifier as the patient&apos;s chart number.</source><seg-source><mrk mtype="seg" mid="10">If required, enter the patient&apos;s date of birth, select the patient&apos;s gender, and enter a unique identifier as the patient&apos;s chart number.</mrk></seg-source><target><mrk mtype="seg" mid="10">Se necessário, insira a data de nascimento do paciente, selecione o gênero do paciente e insira um identificador exclusivo como o número do prontuário do paciente.</mrk></target><sdl:seg-defs><sdl:seg id="10" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 11:29:42</sdl:value><sdl:value key="modified_on">06/12/2024 17:53:39</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-123136808</sdl:value><sdl:value key="SegmentIdentityHash">CulwcCg7KIg97uZUWbSKDaYAugFde2cJEu2nqAN8Se8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ae36f292-091a-4bd5-b98d-571e2e754dcd"><source><g id="28">Note:</g> By default, the date is written in DD/MM/YYYY format.If required, you can change the date format, as described in <x id="30"/>.</source><seg-source><mrk mtype="seg" mid="11"><g id="28">Note:</g> By default, the date is written in DD/MM/YYYY format.</mrk><mrk mtype="seg" mid="12">If required, you can change the date format, as described in <x id="30"/>.</mrk></seg-source><target><mrk mtype="seg" mid="11"><g id="28">Nota:</g> por padrão, a data é escrita no formato DD/MM/AA.</mrk><mrk mtype="seg" mid="12">Se necessário, você pode alterar o formato da data, conforme descrito na <x id="30"/>.</mrk></target><sdl:seg-defs><sdl:seg id="11" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 16:20:31</sdl:value><sdl:value key="modified_on">06/12/2024 17:53:39</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">161182496</sdl:value><sdl:value key="SegmentIdentityHash">kIB4n6PXbB1nCYiqsL+Nir4QZRCeua48KXhKskgTgoU=</sdl:value></sdl:seg><sdl:seg id="12" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 16:22:08</sdl:value><sdl:value key="modified_on">06/12/2024 17:53:39</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1905318146</sdl:value><sdl:value key="SegmentIdentityHash">/6VKKU+wTDTLckY77YhsjfvIhwDSWdbnoo6OIiva7nk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ce87ca75-fe3b-499f-b464-94e8605f0b6c"><source>The new patient&apos;s details are displayed in the <g id="40">Patient</g> area of the <g id="43">New Scan</g> window.</source><seg-source><mrk mtype="seg" mid="13">The new patient&apos;s details are displayed in the <g id="40">Patient</g> area of the <g id="43">New Scan</g> window.</mrk></seg-source><target><mrk mtype="seg" mid="13">Os dados do novo paciente são exibidos na área <g id="40">Paciente</g> da janela <g id="43">Nova Digitalização</g>.</mrk></target><sdl:seg-defs><sdl:seg id="13" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:22</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:22</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1230474270</sdl:value><sdl:value key="SegmentIdentityHash">eR4SjTzV44WNvDzC/NUUFW4jluakzQdIju/6LshYsbk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7c006f9f-fb5a-4fd9-a36e-7caf6eb511e3"><source>Adding a new patient</source><seg-source><mrk mtype="seg" mid="14">Adding a new patient</mrk></seg-source><target><mrk mtype="seg" mid="14">Adicionando um novo paciente</mrk></target><sdl:seg-defs><sdl:seg id="14" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 09:02:39</sdl:value><sdl:value key="modified_on">11/18/2022 00:31:55</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2002925268</sdl:value><sdl:value key="SegmentIdentityHash">7Y/FfRQXthyvqn8atCrSr1w7NIBxheZwOJzGHsvyPGw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="6963e88c-d18b-4d79-b9f7-d0f895601cac"><source><g id="58">Note:</g> If you try adding a patient who already exists, the <g id="61">First Name</g>, <g id="64">Last Name</g>, and <g id="67">Chart Number</g> fields are highlighted, and a message is displayed notifying you that a patient with the same details already exists.</source><seg-source><mrk mtype="seg" mid="15"><g id="58">Note:</g> If you try adding a patient who already exists, the <g id="61">First Name</g>, <g id="64">Last Name</g>, and <g id="67">Chart Number</g> fields are highlighted, and a message is displayed notifying you that a patient with the same details already exists.</mrk></seg-source><target><mrk mtype="seg" mid="15"><g id="58">Nota:</g> se você tentar adicionar um paciente já existente, os campos <g id="61">Nome</g>, <g id="64">Sobrenome</g>e <g id="67">Número do Gráfico</g> serão destacados e será exibida uma mensagem, notificando que já existe um paciente com os mesmos dados.</mrk></target><sdl:seg-defs><sdl:seg id="15" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:22</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:22</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">283800251</sdl:value><sdl:value key="SegmentIdentityHash">tpZK+cy++UCUgfchhFlSG3tx1F7O92Q/+zKCg3uNWSM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2650fd32-3262-45ea-a807-88fa567879bb"><source>Message notifying that a patient with the same details exists</source><seg-source><mrk mtype="seg" mid="16">Message notifying that a patient with the same details exists</mrk></seg-source><target><mrk mtype="seg" mid="16">Mensagem notificando que existe um paciente com os mesmos dados</mrk></target><sdl:seg-defs><sdl:seg id="16" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/30/2020 08:01:19</sdl:value><sdl:value key="modified_on">10/21/2020 19:47:35</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1636317999</sdl:value><sdl:value key="SegmentIdentityHash">sF5X2wA3lEaWe9XcI5bFPZ7qup6QpsRwdf4C5DyuM5c=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="80e752e1-2537-4bc7-9b8a-7ae3d63bcdcc"><source>If the new patient and the existing patient are the same person, tap <g id="73">Load existing patient</g>.</source><seg-source><mrk mtype="seg" mid="17">If the new patient and the existing patient are the same person, tap <g id="73">Load existing patient</g>.</mrk></seg-source><target><mrk mtype="seg" mid="17">Se o novo paciente e o paciente existente forem a mesma pessoa, toque em <g id="73">Carregar paciente existente</g>.</mrk></target><sdl:seg-defs><sdl:seg id="17" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:22</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:22</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1200822950</sdl:value><sdl:value key="SegmentIdentityHash">NtS4ANhlnvzWuL1GrqfbIfJVjvgxx700V61aS3yXzZA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="37e77622-959a-4b05-9c5b-26c620de1c5d"><source>If the new patient and the existing patient are different people, edit the highlighted fields – First Name, Last Name, or Chart Number – to create a new patient.</source><seg-source><mrk mtype="seg" mid="18">If the new patient and the existing patient are different people, edit the highlighted fields – First Name, Last Name, or Chart Number – to create a new patient.</mrk></seg-source><target><mrk mtype="seg" mid="18">Se o novo paciente e o paciente existente forem pessoas diferentes, edite os campos destacados – Nome, Sobrenome ou Número do Gráfico – para criar um novo paciente.</mrk></target><sdl:seg-defs><sdl:seg id="18" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 09:07:19</sdl:value><sdl:value key="modified_on">11/18/2022 00:32:00</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1016027650</sdl:value><sdl:value key="SegmentIdentityHash">ZR0Npnn1VToEEE7eif/TS8CzAkCaGq1HbFLtZccqtP0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e3106dc0-10ce-4267-a6b8-df1f9c422637"><source>The patient&apos;s details are displayed in the <g id="79">New Scan</g> window.</source><seg-source><mrk mtype="seg" mid="19">The patient&apos;s details are displayed in the <g id="79">New Scan</g> window.</mrk></seg-source><target><mrk mtype="seg" mid="19">Os dados do paciente são exibidos na janela <g id="79">Nova Digitalização</g>.</mrk></target><sdl:seg-defs><sdl:seg id="19" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:22</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:22</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-118522434</sdl:value><sdl:value key="SegmentIdentityHash">RMlPhlj5zouDx77vddIMzUlDLKzrzN15JPi9cSkuXn8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group></body></file><file original="C:\Data\My Documents\Studio 2011\Projects\222818 Rev.3 LuminaPro-pt-BR\en-US\222818 Rev.3 LuminaPro-pt-BR_1\Content\Resources\Snippets\AdditionalInformation.flsnp.xlf" datatype="x-sdlfilterframework2" source-language="en-us" target-language="pt-br"><header><reference><internal-file form="base64">UEsDBBQAAAAIACU0GVlxOhcBkQQAAH0eAAAQAAAAZGN2d3dnbmcuZnBxLnhsZu1Z3W7bNhS+L9B3

SDL:OriginalTranslationHash">1412552983</sdl:value><sdl:value key="SegmentIdentityHash">PspaAN+Bt4MMAmL15UKEvHDiCE/2D5p4nf7ei0fgnZw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="f66df9fd-9ae8-4c11-99ae-801bdf78dcdf"><source>As soon as you lift your finger, the selected area is removed, and the scan tool <x id="43"/> is enabled.</source><seg-source><mrk mtype="seg" mid="17">As soon as you lift your finger, the selected area is removed, and the scan tool <x id="43"/> is enabled.</mrk></seg-source><target><mrk mtype="seg" mid="17">Assim que você levanta o dedo, a área selecionada é removida e a ferramenta de digitalização <x id="43"/> é ativada.</mrk></target><sdl:seg-defs><sdl:seg id="17" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 15:49:36</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1708805906</sdl:value><sdl:value key="SegmentIdentityHash">tnBPx+bjybAVH9Lm4dUYXHIWRF5UcnWmjk2zEQMQysQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="36310426-251a-4f76-ae07-c295e28e7d79"><source>Selected area removed, and scan tool enabled</source><seg-source><mrk mtype="seg" mid="18">Selected area removed, and scan tool enabled</mrk></seg-source><target><mrk mtype="seg" mid="18">Área selecionada removida e ferramenta de digitalização ativada</mrk></target><sdl:seg-defs><sdl:seg id="18" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:26</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:26</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">921368967</sdl:value><sdl:value key="SegmentIdentityHash">dB5WV6wcEfua9X7twsrqTewBubUULSBAZ/lXnLE7w1o=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="9735dea4-7916-45eb-ba27-f8c68183272c"><source>If required, tap <x id="45"/> to undo the deletion.</source><seg-source><mrk mtype="seg" mid="19">If required, tap <x id="45"/> to undo the deletion.</mrk></seg-source><target><mrk mtype="seg" mid="19">Se necessário, toque em <x id="45"/> para desfazer a exclusão.</mrk></target><sdl:seg-defs><sdl:seg id="19" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:26</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:26</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-147153589</sdl:value><sdl:value key="SegmentIdentityHash">jqrFC+k+2EJwFCiaMFs+8x+tr0pYyJobNU6RcEPKAqw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="10"/><sdl:cxt id="12"/><sdl:cxt id="13"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="9e89a6bd-4de0-41b5-ba38-5e173f6dc0f7"><source>Tap <x id="50"/> to return to Scan mode and rescan the deleted area.<x id="52"/><x id="55"/><x id="58"/></source><seg-source><mrk mtype="seg" mid="20">Tap <x id="50"/> to return to Scan mode and rescan the deleted area.</mrk><mrk mtype="seg" mid="21"><x id="52"/></mrk><mrk mtype="seg" mid="22"><x id="55"/></mrk><mrk mtype="seg" mid="23"><x id="58"/></mrk></seg-source><target><mrk mtype="seg" mid="20">Toque em <x id="50"/> para retornar ao modo Digitalização e digitalizar novamente a área excluída.</mrk><mrk mtype="seg" mid="21"><x id="52"/></mrk><mrk mtype="seg" mid="22"><x id="55"/></mrk><mrk mtype="seg" mid="23"><x id="58"/></mrk></target><sdl:seg-defs><sdl:seg id="20" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 22:31:18</sdl:value><sdl:value key="modified_on">06/12/2024 15:49:36</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-125179716</sdl:value><sdl:value key="SegmentIdentityHash">Ya8WFqJAQsX1px5Mb9xzaL7Z6dnm0TZZr4i9vm+thws=</sdl:value></sdl:seg><sdl:seg id="21" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="22" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:val
oque para obter assistência remota do Suporte ao Cliente.</mrk><mrk mtype="seg" mid="27">O Suporte ao Cliente está disponível em todas as sobreposições da tela de Ajuda.</mrk><mrk mtype="seg" mid="28"><x id="100"/></mrk><mrk mtype="seg" mid="29"><g id="103">Nota:</g> Entre em contato com o Suporte ao Cliente antes de tentar se conectar remotamente.</mrk></target><sdl:seg-defs><sdl:seg id="26" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="ae+HE0p76DCb7ruDFEpLAn2ke0U5UJuWli2x1Nwg4S4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/13/2020 07:44:46</sdl:value><sdl:value key="modified_on">10/22/2020 03:28:07</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1420321029</sdl:value><sdl:value key="SegmentIdentityHash">ae+HE0p76DCb7ruDFEpLAn2ke0U5UJuWli2x1Nwg4S4=</sdl:value></sdl:seg><sdl:seg id="27" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="4lXjCFEdQpLHxK6I+++49TJiSHYTrA81Vzg11gG8zh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/15/2020 14:03:29</sdl:value><sdl:value key="modified_on">05/31/2020 19:21:59</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1884213166</sdl:value><sdl:value key="SegmentIdentityHash">4lXjCFEdQpLHxK6I+++49TJiSHYTrA81Vzg11gG8zh4=</sdl:value></sdl:seg><sdl:seg id="28" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modi
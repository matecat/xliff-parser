ed, you can turn off this functionality for the current scan.</mrk></seg-source><target><mrk mtype="seg" mid="4">Por padrão, durante a digitalização é removido o excesso de tecido em torno das extremidades do modelo 3D.</mrk><mrk mtype="seg" mid="5">Se necessário, você pode destivar esta funcionalidade para a digitalização atual.</mrk></target><sdl:seg-defs><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/10/2022 16:50:02</sdl:value><sdl:value key="modified_on">11/10/2022 16:50:02</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-140794179</sdl:value><sdl:value key="SegmentIdentityHash">Z5oOxAjmndPuj759Shdopq73OJ9iJvdS07yAbyvfzA0=</sdl:value></sdl:seg><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 12:44:04</sdl:value><sdl:value key="modified_on">11/18/2022 00:34:07</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1165678940</sdl:value><sdl:value key="SegmentIdentityHash">aiN6XJBC0m8s8PXM4vR5sOnxCztngBdUhkA2yKkrGQM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="df8f9f8a-27bd-4cb7-b748-0ffbc77b3a47"><source>Notes:</source><seg-source><mrk mtype="seg" mid="6">Notes:</mrk></seg-source><target><mrk mtype="seg" mid="6">Notas:</mrk></target><sdl:seg-defs><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="MV5Vg0NrwdcmWKQ9naRB8KXHXb6LE+trTaKS4Ou
lue key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="169"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;&lt;bpt id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;MadCap:conditionalText MadCap:conditions=&quot;iTero.aNGie&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&amp;gt;&lt;/bpt&gt;&apos;aNGie&apos;&lt;ept id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/MadCap:conditionalText&amp;gt;&lt;/ept&gt;&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;&lt;bpt id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;MadCap:conditionalText MadCap:conditions=&quot;iTero.aNGie&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&amp;gt;&lt;/bpt&gt;&apos;aNGie&apos;&lt;ept id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/MadCap:conditionalText&amp;gt;&lt;/ept&gt;&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag></tag-defs></header><body><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="f9b965cc-c89a-4675-89e3-c3b1a1c5e838"><source>WhitepaperSecurity whitepaper</source><seg-source><mrk mtype="seg" mid="1">Whitepaper</mrk><mrk mtype="seg" mid="2">Security whitepaper</mrk></seg-source><target><mrk mtype="seg" mid="1"/><mrk mtype="seg" mid="2"/></target><sdl:seg-defs><sdl:seg id="1" locked="true" conf="Draft"><sdl:rep id="/bPeMnqfq0L+qunUJJn4GM0XlfLSE/4ZpTLrhZh9RS0="/><sdl:value key="SegmentIdentityHash">/bPeMnqfq0L+qunUJJn4GM0XlfLSE/4ZpTLrhZh9RS0=</sdl:value></sdl:seg><sdl:seg id="2" locked="true" conf="Draft"><sdl:rep id="6cez9XNlEDFkUZlleSg85O/FI3VnlD13KsxlPDrHt+w="/><sdl:value key="SegmentIdentityHash">6cez9XNlEDFkUZlleSg85O/FI3VnlD13KsxlPDrHt+w=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="7"/><sdl:cxt id="8"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="ad97aaf9-3f88-45e5-b48c-cf6e7d8297e4"><source>iTero <g id="8">Lumina</g><x id="9"/> Family product security whitepaper</source><seg-source><mrk mtype="seg" mid="3">iTero <g id="8">Lumina</g><x id="9"/> Family product security whitepaper</mrk></seg-source><target><mrk mtype="seg" mid="3">Documento de segurança da família de produtos iTero <g id="8">Lumina</g><x id="9"/></mrk></target><sdl:seg-defs><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 21:55:38</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">579130228</sdl:value><sdl:value key="SegmentIdentityHash">ecM/rVw1/LbfcVc9Ho5mq8T0QQL+cEHRBbuvleyzpYg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="7"/><sdl:cxt id="9"/><sdl:cxt id="10"/><sdl:cxt id="11"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="a21a79b8-48e7-4b2a-8dac-864c9ad68d79"><source><g id="33">This whitepaper applies to the iTero </g> <g id="39"><g id="37">Lumina</g> </g> <x id="40"/><x id="41"/> Family of products.Depending on the version of the product you have procured, there may be differences in the features of the product.In addition, as this whitepaper was created at a point-in-time, changes may have occurred in Align Technology’s product security practices to address evolution and maturation in the product security ecosystem.<x id="44"/><x id="46"/></source><seg-source><mrk mtype="seg" mid="4"><g id="33">This whitepaper applies to the iTero </g> <g id="39"><g id="37">Lumina</g> </g> <x id="40"/><x id="41"/> Family of products.</mrk><mrk mtype="seg" mid="5">Depending on the version of the product you have procured, there may be differences in the features of the product.</mrk><mrk mtype="seg" mid="6">In addition, as this whitepaper was created at a point-in-time, changes may have occurred in Align Technology’s product security practices to address evolution and maturation in the product security ecosystem.<x id="44"/></mrk><mrk mtype="seg" mid="7"><x id="46"/></mrk></seg-source><target><mrk mtype="seg" mid="4"><g id="33">Este documento se aplica à família de produtos iTero </g> <g id="39"><g id="37">Lumina</g> </g> <x id="40"/><x id="41"/>.</mrk><mrk mtype="seg" mid="5">Dependendo da versão do produto que você adquiriu, pode haver diferenças nos recursos do produto.</mrk><mrk mtype="seg" mid="6">Além disso, como esse documento foi criado em um determinado momento, podem ter ocorrido alterações nas práticas de segurança de produtos da Align Technology para tratar da evolução e maturação no ecossistema de segurança do produto.<x id="44"/></mrk><mrk mtype="seg" mid="7"><x id="46"/></mrk></target><sdl:seg-defs><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 21:58:56</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1747856962</sdl:value><sdl:value key="SegmentIdentityHash">VbbJtE56UShJ9JzXNRJ68rob2GtUzrzPqEo+9uzfx+Y=</sdl:value></sdl:seg><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/19/2020 21:12:59</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1516990960</sdl:value><sdl:value key="SegmentIdentityHash">WnRA1BU0stTRJ3vBf6eGZGdjclNrlHeDRezc2oqA7H4=</sdl:value></sdl:seg><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">10/02/2020 11:42:31</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1005217828</sdl:value><sdl:value key="SegmentIdentityHash">LTpswQyKwwqeiPer+/yigJoHaXFbYhhdJIbeVfkX/wk=</sdl:value></sdl:seg><sdl:seg id="7" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="7"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="b1ebfbd9-dcb1-4395-8822-77096e5f1247"><source>We understand the life sciences and healthcare industry and are addressing security across the organization.</source><seg-source><mrk mtype="seg" mid="8">We understand the life sciences and healthcare industry and are addressing security across the organization.</mrk></seg-source><target><mrk mtype="seg" mid="8">Nós compreendemos as ciências da vida e o setor de saúde, nos dedicando à segurança em toda a organização.</mrk></target><sdl:seg-defs><sdl:seg id="8" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/02/2020 11:42:36</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1690140484</sdl:value><sdl:value key="SegmentIdentityHash">Dx69+H9RK1ejS4ghu7dvb0wnyAnFB++xUdAl2KoKVD0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="7"/><sdl:cxt id="9"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="93f0e4a6-9e85-4f84-b8b9-bb8c227287ed"><source>The threat of cyber-attacks to life sciences and healthcare products is constantly evolving.With this in mind, we proactively established a product security program that is focused on minimizing the security risk associated with our products, enabling us to be vigilant when facing emerging threats and to continuously improve our products.</source><seg-source><mrk mtype="seg" mid="9">The threat of cyber-attacks to life sciences and healthcare products is constantly evolving.</mrk><mrk mtype="seg" mid="10">With this in mind, we proactively established a product security program that is focused on minimizing the security risk associated with our products, enabling us to be vigilant when facing emerging threats and to continuously improve our products.</mrk></seg-source><target><mrk mtype="seg" mid="9">As ameaças de ataques cibernéticos às ciências da vida e aos produtos da área da saúde estão em constante evolução.</mrk><mrk mtype="seg" mid="10">Com isso em mente, estabelecemos proativamente um programa de segurança de produtos, com foco em minimizar o risco de segurança associado a nossos produtos, possibilitando que estejamos vigilantes para enfrentar ameaças emergentes e aprimorar continuamente nossos produtos.</mrk></target><sdl:seg-defs><sdl:seg id="9" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/30/2020 22:48:06</sdl:value><sdl:value key="modified_on">05/30/2020 22:48:06</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-315621182</sdl:value><sdl:value key="SegmentIdentityHash">9Cm6RPGJJg2gIG2HO+fIR6VJMAOFI+WQ4FQpxgCKjzA=</sdl:value></sdl:seg><sdl:seg id="10" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/02/2020 11:42:46</sdl:value><sdl:value key="modified_on">10/21/2020 20:25:16</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-70514772</sdl:value><sdl:value key="SegmentIdentityHash">zEpjOztc8RvcsT3oU3cqCZahDzdIKRciGetmoWHDax8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="7"/><sdl:cxt id="9"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="78ce1a5a-6f75-41f5-b67d-a5bb1dc21aa1"><source>We recognized the importance of incorporating security and privacy considerations by design and throughout our product lifecycle.To accomplish this, we established a cross-functional product security team, including representatives from engineering/ software development, security, legal/privacy, information technology, and quality.</source><seg-source><mrk mtype="seg" mid="11">We recognized the importance of incorporating security and privacy considerations by design and throughout our product lifecycle.</mrk><mrk mtype="seg" mid="12">To accomplish this, we established a cross-functional product security team, including representatives from engineering/ software development, security, legal/privacy, information technology, and quality.</mrk></seg-source><target><mrk mtype="seg" mid="11">Reconhecemos a importância de incorporar considerações de segurança e privacidade, como parte do projeto e durante todo o ciclo de vida do produto.</mrk><mrk mtype="seg" mid="12">Para isso, estabelecemos uma equipe multifuncional de segurança do produto, incluindo representantes do desenvolvimento de engenharia/software, segurança, jurídico/privacidade, de tecnologia da informação e qualidade.</mrk></target><sdl:seg-defs><sdl:seg id="11" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/30/2020 22:54:37</sdl:value><sdl:value key="modified_on">05/30/2020 22:54:37</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-954363410</sdl:value><sdl:value key="SegmentIdentityHash">pi096gID6vfTmDBA0O/QueEnRaKTZvIvl3vMiSfWpgM=</sdl:value></sdl:seg><sdl:seg id="12" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/19/2024 21:30:18</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1258431183</sdl:value><sdl:value key="SegmentIdentityHash">MEAKVRCRWwQM1oYTUz3umsxvaYSR3A9iaRz82k4YKqo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="7"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="5f21d372-8881-4bdc-826b-7dbd0f05072e"><source>We identify security risks using robust risk management processes.</source><seg-source><mrk mtype="seg" mid="13">We identify security risks using robust risk management processes.</mrk></seg-source><target><mrk mtype="seg" mid="13">Nós identificamos riscos à segurança, usando processos robustos de gerenciamento de riscos.</mrk></target><sdl:seg-defs><sdl:seg id="13" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/26/2020 09:52:29</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1372176616</sdl:value><sdl:value key="SegmentIdentityHash">3fx/lXua9Vd0GvsSA4OPOZIAEt93/i6Eq82yNfJTHQ4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="7"/><sdl:cxt id="9"/><sdl:cxt id="10"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="ee5d12c1-acbc-46ba-b5af-6d2a5dad53e9"><source>Align Technology is committed to addressing and minimizing security and privacy risks in the products that we design, develop, and maintain.We conduct in-depth assessments of our products with the goal of implementing appropriate risk mitigation measures at the outset of product development.Based on the risk level of the product, as well as the functionality of the product, the below methodology is applied.</source><seg-source><mrk mtype="seg" mid="14">Align Technology is committed to addressing and minimizing security and privacy risks in the products that we design, develop, and maintain.</mrk><mrk mtype="seg" mid="15">We conduct in-depth assessments of our products with the goal of implementing appropriate risk mitigation measures at the outset of product development.</mrk><mrk mtype="seg" mid="16">Based on the risk level of the product, as well as the functionality of the product, the below methodology is applied.</mrk></seg-source><target><mrk mtype="seg" mid="14">A Align Technology está comprometida em tratar e minimizar os riscos de segurança e privacidade nos produtos que projetamos, desenvolvemos e mantemos.</mrk><mrk mtype="seg" mid="15">Nós realizamos avaliações detalhadas de nossos produtos com o objetivo de implementar medidas apropriadas de mitigação de riscos desde o início do desenvolvimento do produto.</mrk><mrk mtype="seg" mid="16">Com base no nível de risco do produto, bem como em sua funcionalidade, a metodologia abaixo é aplicada.</mrk></target><sdl:seg-defs><sdl:seg id="14" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/11/2019 11:24:11</sdl:value><sdl:value key="modified_on">12/24/2019 02:35:03</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1852591324</sdl:value><sdl:value key="SegmentIdentityHash">UFCstjuRE7HvpKDOsZ0NWlnEUO5u/o49Za6pjLWYdwc=</sdl:value></sdl:seg><sdl:seg id="15" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 10:04:35</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">197467553</sdl:value><sdl:value key="SegmentIdentityHash">phGnSg13WJQKxuYRF4rYVrziZl9USVkXZu74JuzLmHk=</sdl:value></sdl:seg><sdl:seg id="16" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/26/2020 09:52:52</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">346109588</sdl:value><sdl:value key="SegmentIdentityHash">uWI4vHjk53FCazyFI+i02UWhdfqDqnJ8zNde14uThDU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="14"/><sdl:cxt id="15"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="5eb4c1b7-24e1-4e1a-91a9-a355f635037c"><source><g id="69">Product Security Risk Management Program:</g> Align Technology conducted the program on the iTero <g id="72">Lumina™</g><x id="73"/> Family of products.The methodology included planning and information gathering, scoping product ecosystem, performing a product security risk assessment, analyzing threats and vulnerabilities, assessing applicable security controls, and calculating the residual risk rating of any identified gaps.Security and privacy risks and controls considered as part of the assessment leverage industry leading practice security risk frameworks including, but not limited to, AAMI TIR57, and IEC/TR 80001-2-2.</source><seg-source><mrk mtype="seg" mid="17"><g id="69">Product Security Risk Management Program:</g> Align Technology conducted the program on the iTero <g id="72">Lumina™</g><x id="73"/> Family of products.</mrk><mrk mtype="seg" mid="18">The methodology included planning and information gathering, scoping product ecosystem, performing a product security risk assessment, analyzing threats and vulnerabilities, assessing applicable security controls, and calculating the residual risk rating of any identified gaps.</mrk><mrk mtype="seg" mid="19">Security and privacy risks and controls considered as part of the assessment leverage industry leading practice security risk frameworks including, but not limited to, AAMI TIR57, and IEC/TR 80001-2-2.</mrk></seg-source><target><mrk mtype="seg" mid="17"><g id="69">Programa de Gestão de Riscos de Segurança do Produto:</g> a Align Technology realizou o programa na família de produtos iTero <g id="72">Lumina™</g><x id="73"/>.</mrk><mrk mtype="seg" mid="18">A metodologia incluiu o planejamento e a coleta de informações, a definição do ecossistema do produto, a realização de uma avaliação de risco de segurança do produto, a análise de ameaças e vulnerabilidades, a avaliação de controles de segurança aplicáveis e o cálculo da classificação de risco residual de quaisquer lacunas identificadas.</mrk><mrk mtype="seg" mid="19">Os riscos de segurança e privacidade e os controles considerados como parte da avaliação alavancam a liderança no setor em práticas de enquadramento de riscos de segurança, incluindo, entre outras, AAMI TIR57 e IEC/TR 80001-2-2.</mrk></target><sdl:seg-defs><sdl:seg id="17" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:55</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1645716458</sdl:value><sdl:value key="SegmentIdentityHash">vGj0bLXtKsAzj9ureEkm6IfNW3tu+xHMTlppN6ql1iA=</sdl:value></sdl:seg><sdl:seg id="18" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/09/2020 08:00:37</sdl:value><sdl:value key="modified_on">10/21/2020 20:27:55</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">912735971</sdl:value><sdl:value key="SegmentIdentityHash">tM5F5SU4zT1gm/XHMfFs/etTE9Ap7ah71g0QA4IIc44=</sdl:value></sdl:seg><sdl:seg id="19" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 10:06:08</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1440818582</sdl:value><sdl:value key="SegmentIdentityHash">Dz86gFtvMfIoWRt2EUz/xO30OhHPSEMgaTb/f0idumk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="14"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="c10af717-999e-48c9-ab55-c5170e89111d"><source>iTero has developed a Software Bill of Materials (SBOM) for iTero <g id="86">Lumina</g><x id="87"/> intraoral scanners to support our customers in effectively managing their assets, understanding the potential impact of identified vulnerabilities to the medical device system, and deploying countermeasures to maintain the device’s safety and effectiveness.The SBOM will be provided to customers upon request.</source><seg-source><mrk mtype="seg" mid="20">iTero has developed a Software Bill of Materials (SBOM) for iTero <g id="86">Lumina</g><x id="87"/> intraoral scanners to support our customers in effectively managing their assets, understanding the potential impact of identified vulnerabilities to the medical device system, and deploying countermeasures to maintain the device’s safety and effectiveness.</mrk><mrk mtype="seg" mid="21">The SBOM will be provided to customers upon request.</mrk></seg-source><target><mrk mtype="seg" mid="20">O iTero desenvolveu uma Lista de Materiais de Software (SBOM) para os scanners intraorais iTero <g id="86">Lumina</g><x id="87"/> para apoiar nossos clientes no gerenciamento eficaz de seus ativos, na compreensão do impacto potencial das vulnerabilidades identificadas no sistema de equipamento médico e na implantação de contramedidas para manter a segurança e a eficácia do dispositivo.</mrk><mrk mtype="seg" mid="21">A SBOM será fornecida aos clientes mediante solicitação.</mrk></target><sdl:seg-defs><sdl:seg id="20" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 22:31:18</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">991471738</sdl:value><sdl:value key="SegmentIdentityHash">zhT0gFbl3jJTyM9D7uY2/0M2Y+a1T2F1cEHqGzBkJYI=</sdl:value></sdl:seg><sdl:seg id="21" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 22:31:18</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">352468624</sdl:value><sdl:value key="SegmentIdentityHash">mx66EUa1HfBqHvC013Www6lK2ie6u8SUuDmF/2Z8lzY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="7"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="0ec6a917-45c4-4bba-acd1-fb2bdcccb9fa"><source>Security and privacy features of the product.</source><seg-source><mrk mtype="seg" mid="22">Security and privacy features of the product.</mrk></seg-source><target><mrk mtype="seg" mid="22">Recursos de segurança e privacidade do produto.</mrk></target><sdl:seg-defs><sdl:seg id="22" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/11/2019 11:33:37</sdl:value><sdl:value key="modified_on">12/23/2019 12:00:24</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-472112603</sdl:value><sdl:value key="SegmentIdentityHash">PDHfKTqNAiYiK/1/WpCLrnQZobYNiF1k5qO7ntwEd2I=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="7"/><sdl:cxt id="9"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="1ab17578-a9f5-4f9c-b6cf-bac74cf426f5"><source>We aim to protect your data and patients through the design and maintenance of our products.As a result of our security- and privacy- by-design approach to product development, we have implemented the following non-exhaustive security controls in the iTero <g id="99">Lumina™</g><x id="100"/> Family of products.</source><seg-source><mrk mtype="seg" mid="23">We aim to protect your data and patients through the design and maintenance of our products.</mrk><mrk mtype="seg" mid="24">As a result of our security- and privacy- by-design approach to product development, we have implemented the following non-exhaustive security controls in the iTero <g id="99">Lumina™</g><x id="100"/> Family of products.</mrk></seg-source><target><mrk mtype="seg" mid="23">Nosso objetivo é proteger seus dados e os dados dos pacientes através do design e da manutenção de nossos produtos.</mrk><mrk mtype="seg" mid="24">Como resultado de nossa abordagem de segurança e privacidade através do design para o desenvolvimento de produtos, implementamos os seguintes controles de segurança não exaustivos na família de produtos iTero <g id="99">Lumina™</g><x id="100"/>.</mrk></target><sdl:seg-defs><sdl:seg id="23" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/09/2020 08:04:07</sdl:value><sdl:value key="modified_on">10/21/2020 20:28:18</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">213389322</sdl:value><sdl:value key="SegmentIdentityHash">DjcvDIc47s91gBF8LWqgni/NYLcmhkjGdH2Z+TmiWkM=</sdl:value></sdl:seg><sdl:seg id="24" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:55</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">9798154</sdl:value><sdl:value key="SegmentIdentityHash">RC6XcEx7uhh3ms3jOzNks/RzxWMGf2SNGsd6jDdezvM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="14"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="4dc5307d-6830-40e1-bce6-17a0fbac347a"><source><g id="107">Data-at-rest is encrypted:</g> The scanners store Personally Identifiable Information (PII) in an encrypted database using AES-256 and intraoral scan images in an encrypted folder using Microsoft Encrypting File System (EFS).These encryption technologies help to prevent an attacker from capturing patient information stored on the scanner.</source><seg-source><mrk mtype="seg" mid="25"><g id="107">Data-at-rest is encrypted:</g> The scanners store Personally Identifiable Information (PII) in an encrypted database using AES-256 and intraoral scan images in an encrypted folder using Microsoft Encrypting File System (EFS).</mrk><mrk mtype="seg" mid="26">These encryption technologies help to prevent an attacker from capturing patient information stored on the scanner.</mrk></seg-source><target><mrk mtype="seg" mid="25">Os<g id="107">dados armazenados são criptografados:</g> Os scanners armazenam Informações de Identificação Pessoal (PII) em um banco de dados criptografado, usando AES-256 e imagens intraorais de digitalizadas em uma pasta criptografada, usando o Microsoft Encrypting File System (EFS).</mrk><mrk mtype="seg" mid="26">Essas tecnologias de criptografia ajudam a evitar que um invasor capture as informações do paciente armazenadas no scanner.</mrk></target><sdl:seg-defs><sdl:seg id="25" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:28</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:28</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">64970326</sdl:value><sdl:value key="SegmentIdentityHash">WYLo7jPap6CAwc8tC7yjUS6N3yaytHDeLiQfCy31iIg=</sdl:value></sdl:seg><sdl:seg id="26" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/09/2020 08:10:55</sdl:value><sdl:value key="modified_on">10/21/2020 20:28:51</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-307298384</sdl:value><sdl:value key="SegmentIdentityHash">Kuwp3R83Qr6eRK/25squHz+GNsbuRnnV2zAVBZmhOZU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="14"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="0761bad3-4598-41bb-9346-c503dd1ac762"><source><g id="115">Data-in-transit is encrypted:</g> PII and intraoral scan images that are backed up to Align supporting systems is transmitted over supported transport layer security (TLS) encryption using trusted certificates.This helps to prevent an attacker from capturing patient information while in transit.</source><seg-source><mrk mtype="seg" mid="27"><g id="115">Data-in-transit is encrypted:</g> PII and intraoral scan images that are backed up to Align supporting systems is transmitted over supported transport layer security (TLS) encryption using trusted certificates.</mrk><mrk mtype="seg" mid="28">This helps to prevent an attacker from capturing patient information while in transit.</mrk></seg-source><target><mrk mtype="seg" mid="27"><g id="115">Os dados em trânsito são criptografados:</g> as PII e imagens intraorais digitalizadas que são copiadas para os sistemas de suporte da Align são transmitidas por criptografia de segurança nas camadas de transporte (TLS), usando certificados confiáveis.</mrk><mrk mtype="seg" mid="28">Isso ajuda a impedir que um invasor capture informações do paciente enquanto estiverem em trânsito.</mrk></target><sdl:seg-defs><sdl:seg id="27" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 10:07:45</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">866053260</sdl:value><sdl:value key="SegmentIdentityHash">j58IPumfTxpzy0zQpJhlmTcFn71Vdk8Of+uTO1ZTeBc=</sdl:value></sdl:seg><sdl:seg id="28" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/02/2020 11:48:54</sdl:value><sdl:value key="modified_on">10/21/2020 20:29:13</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-177995426</sdl:value><sdl:value key="SegmentIdentityHash">cQghrPJNuNAYSqAirvfwrbfuoOj49s+MXp2Ggf9VUhE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="14"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="47730981-6644-4ea2-99d8-63ac9a5fc0ce"><source><g id="123">Anti-malware protections are in place:</g> The scanners come with pre- installed anti-virus and security tools that check for malicious files on the system.The anti-virus software definitions are updated frequently and scans are scheduled to run daily on the devices.</source><seg-source><mrk mtype="seg" mid="29"><g id="123">Anti-malware protections are in place:</g> The scanners come with pre- installed anti-virus and security tools that check for malicious files on the system.</mrk><mrk mtype="seg" mid="30">The anti-virus software definitions are updated frequently and scans are scheduled to run daily on the devices.</mrk></seg-source><target><mrk mtype="seg" mid="29"><g id="123">Proteções anti-malware instaladas:</g> os scanners vêm com antivírus pré-instalado e ferramentas de segurança, que verifica se há arquivos maliciosos no sistema.</mrk><mrk mtype="seg" mid="30">As definições do software antivírus são atualizadas com frequência e as verificações são agendadas para execução diária nos dispositivos.</mrk></target><sdl:seg-defs><sdl:seg id="29" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 10:11:10</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">309919007</sdl:value><sdl:value key="SegmentIdentityHash">HtggUe8VveniRaNQlyIMkcgViC3vYYcgbGGTU2pz03Y=</sdl:value></sdl:seg><sdl:seg id="30" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/02/2020 11:49:41</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2015966217</sdl:value><sdl:value key="SegmentIdentityHash">sRoZ9v3ddN2ram4FpWqYBKAaHfaqmEjyIh4WQAFI2K0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="14"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="ea102317-f976-49fe-8b52-21789ab2f895"><source><g id="131">Remote maintenance is not possible without permission:</g> The devices use a commercially available off-the-shelf software to establish remote sessions.The software requires a User ID and password that must be supplied from the customer to the Align service personnel before the connection can take place.</source><seg-source><mrk mtype="seg" mid="31"><g id="131">Remote maintenance is not possible without permission:</g> The devices use a commercially available off-the-shelf software to establish remote sessions.</mrk><mrk mtype="seg" mid="32">The software requires a User ID and password that must be supplied from the customer to the Align service personnel before the connection can take place.</mrk></seg-source><target><mrk mtype="seg" mid="31"><g id="131">A manutenção remota não é possível sem permissão:</g> os dispositivos usam um software disponível comercialmente para estabelecer sessões remotas.</mrk><mrk mtype="seg" mid="32">O software requer um ID de usuário e senha, que o cliente deve fornecer à equipe de serviço da Align antes que a conexão possa ocorrer.</mrk></target><sdl:seg-defs><sdl:seg id="31" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 10:11:52</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1953521753</sdl:value><sdl:value key="SegmentIdentityHash">cWj+a3bbzm3mMWucoZvKp1PIKcFnVPOu7k3gw0XGnHU=</sdl:value></sdl:seg><sdl:seg id="32" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:55</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1764119052</sdl:value><sdl:value key="SegmentIdentityHash">F9zS96308hJn63sXDMBOUu3CUCLIIVyCArgPT93WUPQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="c638c6d5-97f2-4d03-bc91-84f57a7887ac"><source><g id="139">Changes to the operating system and software are restricted:</g> The scanners implement a kiosk mode that prevents the user from making any unwanted changes to the operating system and software components.</source><seg-source><mrk mtype="seg" mid="33"><g id="139">Changes to the operating system and software are restricted:</g> The scanners implement a kiosk mode that prevents the user from making any unwanted changes to the operating system and software components.</mrk></seg-source><target><mrk mtype="seg" mid="33"><g id="139">As alterações no sistema operacional e no software são restritas:</g> Os scanners implementam um modo de quiosque que impede o usuário de fazer alterações indesejadas no sistema operacional e nos componentes de software.</mrk></target><sdl:seg-defs><sdl:seg id="33" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:28</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:28</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1215100124</sdl:value><sdl:value key="SegmentIdentityHash">DmTclpCoowk8S+48Zhv9ZYYS/IqxKAsBQb1pnThD85U=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="14"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="fc5e371e-6044-42ec-ac6c-f9e965f04c0c"><source><g id="145">User access management controls are enforced:</g> A user account and password is required to utilize the scanners.This helps protect access to the scanner and protects against unauthorized use.</source><seg-source><mrk mtype="seg" mid="34"><g id="145">User access management controls are enforced:</g> A user account and password is required to utilize the scanners.</mrk><mrk mtype="seg" mid="35">This helps protect access to the scanner and protects against unauthorized use.</mrk></seg-source><target><mrk mtype="seg" mid="34"><g id="145">Os controles de gerenciamento de acesso do usuário são impostos:</g> É necessário inserir conta de usuário e senha para utilizar os scanners.</mrk><mrk mtype="seg" mid="35">Isso ajuda a proteger o acesso ao scanner e impedir o uso não autorizado.</mrk></target><sdl:seg-defs><sdl:seg id="34" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:28</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:28</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">395352789</sdl:value><sdl:value key="SegmentIdentityHash">1Mt4imE7uIXbarxaF26C2Z5m5+V8kmtwzVt3qjlvKYI=</sdl:value></sdl:seg><sdl:seg id="35" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/19/2020 21:33:56</sdl:value><sdl:value key="modified_on">11/19/2020 21:34:59</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1491747532</sdl:value><sdl:value key="SegmentIdentityHash">076V8Cx+8z4zXOE1LMSg1BSZnPMOWEdKIDE9sm3gBnM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="14"/><sdl:cxt id="15"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="6c73c2c9-9176-4a7a-a676-c7662175d9e1"><source><g id="153">Segregation of duties is applied:</g> The scanners offer the ability to register multiple user accounts with different roles to one scanner.There are roles for Doctor and Staff.This helps ensure the ability to track activities performed by individual users better protecting the device.</source><seg-source><mrk mtype="seg" mid="36"><g id="153">Segregation of duties is applied:</g> The scanners offer the ability to register multiple user accounts with different roles to one scanner.</mrk><mrk mtype="seg" mid="37">There are roles for Doctor and Staff.</mrk><mrk mtype="seg" mid="38">This helps ensure the ability to track activities performed by individual users better protecting the device.</mrk></seg-source><target><mrk mtype="seg" mid="36"><g id="153">A segregação de funções é aplicada:</g> Os scanners oferecem a possibilidade de registrar várias contas de usuário com funções diferentes em um scanner.</mrk><mrk mtype="seg" mid="37">Existem funções para Dentista e Funcionário.</mrk><mrk mtype="seg" mid="38">Isso ajuda a garantir a capacidade de rastrear atividades realizadas por usuários individuais, protegendo melhor o dispositivo.</mrk></target><sdl:seg-defs><sdl:seg id="36" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:28</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:28</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1823115485</sdl:value><sdl:value key="SegmentIdentityHash">UBQ2p/GaVBNErbnPmDcGgwvn6msEA29HL56kOiwHxQw=</sdl:value></sdl:seg><sdl:seg id="37" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 10:21:19</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1343932852</sdl:value><sdl:value key="SegmentIdentityHash">McyXooLXMiPw5MKac2gH38LHFdnzWlQHz8AoVVb36JQ=</sdl:value></sdl:seg><sdl:seg id="38" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="BuDzugmSUgQEhAJAX28g0xjGIF6kmat39MCt9vhhrQE="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/11/2019 11:41:54</sdl:value><sdl:value key="modified_on">12/24/2019 04:12:50</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">960217840</sdl:value><sdl:value key="SegmentIdentityHash">BuDzugmSUgQEhAJAX28g0xjGIF6kmat39MCt9vhhrQE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="7"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="878c13e0-dabe-4c5d-92d4-a1e326b8fe46"><source>Security and privacy responsibilities of the customer.</source><seg-source><mrk mtype="seg" mid="39">Security and privacy responsibilities of the customer.</mrk></seg-source><target><mrk mtype="seg" mid="39">Responsabilidades de segurança e privacidade do cliente.</mrk></target><sdl:seg-defs><sdl:seg id="39" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/02/2020 14:12:48</sdl:value><sdl:value key="modified_on">10/21/2020 20:34:55</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1475112745</sdl:value><sdl:value key="SegmentIdentityHash">TpS3hbcO8HdzuF7fBgkUAw2J/RFV/HyyjzrT1t/9R5o=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="7"/><sdl:cxt id="9"/><sdl:cxt id="10"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="21d1f248-aeb4-4a1e-b315-e3c489551daf"><source>As part of our assessments, we have identified risks that are dependent on how the product is used.The securing of the products we provide to our customers is a shared responsibility among all stakeholders.Based on the assessment conducted on the iTero <g id="168">Lumina™</g><x id="169"/> Family of products, we expect that you will take the following security steps to protect the product:</source><seg-source><mrk mtype="seg" mid="40">As part of our assessments, we have identified risks that are dependent on how the product is used.</mrk><mrk mtype="seg" mid="41">The securing of the products we provide to our customers is a shared responsibility among all stakeholders.</mrk><mrk mtype="seg" mid="42">Based on the assessment conducted on the iTero <g id="168">Lumina™</g><x id="169"/> Family of products, we expect that you will take the following security steps to protect the product:</mrk></seg-source><target><mrk mtype="seg" mid="40">Como parte de nossas avaliações, identificamos riscos que dependem de como o produto é usado.</mrk><mrk mtype="seg" mid="41">A segurança dos produtos que fornecemos aos nossos clientes é uma responsabilidade compartilhada entre todas as partes interessadas.</mrk><mrk mtype="seg" mid="42">Com base na avaliação realizada na Família de iTero <g id="168">Lumina™</g><x id="169"/>, esperamos que você execute as seguintes etapas de segurança para proteger o produto:</mrk></target><sdl:seg-defs><sdl:seg id="40" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/09/2020 08:23:45</sdl:value><sdl:value key="modified_on">10/21/2020 20:35:01</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2048670345</sdl:value><sdl:value key="SegmentIdentityHash">k49mTI3BKvtHVvtqtTARzPa5f1LoXth9sZD8mBZC5Kg=</sdl:value></sdl:seg><sdl:seg id="41" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/09/2020 08:25:11</sdl:value><sdl:value key="modified_on">11/19/2020 21:35:25</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1112463500</sdl:value><sdl:value key="SegmentIdentityHash">rY2pKqnRaAnWtqCLLIiJNAUofyH1ypsHTizlAZIy4PI=</sdl:value></sdl:seg><sdl:seg id="42" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:55</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-510172489</sdl:value><sdl:value key="SegmentIdentityHash">ykawwsTdAXIoOyXS8cmQ7qVCF3OCkSm22lxunO81OjA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="980b7dc2-9f63-4371-abe8-392d6ca45084"><source><g id="177">Physically secure the product and its operating environment:</g> It is the customer’s responsibility to protect the physical security of the product and operate it in a secure manner.</source><seg-source><mrk mtype="seg" mid="43"><g id="177">Physically secure the product and its operating environment:</g> It is the customer’s responsibility to protect the physical security of the product and operate it in a secure manner.</mrk></seg-source><target><mrk mtype="seg" mid="43"><g id="177">Proteger fisicamente o produto e seu ambiente operacional:</g> é de responsabilidade do cliente proteger a segurança física do produto e operá-lo de forma segura.</mrk></target><sdl:seg-defs><sdl:seg id="43" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:28</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:28</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1314452386</sdl:value><sdl:value key="SegmentIdentityHash">kwOpjMWjwDXEdj/YNgGOibPC9ecfJjl+TRWxchbvK3Y=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="14"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="f41a94c7-dd81-4eb8-9e02-967649042318"><source><g id="183">Securely operate and protect your network:</g> It is the customer’s responsibility to secure your network through the use of network intrusion detection and prevention mechanisms, using adequately hardened network/application firewalls, and network segmentation, especially if exposed to public Internet.Additionally, dispose of data in an appropriate manner, complying with all local laws and regulations.</source><seg-source><mrk mtype="seg" mid="44"><g id="183">Securely operate and protect your network:</g> It is the customer’s responsibility to secure your network through the use of network intrusion detection and prevention mechanisms, using adequately hardened network/application firewalls, and network segmentation, especially if exposed to public Internet.</mrk><mrk mtype="seg" mid="45">Additionally, dispose of data in an appropriate manner, complying with all local laws and regulations.</mrk></seg-source><target><mrk mtype="seg" mid="44"><g id="183">Operar e proteger sua rede com segurança:</g> é de responsabilidade do cliente proteger sua rede através do uso de mecanismos de detecção e prevenção de intrusões na rede, usando firewalls de rede/aplicativos devidamente protegidos e segmentação de rede, principalmente se exposta à Internet pública.</mrk><mrk mtype="seg" mid="45">Além disso, descarte os dados de forma apropriada, em cumprimento com todas as leis e regulamentações locais.</mrk></target><sdl:seg-defs><sdl:seg id="44" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:28</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:28</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">353038759</sdl:value><sdl:value key="SegmentIdentityHash">Z8mcsEeIwhCXj4PdNpFdFkum1YccPocpgwxZk87UiLk=</sdl:value></sdl:seg><sdl:seg id="45" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/09/2020 08:47:32</sdl:value><sdl:value key="modified_on">10/21/2020 20:36:32</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1330117340</sdl:value><sdl:value key="SegmentIdentityHash">/9dtvs/J2qBivkSOL3qSk40IFm5f0zWKu1Q4/qP1CH4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="14"/><sdl:cxt id="15"/><sdl:cxt id="16"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="6ca8a6a7-b841-4349-ac82-1b8cf9517564"><source><g id="191">Create strong passwords and protect login credentials:</g> It is the customer’s responsibility to set strong passwords with to access scanners and Align systems.The more characters it has with special characters, the stronger it is.Using a passphrase without personal information is one of the simplest ways to ensure that you have a strong password along with changing it every 90 days.Protect your username and password login credentials granting you access to scanners and Align systems by not sharing with anyone and working in a secure environment.</source><seg-source><mrk mtype="seg" mid="46"><g id="191">Create strong passwords and protect login credentials:</g> It is the customer’s responsibility to set strong passwords with to access scanners and Align systems.</mrk><mrk mtype="seg" mid="47">The more characters it has with special characters, the stronger it is.</mrk><mrk mtype="seg" mid="48">Using a passphrase without personal information is one of the simplest ways to ensure that you have a strong password along with changing it every 90 days.</mrk><mrk mtype="seg" mid="49">Protect your username and password login credentials granting you access to scanners and Align systems by not sharing with anyone and working in a secure environment.</mrk></seg-source><target><mrk mtype="seg" mid="46"><g id="191">Criar senhas fortes e proteger as credenciais de login:</g> é de responsabilidade do cliente definir senhas fortes para acessar os scanners e sistemas Align.</mrk><mrk mtype="seg" mid="47">Quanto maior o uso de caracteres especiais, mais forte será a senha.</mrk><mrk mtype="seg" mid="48">Usar uma senha sem informações pessoais é uma das maneiras mais simples de garantir que você tenha uma senha forte, além de alterá-la a cada 90 dias.</mrk><mrk mtype="seg" mid="49">Proteja suas credenciais de login que lhe permitem acessar aos scanners e sistemas Align, como o nome de usuário e senha, não as compartilhando com ninguém e trabalhando em um ambiente seguro.</mrk></target><sdl:seg-defs><sdl:seg id="46" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:28</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:28</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-571067653</sdl:value><sdl:value key="SegmentIdentityHash">24QrUZq53gRSwuC6U8RrxhcwW9iNtaU5JzGeKjEdUhQ=</sdl:value></sdl:seg><sdl:seg id="47" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/09/2020 08:54:35</sdl:value><sdl:value key="modified_on">10/21/2020 20:38:12</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">268315054</sdl:value><sdl:value key="SegmentIdentityHash">w25q8RSf7yrmOEOcb+HL/rgoL4nTz0q9P5ia+8nTZVs=</sdl:value></sdl:seg><sdl:seg id="48" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/09/2020 08:56:24</sdl:value><sdl:value key="modified_on">10/21/2020 20:38:18</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">442198462</sdl:value><sdl:value key="SegmentIdentityHash">ttKKPPR4YFa/LROJJFKFIW+csemK6i0SVtwhqNy33FQ=</sdl:value></sdl:seg><sdl:seg id="49" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/09/2020 08:59:41</sdl:value><sdl:value key="modified_on">10/21/2020 20:39:16</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1961863170</sdl:value><sdl:value key="SegmentIdentityHash">S1buihrokyYQ87vHpeQoB9q3zkVpsTeHYmdBNjxhGwI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="14"/><sdl:cxt id="15"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="f81e793b-48f4-4fa8-9a46-95bef38b1a96"><source><g id="203">Apply segregation of duties and timely remove staff accounts when no longer needed:</g> If customer has multiple user accounts with access to the scanner, it is the customer’s responsibility to register those multiple user accounts with the appropriate role of Doctor or Staff.This helps ensure the ability to track activities performed by individual users better protecting the device.Additionally, it is the customer’s responsibility to remove user accounts when staff no longer require the access to the scanner.</source><seg-source><mrk mtype="seg" mid="50"><g id="203">Apply segregation of duties and timely remove staff accounts when no longer needed:</g> If customer has multiple user accounts with access to the scanner, it is the customer’s responsibility to register those multiple user accounts with the appropriate role of Doctor or Staff.</mrk><mrk mtype="seg" mid="51">This helps ensure the ability to track activities performed by individual users better protecting the device.</mrk><mrk mtype="seg" mid="52">Additionally, it is the customer’s responsibility to remove user accounts when staff no longer require the access to the scanner.</mrk></seg-source><target><mrk mtype="seg" mid="50"><g id="203">Aplicar a segregação de tarefas e remover em tempo hábil as contas dos funcionários quando já não forem necessárias:</g> se o cliente tiver diversas contas de usuário com acesso ao scanner, é de responsabilidade do cliente registrar tais contas de usuário com a função apropriada de Dentista ou Funcionário.</mrk><mrk mtype="seg" mid="51">Isso ajuda a garantir a capacidade de rastrear atividades realizadas por usuários individuais, protegendo melhor o dispositivo.</mrk><mrk mtype="seg" mid="52">Além disso, é de responsabilidade do cliente remover contas de usuário quando o funcionário não precisar mais de acesso ao scanner.</mrk></target><sdl:seg-defs><sdl:seg id="50" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 11:03:48</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">323433494</sdl:value><sdl:value key="SegmentIdentityHash">D4CQ7JQDOkxHeEMSGa4TlRLlXgCcn19GHK49kHe5MCk=</sdl:value></sdl:seg><sdl:seg id="51" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="BuDzugmSUgQEhAJAX28g0xjGIF6kmat39MCt9vhhrQE="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/11/2019 11:41:54</sdl:value><sdl:value key="modified_on">12/24/2019 04:12:50</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">960217840</sdl:value><sdl:value key="SegmentIdentityHash">BuDzugmSUgQEhAJAX28g0xjGIF6kmat39MCt9vhhrQE=</sdl:value></sdl:seg><sdl:seg id="52" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/09/2020 09:11:36</sdl:value><sdl:value key="modified_on">10/21/2020 20:40:13</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">807360960</sdl:value><sdl:value key="SegmentIdentityHash">pbx9pPk6iJpGZjFUPDxvu1Le1KD+BbOQwOMrTy2ks4I=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="e224a852-39f6-4d8f-a8b3-ee3787248062"><source><g id="213">Ensure current data backup and maintain latest software version:</g> It is the customer’s responsibility to ensure scanners remain connected to Align systems to backup PII and intraoral scan images to Align supporting systems and are being restarted as requested to ensure latest scanner updates are being applied.</source><seg-source><mrk mtype="seg" mid="53"><g id="213">Ensure current data backup and maintain latest software version:</g> It is the customer’s responsibility to ensure scanners remain connected to Align systems to backup PII and intraoral scan images to Align supporting systems and are being restarted as requested to ensure latest scanner updates are being applied.</mrk></seg-source><target><mrk mtype="seg" mid="53"><g id="213">Garantir o backup dos dados atuais e manter a versão mais recente do software:</g> é de responsabilidade do cliente garantir que os scanners permaneçam conectados aos sistemas Align para fazer backup de PII e imagens de digitalização intraoral nos sistemas de suporte da Align, além de reiniciá-los conforme solicitado para garantir que sejam aplicadas as atualizações mais recentes do scanner.</mrk></target><sdl:seg-defs><sdl:seg id="53" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:55</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1956743771</sdl:value><sdl:value key="SegmentIdentityHash">uvIX/0Qa/B2ZU3107jNtCulGl/1XlYUDp1LZyG3WhCg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="7"/><sdl:cxt id="12"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="7c96d2a4-af48-4417-ae77-51a422e61d4c"><source>If you have any questions or concerns, please do not hesitate to contact Customer Support.</source><seg-source><mrk mtype="seg" mid="54">If you have any questions or concerns, please do not hesitate to contact Customer Support.</mrk></seg-source><target><mrk mtype="seg" mid="54">Se você tiver alguma dúvida ou preocupação, por favor, não hesite em entrar em contato com Suporte ao Cliente.</mrk></target><sdl:seg-defs><sdl:seg id="54" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 11:10:00</sdl:value><sdl:value key="modified_on">06/12/2024 18:10:30</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">407452940</sdl:value><sdl:value key="SegmentIdentityHash">eT9POIZwuPFDzsF29suqZfMNiWmp1ksbM1+wcrwFnFA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group></body></file><file original="C:\Data\My Documents\Studio 2011\Projects\222818 Rev.3 LuminaPro-pt-BR\en-US\222818 Rev.3 LuminaPro-pt-BR_1\Content\10. iTero scanner features and tools\iTero scanner features and tools.htm.xlf" datatype="x-sdlfilterframework2" source-language="en-us" target-language="pt-br"><header><reference><internal-file form="base64">UEsDBBQAAAAIACQ0GVk2livaHwoAAI6wAAAQAAAAbnZraG54NHMuY240LnhsZu1d3W7buBK+X2Df

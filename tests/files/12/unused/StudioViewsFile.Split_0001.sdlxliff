dl:value key="modified_on">09/02/2024 13:24:06</sdl:value><sdl:value key="created_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="created_on">08/28/2024 15:24:23</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1583715370</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="9"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="fba435aa-33b0-4899-ae38-0a42f3c1ede9"><source><g id="56">Note:</g> Excess soft tissue will not be removed automatically from around the edges of the model during scanning.If required, you can enable automatic cleanup by pressing on the screen and then tapping the Auto Cleanup tool.For more information, see <x id="59"/>.</source><seg-source><mrk mtype="seg" mid="15"><g id="56">Note:</g> Excess soft tissue will not be removed automatically from around the edges of the model during scanning.</mrk><mrk mtype="seg" mid="16">If required, you can enable automatic cleanup by pressing on the screen and then tapping the Auto Cleanup tool.</mrk><mrk mtype="seg" mid="17">For more information, see <x id="59"/>.</mrk></seg-source><target><mrk mtype="seg" mid="15"><g id="56">Note:</g> o excesso de tecido mole não será removido automaticamente de todas as extremidades do modelo durante a digitalização.</mrk><mrk mtype="seg" mid="16">Se necessário, você pode ativar a limpeza automática, pressionando na tela e, em seguida, tocando na ferramenta Limpeza Automática.</mrk><mrk mtype="seg" mid="17">Para mais informações, consulte.<x id="59"/></mrk></target><sdl:seg-defs><sdl:seg id="15" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:22</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:22</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-50144712</sdl:value><sdl:value key="SegmentIdentityHash">v3I0GYHHauA9VelT1qkFfTvWism+Os826HOD8LYYtLw=</sdl:value></sdl:seg><sdl:seg id="16" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/18/2022 00:44:47</sdl:value><sdl:value key="modified_on">11/18/2022 00:44:47</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1422989128</sdl:value><sdl:value key="SegmentIdentityHash">Nh2FEg6r6QgSuF8phY4+HkA1B0qtQbs9SVmEmUoujQE=</sdl:value></sdl:seg><sdl:seg id="17" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="7Ohy1cOz5eX+waPmq2AF23DPmdMlIbw4Gf/7YOWfIqI="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:19</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:19</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1841781838</sdl:value><sdl:value key="SegmentIdentityHash">7Ohy1cOz5eX+waPmq2AF23DPmdMlIbw4Gf/7YOWfIqI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="9"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="8775d09e-0841-42c2-a56e-cd531169d35c"><source>Vivera Retainer – maintains the position of the teeth after treatment.If brackets are still present, they will be removed by the iTero software.The Vivera retainers will be provided at the debonding appointment.</source><seg-source><mrk mtype="seg" mid="18">Vivera Retainer – maintains the position of the teeth after treatment.</mrk><mrk mtype="seg" mid="19">If brackets are still present, they will be removed by the iTero software.</mrk><mrk mtype="seg" mid="20">The Vivera retainers will be provided at the debonding appointment.</mrk></seg-source><target><mrk mtype="seg" mid="18">Retentor Vivera – mantém a posição dos dentes após o tratamento.</mrk><mrk mtype="seg" mid="19">Se os suportes ainda estiverem presentes, serão removidos pelo software iTero.</mrk><mrk mtype="seg" mid="20">Neste caso, os retentores Vivera serão fornecidos na consulta de extração.</mrk></target><sdl:seg-defs><sdl:seg id="18" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/03/2022 19:04:43</sdl:value><sdl:value key="modified_on">11/18/2022 00:45:41</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">742374756</sdl:value><sdl:value key="SegmentIdentityHash">RXGtHhcp3IaRHho5NMDVLrEylYfdmSTbs2y4+WC+dfU=</sdl:value></sdl:seg><sdl:seg id="19" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/03/2022 19:05:52</sdl:value><sdl:value key="modified_on">11/18/2022 00:45:43</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-782780752</sdl:value><sdl:value key="SegmentIdentityHash">tQLB93XoYVWt02cq8U15WMpMIi+h0H0uKuevQ3pJ1rM=</sdl:value></sdl:seg><sdl:seg id="20" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/03/2022 19:07:11</sdl:value><sdl:value key="modified_on">11/18/2022 00:45:46</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">379912659</sdl:value><sdl:value key="SegmentIdentityHash">FpkP3MnYFM7q/iB3E1PfbwRwZ+F067sZkd54qCjNgpY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="283bb52b-1be3-4efd-88f2-aa8788125945"><source>Invisalign Retainer</source><seg-source><mrk mtype="seg" mid="21">Invisalign Retainer</mrk></seg-source><target><mrk mtype="seg" mid="21">Retentor Invisalign</mrk></target><sdl:seg-defs><sdl:seg id="21" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/04/2022 16:33:27</sdl:value><sdl:value key="modified_on">11/18/2022 00:45:48</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-496581490</sdl:value><sdl:value key="SegmentIdentityHash">5JwB17njZLDh3ZC+rBZAcUSnxFHG9pQkKDFlUuEwYNo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d00c6a56-87f3-45c6-a46d-effeced5a4a4"><source>For Invisalign Aligners, First Aligners, and <x id="72"/>Palatal Expanders, you can select the <g id="75">Treatment Stage</g>:</source><seg-source><mrk mtype="seg" mid="22">For Invisalign Aligners, First Aligners, and <x id="72"/>Palatal Expanders, you can select the <g id="75">Treatment Stage</g>:</mrk></seg-source><target><mrk mtype="seg" mid="22">Para Alinhadores Invisalign, Primeiros Alinhadores e <x id="72"/>Primeiros Expansores Palatinos, você pode selecionar a <g id="75">Fase de Tratamento</g>:</mrk></target><sdl:seg-defs><sdl:seg id="22" conf="ApprovedTranslation" origin="interactive" percent="94"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="94"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">95Ym9AMD6vJCVrzQmNtZdlwISt4+GhapRi5gjuMlULs=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 15:23:49</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">95Ym9AMD6vJCVrzQmNtZdlwISt4+GhapRi5gjuMlULs=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 13:25:07</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1922564786</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="8b1df1b7-43cc-4ee4-a59b-5f192a4716de"><source>Initial Record – for the first Invisalign treatment scan.By default, the Current Aligner # is set to 0.</source><seg-source><mrk mtype="seg" mid="23">Initial Record – for the first Invisalign treatment scan.</mrk><mrk mtype="seg" mid="24">By default, the Current Aligner # is set to 0.</mrk></seg-source><target><mrk mtype="seg" mid="23">Registro Inicial – para a primeira digitalização do tratamento Invisalign.</mrk><mrk mtype="seg" mid="24">Por padrão, o # do Alinhador Atual é definido como 0.</mrk></target><sdl:seg-defs><sdl:seg id="23" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/03/2022 19:09:18</sdl:value><sdl:value key="modified_on">11/18/2022 00:45:53</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">661459634</sdl:value><sdl:value key="SegmentIdentityHash">nEolV/p8LFhndAxuA08q0WkdFrSxWFmrUfNjxGBbTR0=</sdl:value></sdl:seg><sdl:seg id="24" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/04/2022 16:34:37</sdl:value><sdl:value key="modified_on">11/18/2022 00:46:15</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2070859092</sdl:value><sdl:value key="SegmentIdentityHash">9PgULz3T2cRqYCbM5JFGNJ1m6xDN+uNOqSQnhDhKXdg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="04a4f7f1-6940-49f4-bac3-4d3007edbe09"><source>Progress Record – for multiple scans during the ongoing treatment.In addition, enter the patient’s current Aligner number in the <g id="84">Current Aligner #</g> field.</source><seg-source><mrk mtype="seg" mid="25">Progress Record – for multiple scans during the ongoing treatment.</mrk><mrk mtype="seg" mid="26">In addition, enter the patient’s current Aligner number in the <g id="84">Current Aligner #</g> field.</mrk></seg-source><target><mrk mtype="seg" mid="25">Registro de Progresso – para várias digitalizações durante o tratamento em andamento.</mrk><mrk mtype="seg" mid="26">Além disso, insira o número Alinhador atual do paciente no campo <g id="84"># do Alinhador Atual</g>.</mrk></target><sdl:seg-defs><sdl:seg id="25" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/04/2022 12:03:39</sdl:value><sdl:value key="modified_on">11/18/2022 00:46:18</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1957375339</sdl:value><sdl:value key="SegmentIdentityHash">0U8z/up2rsQzmJqfwqatl1yy0Vk3/52P6JYccSIEF0M=</sdl:value></sdl:seg><sdl:seg id="26" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="1ZOiCUbju+hoiuka0cSfjJtkHtCC0GV1U4BoM1NUvg8="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:23</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2125497802</sdl:value><sdl:value key="SegmentIdentityHash">1ZOiCUbju+hoiuka0cSfjJtkHtCC0GV1U4BoM1NUvg8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="05effcda-e081-42b1-b544-13a49ef076b7"><source>Final Record – for the scan done when treatment is completed.In addition, enter the patient’s current Aligner number in the <g id="92">Current Aligner #</g> field.</source><seg-source><mrk mtype="seg" mid="27">Final Record – for the scan done when treatment is completed.</mrk><mrk mtype="seg" mid="28">In addition, enter the patient’s current Aligner number in the <g id="92">Current Aligner #</g> field.</mrk></seg-source><target><mrk mtype="seg" mid="27">Registro Final – para a digitalização realizada quando o tratamento é concluído.</mrk><mrk mtype="seg" mid="28">Além disso, insira o número Alinhador atual do paciente no campo <g id="92"># do Alinhador Atual</g>.</mrk></target><sdl:seg-defs><sdl:seg id="27" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/04/2022 12:07:20</sdl:value><sdl:value key="modified_on">11/18/2022 00:46:37</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">827589541</sdl:value><sdl:value key="SegmentIdentityHash">est8ygUJKtupd18mqftwciIE/3FC97F8ZmjtIAbNLWs=</sdl:value></sdl:seg><sdl:seg id="28" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-
id="549c19ca-b683-4590-a798-9a0aa309a987"><source>Bright</source><seg-source><mrk mtype="seg" mid="25">Bright</mrk></seg-source><target><mrk mtype="seg" mid="25">Brilho</mrk></target><sdl:seg-defs><sdl:seg id="25" conf="ApprovedTranslation" origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="90"><sdl:rep id="5akd7qREi3W5Ztk1CX+8ltSetM5WHqNXEfqEJmbxhrk="/><sdl:value key="SegmentIdentityHash">5akd7qREi3W5Ztk1CX+8ltSetM5WHqNXEfqEJmbxhrk=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 13:51:27</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1048903779</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="14de82c4-cc37-4718-81d5-3e9b61bad1e1"><source>Low</source><seg-source><mrk mtype="seg" mid="26">Low</mrk></seg-source><target><mrk mtype="seg" mid="26">Baixo</mrk></target><sdl:seg-defs><sdl:seg id="26" conf="ApprovedTranslation" origin="interactive"><sdl:rep id="b9+DFgYkB993Yh2KIlfhzBmT0TJdVJc/sR1eqNvRY0k="/><sdl:value key="SegmentIdentityHash">b9+DFgYkB993Yh2KIlfhzBmT0TJdVJc/sR1eqNvRY0k=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 13:51:28</sdl:value><sdl:value key="SDL:ProjectTranslationHash">668270494</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7e697a8e-2715-4b27-8f21-a49fbd850c97"><source>Dentin</source><seg-source><mrk mtype="seg" mid="27">Dentin</mrk></seg-source><target><mrk mtype="seg" mid="27">Dentina</mrk></target><sdl:seg-defs><sdl:seg id="27" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">miujKh02LCRv/SkxpC7vpmwXxzQfQv7Nfd2WrztXU/Y=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 13:51:29</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-420105086</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="83a02a48-7e5f-4369-baea-c0d94d334a9e"><source>Bright</source><seg-source><mrk mtype="seg" mid="28">Bright</mrk></seg-source><target><mrk mtype="seg" mid="28">Brilho</mrk></target><sdl:seg-defs><sdl:seg id="28" conf="ApprovedTranslation" origin="auto-propagated" origin-system="Propagated from segment 25" percent="100"><sdl:rep id="5akd7qREi3W5Ztk1CX+8ltSetM5WHqNXEfqEJmbxhrk="/><sdl:value key="SegmentIdentityHash">5akd7qREi3W5Ztk1CX+8ltSetM5WHqNXEfqEJmbxhrk=</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1048903779</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 13:51:31</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="32531391-3395-4c4f-bab8-84ed236e7df4"><source>Low</source><seg-source><mrk mtype="seg" mid="29">Low</mrk></seg-source><target><mrk mtype="seg" mid="29">Baixo</mrk></target><sdl:seg-defs><sdl:seg id="29" conf="ApprovedTranslation" origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="b9+DFgYkB993Yh2KIlfhzBmT0TJdVJc/sR1eqNvRY0k="/><sdl:prev-origin origin="auto-propagated" origin-system="Propagated from segment 26" percent="100"><sdl:rep id="b9+DFgYkB993Yh2KIlfhzBmT0TJdVJc/sR1eqNvRY0k="/><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">b9+DFgYkB993Yh2KIlfhzBmT0TJdVJc/sR1eqNvRY0k=</sdl:value><sdl:value key="SDL:ProjectTranslationHash">668270494</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">b9+DFgYkB993Yh2KIlfhzBmT0TJdVJc/sR1eqNvRY0k=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 13:51:32</sdl:value><sdl:value key="created_on">08/29/2024 03:13:54</sdl:value><sdl:value key="created_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="SDL:OriginalTranslationHash">668270494</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="10"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="44435461-e630-45fc-8955-eeb136d300b9"><source>The differentiation between carious lesions and dentin is based upon the location of the bright feature.Dentin is located in the center of a tooth, whereas interproximal carious lesions appear on the interproximal or distal mesial region, where healthy enamel is expected.</source><seg-source><mrk mtype="seg" mid="30">The differentiation between carious lesions and dentin is based upon the location of the bright feature.</mrk><mrk mtype="seg" mid="31">Dentin is located in the center of a tooth, whereas interproximal carious lesions appear on the interproximal or distal mesial region, where healthy enamel is expected.</mrk></seg-source><target><mrk mtype="seg" mid="30">A diferenciação entre lesões cariosas e dentina é baseada na localização do brilho.</mrk><mrk mtype="seg" mid="31">A dentina é localizada no centro do dente, onde as lesões cariosas interproximais aparecerem na região mesial interproximal ou mesial e distal, onde se espera encontrar esmalte saudável.</mrk></target><sdl:seg-defs><sdl:seg id="30" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">DqIqpIT5c2uJSiIig1oFLiEK+JZMEu0c4LaAtBB6yIQ=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1253678868</sdl:value></sdl:seg><sdl:seg id="31" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">OgFisLLO4w1+52HDWgwMQe5HVPiuRorJlXtqXD39PXY=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">2032604486</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="f2f2da08-d4b9-4476-91cc-ffc8054bbb3f"><source>As such, dentin and interproximal carious lesions appear as bright features, with a dark enamel ring around the dentin structure, as shown in the figure below, which provides an occlusal view of a carious lesion.</source><seg-source><mrk mtype="seg" mid="32">As such, dentin and interproximal carious lesions appear as bright features, with a dark enamel ring around the dentin structure, as shown in the figure below, which provides an occlusal view of a carious lesion.</mrk></seg-source><target><mrk mtype="seg" mid="32">Como tal, a dentina e as lesões cariosas interproximais aparecem brilhantes, com um anel de esmalte escuro ao redor da estrutura da dentina, como exibido na figura abaixo, que fornece uma visão oclusal de uma lesão cariosa.</mrk></target><sdl:seg-defs><sdl:seg id="32" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">hozzEQJPvhnnnFhGx1+QQB5aUgsUXoGje1BoZqQOj0Y=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1831989114</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2de67e6a-e296-48ae-b030-b6b3be540e13"><source>Interproximal carious lesion</source><seg-source><mrk mtype="seg" mid="33">Interproximal carious lesion</mrk></seg-source><target><mrk mtype="seg" mid="33">Lesão cariosa interproximal</mrk></target><sdl:seg-defs><sdl:seg id="33" conf="ApprovedTranslation" origin="interactive"><sdl:value key="SegmentIdentityHash">Az4Nn3h7cwYkv4G7NRjgyiUNXYRPlLcrcWugMNGCOFU=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">443552706</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group></body></file><file original="C:\Data\My Documents\Studio 2011\Projects\222818 Rev.3 LuminaPro-pt-BR\en-US\222818 Rev.3 LuminaPro-pt-BR_1\Content\7. Working with orders\Working with orders.htm.xlf" datatype="x-sdlfilterframework2" source-language="en-us" target-language="pt-br"><header><reference><internal-file form="base64">UEsDBBQAAAAIACQ0GVn77nyK6Q0AAODTAAAQAAAANXlmdmNrczQuZmhlLnhsZu1d3W7bOBa+H2De

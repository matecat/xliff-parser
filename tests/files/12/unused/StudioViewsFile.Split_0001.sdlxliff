:tc:xliff:document:1.2&quot;&gt;</bpt><bpt-props><value key="prefix"></value><value key="localName">bpt</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;span class=&quot;strong&quot;&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></bpt-props><ept name="&lt;/span&gt;" word-end="false">&lt;ept id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ept><ept-props><value key="prefix"></value><value key="localName">ept</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;/span&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></ept-props></tag></tag-defs></header><body><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="021f83f2-c9b7-4ab2-b490-abb42fd70a9c"><source><g id="5">Preparation Design (Buccal and Lingual):</g> The shape of the finishing line (margin line) created by the user during the preparation.You can choose this for both the buccal and the lingual.</source><seg-source><mrk mtype="seg" mid="1"><g id="5">Preparation Design (Buccal and Lingual):</g> The shape of the finishing line (margin line) created by the user during the preparation.</mrk><mrk mtype="seg" mid="2">You can choose this for both the buccal and the lingual.</mrk></seg-source><target><mrk mtype="seg" mid="1"><g id="5">Projeto da Preparação:</g> o formato da linha de acabamento (linha de margem) criado pelo usuário durante a preparação.</mrk><mrk mtype="seg" mid="2">Você pode fazer escolha tanto para o bucal quanto para o lingual.</mrk></target><sdl:seg-defs><sdl:seg id="1" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:29</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:29</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-156552896</sdl:value><sdl:value key="SegmentIdentityHash">wGbn9SwoDqMccQaShF2sWFtboXiPgCEiYKO+ScyqaX0=</sdl:value></sdl:seg><sdl:seg id="2" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/13/2020 07:56:10</sdl:value><sdl:value key="modified_on">10/22/2020 02:55:24</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1778757988</sdl:value><sdl:value key="SegmentIdentityHash">KdZaSGZqNT3vLWbgdmEEyi8i1+16QMhJMZNZwIvn3Ak=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="af1e3327-2803-4621-85c2-1cedaadfc49b"><source><g id="13">Margin Design (Buccal and Lingual):</g> The type of ceramic-metal border relationship required for the selected metal-based crown.You must choose this for both the buccal and the lingual.This is relevant only for metal dental work.</source><seg-source><mrk mtype="seg" mid="3"><g id="13">Margin Design (Buccal and Lingual):</g> The type of ceramic-metal border relationship required for the selected metal-based crown.</mrk><mrk mtype="seg" mid="4">You must choose this for both the buccal and the lingual.</mrk><mrk mtype="seg" mid="5">This is relevant only for metal dental work.</mrk></seg-source><target><mrk mtype="seg" mid="3"><g id="13">Projeto da Margem (Bucal e Lingual):</g> o tipo de relação de borda cerâmica-metal, necessário para a coroa à base de metal selecionada.</mrk><mrk mtype="seg" mid="4">Você deve fazer essa escolha tanto para o bucal quanto para o lingual.</mrk><mrk mtype="seg" mid="5">Isso é relevante apenas para serviços odontológicos em metal.</mrk></target><sdl:seg-defs><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:29</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:29</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">782816581</sdl:value><sdl:value key="SegmentIdentityHash">tLAb4jCLMUyhpDDZ29uO7PP1u7cbWp6RYHxAtq4jb18=</sdl:value></sdl:seg><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/29/2020 02:00:55</sdl:value><sdl:value key="modified_on">05/29/2020 02:00:55</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-868187124</sdl:value><sdl:value key="SegmentIdentityHash">3t2evgqT0tJv7/keM6anUpbdKDeElgNO55eE9Hjvt2A=</sdl:value></sdl:seg><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/09/2019 19:37:24</sdl:value><sdl:value key="modified_on">12/24/2019 01:13:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1790851346</sdl:value><sdl:value key="SegmentIdentityHash">9uBMeiRbSAKRo4l1dZ7oVe/RC55cBctixZrs45zdeRM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="4"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="457345aa-f15c-4066-b995-bf6cd00dbbe2"><source><g id="23">Incisal:</g> The shade for the incisal area of the restoration.</source><seg-source><mrk mtype="seg" mid="6"><g id="23">Incisal:</g> The shade for the incisal area of the restoration.</mrk></seg-source><target><mrk mtype="seg" mid="6"><g id="23">Incisal:</g> A tonalidade para a área incisal da restauração.</mrk></target><sdl:seg-defs><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:29</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:29</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1883832226</sdl:value><sdl:value key="SegmentIdentityHash">PsEHB87H1aIf5h1ErSXbC7E7/Fs4CAztlbdCeC2Wcuw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="4"/><sdl:cxt id="5"/><sdl:cxt id="6"/></sdl:cxts><trans-unit id="77b78ec4-9da3-4c69-aaf7-d73d80dd50da"><source><g id="29">Gingival:</g> The shade for the gingival area of the restoration.</source><seg-source><mrk mtype="seg" mid="7"><g id="29">Gingival:</g> The shade for the gingival area of the restoration.</mrk></seg-source><target><mrk mtype="seg" mid="7"><g id="29">Gengival:</g> A tonalidade para a área gengival da restauração.</mrk></target><sdl:seg-defs><sdl:seg id="7" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:29</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:29</sdl:value><sdl:value key="last_modified_
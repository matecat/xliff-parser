mrk mtype="seg" mid="11">Invisalign Aligners – Invisalign Outcome Simulator Pro is available only for <g id="42">Invisalign Aligners</g> procedure types.</mrk><mrk mtype="seg" mid="12">For more information on Invisalign Outcome Simulator Pro, see <x id="44"/>.</mrk></seg-source><target><mrk mtype="seg" mid="11">Alinhadores Invisalign – O Simulador de Resultado Invisalign Pro está disponível apenas para os tipos de procedimento <g id="42">Alinhadores Invisalign</g>.</mrk><mrk mtype="seg" mid="12">Para obter mais informações sobre o Simulador de Resultado Invisalign Pro, consulte <x id="44"/>.</mrk></target><sdl:seg-defs><sdl:seg id="11" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">03/07/2023 16:33:23</sdl:value><sdl:value key="modified_on">06/12/2024 17:54:43</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1975306</sdl:value><sdl:value key="SegmentIdentityHash">B5EiwM11JfbXgxaOcSornn/Mo2bKb00gJQBKz5IEEU4=</sdl:value></sdl:seg><sdl:seg id="12" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">03/07/2023 16:33:23</sdl:value><sdl:value key="modified_on">06/12/2024 17:54:43</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2051811106</sdl:value><sdl:value key="SegmentIdentityHash">oPmcG6OZ02QuB6u9KeCjUNB4jc/lOTPoS9iT80iU+Vw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="73bd5d18-2a45-49e7-8cbd-0dfea524ae16"><source>Invisalign First Aligners</source><seg-source><mrk mtype="seg" mid="13
k mtype="seg" mid="3">Do not dispose of this product in domestic or municipal waste.</mrk><mrk mtype="seg" mid="4">This device contains WEEE materials.</mrk></seg-source><target><mrk mtype="seg" mid="3">Não descarte este produto no lixo doméstico ou municipal.</mrk><mrk mtype="seg" mid="4">Este dispositivo contém materiais WEEE.</mrk></target><sdl:seg-defs><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:51</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:14</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1994827956</sdl:value><sdl:value key="SegmentIdentityHash">jRoweJ3aGSFyo19aZ6QfYno2V8mh/mfHWsijRPpJ034=</sdl:value></sdl:seg><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="2i3Yxe5nytV+pHRyoRv/yytoLDs+DqeIVmAoHutUees="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2019 20:00:35</sdl:value><sdl:value key="modified_on">12/23/2019 21:06:42</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-726369916</sdl:value><sdl:value key="SegmentIdentityHash">2i3Yxe5nytV+pHRyoRv/yytoLDs+DqeIVmAoHutUees=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="10"/><sdl:cxt id="11"/><sdl:cxt id="12"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="eef82f6f-6835-4c4f-adc0-61cf2e6580ff"><source><x id="6"/><x id="9"/><x id="10"/></source><seg-source><mrk mtype="seg" mid="5"><x id="6"/></mrk><mrk mtype="seg" mid="6"><x id="9"/></mrk><mrk mtype="seg" mid="7"><x id="10"/></mrk></seg-source><target><mrk mtype="seg" mid="5"><x id
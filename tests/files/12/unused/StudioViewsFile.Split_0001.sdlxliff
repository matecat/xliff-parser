><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="4c2d44e8-d72e-4334-8e62-5447451b41f3"><source>Check whether there are any particles on the wand.If so, repeat the cleaning and disinfection process, described in <x id="2"/>.</source><seg-source><mrk mtype="seg" mid="5">Check whether there are any particles on the wand.</mrk><mrk mtype="seg" mid="6">If so, repeat the cleaning and disinfection process, described in <x id="2"/>.</mrk></seg-source><target><mrk mtype="seg" mid="5">Verificar se há partículas no leitor.</mrk><mrk mtype="seg" mid="6">Se hourver, repita o processo de limpeza e de desinfecção, descrito em <x id="2"/>.</mrk></target><sdl:seg-defs><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/28/2020 08:25:40</sdl:value><sdl:value key="modified_on">10/20/2020 15:45:40</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1611957906</sdl:value><sdl:value key="SegmentIdentityHash">a1IJuKmBlDGkBY9iSLq78ns88eg2MCVlyG+rWyLM5pg=</sdl:value></sdl:seg><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:24</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:24</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1601515946</sdl:value><sdl:value key="SegmentIdentityHash">JloOW4ILs6K0VZytWk2WBb1pG6T1Pn2CDhxIa+BnpvE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="10"/><sdl:cxt id="8"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="72f0a64f-0a28-49e1-9694-9ef5243aa02d"><source>Apply a new sleeve to <x id="22"/><g id="25">reduce the risk of</g> cross-contamination, as described below.<x id="26"/><x id="27"/></source><seg-source><mrk mtype="seg" mid="7">Apply a new sleeve to <x id="22"/><g id="25">reduce the risk of</g> cross-contamination, as described below.</mrk><mrk mtype="seg" mid="8"><x id="26"/></mrk><mrk mtype="seg" mid="9"><x id="27"/></mrk></seg-source><target><mrk mtype="seg" mid="7">Aplique uma nova ponteira para <x id="22"/><g id="25">reduzir o risco de</g> contaminação cruzada, conforme descrito abaixo.</mrk><mrk mtype="seg" mid="8"><x id="26"/></mrk><mrk mtype="seg" mid="9"><x id="27"/></mrk></target><sdl:seg-defs><sdl:seg id="7" conf="ApprovedTranslation" origin="interactive" percent="95"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="95"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">LZnDFYGu+pan/8KORCfRfZkm3/m7bE9+iXtvXR7ef5g=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 19:12:33</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">LZnDFYGu+pan/8KORCfRfZkm3/m7bE9+iXtvXR7ef5g=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 13:26:27</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-996483211</sdl:value></sdl:seg><sdl:seg id="8" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:se
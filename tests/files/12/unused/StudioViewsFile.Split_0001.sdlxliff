</sdl:cxts><trans-unit id="1ad462b6-c246-4879-919d-3f0505fcf131"><source>Personal Protective Equipment (PPE) and work environment<g id="48">Please follow the cleaning and disinfection material manufacturers’ instructions</g></source><seg-source><mrk mtype="seg" mid="17">Personal Protective Equipment (PPE) and work environment</mrk><mrk mtype="seg" mid="18"><g id="48">Please follow the cleaning and disinfection material manufacturers’ instructions</g></mrk></seg-source><target><mrk mtype="seg" mid="17">Equipamento de Proteção Individual (EPI) e Ambiente de Trabalho</mrk><mrk mtype="seg" mid="18"><g id="48">Siga as instruções do fabricante do material de limpeza e desinfecção</g></mrk></target><sdl:seg-defs><sdl:seg id="17" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/29/2020 10:08:03</sdl:value><sdl:value key="modified_on">07/21/2020 00:13:15</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1302819549</sdl:value><sdl:value key="SegmentIdentityHash">ruWvU12fHPWy/GwBntsUifu4Za8HJHW+Qt6uFKWitLo=</sdl:value></sdl:seg><sdl:seg id="18" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:16</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:16</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">121209524</sdl:value><sdl:value key="SegmentIdentityHash">RwnUaOFX4ESHAiwy8YB9I/itXgpthBlB5yqQ+nQNcbk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="03abaae5-ff99-4e0a-97fd-35ece1533fdd"><source><g id="54">Note:</g> Replace cleaning and disinfection materials (brushes/wipes) if visibly damaged or soiled.</source><seg-source><mrk mtype="seg" mid="19"><g id="54">Note:</g> Replace cleaning and disinfection materials (brushes/wipes) if visibly damaged or soiled.</mrk></seg-source><target><mrk mtype="seg" mid="19"><g id="54">Nota:</g> substitua os materiais de limpeza e desinfecção (escovas/lenços) se estiverem visivelmente danificados ou sujos.</mrk></target><sdl:seg-defs><sdl:seg id="19" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="glAETUxYAUIkjNvAmI3EkRn9APxuqLdF1wlv7y3cGcY="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:16</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:16</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-946997791</sdl:value><sdl:value key="SegmentIdentityHash">glAETUxYAUIkjNvAmI3EkRn9APxuqLdF1wlv7y3cGcY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="f402f568-c144-4e82-856b-071a0b9b724f"><source>Before starting the cleaning and disinfection procedure, put on your PPE.</source><seg-source><mrk mtype="seg" mid="20">Before starting the cleaning and disinfection procedure, put on your PPE.</mrk></seg-source><target><mrk mtype="seg" mid="20">Antes de iniciar o procedimento de limpeza e desinfecção, coloque seu EPI.</mrk></target><sdl:seg-defs><sdl:seg id="20" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="vIVT1q/qhOUF0hOjovlrY3XcytK55TwuFBVJ5JvSIcw="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/29/2020 10:11:09</sdl:value><sdl:valu
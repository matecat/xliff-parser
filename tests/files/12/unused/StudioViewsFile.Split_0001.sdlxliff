cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="91e0e81a-a53c-44fb-b55e-1acfa4834522"><source>Password is masked</source><seg-source><mrk mtype="seg" mid="23">Password is masked</mrk></seg-source><target><mrk mtype="seg" mid="23">A senha é mascarada</mrk></target><sdl:seg-defs><sdl:seg id="23" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/22/2021 17:07:31</sdl:value><sdl:value key="modified_on">03/22/2021 17:07:31</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">685992603</sdl:value><sdl:value key="SegmentIdentityHash">YobHQrc64GgONfqY4TlAZdEynp/AKTNn/6CD0wGxmGk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="72ca5cac-b392-441f-97ba-4f8738558d76"><source>If you have forgotten your password, you can reset it, as described in <x id="54"/>.</source><seg-source><mrk mtype="seg" mid="24">If you have forgotten your password, you can reset it, as described in <x id="54"/>.</mrk></seg-source><target><mrk mtype="seg" mid="24">Se você esqueceu sua senha, poderá redefini-la conforme descrito na <x id="54"/>.</mrk></target><sdl:seg-defs><sdl:seg id="24" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:21</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-958179610</sdl:value><sdl:value key="SegmentIdentityHash">OAOUd4XVbf8W8nf28Kszfe+R7w7p7fT/iVupVUTtCXs=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="1f85ed4e-05b7-4241-a9a0-71458910983f"><source>Select the <g id="60">Remember Me</g> check box for the system to remember your email address in future sessions.You will still need to enter your password in order to access the scanner.</source><seg-source><mrk mtype="seg" mid="25">Select the <g id="60">Remember Me</g> check box for the system to remember your email address in future sessions.</mrk><mrk mtype="seg" mid="26">You will still need to enter your password in order to access the scanner.</mrk></seg-source><target><mrk mtype="seg" mid="25">Marque a caixa de seleção <g id="60">Lembrar-Me</g> para que o sistema relembre seu e-mail nas próximas sessões.</mrk><mrk mtype="seg" mid="26">Você ainda precisará digitar sua senha para acessar o scanner.</mrk></target><sdl:seg-defs><sdl:seg id="25" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:21</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1159031110</sdl:value><sdl:value key="SegmentIdentityHash">Q7mjCR7Fu/GT56ZZA5YLsSAsXOzvlOn1BSevHa8gH9Y=</sdl:value></sdl:seg><sdl:seg id="26" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/07/2019 01:13:46</sdl:value><sdl:value key="modified_on">12/23/2019 21:57:31</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">165403470</sdl:value><sdl:value key="SegmentIdentityHash">GmjTqdtTTd6/aLyZtvzfTi/4Qv2khqVysrbLhInH6F8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="1e4d237e-8ca3-481a-aab4-5626961addde"><source>Tap <g id="68">Login</g>.</source><seg-source><mrk mtype="seg" mid="27">Tap <g id="68">Login</g>.</mrk></seg-source><target><mrk mtype="seg" mid="27">Toque em <g id="68">Login</g>.</mrk></target><sdl:seg-defs><sdl:seg id="27" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:21</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1943289246</sdl:value><sdl:value key="SegmentIdentityHash">8cfLIBysuaFxNreb6SPLaoYy0sDVwBxhfmBT6Yb8mw4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="8c9b48e0-9a5c-4503-bc9a-e3746403df7f"><source>The iTero home screen is displayed.</source><seg-source><mrk mtype="seg" mid="28">The iTero home screen is displayed.</mrk></seg-source><target><mrk mtype="seg" mid="28">A tela inicial do iTero é exibida.</mrk></target><sdl:seg-defs><sdl:seg id="28" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/07/2019 01:24:19</sdl:value><sdl:value key="modified_on">12/22/2019 01:07:50</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1271079059</sdl:value><sdl:value key="SegmentIdentityHash">+4rxx/jeD8PFr/p2Qrunm31pq
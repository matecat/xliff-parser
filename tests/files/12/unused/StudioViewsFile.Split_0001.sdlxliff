ap:xref href=&quot;../7. Working with orders/Working with orders.htm&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;section 1&lt;/MadCap:xref&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag></tag-defs></header><body><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="b785ea71-f8f6-4181-b865-37bb59640674"><source>Demo mode</source><seg-source><mrk mtype="seg" mid="1">Demo mode</mrk></seg-source><target><mrk mtype="seg" mid="1"/></target><sdl:seg-defs><sdl:seg id="1" locked="true" conf="Draft"><sdl:rep id="8vI08N4xcp5c/cMA9nKXtzZcS3ePyEGO3F/J87qy3aw="/><sdl:value key="SegmentIdentityHash">8vI08N4xcp5c/cMA9nKXtzZcS3ePyEGO3F/J87qy3aw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7c561b72-7ea1-4211-9c93-75472385ca5c"><source>Working in Demo Mode</source><seg-source><mrk mtype="seg" mid="2">Working in Demo Mode</mrk></seg-source><target><mrk mtype="seg" mid="2">Trabalhando no Modo de Demonstração</mrk></target><sdl:seg-defs><sdl:seg id="2" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/07/2019 00:51:03</sdl:value><sdl:value key="modified_on">12/23/2019 12:27:37</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1988385927</sdl:value><sdl:value key="SegmentIdentityHash">53foP7XhHea10gvXx1A6/dkaZTRlCPlf7ifojIuHRBM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="8"/><sdl:cxt id="9"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="4c4d295c-ae6e-4404-8bb9-7dd038165378"><source>Demo Mode is designed for training new staff members and for practicing scanning.It is available anytime for training on an iTero scanner, for scanning techniques, how-to guidelines for prescription forms, procedures and procedure types, and to familiarize yourself with the iTero interface.Demo Mode features all the aspects of the scanning process and includes a wide variety of sample cases, including clinical cases, Invisalign | Vivera cases, and <g id="13">other orthodontic cases</g><x id="14"/>.<x id="16"/></source><seg-source><mrk mtype="seg" mid="3">Demo Mode is designed for training new staff members and for practicing scanning.</mrk><mrk mtype="seg" mid="4">It is available anytime for training on an iTero scanner, for scanning techniques, how-to guidelines for prescription forms, procedures and procedure types, and to familiarize yourself with the iTero interface.</mrk><mrk mtype="seg" mid="5">Demo Mode features all the aspects of the scanning process and includes a wide variety of sample cases, including clinical cases, Invisalign | Vivera cases, and <g id="13">other orthodontic cases</g><x id="14"/>.</mrk><mrk mtype="seg" mid="6"><x id="16"/></mrk></seg-source><target><mrk mtype="seg" mid="3">O Modo de Demonstração foi desenvolvido para o treino de novos membros da equipe e para a prática da digitalização.</mrk><mrk mtype="seg" mid="4">Ele está disponível a todo momento para treinamento com o scanner iTero, orientações sobre técnicas de digitalização, formulários de prescrição, procedimentos e tipos de procedimento, e para que você se familiarize com a interface do iTero.</mrk><mrk mtype="seg" mid="5">O Modo de Demonstração apresenta todos os aspectos do processo de digitalização e inclui uma grande variedade de demonstrações, incluindo casos clínicos, casos Invisalign | Vivera e <g id="13">outros casos ortodônticos</g><x id="14"/>.</mrk><mrk mtype="seg" mid="6"><x id="16"/></mrk></target><sdl:seg-defs><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">05/28/2020 21:29:38</sdl:value><sdl:value key="modified_on">06/12/2024 16:15:07</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1384647471</sdl:value><sdl:value key="SegmentIdentityHash">uxYlCsOfdtmVUa1sps9Scza0er660iudsgApjbcSFkc=</sdl:value></sdl:seg><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/16/2024 13:47:38</sdl:value><sdl:value key="modified_on">06/12/2024 16:15:07</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-812515221</sdl:value><sdl:value key="SegmentIdentityHash">vStx5SAkkl2gtOtuaZyqkrlax09me3V63sFkCpYL+qY=</sdl:value></sdl:seg><sdl:seg id="5" conf="ApprovedTranslation" origin="interactive"><sdl:prev-origin origin="source"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="95"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">05HRwFZHCuzAB9Q/SxCM98hK8/LRt6xVKiqh9SJdFvw=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 19:21:31</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">05HRwFZHCuzAB9Q/SxCM98hK8/LRt6xVKiqh9SJdFvw=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 19:23:04</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1852185302</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">05HRwFZHCuzAB9Q/SxCM98hK8/LRt6xVKiqh9SJdFvw=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:29:14</sdl:value><sdl:value key="SDL:ProjectTranslationHash">969535402</sdl:value><sdl:value key="created_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="created_on">08/28/2024 19:23:08</sdl:value></sdl:seg><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="65f960cf-ac2a-440f-b3fa-594740fb21af"><source>The words <g id="25">Demo Mode</g> are displayed in red on the top left of the screen to indicate that you are in Demo Mode, and when scanning, a lightly striped background is displayed.</source><seg-source><mrk mtype="seg" mid="7">The words <g id="25">Demo Mode</g> are displayed in red on the top left of the screen to indicate that you are in Demo Mode, and when scanning, a lightly striped background is displayed.</mrk></seg-source><target><mrk mtype="seg" mid="7">As palavras <g id="25">Modo de Demonstração</g> são exibidas em vermelho na parte superior esquerdo da tela para indicar que você está no Modo de Demonstração e, durante a digitalização, um fundo listrado é exibido.</mrk></target><sdl:seg-defs><sdl:seg id="7" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/16/2024 13:50:19</sdl:value><sdl:value key="modified_on">06/12/2024 16:15:07</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1245859019</sdl:value><sdl:value key="SegmentIdentityHash">9zaHhYmtwAAC8+sYuqmW56ixeoaYcQJZLUonvoPuR8w=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ee6f71aa-703f-4b27-9967-aacc4ca3622c"><source><g id="31">Note:</g> Scans captured in Demo Mode cannot be saved or submitted for patient treatment.</source><seg-source><mrk mtype="seg" mid="8"><g id="31">Note:</g> Scans captured in Demo Mode cannot be saved or submitted for patient treatment.</mrk></seg-source><target><mrk mtype="seg" mid="8"><g id="31">Nota:</g> as digitalizações capturadas no Modo de Demonstração não podem ser salvas ou enviadas para o tratamento do paciente.</mrk></target><sdl:seg-defs><sdl:seg id="8" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/16/2024 13:52:27</sdl:value><sdl:value key="modified_on">06/12/2024 16:15:07</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1239046321</sdl:value><sdl:value key="SegmentIdentityHash">ZUSPgAX4aEzwmPk+/jygULzYJ4K2PNOq1wSNLkhGpNA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="5aadd3f5-5664-43a6-bfbe-24c3490176bf"><source>Demo Mode is available from the <g id="37">Welcome</g> screen when logging in for the first time, or at any point by tapping the iTero logo on the home screen.</source><seg-source><mrk mtype="seg" mid="9">Demo Mode is available from the <g id="37">Welcome</g> screen when logging in for the first time, or at any point by tapping the iTero logo on the home screen.</mrk></seg-source><target><mrk mtype="seg" mid="9">O Modo de Demonstração está disponível na tela de <g id="37">Boas-vindas</g> ao efetuar login pela primeira vez ou a qualquer momento em que se pressionar o logotipo do iTero na tela inicial.</mrk></target><sdl:seg-defs><sdl:seg id="9" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/16/2024 18:52:45</sdl:value><sdl:value key="modified_on">06/12/2024 16:15:07</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">548061133</sdl:value><sdl:value key="SegmentIdentityHash">ijFCG2TouIqUw+T63hWnZJellWklx/E+rPSL8d/VNSo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="1fb602bc-ad7a-45a3-94f9-f903c93730c8"><source>To enter Demo Mode after logging in:</source><seg-source><mrk mtype="seg" mid="10">To enter Demo Mode after logging in:</mrk></seg-source><target><mrk mtype="seg" mid="10">Para entrar no Modo de Demonstração após efetuar login:</mrk></target><sdl:seg-defs><sdl:seg id="10" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/07/2019 00:46:30</sdl:value><sdl:value key="modified_on">12/22/2019 00:56:59</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-605281149</sdl:value><sdl:value key="SegmentIdentityHash">I1REOTp+4pzEH1gTFt/lp90tvuyDc50rxWOx9WjeX0Y=</sdl:value></sdl:seg></sdl:seg-d
<sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="23297ea7-f93b-4f25-b530-c6a3ccac1410"><source>Capture a screenshot of the model, as described in <x id="55"/>.</source><seg-source><mrk mtype="seg" mid="16">Capture a screenshot of the model, as described in <x id="55"/>.</mrk></seg-source><target><mrk mtype="seg" mid="16">Fazer uma captura de tela do modelo conforme descrito na <x id="55"/>.</mrk></target><sdl:seg-defs><sdl:seg id="16" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="Source"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/19/2024 13:36:11</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-898383306</sdl:value><sdl:value key="SegmentIdentityHash">nwDjA6O9zpgtdzvKuPBKQhjV72I3sAKMJGjylhbaKqs=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e4182255-ad77-4c57-8288-f79e97f17336"><source>After you have reviewed the scan to ensure that it is complete, tap <x id="64"/> on the toolbar to send the scan <x id="65"/><g id="68">to the lab or your MyiTero account</g>, as described in <x id="69"/>.</source><seg-source><mrk mtype="seg" mid="17">After you have reviewed the scan to ensure that it is complete, tap <x id="64"/> on the toolbar to send the scan <x id="65"/><g id="68">to the lab or your MyiTero account</g>, as described in <x id="69"/>.</mrk></seg-source><target><mrk mtype="seg" mid="17">Depois de revisar a digitalização para garantir que ela esteja concluída, toque em <x id="64"/> na barra de ferramentas para enviá-la <x id="65"/><g id="68">ao laboratório ou para o para sua conta de MyiTero</g>, conforme descrito em <x id="69"/>.</mrk></target><sdl:seg-defs><sdl:seg id="1
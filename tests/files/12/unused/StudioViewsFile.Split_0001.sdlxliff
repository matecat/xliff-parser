:</source><seg-source><mrk mtype="seg" mid="28">To zoom in or out using the zoom button:</mrk></seg-source><target><mrk mtype="seg" mid="28">Para aumentar ou diminuir o zoom, usando o botão de zoom:</mrk></target><sdl:seg-defs><sdl:seg id="28" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="8JhsbrOVHElpJZTLmXnbMoOUqpuioHWzbbYXyFg25Bk="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/01/2020 16:00:10</sdl:value><sdl:value key="modified_on">10/21/2020 20:02:14</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">431737638</sdl:value><sdl:value key="SegmentIdentityHash">8JhsbrOVHElpJZTLmXnbMoOUqpuioHWzbbYXyFg25Bk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="10"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="36a30324-0e9e-469e-9a1b-42bbe352d969"><source>Tap <x id="39"/> on the colored intraoral image to zoom in to the area of interest.</source><seg-source><mrk mtype="seg" mid="29">Tap <x id="39"/> on the colored intraoral image to zoom in to the area of interest.</mrk></seg-source><target><mrk mtype="seg" mid="29">Toque <x id="39"/> na imagem intraoral colorida para aumentar o zoom da área de interesse.</mrk></target><sdl:seg-defs><sdl:seg id="29" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:26</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:26</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1449631955</sdl:value><sdl:value key="SegmentIdentityHash">dgQIY8b+QpUawhUG7U9Nm+tLmkn5j4PUCjlWkGLIu3A=</sdl:value></sdl:seg></sdl:seg-defs><
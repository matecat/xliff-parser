lName">ept</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;/span&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></ept-props></tag></tag-defs></header><body><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="65e6e933-b03e-4ef8-90bf-7be8cf19bdbb"><source>General cleaning<g id="5"> and disinfection comments</g></source><seg-source><mrk mtype="seg" mid="1">General cleaning<g id="5"> and disinfection comments</g></mrk></seg-source><target><mrk mtype="seg" mid="1"><g id="5">Comentários gerais sobre</g> limpeza e desinfecção</mrk></target><sdl:seg-defs><sdl:seg id="1" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 12:48:08</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">585445661</sdl:value><sdl:value key="SegmentIdentityHash">KnFi+9Qc3kR4NCTRtFc2fWJAz6UiWidDJAvl2s+oPBU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="5ac8f35c-6df5-4284-8043-6843df9b7dc0"><source>All scanner parts and <g id="14">reusable </g>accessories not outlined above should be <g id="17">thoroughly </g>cleaned according to standard operating procedures or local regulations.</source><seg-source><mrk mtype="seg" mid="2">All scanner parts and <g id="14">reusable </g>accessories not outlined above should be <g id="17">thoroughly </g>cleaned according to standard operating procedures or local regulations.</mrk></seg-source><target><mrk mtype="seg" mid="2">Todas as peças e acessórios <g id="14">reutilizáveis </g>do scanner que não foram mencionados acima devem ser <g id="17">totalmente </g>limpos de acordo com os procedimentos operacionais padrão ou com as regulamentações locais.</mrk></target><sdl:seg-defs><sdl:seg id="2" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:50</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1684997870</sdl:value><sdl:value key="SegmentIdentityHash">zFc14PaWEc/hAE95Tw+bTAKL+TsZIC2KUGrOq3TAaJc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="7"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="a5af010c-5751-4f33-bc4b-2371b0d16fec"><source><g id="23">Note: </g>Refer to the disinfecting agent manufacturer&apos;s user manuals and data sheets for additional information and instructions for use.</source><seg-source><mrk mtype="seg" mid="3"><g id="23">Note: </g>Refer to the disinfecting agent manufacturer&apos;s user manuals and data sheets for additional information and instructions for use.</mrk></seg-source><target><mrk mtype="seg" mid="3"><g id="23">Nota: </g> consulte os manuais do usuário e as folhas de dados do fabricante do agente desinfetante para obter informações adicionais e instruções de uso.</mrk></target><sdl:seg-defs><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:50</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">575199099</sdl:value><sdl:value key="SegmentIdentityHash">XLumH5xRYXzUS0O2xqVmu/7LWnHmoctKjhySifeKz8Q=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="c62b2dbd-82e4-453c-9370-2c153693114e"><source>In addition to the processes described above, national standards and regulatory requirements may apply.</source><seg-source><mrk mtype="seg" mid="4">In addition to the processes described above, national standards and regulatory requirements may apply.</mrk></seg-source><target><mrk mtype="seg" mid="4">Além dos processos descritos acima, podem ser aplicadas normas nacionais e requisitos regulamentares.</mrk></target><sdl:seg-defs><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 09:57:10</sdl:value><sdl:value key="modified_on">11/16/2022 23:58:19</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2119934336</sdl:value><sdl:value key="SegmentIdentityHash">fs5FSh7bzpDSaQsEt5yTLEAqyJQ7yOBql0KdvuyMbWo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="7"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="c5639dcc-8f81-4738-ab71-3aa0d92069c8"><source>iTero scanners are typically cleaned and disinfected in the use environment.</source><seg-source><mrk mtype="seg" mid="5">iTero scanners are typically cleaned and disinfected in the use environment.</mrk></seg-source><target><mrk mtype="seg" mid="5">Os scanners iTero normalmente são limpos e desinfetados no ambiente de uso.</mrk></target><sdl:seg-defs><sdl:se
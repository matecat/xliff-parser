/value><value key="localName">bpt</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;span class=&quot;strong&quot;&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></bpt-props><ept name="&lt;/span&gt;" word-end="false">&lt;ept id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ept><ept-props><value key="prefix"></value><value key="localName">ept</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;/span&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></ept-props></tag><tag id="13"><bpt name="&lt;span class=&quot;strong&quot;&gt;" word-end="false">&lt;bpt id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</bpt><bpt-props><value key="prefix"></value><value key="localName">bpt</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;span class=&quot;strong&quot;&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">2</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></bpt-props><ept name="&lt;/span&gt;" word-end="false">&lt;ept id=&quot;2&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ept><ept-props><value key="prefix"></value><value key="localName">ept</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;/span&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">2</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></ept-props></tag></tag-defs></header><body><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/><sdl:cxt id="6"/><sdl:cxt id="7"/><sdl:cxt id="8"/></sdl:cxts><trans-unit id="a68b4d36-7562-4d7f-8b0e-896552da23ed"><source>In the <g id="8">Notes</g> area, if required, enter any specific notes to the lab regarding the patient’s treatment.For example, special instructions for delivery or manufacturing.Tap anywhere outside the <g id="13">Notes</g> area to add the note.Each note shows the author of the note, with a timestamp, and can be edited and deleted.</source><seg-source><mrk mtype="seg" mid="1">In the <g id="8">Notes</g> area, if required, enter any specific notes to the lab regarding the patient’s treatment.</mrk><mrk mtype="seg" mid="2">For example, special instructions for delivery or manufacturing.</mrk><mrk mtype="seg" mid="3">Tap anywhere outside the <g id="13">Notes</g> area to add the note.</mrk><mrk mtype="seg" mid="4">Each note shows the author of the note, with a timestamp, and can be edited and deleted.</mrk></seg-source><target><mrk mtype="seg" mid="1">Na área <g id="8">Notas</g>, se necessário, insira quaisquer notas específicas para o laboratório sobre o tratamento do paciente.</mrk><mrk mtype="seg" mid="2">Por exemplo, instruções especiais sobre a entrega ou fabricação.</mrk><mrk mtype="seg" mid="3">Toque em qualquer lugar fora da área <g id="13">Notas</g> para adicionar a nota.</mrk><mrk mtype="seg" mid="4">Cada nota mostra o autor da nota com um carimbo de data e hora, e pode ser editada e excluída.</mrk></target><sdl:seg-defs><sdl:seg id="1" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:29</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:29</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">674806720</sdl:value><sdl:value key="SegmentIdentityHash">+8aIq4SIEgsRaoe3ct8hNCflWHD+rhIOKQ5sxdVqtwg=</sdl:value></sdl:seg><sdl:seg id="2" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/23/2022 18:23:24</sdl:value><sdl:value key="modified_on">11/23/2022 18:23:24</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1012581000</sdl:value><sdl:value key="SegmentIdentityHash">uYNTvoJjk77ZTOK/6gPlvh2MBVnX4y+rJYy8kZS0gEg=</sdl:value></sdl:seg><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="KoJf2uDdfR7KT3F62fI0xbITnZ0i+4IHFbd5Ay+YyX8="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:21</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1394245707</sdl:value><sdl:value key="SegmentIdentityHash">KoJf2uDdfR7KT3F62fI0xbITnZ0i+4IHFbd5Ay+YyX8=</sdl:value></sdl:seg><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="3GNfRrXDNp/RV5FJ66PCV47qrj9CDhaQeqoG66Cnq2w="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/03/2022 18:03:59</sdl:value><sdl:value key="modified_on">11/18/2022 00:43:16</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">500107389</sdl:value><sdl:value key="SegmentIdentityHash">3GNfRrXDNp/RV5FJ66PCV47qrj9CDhaQeqoG66Cnq2w=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group></body></file><file ori
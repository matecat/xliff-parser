ativado e apenas para a sessão de digitalização atual.</mrk><mrk mtype="seg" mid="11">O excesso de material será removido por padrão na próxima digitalização.</mrk></target><sdl:seg-defs><sdl:seg id="10" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 15:49:36</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">183872221</sdl:value><sdl:value key="SegmentIdentityHash">7n2LXWfFIFZMY5cNm5wTKN7rKkxF9gU6O575Btgy7HA=</sdl:value></sdl:seg><sdl:seg id="11" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/01/2020 11:37:48</sdl:value><sdl:value key="modified_on">10/21/2020 19:32:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">567873002</sdl:value><sdl:value key="SegmentIdentityHash">/MVs9ffHV7HMKboQTgLemYLqSYe2Jl+abKVO5S73A80=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="f1338f12-34d7-4039-9644-a3218f5ddbb0"><source>To disable auto-cleanup:</source><seg-source><mrk mtype="seg" mid="12">To disable auto-cleanup:</mrk></seg-source><target><mrk mtype="seg" mid="12"/></target><sdl:seg-defs><sdl:seg id="12" locked="true" conf="Draft"><sdl:rep id="AU3uaE/gSW1zwFDdOmSpe+bIZlLFkYNQLN63apuCR+4="/><sdl:value key="SegmentIdentityHash">AU3uaE/gSW1zwFDdOmSpe+bIZlLFkYNQLN63apuCR+4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="14"/><sdl:cxt id="8"/><sdl:cxt id="4"/>
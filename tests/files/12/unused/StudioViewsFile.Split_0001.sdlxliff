">Before cleaning and disinfecting the wand, ensure that the sleeve has been removed.</mrk></seg-source><target><mrk mtype="seg" mid="2">Antes de limpar e desinfetar ao leitor, verifique se a ponteira foi removida.</mrk></target><sdl:seg-defs><sdl:seg id="2" conf="ApprovedTranslation" origin="interactive" percent="94"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="94"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">tf9mU49Ul/D6jtWhNlYHjWxR3lQ+SUvs/3hz5pgGCs0=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 15:48:25</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">tf9mU49Ul/D6jtWhNlYHjWxR3lQ+SUvs/3hz5pgGCs0=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:23:44</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1917586356</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="3ee4ed35-6790-4f95-b404-d9dd72cf8620"><source>Cleaning</source><seg-source><mrk mtype="seg" mid="3">Cleaning</mrk></seg-source><target><mrk mtype="seg" mid="3">Limpeza</mrk></target><sdl:seg-defs><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="ARcrJNDMHbMxP/dZxDdJEdi6+XcZTnBwq5fYC4GoVbQ="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2019 19:02:19</sdl:value><sdl:value key="modified_on">05/31/2020 23:02:05</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1435563693</sdl:value><sdl:value key="SegmentIdentityHash">ARcrJNDMHbMxP/dZxDdJEdi6+XcZTnBwq5fYC4GoVbQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="acd8ee49-2ee1-4f13-86d8-2ebab1c02e16"><source>Using <g id="9">CaviWipes1</g><x id="10"/>, remove any gross contaminants on the wand body and wand tip, including the optical surface, for a minimum of one (1) minute.</source><seg-source><mrk mtype="seg" mid="4">Using <g id="9">CaviWipes1</g><x id="10"/>, remove any gross contaminants on the wand body and wand tip, including the optical surface, for a minimum of one (1) minute.</mrk></seg-source><target><mrk mtype="seg" mid="4">Usando o <g id="9">CaviWipes1</g><x id="10"/>, remova qualquer agente contaminante do corpo e da ponta do leitor por, no mínimo, um (1) minuto, incluindo a superfície óptica.</mrk></target><sdl:seg-defs><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 11:29:43</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-48214621</sdl:value><sdl:value key="SegmentIdentityHash">LHzfoCgyyIaHIMunaA5Yq6Gy+KZpK3brLeEhw8+WsU0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="8"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7148539c-3c15-48c6-b3e3-df6350da5080"><source><g id="17">Note:</g> If you are using an alternative disinfectant, see <x id="18"/> for the required contact time.</source><seg-source><mrk mtype="seg" mid="5"><g id="17">Note:</g> If you are using an alternative disinfectant, see <x id="18"/> for the required contact time.</mrk></seg-source><target><mrk mtype="seg" mid="5"/></target><sdl:seg-defs><sdl:seg id="5" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">t3vQpTjAZw4vQvfuvhi0d9UxN2O5jYQAVscLS8zovV0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="f98c1319-90ee-48c0-ba97-8f335a218617"><source><g id="24">Note:</g> If you are using an alternative disinfectant, see the following sections for the required contact time.</source><seg-source><mrk mtype="seg" mid="6"><g id="24">Note:</g> If you are using an alternative disinfectant, see the following sections for the required contact time.</mrk></seg-source><target><mrk mtype="seg" mid="6"><g id="24">Nota:</g> se estiver usando desinfetantes alternativos, consulte as sessões a seguir para se certificar sobre o tempo de contato necessário.</mrk></target><sdl:seg-defs><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 11:29:43</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-711440188</sdl:value><sdl:value key="SegmentIdentityHash">tWhzGUwxDeC+uHE00EBDGerFwO+WTOE4IstA0PMpp4o=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="10"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="1ba34904-6b13-45b5-b41b-1867e375e5cd"><source><g id="31">Outside Australia:</g> See <x id="32"/></source><seg-source><mrk mtype="seg" mid="7"><g id="31">Outside Australia:</g> See <x id="32"/></mrk></seg-source><target><mrk mtype="seg" mid="7"><g id="31">Fora da Austrália:</g> consulte <x id="32"/></mrk></target><sdl:seg-defs><sdl:seg id="7" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 17:12:18</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">344696016</sdl:value><sdl:value key="SegmentIdentityHash">3XeN7GnOb6uUigq5KLKUSFbYq0aZWiz+Qqf5mQeFCEI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="10"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2d39c2f6-4d00-47b6-8b33-9baf4991c61f"><source><g id="39">Australia:</g> See <x id="40"/></source><seg-source><mrk mtype="seg" mid="8"><g id="39">Australia:</g> See <x id="40"/></mrk></seg-source><target><mrk mtype="seg" mid="8"><g id="39">Austrália:</g> consulte <x id="40"/></mrk></target><sdl:seg-defs><sdl:seg id="8" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 17:12:39</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">865305096</sdl:value><sdl:value key="SegmentIdentityHash">49l5baqNDZwgs91gmA3eBFSAhOgILLZQf5QbZhFwNW4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="8fd7e00c-e517-4f66-8205-d9346f4887ed"><source>Remove gross contaminants using <g id="49">CaviWipes1</g><x id="50"/></source><seg-source><mrk mtype="seg" mid="9">Remove gross contaminants using <g id="49">CaviWipes1</g><x id="50"/></mrk></seg-source><target><mrk mtype="seg" mid="9">Remova contaminantes aparentes, usando o <g id="49">CaviWipes1</g><x id="50"/></mrk></target><sdl:seg-defs><sdl:seg id="9" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/25/2020 09:48:04</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1040218448</sdl:value><sdl:value key="SegmentIdentityHash">cusLUojRVZTsH2Dq6q44PjleEgswdt30Ijb7h1iSRBo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="11"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="40a8d76b-0ed2-446c-99c2-514211c65beb"><source>Using the soft bristle brush, remove any remaining marks and stains on the wand body and wand tip, paying special attention to the grooves, indents, joints, vents, etc.Brush until visibly clean.</source><seg-source><mrk mtype="seg" mid="10">Using the soft bristle brush, remove any remaining marks and stains on the wand body and wand tip, paying special attention to the grooves, indents, joints, vents, etc.</mrk><mrk mtype="seg" mid="11">Brush until visibly clean.</mrk></seg-source><target><mrk mtype="seg" mid="10">Usando a escova de cerdas macias, remova quaisquer marcas e manchas restantes no corpo e na ponta do leitor, prestando atenção especial às ranhuras, juntas, orifícios etc.</mrk><mrk mtype="seg" mid="11">Escove até ficar visivelmente limpo.</mrk></target><sdl:seg-defs><sdl:seg id="10" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/13/2020 10:08:30</sdl:value><sdl:value key="modified_on">10/22/2020 03:42:45</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1136359572</sdl:value><sdl:value key="SegmentIdentityHash">plxtOMZC7MYzVMw2TFinbdm3oWXZEuVmQEnXuYf/n0s=</sdl:value></sdl:seg><sdl:seg id="11" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">07/20/2020 13:25:46</sdl:value><sdl:value key="modified_on">07/21/2020 00:09:18</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-966212350</sdl:value><sdl:value key="SegmentIdentityHash">sgyPOCz5es9vJzUrs2KRMBYjUSB6CTnwcQhgTWOglyM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e1eb77f8-1aa3-4cb0-ab8b-5859937b4d16"><source><x id="65"/><g id="68">Note:</g> Do not use the brush on the optical surface to <x id="69"/><g id="72">avoid</g> damage to the wand.</source><seg-source><mrk mtype="seg" mid="12"><x id="65"/><g id="68">Note:</g> Do not use the brush on the optical surface to <x id="69"/><g id="72">avoid</g> damage to the wand.</mrk></seg-source><target><mrk mtype="seg" mid="12"><x id="65"/><g id="68">Nota:</g> não use a escova na superfície óptica para <x id="69"/><g id="72">evitar</g> danos ao leitor.</mrk></target><sdl:seg-defs><sdl:seg id="12" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 10:54:30</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1371646284</sdl:value><sdl:value key="SegmentIdentityHash">qOWp4zEtug3I31Ula//Hk+xYujuwJcf6o1kfHTKD7Os=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ba15dfe9-6e6f-4dc3-9a86-0d276e15b7b2"><source>Remove marks and stains using a soft bristle brush</source><seg-source><mrk mtype="seg" mid="13">Remove marks and stains using a soft bristle brush</mrk></seg-source><target><mrk mtype="seg" mid="13">Remova marcas e manchas, usando uma escova de cerdas macias</mrk></target><sdl:seg-defs><sdl:seg id="13" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/25/2020 09:52:31</sdl:value><sdl:value key="modified_on">10/22/2020 03:42:55</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1367462452</sdl:value><sdl:value key="SegmentIdentityHash">VSXhJkAmPCuh4ov2PdKoz1fsQ5dADTQbRNOvTkDb+y4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="55786356-6220-4d61-8177-9af62b67b30f"><source>Using <g id="81">CaviWipes1</g><x id="82"/>, remove any remaining contaminants on the wand body and wand tip.</source><seg-source><mrk mtype="seg" mid="14">Using <g id="81">CaviWipes1</g><x id="82"/>, remove any remaining contaminants on the wand body and wand tip.</mrk></seg-source><target><mrk mtype="seg" mid="14">Usando o <g id="81">CaviWipes1</g><x id="82"/>, remova todos os contaminantes restantes do corpo e da ponta do leitor.</mrk></target><sdl:seg-defs><sdl:seg id="14" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">09/25/2020 09:53:58</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1160167114</sdl:value><sdl:value key="SegmentIdentityHash">yQWxORbE/tW8/YKSsEkjE1CvTlkRnt/FR+6MTq9cLfc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="4e64650a-0c42-4acb-8eed-88faeb65c797"><source>Visually inspect the device in a well-lit area to ensure all surfaces are visibly clean.</source><seg-source><mrk mtype="seg" mid="15">Visually inspect the device in a well-lit area to ensure all surfaces are visibly clean.</mrk></seg-source><target><mrk mtype="seg" mid="15">Inspecione visualmente o dispositivo em uma área bem iluminada para garantir que todas as superfícies estejam visivelmente limpas.</mrk></target><sdl:seg-defs><sdl:seg id="15" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/25/2020 09:54:35</sdl:value><sdl:value key="modified_on">10/22/2020 03:43:01</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1173970980</sdl:value><sdl:value key="SegmentIdentityHash">gpmNVUjM9yR4UZuxqwMR95tFBkJih0YFCwqooITYF+0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="32aeb115-ba88-4204-a6af-f34ef63de381"><source>If required, repeat step 3 until no visual contamination is observed.</source><seg-source><mrk mtype="seg" mid="16">If required, repeat step 3 until no visual contamination is observed.</mrk></seg-source><target><mrk mtype="seg" mid="16">Se necessário, repita a etapa 3 até que nenhuma contaminação visual seja observada.</mrk></target><sdl:seg-defs><sdl:seg id="16" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="MfFJaOe78I3wb0O/Gwp8rhgW4Oom7L8yVVsW36BZQ24="/><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 11:01:59</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1529516116</sdl:value><sdl:value key="SegmentIdentityHash">MfFJaOe78I3wb0O/Gwp8rhgW4Oom7L8yVVsW36BZQ24=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="9729890e-f40d-469f-b7b1-ca2a39d9445f"><source><g id="91">Disinfection</g> <g id="94"> (intermediate-level disinfection)</g></source><seg-source><mrk mtype="seg" mid="17"><g id="91">Disinfection</g> <g id="94"> (intermediate-level disinfection)</g></mrk></seg-source><target><mrk mtype="seg" mid="17"><g id="91">Desinfecção</g> <g id="94"> (desinfecção de nível intermediário)</g></mrk></target><sdl:seg-defs><sdl:seg id="17" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="lq0Xh9ndpfyDxaftdgjm3NRQK2aS54ifRrEtPRGB+CI="/><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 11:02:56</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1847701668</sdl:value><sdl:value key="SegmentIdentityHash">lq0Xh9ndpfyDxaftdgjm3NRQK2aS54ifRrEtPRGB+CI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="c3c63cee-413a-40f9-bb49-5ddd82f61d77"><source><g id="100">Note:</g> Use multiple fresh wipes to keep the wand’s surfaces wet, paying special attention to the hard to disinfect areas (i.e., notches, seams, sleeve snappers, and buttons).</source><seg-source><mrk mtype="seg" mid="18"><g id="100">Note:</g> Use multiple fresh wipes to keep the wand’s surfaces wet, paying special attention to the hard to disinfect areas (i.e., notches, seams, sleeve snappers, and buttons).</mrk></seg-source><target><mrk mtype="seg" mid="18"><g id="100">Nota:</g> use vários lenços novos para manter as superfícies do leitor umedecidas, úmidas, prestando atenção especial às áreas difíceis de desinfetar (ou seja, entalhes, costuras, encaixes da ponteira e botões).</mrk></target><sdl:seg-defs><sdl:seg id="18" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 11:03:35</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-411619828</sdl:value><sdl:value key="SegmentIdentityHash">hl+eJRxwIg1lhSRyjryID07b4C7v6H0KGmGxKJPmnr8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="8a24984b-478e-4b36-9588-5049b036f403"><source>Ensure the wand surfaces remain wet for the full<g id="109"> one (1) minute</g> contact time<x id="110"/>.</source><seg-source><mrk mtype="seg" mid="19">Ensure the wand surfaces remain wet for the full<g id="109"> one (1) minute</g> contact time<x id="110"/>.</mrk></seg-source><target><mrk mtype="seg" mid="19">Certifique-se de que as superfícies do leitor permaneçam umedecidas durante todo o tempo de contato<g id="109"> de um (1) minuto</g><x id="110"/>.</mrk></target><sdl:seg-defs><sdl:seg id="19" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 11:06:26</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2066878494</sdl:value><sdl:value key="SegmentIdentityHash">oSLLvBRqUCU8pOkmmPckGKIkMfytNQpvv6H/aHnnJrw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="243f647e-21f3-424e-a32b-3a1351402bd6"><source>Using <g id="125">CaviWipes1</g><x id="126"/>, thoroughly dampen all external surfaces of the wand body and wand tip, including the optical surface, and ensure they remain wet for a minimum of <g id="129">one (1) minute</g><x id="130"/>.</source><seg-source><mrk mtype="seg" mid="20">Using <g id="125">CaviWipes1</g><x id="126"/>, thoroughly dampen all external surfaces of the wand body and wand tip, including the optical surface, and ensure they remain wet for a minimum of <g id="129">one (1) minute</g><x id="130"/>.</mrk></seg-source><target><mrk mtype="seg" mid="20">Usando o <g id="125">CaviWipes1</g><x id="126"/>, umedeça completamente todas as superfícies externas do corpo e da ponta do leitor, incluindo a superfície óptica. Certifique-se de que permaneçam úmidas por, no mínimo, <g id="129">um (1) minuto</g><x id="130"/>.</mrk></target><sdl:seg-defs><sdl:seg id="20" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 11:29:43</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2055974706</sdl:value><sdl:value key="SegmentIdentityHash">Zgk8r3dlAzkHyVOI7+jxkhj13KQ+lVSwI20B5kv3/tg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="14"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="0affce76-8eaa-464d-b888-3a7da9d02ccd"><source><g id="136">Note:</g> Use multiple fresh wipes, as necessary, to keep the wand surfaces wet for the full one (1) minute contact time.</source><seg-source><mrk mtype="seg" mid="21"><g id="136">Note:</g> Use multiple fresh wipes, as necessary, to keep the wand surfaces wet for the full one (1) minute contact time.</mrk></seg-source><target><mrk mtype="seg" mid="21"/></target><sdl:seg-defs><sdl:seg id="21" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">1ORNXoSFyk6+b+SBGAHoiEs5YI42GD1WpbZf9iB/zy8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7399aaa2-0055-4eb8-8f11-3506310aa4bd"><source>Using lint-free wipe(s) wetted (but not dripping) with 70% Isopropyl Alcohol (IPA), thoroughly wipe the wand body and tip, <g id="142">excluding</g> the optical surface of the wand, one (1) time.</source><seg-source><mrk mtype="seg" mid="22">Using lint-free wipe(s) wetted (but not dripping) with 70% Isopropyl Alcohol (IPA), thoroughly wipe the wand body and tip, <g id="142">excluding</g> the optical surface of the wand, one (1) time.</mrk></seg-source><target><mrk mtype="seg" mid="22">Usando um ou mais lenços sem fiapos, umedecidos — mas não pingando —com álcool isopropílico de 70% (IPA), higienize completamente o corpo e a ponteira do leitor, <g id="142">exceto</g> a ponteira óptica do leitor, uma (1) vez.</mrk></target><sdl:seg-defs><sdl:seg id="22" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:50</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-44700175</sdl:value><sdl:value key="SegmentIdentityHash">fbOc5QNCPLaT9uY4nYnVYbDc0B+z165PKqXw2WZwL8c=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="6114e483-dc26-40f2-8fe1-40c5966947b3"><source><x id="155"/> <g id="161">Using a <g id="159">new</g> lint-free wipe</g> wetted (but not dripping) with 70% Isopropyl Alcohol (IPA), thoroughly wipe the <g id="164">optical surface</g> of the wand one (1) time until visibly clean.</source><seg-source><mrk mtype="seg" mid="23"><x id="155"/> <g id="161">Using a <g id="159">new</g> lint-free wipe</g> wetted (but not dripping) with 70% Isopropyl Alcohol (IPA), thoroughly wipe the <g id="164">optical surface</g> of the wand one (1) time until visibly clean.</mrk></seg-source><target><mrk mtype="seg" mid="23"><x id="155"/> <g id="161">Usando um <g id="159">novo</g> lenço sem fiapos</g> umedecidos, mas não pingando, com álcool isopropílico de 70% (IPA), higienize completamente a <g id="164">superfície óptica</g> do leitor uma (1) vez até que fique visivelmente limpo</mrk></target><sdl:seg-defs><sdl:seg id="23" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 11:14:07</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-856031592</sdl:value><sdl:value key="SegmentIdentityHash">7Yn4JtDrsFWNRgVl1HxL+HagG/5u6DXi66rxDCLgHR0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="27d4c576-1bf6-4cb9-8fa3-bb5364c48ed0"><source>Wipe the optical surface of the wand with IPA</source><seg-source><mrk mtype="seg" mid="24">Wipe the optical surface of the wand with IPA</mrk></seg-source><target><mrk mtype="seg" mid="24">Limpe a superfície óptica do leitor com IPA</mrk></target><sdl:seg-defs><sdl:seg id="24" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/25/2020 09:59:12</sdl:value><sdl:value key="modified_on">11/18/2020 18:58:14</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1312906323</sdl:value><sdl:value key="SegmentIdentityHash">UVRhGmwKxDHdpd2tTr4ZEoFkuIbZYXZMz5+tjWFShWM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="9e718dbd-f7fe-4bda-a6ba-f3e02056eae5"><source>Wait until the optical surface dries (approximately 5–10 seconds).</source><seg-source><mrk mtype="seg" mid="25">Wait until the optical surface dries (approximately 5–10 seconds).</mrk></seg-source><target><mrk mtype="seg" mid="25">Aguarde até a superfície óptica secar (de 5 a 10 segundos, aproximadamente).</mrk></target><sdl:seg-defs><sdl:seg id="25" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">09/25/2020 10:00:28</sdl:value><sdl:value key="modified_on">10/22/2020 03:45:08</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1604703036</sdl:value><sdl:value key="SegmentIdentityHash">niTPQcCmjz03ONV/Mj2QTd0FRRE6VJzU/1KBZ+xxygk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="76b6553f-4f9b-45bb-b2ee-c32a678ed0fa"><source>Remove any residue from the optical surface using a dry lint-free wipe.</source><seg-source><mrk mtype="seg" mid="26">Remove any residue from the optical surface using a dry lint-free wipe.</mrk></seg-source><target><mrk mtype="seg" mid="26">Remova qualquer resíduo da superfície óptica, usando um lenço seco e sem fiapos.</mrk></target><sdl:seg-defs><sdl:seg id="26" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/18/2020 18:58:18</sdl:value><sdl:value key="modified_on">11/22/2020 07:10:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1028895968</sdl:value><sdl:value key="SegmentIdentityHash">Lavd8n8genJhmX7oLq0ykYMrPXwvf1SIwmN1r4qLVU0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="a0d23d24-ffd2-4a24-ac6f-b64f9131a765"><source>Visually inspect the optical surface for any noticeable damage, for example, scratches, stains, murkiness, or opaqueness.</source><seg-source><mrk mtype="seg" mid="27">Visually inspect the optical surface for any noticeable damage, for example, scratches, stains, murkiness, or opaqueness.</mrk></seg-source><target><mrk mtype="seg" mid="27">Verifique visualmente a superfície óptica em busca de danos visíveis, por exemplo, riscos, manchas, obscuridade ou opacidade.</mrk></target><sdl:seg-defs><sdl:seg id="27" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:50</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">474147096</sdl:value><sdl:value key="SegmentIdentityHash">v3OAZx99twc+ZBOinuGgkyMfxxuRnyOKolonAaa1N/c=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="15"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ea9148d1-6f00-4ed5-9ed1-be2eae07b43a"><source>If damage is found, see the <g id="171">Scanner warnings</g> section of the<x id="172"/>.</source><seg-source><mrk mtype="seg" mid="28">If damage is found, see the <g id="171">Scanner warnings</g> section of the<x id="172"/>.</mrk></seg-source><target><mrk mtype="seg" mid="28"/></target><sdl:seg-defs><sdl:seg id="28" locked="true" conf="Draft"><sdl:rep id="nhOnpaPhCY1/cSFwcNc18R5ZlHGNTRIXsIDGOZP2yhQ="/><sdl:value key="SegmentIdentityHash">nhOnpaPhCY1/cSFwcNc18R5ZlHGNTRIXsIDGOZP2yhQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="16"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="3e210cc4-5abf-41b4-8abc-61f27f4a5384"><source>If damage is found, see the <g id="179">Scanner warnings</g> section of the<x id="180"/>.</source><seg-source><mrk mtype="seg" mid="29">If damage is found, see the <g id="179">Scanner warnings</g> section of the<x id="180"/>.</mrk></seg-source><target><mrk mtype="seg" mid="29">Se for encontrado algum dano, consulte a seção <g id="179">Alertas do scanner</g> nas<x id="180"/>.</mrk></target><sdl:seg-defs><sdl:seg id="29" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="nhOnpaPhCY1/cSFwcNc18R5ZlHGNTRIXsIDGOZP2yhQ="/><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 10:52:46</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:
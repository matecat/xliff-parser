e><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="61"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;&lt;bpt id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;span class=&quot;strong&quot; MadCap:conditions=&quot;iTero.Lumina Ortho&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&amp;gt;&lt;/bpt&gt;Warning:&lt;ept id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/span&amp;gt;&lt;/ept&gt; Do not use the scanner screen if any damage is found.&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;&lt;bpt id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;span class=&quot;strong&quot; MadCap:conditions=&quot;iTero.Lumina Ortho&quot; xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&amp;gt;&lt;/bpt&gt;Warning:&lt;ept id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/span&amp;gt;&lt;/ept&gt; Do not use the scanner screen if any damage is found.&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="64"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;Please contact iTero Customer Support for further instructions.&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;Please contact iTero Customer Support for further instructions.&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag></tag-defs></header><body><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="37d56ad5-db01-49ea-9a9c-d6f41fa737b0"><source>Cleaning and disinfecting:Handle</source><seg-source><mrk mtype="seg" mid="1">Cleaning and disinfecting:Handle</mrk></seg-source><target><mrk mtype="seg" mid="1"/></target><sdl:seg-defs><sdl:seg id="1" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">25pOfx3xYsCuj4UWF9b2TxohxhrBPEdts2cG8oue2C0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ad65794f-51c9-4d3a-bd0a-a86c601b7d0f"><source>Cleaning and disinfecting:Touch screen</source><seg-source><mrk mtype="seg" mid="2">Cleaning and disinfecting:Touch screen</mrk></seg-source><target><mrk mtype="seg" mid="2"/></target><sdl:seg-defs><sdl:seg id="2" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">+zMB2H6HWtFMFM1m/ipi6vs1fs9r8vVMm8CTlYPIn7c=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="881f9cc8-0174-4981-a8ff-22f86a026064"><source>Cleaning and disinfecting the scanner touch screen<x id="6"/><g id="9"> and the main handle</g></source><seg-source><mrk mtype="seg" mid="3">Cleaning and disinfecting the scanner touch screen<x id="6"/><g id="9"> and the main handle</g></mrk></seg-source><target><mrk mtype="seg" mid="3">Limpeza e desinfecção da tela tátil do scanner<x id="6"/><g id="9"> e da alça central</g></mrk></target><sdl:seg-defs><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:50</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">183896924</sdl:value><sdl:value key="SegmentIdentityHash">I63Xbl+f9UJUQJarphcx0XnQMoR31mB0XF7bfMn7RBU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7588c9ea-e303-4e09-8905-e0b7d0e86d13"><source>The scanner screen<x id="25"/><g id="28"> and main handle</g> must be cleaned <g id="31">and disinfected (low-level disinfection) </g><x id="32"/><g id="35">immediately after each patient,</g> as follows:</source><seg-source><mrk mtype="seg" mid="4">The scanner screen<x id="25"/><g id="28"> and main handle</g> must be cleaned <g id="31">and disinfected (low-level disinfection) </g><x id="32"/><g id="35">immediately after each patient,</g> as follows:</mrk></seg-source><target><mrk mtype="seg" mid="4">A tela do scanner<x id="25"/><g id="28"> e a alça central</g> devem ser limpas <g id="31">e desinfetadas (desinfecção de nível baixo) </g><x id="32"/><g id="35">imediatamente após cada paciente,</g> conforme segue:</mrk></target><sdl:seg-defs><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 11:19:51</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1197064556</sdl:value><sdl:value key="SegmentIdentityHash">weWN4u0d41pKkPYu51ezP5Va7JY7Kuvy+Q2C2hxfDv0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="0e035e9c-f546-499a-aeed-cb91a7440359"><source>Clean and disinfect all outer surfaces using approved disinfectant wipes, or approved disinfectant liquid with a clean lint‑free wipe, and follow the manufacturer’s instructions.For a list of approved materials, see <x id="38"/>.</source><seg-source><mrk mtype="seg" mid="5">Clean and disinfect all outer surfaces using approved disinfectant wipes, or approved disinfectant liquid with a clean lint‑free wipe, and follow the manufacturer’s instructions.</mrk><mrk mtype="seg" mid="6">For a list of approved materials, see <x id="38"/>.</mrk></seg-source><target><mrk mtype="seg" mid="5">Limpe todas as superfícies externas, usando lenços desinfetantes aprovados ou desinfetante líquido com um lenço limpo sem fiapos e siga as instruções do fabricante.</mrk><mrk mtype="seg" mid="6">Para obter uma lista de materiais aprovados, consulte a <x id="38"/>.</mrk></target><sdl:seg-defs><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 11:29:42</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-58751539</sdl:value><sdl:value key="SegmentIdentityHash">rN8fAF9fi5X12O7u3C3NLwsi3H33xRdIq4uY1FM16FU=</sdl:value></sdl:seg><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:17</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:17</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-865421498</sdl:value><sdl:value key="SegmentIdentityHash">O7b3CtSKL6iu02vPc9Z9GWL2W8M7xuShCnQC9xEqfE0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2af97caa-a7e5-41d7-9804-8f3c9505de41"><source>Remove any residual liquid disinfectant with a clean lint-free wipe.</source><seg-source><mrk mtype="seg" mid="7">Remove any residual liquid disinfectant with a clean lint-free wipe.</mrk></seg-source><target><mrk mtype="seg" mid="7">Remova qualquer líquido residual do desinfetante com um pano limpo e sem fiapos.</mrk></target><sdl:seg-defs><sdl:seg id="7" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/25/2020 14:43:30</sdl:value><sdl:value key="modified_on">05/31/2020 18:37:29</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-44092644</sdl:value><sdl:value key="SegmentIdentityHash">Cd/J/69q8eKbByTUo9LZwvqfgsbaoYHbDoxo7Z4HttQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="10"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="04a75898-5a6e-4c69-9880-f5bd591298cd"><source>Visually inspect the scanner screen and the main handle in a well-lit area to ensure all surfaces are visibly clean.Repeat the cleaning procedure according to the manufacturer’s instructions until no visual contamination is observed.</source><seg-source><mrk mtype="seg" mid="8">Visually inspect the scanner screen and the main handle in a well-lit area to ensure all surfaces are visibly clean.</mrk><mrk mtype="seg" mid="9">Repeat the cleaning procedure according to the manufacturer’s instructions until no visual contamination is observed.</mrk></seg-source><target><mrk mtype="seg" mid="8">Verifique visualmente a tela do scanner e a alça central em uma área bem iluminada para garantir que todas as superfícies estejam visivelmente limpas.</mrk><mrk mtype="seg" mid="9">Repita o procedimento de limpeza de acordo com as instruções do fabricante até que não seja observada contaminação visual.</mrk></target><sdl:seg-defs><sdl:seg id="8" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:50</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">2075006554</sdl:value><sdl:value key="SegmentIdentityHash">EWjxHy+bZPKrtgqHwtdk9MzPuUvzwLvfV7vv/d5qklQ=</sdl:value></sdl:seg><sdl:seg id="9" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:50</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-876452405</sdl:value><sdl:value key="SegmentIdentityHash">DMxWRSZH8bpfx7/IzXxjHQoP/nFvYAeIdRU7ngkkHWA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ba6cf2d9-1b48-4af1-a7f6-60d44fceb3cb"><source>Visually inspect the scanner screen for any noticeable damage, for example, scratches or stains, and confirm the responsiveness of the touch screen.</source><seg-source><mrk mtype="seg" mid="10">Visually inspect the scanner screen for any noticeable damage, for example, scratches or stains, and confirm the responsiveness of the touch screen.</mrk></seg-source><target><mrk mtype="seg" mid="10">Verifique visualmente a tela do scanner em busca de danos visíveis, por exemplo, riscos ou manchas, e confirme a capacidade de resposta da tela tátil.</mrk></target><sdl:seg-defs><sdl:seg id="10" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:50</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">898773938</sdl:value><sdl:value key="SegmentIdentityHash">35utjz+ym7DZTwDPx4m0MUaAgTC4E3UWA7IUk/Vzku4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="c08d5d43-e207-45d3-a4ff-db746b1d6d22"><source>If damage is found, see the <g id="48">Scanner warnings</g> section of the<x id="49"/>.</source><seg-source><mrk mtype="seg" mid="11">If damage is found, see the <g id="48">Scanner warnings</g> section of the<x id="49"/>.</mrk></seg-source><target><mrk mtype="seg" mid="11"/></target><sdl:seg-defs><sdl:seg id="11" locked="true" conf="Draft"><sdl:rep id="nhOnpaPhCY1/cSFwcNc18R5ZlHGNTRIXsIDGOZP2yhQ="/><sdl:value key="SegmentIdentityHash">nhOnpaPhCY1/cSFwcNc18R5ZlHGNTRIXsIDGOZP2yhQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="12"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="c365e56d-a568-4c50-92d1-257c32799377"><source>If damage is found, see the <g id="56">Scanner warnings</g> section of the<x id="57"/>.</source><seg-source><mrk mtype="seg" mid="12">If damage is found, see the <g id="56">Scanner warnings</g> section of the<x id="57"/>.</mrk></seg-source><target><mrk mtype="seg" mid="12">Se for encontrado algum dano, consulte a seção <g id="56">Alertas do scanner</g> nas<x id="57"/>.</mrk></target><sdl:seg-defs><sdl:seg id="12" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="nhOnpaPhCY1/cSFwcNc18R5ZlHGNTRIXsIDGOZP2yhQ="/><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 10:52:46</sdl:value><sdl:value key="modified_on">06/12/2024 16:11:13</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1121994230</sdl:value><sdl:value key="SegmentIdentityHash">nhOnpaPhCY1/cSFwcNc18R5ZlHGNTRIXsIDGOZP2yhQ=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="14"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="af988dde-d54c-46b7-ae40-a9cfce0692c0"><source><x id="61"/><x id="64"/></source><seg-source><mrk mtype="seg" mid="13"><x id="61"/></mrk><mrk mtype="seg" mid="14"><x id="64"/></mrk></seg-source><target><mrk mtype="seg" mid="13"><x id="61"/></mrk><mrk mtype="seg" mid="14"><x id="64"/></mrk></target><sdl:seg-defs><sdl:seg id="13" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:va
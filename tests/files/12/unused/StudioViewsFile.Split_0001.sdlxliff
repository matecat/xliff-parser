>DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1121163817</sdl:value><sdl:value key="SegmentIdentityHash">38frjPnujGJwJbhwMyuOPnTGF28+YkjYcI25wXAnPzU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="19"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="f0746334-642d-425c-b2e4-6f8b539f32df"><source>Clean and disinfect the wand, as described in <x id="50"/>.</source><seg-source><mrk mtype="seg" mid="16">Clean and disinfect the wand, as described in <x id="50"/>.</mrk></seg-source><target><mrk mtype="seg" mid="16">Limpe e desinfete o leitor conforme descrito na <x id="50"/>.</mrk></target><sdl:seg-defs><sdl:seg id="16" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="0ABVSkqvZNVFZUxzX4WbrtyTNSVzhp7pBRFJ2KkGcfo="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:22</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:22</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1446529130</sdl:value><sdl:value key="SegmentIdentityHash">0ABVSkqvZNVFZUxzX4WbrtyTNSVzhp7pBRFJ2KkGcfo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="19"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="81a44000-83b2-4804-be62-d88443ade71c"><source>Gently slide a new sleeve onto the tip of the wand until it clicks into place.</source><seg-source><mrk mtype="seg" mid="17">Gently slide a new sleeve onto the tip of the wand until it clicks into place.</mrk></seg-source><target><mrk mtype="seg" mid="17">Coloque cuidadosamente uma nova ponteira na ponta do leitor, até ouvir um clique.</mrk></target><sdl:seg-defs><sdl:seg id="17" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="jHRmPhS3gjeAZL7KDiaeLY/CUajGAawF8i+/HTmobBw="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/09/2020 10:03:33</sdl:value><sdl:value key="modified_on">10/21/2020 21:23:01</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">145381629</sdl:value><sdl:value key="SegmentIdentityHash">jHRmPhS3gjeAZL7KDiaeLY/CUajGAawF8i+/HTmobBw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="19"/><sdl:cxt id="9"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="a23f892c-a378-419b-bd14-16dba741c5df"><source><g id="62">Note:</g> If the scanner will not be used immediately after cleaning and disinfection, attach the <x id="63"/><g id="66">dark</g> protective sleeve.</source><seg-source><mrk mtype="seg" mid="18"><g id="62">Note:</g> If the scanner will not be used immediately after cleaning and disinfection, attach the <x id="63"/><g id="66">dark</g> protective sleeve.</mrk></seg-source><target><mrk mtype="seg" mid="18"><g id="62">Nota:</g> se o scanner não for usado imediatamente após a limpeza e desinfecção, coloque a ponteira protetora <x id="63"/><g id="66">escura</g>.</mrk></target><sdl:seg-defs><sdl:seg id="18" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:48</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">706380474</sdl:value><sdl:value key="SegmentIdentityHash">5apwqtrcPwRFbSByx/U2/rxk3tuPqKmH3YBOfaN/8ls=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="19"/><sdl:cxt id="9"/><sdl:cxt 
dl:seg id="24" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="PAtel4qryxabwpkG3KuH9WGxWgX6I9cGPow2shLuZvw="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/01/2020 11:40:38</sdl:value><sdl:value key="modified_on">10/21/2020 19:33:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1852616563</sdl:value><sdl:value key="SegmentIdentityHash">PAtel4qryxabwpkG3KuH9WGxWgX6I9cGPow2shLuZvw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="18"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="11aae84d-272b-43a0-8ff6-fe028c1ce7ab"><source>Scan displayed with excess material showing</source><seg-source><mrk mtype="seg" mid="25">Scan displayed with excess material showing</mrk></seg-source><target><mrk mtype="seg" mid="25">Digitalização exibida com excesso de material à mostra</mrk></target><sdl:seg-defs><sdl:seg id="25" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="vmbxev3hqAarrxQXb6Ddmd4R8Q4Vml3oOWaYDsKlRNs="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/01/2020 11:41:30</sdl:value><sdl:value key="modified_on">10/21/2020 19:33:57</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">334767240</sdl:value><sdl:value key="SegmentIdentityHash">vmbxev3hqAarrxQXb6Ddmd4R8Q4Vml3oOWaYDsKlRNs=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="12"/><sdl:cxt id="16"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="3f5d252c-400b-4cfe-95a2-aa0271b8cac1"><source><x id="52"/>To return to scanning without excess tissue, press the screen to display the editing options and then tap <g id="55">Enable auto-cleanup</g>.From this point on, scanned excess tissue is removed from the model.<x id="57"/></source><seg-source><mrk mtype="seg" mid="26"><x id="52"/>To return to scanning without excess tissue, press the screen to display the editing options and then tap <g id="55">Enable auto-cleanup</g>.</mrk><mrk mtype="seg" mid="27">From this point on, scanned excess tissue is removed from the model.<x id="57"/></mrk></seg-source><target><mrk mtype="seg" mid="26"><x id="52"/>Para retornar à digitalização sem excesso de tecido, pressione a tela para exibir as opções de edição e, em seguida, toque em <g id="55">Habilitar Limpeza</g>.</mrk><mrk mtype="seg" mid="27">A partir daqui, o excesso de tecido digitalizado é removido do modelo.<x id="57"/></mrk></target><sdl:seg-defs><sdl:seg id="26" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 15:49:36</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2067994570</sdl:value><sdl:value key="SegmentIdentityHash">AegiJ2bXJifcyiplo7BK796c5g12XBNMsP3PLO8G0GM=</sdl:value></sdl:seg><sdl:seg id="27" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 15:49:36</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1789453990</sdl:value><sdl:value key="SegmentIdentityHash">HrC+kFyZ5XgNYCAWd1ocomDwAa/U+21Kiq7UgB1XrY4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group></body></file><fil
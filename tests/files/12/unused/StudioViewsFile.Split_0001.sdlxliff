sdl:value key="created_on">03/07/2023 16:33:19</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:19</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">665616545</sdl:value><sdl:value key="SegmentIdentityHash">5gMQ/peuGb0KHN6YyknD1ugkMwnZwPdkJ4VVTksFXE4=</sdl:value></sdl:seg><sdl:seg id="7" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:19</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:19</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">941656802</sdl:value><sdl:value key="SegmentIdentityHash">rY1kkGnoZYQRvsdB1fS9nPhGR/uqwtjXGBA8Fko2/SE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="57f99028-4fc0-4fba-ba36-beecdacaf3df"><source><g id="22">Demo Mode:</g> Enables you to familiarize yourself with the scanner’s features and perform practice scans without submitting the scans.For more information, see <x id="24"/>.</source><seg-source><mrk mtype="seg" mid="8"><g id="22">Demo Mode:</g> Enables you to familiarize yourself with the scanner’s features and perform practice scans without submitting the scans.</mrk><mrk mtype="seg" mid="9">For more information, see <x id="24"/>.</mrk></seg-source><target><mrk mtype="seg" mid="8"><g id="22">Modo de Demonstração:</g> permite que você se familiarize com os recursos do scanner e execute digitalizações para práticar, sem o envio das digitalizações.</mrk><mrk mtype="seg" mid="9">Para mais informações, consulte <x id="24"/>.</mrk></target><sdl:seg-defs><sdl:seg id="8" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:19</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:19</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">872783549</sdl:value><sdl:value key="SegmentIdentityHash">OTkUe7i3lI54bIuYOek/KflJcV44OwIe1hGUfWzksho=</sdl:value></sdl:seg><sdl:seg id="9" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="7Ohy1cOz5eX+waPmq2AF23DPmdMlIbw4Gf/7YOWfIqI="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:19</sdl:value><sdl:value key="modified_on">06/12/2024 15:49:36</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1809051878</sdl:value><sdl:value key="SegmentIdentityHash">7Ohy1cOz5eX+waPmq2AF23DPmdMlIbw4Gf/7YOWfIqI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="92adc9d4-d707-4be1-93b5-12b05bff0df7"><source><g id="40">Note:</g> If you select the <g id="43">Demo Mode</g> option before registering the scanner (<g id="46">Make It Mine</g> option), you will have to restart the scanner to access the <g id="49">Make It Mine</g> option.</source><seg-source><mrk mtype="seg" mid="10"><g id="40">Note:</g> If you select the <g id="43">Demo Mode</g> option before registering the scanner (<g id="46">Make It Mine</g> option), you will have to restart the scanner to access the <g id="49">Make It Mine</g> option.</mrk></seg-source><target><mrk mtype="seg" mid="10"><g id="40">Nota:</g> se você selecionar a opção <g id="43">Modo de Demonstração</g> antes de registrar o scanner (opção <g id="46">Registro de Aquisição</g>) será necessário reiniciar o scanner para acessar a opção <g id="49">Registro de Aquisição</g>.</mrk></target><sdl:seg-defs><sdl:seg id="10" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/20/2024 09:53:26</sdl:value><sdl:value key="modified_on">06/12/2024 16:15:07</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">264382138</sdl:value><sdl:value key="SegmentIdentityHash">WaRySH9v9XyvCfqTJ17PMszdWqz29/i23Gc67T0H4kg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="43ce9cfd-c463-49ea-87b1-3ee9ab5a35ff"><source>Select the required language and the <g id="55">Make It Mine</g> option.</source><seg-source><mrk mtype="seg" mid="11">Select the required language and the <g id="55">Make It Mine</g> option.</mrk></seg-source><target><mrk mtype="seg" mid="11"/></target><sdl:seg-defs><sdl:seg id="11" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">swQ3qstF47KodZDt3XHFvsTvFGSFI5ylOQx2vlqhdo8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group></body></file><file original="C:\Data\My Documents\Studio 2011\Projects\222818 Rev.3 LuminaPro-pt-BR\en-US\222818 Rev.3 LuminaPro-pt-BR_1\Content\4. Working with the scanner\Logging out of the scanner.htm.xlf" datatype="x-sdlfilterframework2" source-language="en-us" target-language="pt-br"><header><reference><internal-file form="base64">UEsDBBQAAAAIACQ0GVlAvlq3VQUAAJ4hAAAQAAAAY2RubnZpNHouZHkwLnhsZuVa3W7bNhS+L9B3

ctype">image</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag></tag-defs></header><body><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="daa5331c-074b-4159-8d3d-cc9ded07b643"><source>Scanning the patient</source><seg-source><mrk mtype="seg" mid="1">Scanning the patient</mrk></seg-source><target><mrk mtype="seg" mid="1"/></target><sdl:seg-defs><sdl:seg id="1" locked="true" conf="Draft"><sdl:rep id="yj/1pwLvdbgT+CbtwFn7UC2ESQbCdw1l9porW4q8kSE="/><sdl:value key="SegmentIdentityHash">yj/1pwLvdbgT+CbtwFn7UC2ESQbCdw1l9porW4q8kSE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="0d104293-ac60-4fd8-bf06-cf706abc32e0"><source>Scanning the patient</source><seg-source><mrk mtype="seg" mid="2">Scanning the patient</mrk></seg-source><target><mrk mtype="seg" mid="2">Digitalização do paciente</mrk></target><sdl:seg-defs><sdl:seg id="2" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="yj/1pwLvdbgT+CbtwFn7UC2ESQbCdw1l9porW4q8kSE="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2019 18:58:11</sdl:value><sdl:value key="modified_on">11/19/2020 20:13:33</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-276727223</sdl:value><sdl:value key="SegmentIdentityHash">yj/1pwLvdbgT+CbtwFn7UC2ESQbCdw1l9porW4q8kSE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2f71b5e8-4c22-4b63-adfa-f882156fcd84"><source>After you have filled in the Rx, tap <x id="4"/> on the toolbar to enter Scan mode.The <g id="8">Scan</g> window is displayed, enabling you to start scanning the patient.</source><seg-source><mrk mtype="seg" mid="3">After you have filled in the Rx, tap <x id="4"/> on the toolbar to enter Scan mode.</mrk><mrk mtype="seg" mid="4">The <g id="8">Scan</g> window is displayed, enabling you to start scanning the patient.</mrk></seg-source><target><mrk mtype="seg" mid="3">Depois de preencher o Rx, toque em <x id="4"/> na barra de ferramentas para entrar no modo Digitalizar.</mrk><mrk mtype="seg" mid="4">A janela <g id="8">Digitalizar</g>  é exibida, permitindo que você comece a digitalização do paciente.</mrk></target><sdl:seg-defs><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:23</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">743080396</sdl:value><sdl:value key="SegmentIdentityHash">ri+1Bccylt6zmH+cRjwIgSx7wBiywWMDKA1ab79fxFo=</sdl:value></sdl:seg><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:23</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-536673840</sdl:value><sdl:value key="SegmentIdentityHash">KnT+n4Xnnu8EUe88Rd13kTclAyVTLhGGsStKDPPIDJY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="10"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d4fb7a40-c669-405e-a235-733295b15f97"><source><g id="16">Note:</g> After switching on the scanner, the system requires approximately 7 minutes to initialize and warm up.If the wand is not ready for use, <x id="18"/> is displayed on the scanner toolbar and a progress bar displays the status of the initialization.</source><seg-source><mrk mtype="seg" mid="5"><g id="16">Note:</g> After switching on the scanner, the system requires approximately 7 minutes to initialize and warm up.</mrk><mrk mtype="seg" mid="6">If the wand is not ready for use, <x id="18"/> is displayed on the scanner toolbar and a progress bar displays the status of the initialization.</mrk></seg-source><target><mrk mtype="seg" mid="5"><g id="16">Nota:</g> depois de ligar o scanner, o sistema necessita de aproximadamente 7 minutos para inicializar e aquecer.</mrk><mrk mtype="seg" mid="6">Caso o leitor não esteja pronto para uso, <x id="18"/>será exibido na barra de ferramentas do scanner e uma barra de progresso exibirá o status da inicialização.</mrk></target><sdl:seg-defs><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 11:55:23</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1487937646</sdl:value><sdl:value key="SegmentIdentityHash">eCn0G2MdqQs0Z5Ta8CW662RInlQeL4/KxxsuYOCxm64=</sdl:value></sdl:seg><sdl:seg id="6" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1203290261</sdl:value><sdl:value key="SegmentIdentityHash">ClnMk2ON+/CNOAC+YTi2SvlWwXMQkHlE0MdDcNPuOnE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="069d6c0d-402c-4334-9a48-34fdc63467ab"><source>Wand initialization icon and progress bar</source><seg-source><mrk mtype="seg" mid="7">Wand initialization icon and progress bar</mrk></seg-source><target><mrk mtype="seg" mid="7">Ícone de inicialização do leitor e barra de progresso</mrk></target><sdl:seg-defs><sdl:seg id="7" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-401716010</sdl:value><sdl:value key="SegmentIdentityHash">gbTihPmxkNARg5KrGPhJaaUtkTiEcarPQAUHuXwltFs=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="6d8eaf0a-771a-466d-9c50-23e3c0b7b7c7"><source>The iTero Element 5D scanner provides simultaneous capture and display of NIRI, 2D color images, and 3D intraoral optical impression data.</source><seg-source><mrk mtype="seg" mid="8">The iTero Element 5D scanner provides simultaneous capture and display of NIRI, 2D color images, and 3D intraoral optical impression data.</mrk></seg-source><target><mrk mtype="seg" mid="8"/></target><sdl:seg-defs><sdl:seg id="8" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">Zdzzfj1zEkjhYNiJ//pmS/gfo4kYMtAoayXmp7o9HyI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="1eaf9a8b-d95b-45a4-b0e6-f433c102d4b1"><source>Ensure that the patient&apos;s mouth is dry both before and during the scan.</source><seg-source><mrk mtype="seg" mid="9">Ensure that the patient&apos;s mouth is dry both before and during the scan.</mrk></seg-source><target><mrk mtype="seg" mid="9">Certifique-se de que a boca do paciente esteja seca antes e durante a digitalização.</mrk></target><sdl:seg-defs><sdl:seg id="9" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:52</sdl:value><sdl:value key="modified_on">06/12/2024 16:36:49</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-834087273</sdl:value><sdl:value key="SegmentIdentityHash">SPBe5NgfsmdXoogyTYmCK2Dx9xgR6ijqh5EURWDRNUE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7a767c56-533b-42b1-967f-bef1eff9055b"><source>While in Scan mode, you can perform the following actions:</source><seg-source><mrk mtype="seg" mid="10">While in Scan mode, you can perform the following actions:</mrk></seg-source><target><mrk mtype="seg" mid="10">Enquanto estiver no modo Digitalizar, você pode executar as seguintes ações:</mrk></target><sdl:seg-defs><sdl:seg id="10" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/10/2022 07:47:36</sdl:value><sdl:value key="modified_on">11/17/2022 00:48:36</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-204285993</sdl:value><sdl:value key="SegmentIdentityHash">T/htHOchLjGKK56omOimCdZIDRPxhDGjYnEVZAQT6rg=</sdl:valu
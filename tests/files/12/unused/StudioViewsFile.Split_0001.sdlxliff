xt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="8ce53251-8fae-44d1-977d-987d526f6f61"><source>Align hostname recommendations</source><seg-source><mrk mtype="seg" mid="3">Align hostname recommendations</mrk></seg-source><target><mrk mtype="seg" mid="3">Recomendações de nome de host da Align</mrk></target><sdl:seg-defs><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/11/2019 10:26:05</sdl:value><sdl:value key="modified_on">12/23/2019 02:55:19</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-289306331</sdl:value><sdl:value key="SegmentIdentityHash">7Fcw7qLtObRoqZWZVc9P1Hn339ipAriv72rg/Dj4IBY=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="f8d3fc04-2c12-4012-b8a9-3b6f1b13aa85"><source>Align constantly improves its products and services, and can therefore commit to a Hostname, rather than a specific IP address.</source><seg-source><mrk mtype="seg" mid="4">Align constantly improves its products and services, and can therefore commit to a Hostname, rather than a specific IP address.</mrk></seg-source><target><mrk mtype="seg" mid="4">O Align aprimora constantemente seus produtos e serviços e, portanto, pode se comprometer com um nome de host, em vez de com um endereço IP específico.</mrk></target><sdl:seg-defs><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/26/2020 08:28:38</sdl:value><sdl:value key="modified_on">10/22/2020 03:47:16</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1943810310</sdl:value><sdl:value key="SegmentIdentityHash">7gIPT0QfJGYpbghCYbHlS3+VwKSWYFSrpzS/imbiUNo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="98badd84-4567-4e34-8376-e417098f056e"><source>The following list of hostnames was created to provide Align’s scanners the proper operation functions, in order to be able to utilize all the advanced capabilities of the scanner performance.</source><seg-source><mrk mtype="seg" mid="5">The following list of hostnames was created to provide Align’s scanners the proper operation functions, in order to be able to utilize all the advanced capabilities of the scanner performance.</mrk></seg-source><target><mrk mtype="seg" mid="5">A lista de nomes de host a seguir foi criada para fornecer aos scanners da Align as funções operacionais adequadas, que possibilitam utilizar todos os recursos avançados do desempenho do scanner.</mrk></target><sdl:seg-defs><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/26/2020 08:28:41</sdl:value><sdl:value key="modified_on">05/31/2020 18:40:11</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1123325923</sdl:value><sdl:value key="SegmentIdentityHash">q4+spF4dgQHf56C0fPWWmuR80S8dh5aNGyVl3lgVrYo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="c1a59375-5f17-4957-affd-c13a457ede9a"><source>Align hostname recommendation:</source><seg-source><mrk mtype="seg" mid="6">Align hostname recommendation:</mrk></seg-source><target><mrk mtype="seg" mid="6">Recomendação de nome de ho
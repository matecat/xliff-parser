is:names:tc:xliff:document:1.2</value></props></tag><tag id="51"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;&lt;bpt id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;span class=&quot;strong&quot;&amp;gt;&lt;/bpt&gt;CAUTION:&lt;ept id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/span&amp;gt;&lt;/ept&gt; Never press the Power button for more than 4 seconds.&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;&lt;bpt id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;span class=&quot;strong&quot;&amp;gt;&lt;/bpt&gt;CAUTION:&lt;ept id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;&amp;lt;/span&amp;gt;&lt;/ept&gt; Never press the Power button for more than 4 seconds.&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag><tag id="54"><ph name="&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;This activates a hard reset, which can cause problems such as gray and blue screens.&lt;/MadCap:placeholderCondition&gt;" word-end="false">&lt;ph id=&quot;1&quot; xmlns=&quot;urn:oasis:names:tc:xliff:document:1.2&quot;&gt;</ph><props><value key="prefix"></value><value key="localName">ph</value><value key="namespaces"></value><value key="isEmptyElement">False</value><value key="nodeType">Element</value><value key="displayText">&lt;MadCap:placeholderCondition xmlns:MadCap=&quot;http://www.madcapsoftware.com/Schemas/MadCap.xsd&quot;&gt;This activates a hard reset, which can cause problems such as gray and blue screens.&lt;/MadCap:placeholderCondition&gt;</value><value key="hasDisplayText">True</value><value key="attribute:id">1</value><value key="attribute:xmlns">urn:oasis:names:tc:xliff:document:1.2</value></props></tag></tag-defs></header><body><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="3"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="7a614b7e-b14b-47b5-b4e1-4ea94ed00860"><source>Shutting down</source><seg-source><mrk mtype="seg" mid="1">Shutting down</mrk></seg-source><target><mrk mtype="seg" mid="1"/></target><sdl:seg-defs><sdl:seg id="1" locked="true" conf="Draft"><sdl:rep id="MPdWL1D7BXQhiY1b4Fz5IVZ952wbIwrEqrWZ6dayHB4="/><sdl:value key="SegmentIdentityHash">MPdWL1D7BXQhiY1b4Fz5IVZ952wbIwrEqrWZ6dayHB4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="62860d0e-46d4-497e-adc4-e06ddaa745d3"><source>Shutting down the scanner</source><seg-source><mrk mtype="seg" mid="2">Shutting down the scanner</mrk></seg-source><target><mrk mtype="seg" mid="2">Desligando o scanner</mrk></target><sdl:seg-defs><sdl:seg id="2" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">10/13/2020 09:26:52</sdl:value><sdl:value key="modified_on">10/22/2020 03:30:28</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">326259537</sdl:value><sdl:value key="SegmentIdentityHash">NZgPNelqWVkRoXId/IvzlLqSyGYWIskNzhFFhEVuo88=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="1d1f7ab5-e759-4208-a7f5-9c09f0ced768"><source>It is recommended to shut down the scanner at the end of each day, to ensure optimal performance.</source><seg-source><mrk mtype="seg" mid="3">It is recommended to shut down the scanner at the end of each day, to ensure optimal performance.</mrk></seg-source><target><mrk mtype="seg" mid="3">É recomendável desligar o scanner no final de cada dia para garantir que o desempenho seja ótimo.</mrk></target><sdl:seg-defs><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/19/2024 17:37:08</sdl:value><sdl:value key="modified_on">06/12/2024 16:29:53</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1145819965</sdl:value><sdl:value key="SegmentIdentityHash">m6nuPfKSfNdo6U4N8lhVGvs9IReDFK3IjqtJgcI++Mo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="f92ae32b-3e06-4bf9-9371-d265dbdd3786"><source><g id="6">Note:</g> Do not shut down the scanner if you have scheduled a software installation for that night, as described in <x id="7"/>.</source><seg-source><mrk mtype="seg" mid="4"><g id="6">Note:</g> Do not shut down the scanner if you have scheduled a software installation for that night, as described in <x id="7"/>.</mrk></seg-source><target><mrk mtype="seg" mid="4"><g id="6">Nota:</g> não desligue o scanner caso você tenha agendado uma instalação de software para a noite, conforme descrito em <x id="7"/>.</mrk></target><sdl:seg-defs><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/19/2024 17:37:24</sdl:value><sdl:value key="modified_on">06/12/2024 16:29:53</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2111084086</sdl:value><sdl:value key="SegmentIdentityHash">W0tM7BVs/Gj5PUWKGoAmOGc/Pz5owzf04lRTcwO4sF4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="cf050135-05db-4f57-98f0-1ab7e8abf557"><source>To shut down the scanner:</source><seg-source><mrk mtype="seg" mid="5">To shut down the scanner:</mrk></seg-source><target><mrk mtype="seg" mid="5">Para desligar o scanner:</mrk></target><sdl:seg-defs><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/09/2019 08:30:54</sdl:value><sdl:value key="modified_on">12/22/2019 01:12:22</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1648933912</sdl:value><sdl:value key="SegmentIdentityHash">2gioStQiFIMpcHLAZn4scwapH6qpSWHt7V+lFmIwSOo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="8"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="e89e35d9-8d0f-44b7-b49d-8621f01721a4"><source>Close all files and applications.</source><seg-source><mrk mtype="seg" mid="6">Close all files and applications.</mrk></seg-source><target><mrk mtype="seg" mid="6"/></target><sdl:seg-defs><sdl:seg id="6" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">ep6Jdtv6wtP4SmHHn5yU0ehVZvaY/79mVMlCKWs09Ng=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="10"/><sdl:cxt id="11"/><sdl:cxt id="12"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2ebdfeaf-9349-4809-8787-caa03d22893b"><source>Press and release the Power button to shut down the system.<x id="23"/><x id="24"/><x id="25"/><x id="28"/><x id="29"/>The Power button is located on the top right of the screen.<x id="31"/><x id="32"/></source><seg-source><mrk mtype="seg" mid="7">Press and release the Power button to shut down the system.</mrk><mrk mtype="seg" mid="8"><x id="23"/></mrk><mrk mtype="seg" mid="9"><x id="24"/><x id="25"/></mrk><mrk mtype="seg" mid="10"><x id="28"/><x id="29"/>The Power button is located on the top right of the screen.</mrk><mrk mtype="seg" mid="11"><x id="31"/><x id="32"/></mrk></seg-source><target><mrk mtype="seg" mid="7">Pressione e solte o botão Ligar/Desligar para desligar o sistema.</mrk><mrk mtype="seg" mid="8"><x id="23"/></mrk><mrk mtype="seg" mid="9"><x id="24"/><x id="25"/></mrk><mrk mtype="seg" mid="10"><x id="28"/><x id="29"/>O botão Ligar/Desligar está localizado no canto superior direito da tela.</mrk><mrk mtype="seg" mid="11"><x id="31"/><x id="32"/></mrk></target><sdl:seg-defs><sdl:seg id="7" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2022 11:10:46</sdl:value><sdl:value key="modified_on">12/06/2022 11:10:46</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-2039766462</sdl:value><sdl:value key="SegmentIdentityHash">cGxSEsP8B1N0fYx12D0VdBcxz1b8LFwHvrFCHmD+1g4=</sdl:value></sdl:seg><sdl:seg id="8" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-608962140</sdl:value><sdl:value key="SegmentIdentityHash">FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4=</sdl:value></sdl:seg><sdl:seg id="9" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="5Zioq4EY/PhydFhV6TLDNyjbw4s2FodbeKnL1+XGxrU="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:53:33</sdl:value><sdl:value key="modified_on">11/12/2022 05:54:20</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1217924312</sdl:value><sdl:value key="SegmentIdentityHash">5Zioq4EY/PhydFhV6TLDNyjbw4s2FodbeKnL1+XGxrU=</sdl:value></sdl:seg><sdl:seg id="10" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/05/2024 22:31:18</sdl:value><sdl:value key="modified_on">06/12/2024 16:29:53</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">214991354</sdl:value><sdl:value key="SegmentIdentityHash">m9dpViZOcZEWPloc9x5glIeKe40ShbwvLS9vTEf1Ogs=</sdl:value></sdl:seg><sdl:seg id="11" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="5Zioq4EY/PhydFhV6TLDNyjbw4s2FodbeKnL1+XGxrU="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:53:33</sdl:value><sdl:value key="modified_on">11/12/2022 05:54:20</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1217924312</sdl:value><sdl:value key="SegmentIdentityHash">5Zioq4EY/PhydFhV6TLDNyjbw4s2FodbeKnL1+XGxrU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="28f1d790-e35a-4a84-8218-33a55423e480"><source><g id="41">Note:</g> If you do not shut down the scanner correctly, the next time you log on, a message will be displayed notifying you of this and will remain until you acknowledge it.</source><seg-source><mrk mtype="seg" mid="12"><g id="41">Note:</g> If you do not shut down the scanner correctly, the next time you log on, a message will be displayed notifying you of this and will remain until you acknowledge it.</mrk></seg-source><target><mrk mtype="seg" mid="12"><g id="41">Nota:</g> se você não desligar o scanner corretamente, na próxima vez que fizer login, será exibida uma mensagem notificando-o sobre isso e a mesma permanecerá até que você confirme a mensagem.</mrk></target><sdl:seg-defs><sdl:seg id="12" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:21</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:21</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">96904032</sdl:value><sdl:value key="SegmentIdentityHash">PCFu72tE9+aBbkNn1EiDm4PK28xpLmnFIdopHu4Bcww=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="13"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="b00aa645-be0a-4372-9c11-0a110ee02a20"><source>Incorrect shutdown can be caused <g id="47">by letting the battery run down and </g>by pressing the Power button for longer than 4 seconds, which activates a hard reset and can cause problems such as gray and blue screens.</source><seg-source><mrk mtype="seg" mid="13">Incorrect shutdown can be caused <g id="47">by letting the battery run down and </g>by pressing the Power button for longer than 4 seconds, which activates a hard reset and can cause problems such as gray and blue screens.</mrk></seg-source><target><mrk mtype="seg" mid="13">O desligamento incorreto pode ser causado <g id="47">ao deixar a bateria descarregar ou</g>ao pressionar o botão Ligar/Desligar por mais de 4 segundos, o que pode ativar uma redefinição do hardware e pode causar problemas como telas azul ou cinza.</mrk></target><sdl:seg-defs><sdl:seg id="13" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">02/19/2024 17:40:00</sdl:value><sdl:value key="modified_on">06/12/2024 16:29:53</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">736399485</sdl:value><sdl:value key="SegmentIdentityHash">+i5Fgc7xKWIkhiivKLls1Rj1o4Qxu0ZAk5QJS5QL+Hk=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="14"/><sdl:cxt id="15"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="ac837b3d-f264-4dfd-b0f0-d0d646727da7"><source><x id="51"/><x id="54"/></source><seg-source><mrk mtype="seg" mid="14"><x id="51"/></mrk><mrk mtype="seg" mid="15"><x id="54"/></mrk></seg-source><target><mrk mtype="seg" mid="14"><x id="51"/></mrk><mrk mtype="seg" mid="15"><x id="54"/></mrk></target><sdl:seg-defs><sdl:seg id="14" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/12/2022 04:45:51</sdl:value><sdl:value key="modified_on">11/12/2022 05:26:54<
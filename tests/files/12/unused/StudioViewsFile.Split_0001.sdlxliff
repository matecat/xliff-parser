><sdl:rep id="SwXI51SAFhXq4veO8AhvRgC01TigC9HxnQJYkzfLCzw="/><sdl:value key="SegmentIdentityHash">SwXI51SAFhXq4veO8AhvRgC01TigC9HxnQJYkzfLCzw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="6"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="189de124-f670-406a-b8ca-d4205f2a7191"><source>Invisalign Outcome Simulator Pro</source><seg-source><mrk mtype="seg" mid="2">Invisalign Outcome Simulator Pro</mrk></seg-source><target><mrk mtype="seg" mid="2">Simulador de Resultado Invisalign Pro</mrk></target><sdl:seg-defs><sdl:seg id="2" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="SwXI51SAFhXq4veO8AhvRgC01TigC9HxnQJYkzfLCzw="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 09:47:15</sdl:value><sdl:value key="modified_on">11/16/2022 23:56:44</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">950717622</sdl:value><sdl:value key="SegmentIdentityHash">SwXI51SAFhXq4veO8AhvRgC01TigC9HxnQJYkzfLCzw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="40df2860-4283-4c86-9b03-b28dae062075"><source>Invisalign Outcome Simulator Pro is an advanced patient communication software tool that enables you to show patients the simulated outcome of their Invisalign treatment on an image of their own face.This tool provides additional information for the patient in their decision to begin Invisalign treatment.</source><seg-source><mrk mtype="seg" mid="3">Invisalign Outcome Simulator Pro is an advanced patient communication software tool that enables you to show patients the simulated outcome of their Invisalign treatment on an image of their own face.</mrk><mrk mtype="seg" mid="4">This tool provides additional information for the patient in their decision to begin Invisalign treatment.</mrk></seg-source><target><mrk mtype="seg" mid="3">O Simulador de Resultado Invisalign é uma avançada ferramenta de software de comunicação com o paciente que permite mostrar aos pacientes o resultado simulado do seu tratamento Invisalign em uma imagem de seu próprio rosto.</mrk><mrk mtype="seg" mid="4">Essa ferramenta fornece informações adicionais ao paciente, ajudando-o em sua decisão de iniciar o tratamento Invisalign.</mrk></target><sdl:seg-defs><sdl:seg id="3" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 09:46:33</sdl:value><sdl:value key="modified_on">11/16/2022 23:56:53</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-356070789</sdl:value><sdl:value key="SegmentIdentityHash">Lyi0my1UC+DcKSjZe/8JPEQPHCqgeZ/ABq0gC6u/m+U=</sdl:value></sdl:seg><sdl:seg id="4" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 09:46:50</sdl:value><sdl:value key="modified_on">11/16/2022 23:57:02</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1836227935</sdl:value><sdl:value key="SegmentIdentityHash">VyQHa/OTrNCeqqVHlQscN9elWUGDEpGTpwNeiT5+qj8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="eaece8b3-88d1-4ae6-9663-82fd0f1811f6"><source>Notes:</source><seg-source><mrk mtype="seg" mid="5">Notes:</mrk></seg-source><target><mrk mtype="seg" mid="5">Notas:</mrk></target><sdl:seg-defs><sdl:seg id="5" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="MV5Vg0NrwdcmWKQ9naRB8KXHXb6LE+trTaKS4OubnEc="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/07/2019 00:22:06</sdl:value><sdl:value key="modified_on">11/19/2020 22:28:16</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-381729265</sdl:value><sdl:value key="SegmentIdentityHash">MV5Vg0NrwdcmWKQ9naRB8KXHXb6LE+trTaKS4OubnEc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="9"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="4dceb9ee-6c09-4957-a9ae-690b286bc0cb"><source>Invisalign Outcome Simulator Pro is supported on iTero Element Plus series intraoral scanners only.</source><seg-source><mrk mtype="seg" mid="6">Invisalign Outcome Simulator Pro is supported on iTero Element Plus series intraoral scanners only.</mrk></seg-source><target><mrk mtype="seg" mid="6"/></target><sdl:seg-defs><sdl:seg id="6" locked="true" conf="Draft"><sdl:value key="SegmentIdentityHash">Vk7qBOhCudFffihmqVvlz45O03PIHLuOWoi9WDL8em8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="c0fc519d-66bd-4db8-8941-fdccf0e4faa2"><source>The Invisalign Outcome Simulator Pro simulation is available only for <g id="10">Study Model/iRecord</g> procedures and <g id="13">Invisalign Aligners</g> procedure types, and is automatically triggered when sending the scan.</source><seg-source><mrk mtype="seg" mid="7">The Invisalign Outcome Simulator Pro simulation is available only for <g id="10">Study Model/iRecord</g> procedures and <g id="13">Invisalign Aligners</g> procedure types, and is automatically triggered when sending the scan.</mrk></seg-source><target><mrk mtype="seg" mid="7">A simulação do Simulador de Resultado Invisalign Pro está disponível apenas para os procedimentos <g id="10">Modelo de Estudo/iRecord</g> e para os tipos de procedimentos <g id="13">Alinhadores Invisalign</g>, sendo automaticamente acionada quando envia a digitalização.</mrk></target><sdl:seg-defs><sdl:seg id="7" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:25</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:25</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-496330683</sdl:value><sdl:value key="SegmentIdentityHash">xSe2SnZCpa5Q6KP6MFHqncFdU0bKv7+FLYnD6sTojpg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="c7448da5-972e-4d1d-a88b-8c9f5fc4a6ab"><source>Invisalign Outcome Simulator Pro requires pairing your Invisalign Doctor Site account with your iTero account.For more information, contact iTero Customer Support.</source><seg-source><mrk mtype="seg" mid="8">Invisalign Outcome Simulator Pro requires pairing your Invisalign Doctor Site account with your iTero account.</mrk><mrk mtype="seg" mid="9">For more information, contact iTero Customer Support.</mrk></seg-source><target><mrk mtype="seg" mid="8">O Simulador de Resultado Invisalign Pro requer o emparelhamento da sua conta do site Invisalign Doctor com a sua conta iTero.</mrk><mrk mtype="seg" mid="9">Para obter mais informações, entre em contato com o Suporte ao Cliente iTero.</mrk></target><sdl:seg-defs><sdl:seg id="8" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 09:51:50</sdl:value><sdl:value key="modified_on">11/16/2022 23:57:54</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1036025162</sdl:value><sdl:value key="SegmentIdentityHash">YJHWHhR/1ScYZccYsqG9r6Bfs30Nq0BUQC+ArS8HepM=</sdl:value></sdl:seg><sdl:seg id="9" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 09:52:31</sdl:value><sdl:value key="modified_on">11/16/2022 23:57:56</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1434895769</sdl:value><sdl:value key="SegmentIdentityHash">JkQ8dU6kUFcTnE/m2X8l6cIMHbisElQj6MVziPOft6Q=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="97a86b93-bbf4-4e22-89aa-79c3772828a3"><source>Once the simulation is complete, you can tap <x id="24"/> in the Viewer or the <g id="27">Invisalign Outcome Simulator Pro</g> button in the <g id="30">Orders</g> page, as described in <x id="31"/>.</source><seg-source><mrk mtype="seg" mid="10">Once the simulation is complete, you can tap <x id="24"/> in the Viewer or the <g id="27">Invisalign Outcome Simulator Pro</g> button in the <g id="30">Orders</g> page, as described in <x id="31"/>.</mrk></seg-source><target><mrk mtype="seg" mid="10">Assim que a simulação for concluída, você pode tocar em <x id="24"/> no Visualizador ou no botão <g id="27">Simulador de Resultado Invisalign Pro</g> na página <g id="30">Pedidos</g>, conforme descrito em <x id="31"/>.</mrk></target><sdl:seg-defs><sdl:seg id="10" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:25</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:25</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-573134394</sdl:value><sdl:value key="SegmentIdentityHash">wxloypmddCBBygig7NAw5LIlC1qC3UI3ckBOztNbhsA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="10"/><sdl:cxt id="11"/><sdl:cxt id="8"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="9e536869-b355-4366-a74c-b49e00665abf"><source>For more information on using Invisalign Outcome Simulator Pro, refer to the Invisalign Outcome Simulator Pro documentation.<x id="36"/><x id="37"/><x id="38"/></source><seg-source><mrk mtype="seg" mid="11">For more information on using Invisalign Outcome Simulator Pro, refer to the Invisalign Outcome Simulator Pro documentation.</mrk><mrk mtype="seg" mid="12"><x id="36"/></mrk><mrk mtype="seg" mid="13"><x id="37"/></mrk><mrk mtype="seg" mid="14"><x id="38"/></mrk></seg-source><target><mrk mtype="seg" mid="11">Para obter mais informações sobre como usar o Simulador de Resultado Invisalign Pro, consulte a documentação do Simulador de Resultado Invisalign Pro.</mrk><mrk mtype="seg" mid="12"><x id="36"/></mrk><mrk mtype="seg" mid="13"><x id="37"/></mrk><mrk mtype="seg" mid="14"><x id="38"/></mrk></target><sdl:seg-defs><sdl:seg id="11" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 09:56:48</sdl:value><sdl:value key="modified_on">11/16/2022 23:58:04</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1324822951</sdl:value><sdl:value key="SegmentIdentityHash">KQXb
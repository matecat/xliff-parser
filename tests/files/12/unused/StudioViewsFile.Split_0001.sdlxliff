:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/10/2019 00:42:50</sdl:value><sdl:value key="modified_on">12/22/2019 19:37:12</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-227731688</sdl:value><sdl:value key="SegmentIdentityHash">MoL48YJNs4Sw5le6FgWEPV6IkbFjgzjEz5bqe+gX0EM=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="10"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="5167195c-8377-40c6-8c48-f721b80b360f"><source>The Viewer is a tool that enables you to view and manipulate the digital model for case presentations.Only scans that have already been sent can be viewed in the Viewer.</source><seg-source><mrk mtype="seg" mid="7">The Viewer is a tool that enables you to view and manipulate the digital model for case presentations.</mrk><mrk mtype="seg" mid="8">Only scans that have already been sent can be viewed in the Viewer.</mrk></seg-source><target><mrk mtype="seg" mid="7">O Visualizador é uma ferramenta que permite visualizar e manipular o modelo digital para apresentações de casos.</mrk><mrk mtype="seg" mid="8">Somente as digitalizações que já foram enviados podem ser visualizados no Visualizador.</mrk></target><sdl:seg-defs><sdl:seg id="7" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/10/2019 00:32:49</sdl:value><sdl:value key="modified_on">12/22/2019 19:37:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1648475893</sdl:value><sdl:value key="SegmentIdentityHash">0p5A3LVa4IcR5eAgdHwMgcgcsiYmD3Hp+UQTDXnn6Og=</sdl:value></sdl:seg><sdl:seg id="8" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt
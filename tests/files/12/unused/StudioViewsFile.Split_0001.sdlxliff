Apnea/Sleep appliances.For more information, see <x id="192"/>.</source><seg-source><mrk mtype="seg" mid="39"><g id="189">Appliance:</g> Enables you to create a prescription<x id="190"/> for various dental appliances, for example, night guards and Apnea/Sleep appliances.</mrk><mrk mtype="seg" mid="40">For more information, see <x id="192"/>.</mrk></seg-source><target><mrk mtype="seg" mid="39"><g id="189">Aparelho:</g> permite que você crie uma prescrição<x id="190"/> para vários aparelhos dentários, como, por exemplo, os protetores noturnos e aparelhos para Apneia/Sono.</mrk><mrk mtype="seg" mid="40">Para mais informações, consulte <x id="192"/>.</mrk></target><sdl:seg-defs><sdl:seg id="39" conf="ApprovedTranslation" origin="interactive" percent="79"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="79"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">bjIdVO5ccx3qxTJPi0WO3IEBr0FJ5oAT67RfaNRKHqQ=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 15:31:49</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">bjIdVO5ccx3qxTJPi0WO3IEBr0FJ5oAT67RfaNRKHqQ=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1709880713</sdl:value></sdl:seg><sdl:seg id="40" conf="ApprovedTranslation" origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="99"><sdl:rep id="7Ohy1cOz5eX+waPmq2AF23DPmdMlIbw4Gf/7YOWfIqI="/><sdl:value key="SegmentIdentityHash">7Ohy1cOz5eX+waPmq2AF23DPmdMlIbw4Gf/7YOWfIqI=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 16:35:48</sdl:value><sdl:value key="created_on">03/07/2023 16:33:19</sdl:value><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1809051878</sdl:value><sdl:value key="SDL:ProjectTranslationHash">1809051878</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="12"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="33a97841-138e-40de-9364-5bdd586bc331"><source>The <g id="205">Order</g> and <g id="208">Scan Options</g> areas of the <g id="211">New Scan</g> window are displayed according to the selected procedure.</source><seg-source><mrk mtype="seg" mid="41">The <g id="205">Order</g> and <g id="208">Scan Options</g> areas of the <g id="211">New Scan</g> window are displayed according to the selected procedure.</mrk></seg-source><target><mrk mtype="seg" mid="41">As áreas <g id="205">Pedido</g> e <g id="208">Opções de Digitalização</g> da janela <g id="211">Nova Digitalização</g> são exibidas de acordo com o procedimento selecionado.</mrk></target><sdl:seg-defs><sdl:seg id="41" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:23</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-488202591</sdl:value><sdl:value key="SegmentIdentityHash">Y0GWNbqVkxLtKarXqrVRzW0cmWP878rEuH90cTZohp4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="12"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="8a5d1bf4-4fe2-4267-8676-c34bb8144159"><source>If relevant, from the <g id="217">Type</g> drop-down list, select the procedure type required.</source><seg-source><mrk mtype="seg" mid="42">If relevant, from the <g id="217">Type</g> drop-down list, select the procedure type required.</mrk></seg-source><target><mrk mtype="seg" mid="42">Se relevante, selecione o <g id="217">tipo</g> de procedimento necessário na lista suspensa Tipo.</mrk></target><sdl:seg-defs><sdl:seg id="42" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:23</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">430015867</sdl:value><sdl:value key="SegmentIdentityHash">//j0BW3TSkaoLC1AUHxNUf7rrxaMJd+K1Ct0O9KvpFA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="12"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="d1dfeae9-24e6-456d-9d3a-ac051b07d014"><source><g id="226">Note:</g> Procedure types are not relevant for Study Model/iRecord <x id="227"/>procedures.</source><seg-source><mrk mtype="seg" mid="43"><g id="226">Note:</g> Procedure types are not relevant for Study Model/iRecord <x id="227"/>procedures.</mrk></seg-source><target><mrk mtype="seg" mid="43"><g id="226">Nota:</g> os tipos de procedimentos não são relevantes para os procedimentos Modelo de Estudo/iRecord <x id="227"/></mrk></target><sdl:seg-defs><sdl:seg id="43" conf="ApprovedTranslation" origin="interactive" percent="81"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="81"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">0fuw2SMvmrNW5yllLOk6dLs/UP+OCxkbC5N4fYNf/Jw=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 15:34:02</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">0fuw2SMvmrNW5yllLOk6dLs/UP+OCxkbC5N4fYNf/Jw=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1413076186</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="12"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="11e69e8f-0a96-487c-9d6c-9137a755c4f1"><source>If required, tap the calendar in the <g id="233">Due Date</g> field and then select the date the case is due back from the lab.</source><seg-source><mrk mtype="seg" mid="44">If required, tap the calendar in the <g id="233">Due Date</g> field and then select the date the case is due back from the lab.</mrk></seg-source><target><mrk mtype="seg" mid="44">Se necessário, toque no calendário no campo <g id="233">Data de Vencimento</g> e, em seguida, selecione a data em que a dentadura deve estar pronta no laboratório.</mrk></target><sdl:seg-defs><sdl:seg id="44" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:23</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">748940966</sdl:value><sdl:value key="SegmentIdentityHash">Auu9MAuOiA+P4/ZjMoygyrnZnIL3E6P+PgFnUudYnd8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="12"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="36432318-5e5d-43ac-a30d-551d12e06e7e"><source><x id="244"/> <g id="250">From the <g id="248">Send To</g> drop-down list, select either the lab to which the scan should be sent, or your MyiTero account.</g></source><seg-source><mrk mtype="seg" mid="45"><x id="244"/> <g id="250">From the <g id="248">Send To</g> drop-down list, select either the lab to which the scan should be sent, or your MyiTero account.</g></mrk></seg-source><target><mrk mtype="seg" mid="45"><x id="244"/> <g id="250">Na lista suspensa <g id="248">Enviar Para</g> selecione o laboratório para o qual a digitalização deve ser enviada do consultório ou sua conta MyiTero.</g></mrk></target><sdl:seg-defs><sdl:seg id="45" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 14:21:46</sdl:value><sdl:value key="modified_on">06/12/2024 17:54:43</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">133979154</sdl:value><sdl:value key="SegmentIdentityHash">DYVk1Bgghgn4Zx4jO6zr8LFrCzP9zuEvCo5758//OGc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="12"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="03fc91d7-c45b-435a-bb95-0e672341c636"><source>Depending on the procedure selected, fill in the relevant additional details.</source><seg-source><mrk mtype="seg" mid="46">Depending on the procedure selected, fill in the relevant additional details.</mrk></seg-source><target><mrk mtype="seg" mid="46">Dependendo do procedimento selecionado, preencha os detalhes adicionais relevantes.</mrk></target><sdl:seg-defs><sdl:seg id="46" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/04/2022 16:24:58</sdl:value><sdl:value key="modified_on">11/18/2022 00:49:03</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1647698067</sdl:value><sdl:value key="SegmentIdentityHash">DQjEmAmt6hD18Hl3gxYvm5RDTo5JQI68/FEgMjbVqgc=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="12"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="0336289e-6a99-4ac4-a4ea-c00df94da02c"><source>In the <g id="256">Scan Options</g> area, turn on/off the following toggles, depending on the procedure selected, as required.</source><seg-source><mrk mtype="seg" mid="47">In the <g id="256">Scan Options</g> area, turn on/off the following toggles, depending on the procedure selected, as required.</mrk></seg-source><target><mrk mtype="seg" mid="47">Na área <g id="256">Opções de Digitalização</g>, ative/desative as seguintes opções, dependendo do procedimento selecionado, conforme necessário.</mrk></target><sdl:seg-defs><sdl:seg id="47" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:23</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:23</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">371449323</sdl:value><sdl:value key="SegmentIdentityHash">SNpI+bPPx4oO4H7w2wXj+pyFwxcQQIRPcQWHAPo60XE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="9"/><sdl:cxt id="12"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="303d6c48-6e4a-4512-819c-2395ca471d0d"><source>For Invisalign from Study Model/iRecord procedures, it is recommended that the first bite is scanned bilaterally.Only the first bite will be used in the ClinCheck software.</source><seg-source><mrk mtype="seg" mid="48">For Invisalign from Study Model/iRecord procedures, it is recommended that the first bite is scanned bilaterally.</mrk><mrk mtype="seg" mid="49">Only the first bite will be used in the ClinCheck software.</mrk></seg-source><target><mrk mtype="seg" mid="48">Para procedimentos Invisalign do Modelo de Estudo/iRecord, recomenda-se que a primeira mordida seja digitalizada bilateralmente.</mrk><mrk mtype="seg" mid="49">Apenas a primeira mordida será usada no software ClinCheck.</mrk></target><sdl:seg-defs><sdl:seg id="48" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/04/2022 16:26:17</sdl:value><sdl:value key="modified_on">11/18/2022 00:49:14</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1242812375</sdl:value><sdl:value key="SegmentIdentityHash">xRUOzMwrI2YvVr3fTvkbtvkYCJgC3PIiDP48FNvfvW4=</sdl:value></sdl:seg><sdl:seg id="49" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/04/2022 16:26:31</sdl:value><sdl:value key="modified_on">11/18/2022 00:49:16</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-151931109</sdl:value><sdl:value key="SegmentIdentityHash">ZpDGAqVdRHyk3hgdqiBth3Qsi3SwpeP/D4HT1QMuBuI=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="23"/><sdl:cxt id="24"/><sdl:cxt id="25"/><sdl:cxt id="12"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="130d8729-676b-41b5-8cbb-86046fbb92ea"><source><x id="265"/><x id="268"/><x id="271"/></source><seg-source><mrk mtype="seg" mid="50"><x id="265"/></mrk><mrk mtype="seg" mid="51"><x id="268"/></mrk><mrk mtype="seg" mid="52"><x id="271"/></mrk></seg-source><target><mrk mtype="seg" mid="50"><x id="265"/></mrk><mrk mtype="seg" mid="51"><x id="268"/></mrk><mrk mtype="seg" mid="52"><x id="271"/></mrk></target><sdl:seg-defs><sdl:seg id="50" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:rep id="FslqDmLvPQjBA3EOXBWhXy4vnYUlofjo5SMK9LGXmh4="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:va
ast order of a specific patient in the <g id="48">Orders</g> page, or from a specific patient&apos;s profile page, tap <g id="51">Viewer</g> to display the Viewer.</source><seg-source><mrk mtype="seg" mid="22">Open the past order of a specific patient in the <g id="48">Orders</g> page, or from a specific patient&apos;s profile page, tap <g id="51">Viewer</g> to display the Viewer.</mrk></seg-source><target><mrk mtype="seg" mid="22">Abra o pedido anterior de um paciente específico na página <g id="48">Pedidos</g> ou na página de perfil de um paciente específico. Toque em <g id="51">Visualizador</g> para exibir o Visualizador.</mrk></target><sdl:seg-defs><sdl:seg id="22" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:26</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:26</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-158888351</sdl:value><sdl:value key="SegmentIdentityHash">OMst9toOrQG3/nzdrkbwtpXQD01GEEsCawbux9QjbGw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="2"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2a9c451d-120c-49f2-bf4d-8b4b10964aee"><source>In the Viewer, tap <x id="53"/>.</source><seg-source><mrk mtype="seg" mid="23">In the Viewer, tap <x id="53"/>.</mrk></seg-source><target><mrk mtype="seg" mid="23">No Visualizador, toque em <x id="53"/>.</mrk></target><sdl:seg-defs><sdl:seg id="23" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:26</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:26</sdl:value><sdl:value key="last_modified_by
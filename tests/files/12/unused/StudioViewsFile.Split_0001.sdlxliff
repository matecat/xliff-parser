tem="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/28/2020 19:21:02</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1343137165</sdl:value><sdl:value key="SegmentIdentityHash">4byeaAcU04w6QQsj78J1nGk+PnVukMawWw1NVw6XhkE=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="cfae55bd-1df8-44ba-945b-65fb49dd5fa5"><source>Equipment not suitable for use in the presence of flammable anesthetic mixtures.</source><seg-source><mrk mtype="seg" mid="333">Equipment not suitable for use in the presence of flammable anesthetic mixtures.</mrk></seg-source><target><mrk mtype="seg" mid="333">Equipamento não adequado para uso na presença de anestésicos com substâncias inflamáveis.</mrk></target><sdl:seg-defs><sdl:seg id="333" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/28/2020 19:22:19</sdl:value><sdl:value key="modified_on">05/28/2020 19:22:19</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-215155356</sdl:value><sdl:value key="SegmentIdentityHash">Rto0p34kqfMqmhNjenddeZzEVHAVKhS4IrmADiplBx8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="6"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="711081cd-63c3-42d1-b2ff-cf20b82759e8"><source>Mode of operation: Continuous.</source><seg-source><mrk mtype="seg" mid="334">Mode of operation: Continuous.</mrk></seg-source><target><mrk mtype="seg" mid="334">Modo de operação: Contínuo.</mrk></target><sdl:seg-defs><sdl:seg id="334" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/15/2020 09:38:50</sdl:value><sdl:value key="modified_on">05/15/2020 09:38:50</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1076675209</sdl:value><sdl:value key="SegmentIdentityHash">xyv9+KeIU8JmstmI7ckfdm2ZyX/Nt4wR//dNoevd0t4=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="175aec99-6754-4c3d-8782-42e1739a741b"><source>Prescription health device</source><seg-source><mrk mtype="seg" mid="335">Prescription health device</mrk></seg-source><target><mrk mtype="seg" mid="335">Equipamento médico para prescrição</mrk></target><sdl:seg-defs><sdl:seg id="335" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">05/28/2020 19:23:44</sdl:value><sdl:value key="modified_on">05/28/2020 19:23:44</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">72561318</sdl:value><sdl:value key="SegmentIdentityHash">pXuR5aNuqRQJsvwt9r08jaqNfzdsVhw1FXq/o2pMZ20=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="11"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="2208b733-089d-4106-952a-1f518b048a82"><source>The system serves as a prescription medical device and should be operated by <x id="561"/><g id="564">trained dental</g> health-care providers only.</source><seg-source><mrk mtype="seg" mid="336">The system serves as a prescription medical device and should be operated by <x id="561"/><g id="564">trained dental</g> health-care providers only.</mrk></seg-source><target><mrk mtype="seg" mid="336">O sistema funciona como um dispositivo para a prescrição médica e deve ser operado apenas por profissionais da saúde <x id="561"/><g id="564">dentária treinados</g>.</mrk></target><sdl:seg-defs><sdl:seg id="336" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 20:17:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1293562902</sdl:value><sdl:value key="SegmentIdentityHash">9cVk/DUw9Z6bpGKvgbrvNc4ig2jUVLRY83Swxnn/4CA=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="47"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="b938c176-3717-4d2b-aef0-c93b458f69ca"><source>Scanner warnings</source><seg-source><mrk mtype="seg" mid="337">Scanner warnings</mrk></seg-source><target><mrk mtype="seg" mid="337">Alertas do scanner</mrk></target><sdl:seg-defs><sdl:seg id="337" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">12/06/2019 20:45:35</sdl:value><sdl:value key="modified_on">12/23/2019 13:16:59</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1042760254</sdl:value><sdl:value key="SegmentIdentityHash">7JbYc0O8wkeiFvjaeXM6rPJ0p0uA9aHMdzqJ6BjgcyU=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="48"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="29b6fb35-241c-4dd6-aa76-4e13b9968250"><source><g id="570">Warning:</g> When the system is not in use, the wand should be placed in the cradle with the optical window facing the cradle.</source><seg-source><mrk mtype="seg" mid="338"><g id="570">Warning:</g> When the system is not in use, the wand should be placed in the cradle with the optical window facing the cradle.</mrk></seg-source><target><mrk mtype="seg" mid="338"><g id="570">Aviso:</g> quando o sistema não estiver em uso, o leitor deverá ser colocado no suporte com a janela óptica voltada para o suporte.</mrk></target><sdl:seg-defs><sdl:seg id="338" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 22:17:03</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-575673981</sdl:value><sdl:value key="SegmentIdentityHash">b50NOzTByzNQpZY3hkgGtGA3Aom2VsE57kSZh3Dxbfo=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="48"/><sdl:cxt id="49"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="f8f4d173-adfd-43b3-a7c7-7c51ff570c13"><source><g id="580">Warning:</g> Avoid using the wand without a <x id="581"/>sleeve in order to reduce the risk of cross-contamination, discomfort, and even burns.The temperature of the wand tip, without a sleeve, can get up to 51ºC during scanning.</source><seg-source><mrk mtype="seg" mid="339"><g id="580">Warning:</g> Avoid using the wand without a <x id="581"/>sleeve in order to reduce the risk of cross-contamination, discomfort, and even burns.</mrk><mrk mtype="seg" mid="340">The temperature of the wand tip, without a sleeve, can get up to 51ºC during scanning.</mrk></seg-source><target><mrk mtype="seg" mid="339"><g id="580">Aviso:</g> para reduzir a contaminação cruzada, desconforto e até mesmo queimaduras, evite usar o leitor sem uma ponteira <x id="581"/>.</mrk><mrk mtype="seg" mid="340">A temperatura da ponta do leitor sem a ponteira pode chegar a 51ºC durante a digitalização.</mrk></target><sdl:seg-defs><sdl:seg id="339" conf="ApprovedTranslation" origin="interactive" percent="95"><sdl:prev-origin origin="tm" origin-system="222818 Rev.3 LuminaPro-pt-BR_NG_Core-pt-BR2" percent="95"><sdl:prev-origin/><sdl:value key="SegmentIdentityHash">tkED0JurUN8LmjdVogIbSleOEp3dMPOriJDBM5B/CKA=</sdl:value><sdl:value key="last_modified_by">DESKTOP-0BKV72R\xzgab</sdl:value><sdl:value key="modified_on">08/28/2024 18:47:06</sdl:value></sdl:prev-origin><sdl:value key="SegmentIdentityHash">tkED0JurUN8LmjdVogIbSleOEp3dMPOriJDBM5B/CKA=</sdl:value><sdl:value key="last_modified_by">NEARUACER\veren</sdl:value><sdl:value key="modified_on">09/02/2024 18:20:19</sdl:value><sdl:value key="SDL:ProjectTranslationHash">-1030860394</sdl:value></sdl:seg><sdl:seg id="340" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1769467483</sdl:value><sdl:value key="SegmentIdentityHash">mZqLRj4KIS6Kxv/b96uE1zZTXJ6yLOGzRGYV5GjRnYg=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="50"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="87597910-c7b1-436e-903f-f9e3ffe9703c"><source><g id="589">CAUTION:</g> Avoid twisting, knotting, pulling, and stepping on the wand cable and the power cable.</source><seg-source><mrk mtype="seg" mid="341"><g id="589">CAUTION:</g> Avoid twisting, knotting, pulling, and stepping on the wand cable and the power cable.</mrk></seg-source><target><mrk mtype="seg" mid="341"><g id="589">ATENÇÃO:</g> evite torcer, dar nós, puxar e pisar no cabo do leitor e no cabo de energia.</mrk></target><sdl:seg-defs><sdl:seg id="341" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">NEARUACER\veren</sdl:value><sdl:value key="created_on">06/04/2024 22:21:15</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-476737549</sdl:value><sdl:value key="SegmentIdentityHash">g8EkI0QZY6vlM/UCO+rmD5boxJYHXhVAo89wJ83T2B8=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="48"/><sdl:cxt id="49"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="317cc4b7-044e-4fbc-ba66-3746b5271540"><source><g id="595">Warning:</g> Do not use the equipment if a scanner malfunction occurs or if physical damage is observed, in order to avoid electrical shock or physical injury.As soon as any damage is observed, stop scanning immediately, disconnect the system from the electricity, and call Customer Support.</source><seg-source><mrk mtype="seg" mid="342"><g id="595">Warning:</g> Do not use the equipment if a scanner malfunction occurs or if physical damage is observed, in order to avoid electrical shock or physical injury.</mrk><mrk mtype="seg" mid="343">As soon as any damage is observed, stop scanning immediately, disconnect the system from the electricity, and call Customer Support.</mrk></seg-source><target><mrk mtype="seg" mid="342"><g id="595">Aviso:</g> para evitar choque elétrico ou lesão física, não use o equipamento se ocorrer um mau funcionamento do scanner ou se forem observados danos físicos.</mrk><mrk mtype="seg" mid="343">Assim que for detectada a presença de algum dano, pare imediatamente a digitalização, desconecte o sistema da eletricidade e ligue para o Suporte ao Cliente.</mrk></target><sdl:seg-defs><sdl:seg id="342" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-684203520</sdl:value><sdl:value key="SegmentIdentityHash">uyp3H4oiDOFA2TO1mZHhXPggLTrFUcbhC0dH95c2Y6o=</sdl:value></sdl:seg><sdl:seg id="343" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">08/08/2024 10:21:49</sdl:value><sdl:value key="modified_on">06/12/2024 14:19:04</sdl:value><sdl:value key="last_modified_by">JONATAS-CAMPOS\Gabriel</sdl:value><sdl:value key="SDL:OriginalTranslationHash">-1812338568</sdl:value><sdl:value key="SegmentIdentityHash">GLFnOyrsL33JGcywbhuYs9mZQ0xy4eGxM7h/G/+nxrw=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="48"/><sdl:cxt id="49"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="32456cdd-a504-4150-bb9b-974fa014ea8c"><source><g id="603">Warning:</g> Do not clean, disinfect, or use the wand if any damage is found.Please contact iTero Customer Support for further instructions.</source><seg-source><mrk mtype="seg" mid="344"><g id="603">Warning:</g> Do not clean, disinfect, or use the wand if any damage is found.</mrk><mrk mtype="seg" mid="345">Please contact iTero Customer Support for further instructions.</mrk></seg-source><target><mrk mtype="seg" mid="344"><g id="603">Alerta:</g> Não limpe, desinfete ou use o leitor se for encontrado algum dano.</mrk><mrk mtype="seg" mid="345">Entre em contato com o Suporte ao Cliente iTero para obter instruções adicionais.</mrk></target><sdl:seg-defs><sdl:seg id="344" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">03/07/2023 16:33:16</sdl:value><sdl:value key="modified_on">03/07/2023 16:33:16</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">1181888751</sdl:value><sdl:value key="SegmentIdentityHash">AJQwJbiCy80SgldBeu5KhGeXMzQ0eNsqDnSRTwvbGPI=</sdl:value></sdl:seg><sdl:seg id="345" locked="true" conf="Translated" origin="tm" origin-system="NG_Core-pt-BR2" percent="100" text-match="SourceAndTarget"><sdl:rep id="zmxmeFUgq3v6Tf0ogdtgZ7yv2D98pBwHNxdQ0DpWaa0="/><sdl:value key="created_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="created_on">11/09/2022 09:53:12</sdl:value><sdl:value key="modified_on">11/09/2022 09:53:12</sdl:value><sdl:value key="last_modified_by">DESKTOP-MP0FQK1\ASUS</sdl:value><sdl:value key="SDL:OriginalTranslationHash">309777849</sdl:value><sdl:value key="SegmentIdentityHash">zmxmeFUgq3v6Tf0ogdtgZ7yv2D98pBwHNxdQ0DpWaa0=</sdl:value></sdl:seg></sdl:seg-defs></trans-unit></group><group><sdl:cxts><sdl:cxt id="1"/><sdl:cxt id="48"/><sdl:cxt id="49"/><sdl:cxt id="7"/><sdl:cxt id="4"/><sdl:cxt id="5"/></sdl:cxts><trans-unit id="0036f061-6b20-4d42-aa6c-03494fdb5d4a"><source><g id="611">Warning:</g> Do not use the wand if any damage is found on the optical surface.Please contact iTero Customer Support for further instructions.</source><seg-source><mrk mtype="seg" mid="346"><g id="611">Warning:</g> Do not use the wand if any damage is found on the optical surface.</mrk><mrk mtype="seg" mid="347">Please contact iTero Customer Support for further instructions.</mrk></seg-source><target><mrk mtype="seg" mid